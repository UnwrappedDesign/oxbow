---
// Assets

import AlpineTailwind from "@/components/global/AlpineTailwind.astro";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/typography/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ComponentsShowcase from "@/components/landing/ComponentsShowcase.astro";
---

<BaseLayout>
  <section class="relative">
    <Wrapper variant="standard" class="pt-32 lg:pt-12 pb-12 relative">
      <div class="text-balance max-w-xl mx-auto text-center">
        <Text
          tag="h1"
          variant="displaySM"
          class="tracking-tight text-foreground font-medium"
        >
          Open Source code blocks made with Tailwind CSS &amp; Alpine JS
        </Text>
        <Text
          tag="p"
          variant="textSM"
          class="mt-4 text-muted-foreground font-medium"
        >
          427 production-ready Tailwind CSS & Alpine.js blocks, released under
          the MIT license — Copy-paste or use MCP.
        </Text>
      </div>
    </Wrapper>
  </section>
  <ComponentsShowcase />
</BaseLayout>
