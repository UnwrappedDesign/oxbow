---
// Assets

import AlpineTailwind from "@/components/global/AlpineTailwind.astro";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/typography/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ComponentsShowcase from "@/components/landing/ComponentsShowcase.astro";
---

<BaseLayout>
  <section class="relative">
    <Wrapper variant="standard" class="py-32 lg:pt-12  relative">
      <div class="text-balance max-w-x3l relative text-center flex flex-col items-center">
        <AlpineTailwind />
        <Text
          tag="h1"
          variant="displayLG"
          class="font-semibold tracking-tight text-base-900 mt-12 font-display"
        >
          Open Sourc blocks and components for Tailwind CSS &amp; Alpine JS UI
          Blocks
        </Text>
      </div>
    </Wrapper>
  </section>
  <ComponentsShowcase />
</BaseLayout>
