---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/typography/Text.astro";
import Button from "@/components/fundations/buttons/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="relative py-32 overflow-hidden lg:py-55">
      <div class="relative text-center text-balance max-w-xl mx-auto">
        <Text
          tag="h1"
          variant="displayLG"
          class="tracking-tight text-foreground mt-12 font-serif"
        >
          Well, this is awkward.
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-muted-foreground">
          The page you’re looking for either vanished, never existed, or decided
          it was too cool to show up. We respect the hustle.
        </Text>
      </div>
      <div
        class="relative flex flex-wrap items-center justify-center w-full mt-10 gap-2"
      >
        <Button isLink={true} size="xs" variant="oxbowmuted" href="/"
          >Looking for blocks?</Button
        >
      </div>
    </Wrapper>
  </section>
</BaseLayout>
