---
import Text from "@/components/fundations/typography/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Fundations
const navLinks = [
  {
    title: "Tools",
    links: [
      {
        label: "Grid generator",
        href: "/tools/tailwind-css-grid-generator",
      },
      {
        label: "Gradient generator",
        href: "/tools/tailwind-css-gradient-generator",
      },
      {
        label: "Color picker",
        href: "/tools/tailwind-css-color-palette",
      },
    ],
  },
];
---

<footer>
  <Wrapper class="py-8">
    <div class="max-w-2xl mx-auto text-center">
      <Text tag="p" variant="textSM" class="text-base-500">
        Built by
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="text-base-900"
          href="https://x.com/mike_andreuzza">Michael</a
        >

        . Code available on
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="text-base-900"
          href="https://github.com/UnwrappedDesign/oxbow">GitHub</a
        >
      </Text>
      {
        navLinks.map((section, i) => (
          <nav aria-label={section.title}>
            <ul
              role="list"
              class="mt-4 text-sm flex gap-4 justify-center flex-wrap text-base-600 dark:text-base-400"
            >
              {section.links.map((link, j) => (
                <li>
                  <a
                    class="hover:text-base-900 dark:hover:text-white"
                    href={link.href}
                    title={link.label}
                    target={link.href.startsWith("http") ? "_blank" : undefined}
                    rel={
                      link.href.startsWith("http")
                        ? "noopener noreferrer"
                        : undefined
                    }
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </Wrapper>
</footer>
