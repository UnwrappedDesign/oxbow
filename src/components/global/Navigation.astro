---
import ThemeToggle from "@/components/assets/ThemeToggle.astro";
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/typography/Text.astro";

import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<div
  class="fixed top-0 left-0 right-0 z-50 items-center w-full mx-auto duration-300 bg-background"
>
  <Wrapper variant="nav" class="w-full">
    <div
      class="flex w-full items-center gap-4 text-xs lg:text-sm font-medium text-muted-foreground"
    >
      <a href="/"> oxbow</a>

      <a
        class="hover:text-foreground duration-300 focus:outline-none ml-auto"
        href="https://github.com/UnwrappedDesign/oxbow">GitHub</a
      >
      <a
        class="hover:text-foreground duration-300 focus:outline-none"
        href="https://lexingtonthemes.com">Astro Templates</a
      >

      <ThemeToggle />
    </div>
  </Wrapper>
</div>
