---
import ThemeToggle from "@/components/assets/ThemeToggle.astro";
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/typography/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import BlocksSearch from "@/components/landing/BlocksSearch.astro";
import {
  pageSections,
  pageExamples,
  forms,
  elements,
  overlay,
  navigation,
  storeSections,
} from "@/data/entries.json";

const groupedEntries = [
  {
    title: "Marketing",
    groups: [
      { label: "Page sections", data: pageSections },
      { label: "Landing Pages", data: pageExamples },
    ],
  },
  {
    title: "Application",
    groups: [
      { label: "Navigation", data: navigation },
      { label: "Overlay", data: overlay },
      { label: "Forms", data: forms },
      { label: "Elements", data: elements },
    ],
  },
  {
    title: "eCommerce",
    groups: [{ label: "Pages", data: storeSections }],
  },
];

const searchItems = groupedEntries.flatMap((section) =>
  section.groups.flatMap((group) =>
    group.data
      .filter((entry) => (entry.count || 0) > 0)
      .map((entry) => ({
        title: entry.name,
        description: `${section.title} / ${group.label}`,
        href: entry.link,
      })),
  ),
);
---

<div
  class="fixed top-0 left-0 right-0 z-50 items-center w-full mx-auto duration-300 bg-background"
>
  <Wrapper variant="nav" class="w-full">
    <div
      class="flex w-full items-center gap-4 text-xs lg:text-sm font-medium text-muted-foreground"
    >
      <a href="/"> oxbow</a>

      <a
        class="hover:text-foreground duration-300 focus:outline-none ml-auto"
        href="https://github.com/UnwrappedDesign/oxbow">GitHub</a
      >
      <a
        class="hover:text-foreground duration-300 focus:outline-none"
        href="https://lexingtonthemes.com">Astro Templates</a
      >
      <BlocksSearch items={searchItems} />

      <ThemeToggle />
    </div>
  </Wrapper>
</div>
