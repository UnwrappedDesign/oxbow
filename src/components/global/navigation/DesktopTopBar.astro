---
// Fundations
import Text from "@/components/fundations/typography/Text.astro";
import Button from "@/components/fundations/buttons/Button.astro";
//Icons
import Burger from "@/components/fundations/icons/Burger.astro";
import Search from "@/components/fundations/icons/Search.astro";
import GithubBrand from "@/components/fundations/icons/GithubBrand.astro";
// Assets
import Logo from "@/components/assets/Logo.astro";
import ThemeToggle from "@/components/assets/ThemeToggle.astro";
---

<header
  class="sticky top-0 z-10 flex flex-col gap-4 bg-background px-8 py-4 lg:px-12 border-b border-border"
>
  <div class="flex items-center justify-between gap-2 w-full">
    <a
      href="/"
      class="flex lg:hidden items-center gap-3 text-sm font-semibold uppercase tracking-wide text-foreground"
    >
      <Logo class="h-6" />
      <span>Oxbowui</span>
    </a>
    <div class="relative z-0 focus-within:z-10 mt-2 w-62 hidden lg:flex">
      <div
        class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none"
      >
        <Search size="xs" class="text-muted-foreground" />
      </div>
      <input
        placeholder="Search.."
        id="search-left"
        name="search-left"
        type="search"
        class="w-full block text-xs transition duration-300 ease-in-out leading-tight align-middle focus:z-10 pl-10 h-8 px-4 py-2 text-sm rounded-md border border-transparent ring-1 ring-border placeholder-muted-foreground focus:border-border focus:ring-border focus:ring-2 focus:outline-none shadow-sm bg-background text-foreground focus:border-border"
      />
    </div>
    <div
      class="flex items-center gap-2 justify-end w-full text-muted-foreground"
    >
      <Text
        tag="a"
        variant="textXS"
        href="https://lexingtonthemes.com"
        class="hover:text-muted-foreground font-medium">Astro Templates</Text
      >
      <Text
        tag="a"
        variant="textXS"
        href="https://github.com/UnwrappedDesign/oxbow"
        class="hover:text-muted-foreground font-medium">GitHub</Text
      >

      <ThemeToggle />
      <Button
        variant="muted"
        size="xs"
        iconOnly
        type="button"
        class="lg:hidden"
        data-docs-toggle
      >
        <Burger size="xs" slot="right-icon" />
        <span class="sr-only">Open navigation</span>
      </Button>
    </div>
  </div>
</header>
