---
import Button from "@/components/fundations/buttons/Button.astro";
import Burger from "@/components/fundations/icons/Burger.astro";
---

<div
  class="flex items-center justify-between p-4 bg-white border-b border-base-200 lg:hidden"
>
  <h1 class="text-lg font-semibold text-base-900 ">
    Documentation
  </h1>
  <Button
    variant="muted"
    size="sm"
    iconOnly
    type="button"
    class="inline-flex items-center gap-2 rounded-lg border border-base-200 bg-white px-3 py-1.5 text-sm font-medium text-base-700 shadow-sm transition hover:border-accent-300 hover:text-accent-600  "
    data-docs-toggle
  >
    <Burger size="sm" slot="right-icon" />
    <span class="sr-only">Open navigation</span>
  </Button>
</div>
