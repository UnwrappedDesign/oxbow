---
import Button from "@/components/fundations/buttons/Button.astro";
import Burger from "@/components/fundations/icons/Burger.astro";
---

<div
  class="flex items-center justify-between p-4 bg-background border-b border-border lg:hidden"
>
  <h1 class="text-lg font-semibold text-muted-foreground">
    Documentation
  </h1>
  <Button
    variant="muted"
    size="sm"
    iconOnly
    type="button"
    class="inline-flex items-center gap-2 rounded-lg border border-border bg-background px-3 py-1.5 text-sm font-medium shadow-sm transition hover:border-border-300 hover:text-foreground text-foreground"
    data-docs-toggle
  >
    <Burger size="sm" slot="right-icon" />
    <span class="sr-only">Open navigation</span>
  </Button>
</div>
