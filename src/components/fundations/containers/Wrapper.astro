---
interface Props {
  variant?:
    | "wide"
    | "prose"
    | "standard"
    | "nav"
    | "footer"
    | "paddinglessDesktop"
    | "paddingless"
    | "narrow"; // Define any variants you need
  class?: string; // Optional prop for additional classes
}
const { variant = "standard", class: extraClass = "" } = Astro.props;
// Map each variant to its specific classes
const variantClasses = {
  narrow: "max-w-xl 2xl:max-w-3xl mx-auto px-8 lg:px-4 ",
  //
  prose: [
    // Base typography
    "prose",
    "prose-base",
    "max-w-none",
    "prose-headings:scroll-mt-24",
    // Body text
    "text-muted-foreground",
    "text-muted-foreground",
    // Headings
    "prose-headings:font-medium",
    "prose-headings:text-foreground",
    "prose-headings:text-foreground",
    // Links
    "prose-a:text-muted-foreground",
    "prose-a:hover:text-foreground",
    "prose-a:hover:text-muted-foreground",
    "prose-a:duration-200",
    // Strong text
    "prose-strong:font-medium",
    "prose-strong:text-foreground",
    // Blockquotes
    "prose-blockquote:font-normal",
    "prose-blockquote:tracking-normal",
    "prose-blockquote:text-muted-foreground",
    "prose-blockquote:text-muted-foreground",
    "prose-blockquote:border-border",
    // Horizontal rules
    "prose-hr:border-border",
    "prose-hr:border-border",
    // Images
    "prose-img:border",
    "prose-img:border-border",
    "prose-img:border-border",
    // Code blocks
    "prose-pre:border-none",
    "prose-pre:rounded-xl",
    "prose-pre:relative",
    "prose-pre:my-0",
    "prose-pre:outline-border",
    "prose-pre:outline-border",
    "prose-pre:selection:bg-muted-600/10",
    "prose-pre:selection:text-foreground",
    "prose-pre:selection:text-foreground",
    "prose-pre:overflow-y-hidden",
    "prose-pre:scrollbar-hide",

    // Inline code
    "prose-code:text-foreground",
    // Tables
    "prose-tr:border-border",
    "prose-thead:border-border",
  ].join(" "),
  //
  wide: "max-w-screen 2xl:max-w-[1440px] w-full mx-auto px-8 ",
  //

  paddinglessDesktop:
    "mx-auto max-w-7xl px-4 xl:px-0  overflow-hidden xl:overflow-visible",
  paddingless: "mx-auto max-w-7xl   overflow-hidden xl:overflow-visible",
  standard: "mx-auto px-8 w-full max-w-3xl ",
  nav: "mx-auto px-8 py-2   w-full max-w-3xl ",
};
// Combine the classes for the specified variant with any extra classes
const classes = `${variantClasses[variant]} ${extraClass}`.trim();
---

<div class={classes}>
  <slot />
</div>
