---
const {
  variant,
  size,
  onlyIconSize,
  gap,
  class: className,
  ...rest
} = Astro.props;

// Accent badge
const accentClass = [
  "text-foreground",
  "bg-info",
  "text-foreground",
  "bg-info",
];
// Alternative badge
const alternativeAccentClass = [
  "text-muted-foreground",
  "bg-background",
  "ring-1",
  "ring-border",
  "text-foreground",
  "bg-background",
  "ring-border",
];
// Default badge
const defaultClass = [
  "text-foreground",
  "bg-background",
  "text-foreground",
  "bg-muted",
];
// Muted badge
const mutedClass = [
  "text-muted-foreground",
  "bg-muted",
  "text-foreground",
  "bg-background",
];
// Text badge
const textClass = [
  "text-muted-foreground",
  "bg-background",
  "text-foreground",
  "bg-background",
];
// Info badge
const infoClass = [
  "text-info",
  "bg-info/10",
  "text-info",
  "bg-info/20",
];
// Success badge
const successClass = [
  "text-success",
  "bg-success/10",
  "text-success",
  "bg-success/20",
];
// Warning badge
const warningClass = [
  "text-warning",
  "bg-warning/10",
  "text-warning",
  "bg-warning/20",
];
// Danger badge
const dangerClass = [
  "text-destructive",
  "bg-destructive/10",
  "text-destructive",
  "bg-destructive/20",
];

// Size
const xs = ["px-2.5", "py-1", "text-xs", "rounded-md"];
const sm = ["px-4", "py-1.5", "text-sm", "rounded-lg"];

// Gap
const gapXS = ["gap-1"];
const gapSM = ["gap-4"];
---

<span
  class:list={[
    "inline-flex",
    "items-center",
    "font-medium",
    "relative",
    variant === "accent" && accentClass,
    variant === "alternative" && alternativeAccentClass,
    variant === "default" && defaultClass,
    variant === "muted" && mutedClass,
    variant === "text" && textClass,
    variant === "info" && infoClass,
    variant === "success" && successClass,
    variant === "warning" && warningClass,
    variant === "danger" && dangerClass,
    size === "xs" && xs,
    size === "sm" && sm,
    gap === "xs" && gapXS,
    gap === "sm" && gapSM,
    className,
  ]}
  {...rest}
>
  <slot name="left-icon" />
  <slot />
  <slot name="right-icon" />
  <slot name="notification" />
</span>
