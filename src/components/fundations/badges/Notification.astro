---
const { variant, position, size, class: className, ...rest } = Astro.props;

// Accent
const accentClass = [
  "text-primary",
  "ring-primary",
  "",
  "",
  "",
];
// Alternative
const alternativeAccentClass = [
  "text-base-500",
  "ring-base-200",
  "",
  "",
  "",
];
// Default
const defaultClass = [
  "text-base-800",
  "ring-base-800",
  "",
  "",
  "",
];
// Muted
const mutedClass = [
  "text-base-600",
  "ring-base-600",
  "",
  "",
  "",
];
// Text
const textClass = [
  "text-base-500",
  "bg-white",
  "",
  "",
];
// Info
const infoClass = [
  "text-primary/88",
  "ring-primary/88",
  "",
  "",
  "",
];
// Success
const successClass = [
  "text-success",
  "ring-success",
  "",
  "",
  "",
];
// Warning
const warningClass = [
  "text-warning",
  "ring-warning",
  "",
  "",
  "",
];
// Danger
const dangerClass = [
  "text-destructive",
  "ring-destructive",
  "",
  "",
  "",
];
// Position
const positionXS = ["gap-1"];
const positionSM = ["gap-4"];
// Size
const xs = ["text-[0.6rem]", "size-5", "top-0.5", "right-0"];
const sm = ["text-[0.8rem]", "size-7", "top-1", "right-0"];
---

<span
  class:list={[
    "ring-2",
    "absolute",
    "top-0",
    "right-0",
    "transform",
    "translate-x-1/2",
    "-translate-y-1/2",
    "rounded-full",
    "text-[0.6rem]",
    "flex",
    "bg-white",
    "",
    "items-center",
    "justify-center",
    variant === "accent" && accentClass,
    variant === "alternative" && alternativeAccentClass,
    variant === "default" && defaultClass,
    variant === "muted" && mutedClass,
    variant === "text" && textClass,
    variant === "info" && infoClass,
    variant === "success" && successClass,
    variant === "warning" && warningClass,
    variant === "danger" && dangerClass,
    position === "xs" && positionXS,
    position === "sm" && positionSM,
    size === "xs" && xs,
    size === "sm" && sm,
  ]}
  {...rest}
>
  <slot />
</span>
