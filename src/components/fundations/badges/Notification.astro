---
const { variant, position, size, class: className, ...rest } = Astro.props;

// Accent
const accentClass = [
  "text-info",
  "ring-info",
  "text-info",
  "ring-info/40",
  "bg-background",
];
// Alternative
const alternativeAccentClass = [
  "text-muted-foreground",
  "ring-border",
  "text-foreground",
  "ring-border",
  "bg-background",
];
// Default
const defaultClass = [
  "text-muted-foreground",
  "ring-border",
  "text-foreground",
  "ring-border",
  "bg-background",
];
// Muted
const mutedClass = [
  "text-muted-foreground",
  "ring-border",
  "text-muted-foreground",
  "ring-border",
  "bg-background",
];
// Text
const textClass = [
  "text-muted-foreground",
  "bg-background",
  "text-foreground",
  "bg-background",
];
// Info
const infoClass = [
  "text-info",
  "ring-info",
  "text-info",
  "ring-info/40",
  "bg-background",
];
// Success
const successClass = [
  "text-success",
  "ring-success",
  "text-success",
  "ring-success/40",
  "bg-background",
];
// Warning
const warningClass = [
  "text-warning",
  "ring-warning",
  "text-warning",
  "ring-warning/40",
  "bg-background",
];
// Danger
const dangerClass = [
  "text-destructive",
  "ring-destructive",
  "text-destructive",
  "ring-destructive/40",
  "bg-background",
];
// Position
const positionXS = ["gap-1"];
const positionSM = ["gap-4"];
// Size
const xs = ["text-[0.6rem]", "size-5", "top-0.5", "right-0"];
const sm = ["text-[0.8rem]", "size-7", "top-1", "right-0"];
---

<span
  class:list={[
    "ring-2",
    "absolute",
    "top-0",
    "right-0",
    "transform",
    "translate-x-1/2",
    "-translate-y-1/2",
    "rounded-full",
    "text-[0.6rem]",
    "flex",
    "bg-background",
    "bg-background",
    "items-center",
    "justify-center",
    variant === "accent" && accentClass,
    variant === "alternative" && alternativeAccentClass,
    variant === "default" && defaultClass,
    variant === "muted" && mutedClass,
    variant === "text" && textClass,
    variant === "info" && infoClass,
    variant === "success" && successClass,
    variant === "warning" && warningClass,
    variant === "danger" && dangerClass,
    position === "xs" && positionXS,
    position === "sm" && positionSM,
    size === "xs" && xs,
    size === "sm" && sm,
  ]}
  {...rest}
>
  <slot />
</span>
