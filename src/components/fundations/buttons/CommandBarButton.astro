---
// Props to make the component more flexible
const {
  text = "Search projects...",
  hasKbd = false,
  kbdKey = "S",
  iconSlot, // Slot for custom icons
  additionalClasses = "",
} = Astro.props;
---

<button
  class={`flex p-2 items-center w-full text-xs text-muted-foreground duration-200 cursor-pointer select-none hover:text-foreground group rounded-md hover:bg-muted ${additionalClasses}`}
>
  <div class="flex items-center gap-2">
    {iconSlot ? <slot name="icon" /> : null}
    <span class="flex-auto truncate">{text}</span>
  </div>
  {
    hasKbd && (
      <span class="flex-none ml-auto text-xs font-semibold text-muted-foreground">
        <kbd class="flex items-center justify-center font-semibold bg-background border rounded size-4 text-muted-foreground border-border">
          {kbdKey}
        </kbd>
      </span>
    )
  }
</button>
