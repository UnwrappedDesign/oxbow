---
const { variant, size, class: className, ...rest } = Astro.props;
// Variant classes
const defaultClass = [
  // Link
  "text-foreground",
  "bg-background",
  "outline",
  "outline-border",
  "hover:bg-background",
  "focus:outline-border",
  // Dark
  "bg-muted",
  "text-foreground",
  "outline-border",
  "hover:bg-muted",
  "focus:outline-border",
];
const accentClass = [
  // Light
  "text-foreground",
  "bg-muted",
  "outline",
  "outline-border",
  "hover:bg-muted",
  "focus:outline-border",
  // Dark
  "bg-muted",
  "text-foreground",
  "outline-border",
  "hover:bg-muted",
  "focus:outline-border",
];
const mutedClass = [
  // Light
  "text-muted-foreground",
  "bg-muted",
  "outline",
  "outline-border",
  "hover:bg-muted",
  "focus:outline-border",
  // Dark
  "text-foreground",
  "bg-background",
  "outline-border",
  "hover:bg-muted",
  "focus:outline-border",
];
const outlineClass = [
  // Light
  "text-muted-foreground",
  "bg-background",
  "outline",
  "outline-border",
  "hover:shadow-sm",
  "focus:outline-border",
  // Dark
  "text-foreground",
  "bg-background",
  "outline-border",
  "hover:bg-background",
  "focus:outline-border",
];
const ghostClass = [
  "text-muted-foreground",
  "bg-transparent",
  "hover:bg-muted",
  "focus:outline-border",
  "text-foreground",
  "hover:bg-background",
  "focus:outline-border",
  "bg-transparent",
];
const textClass = [
  "text-muted-foreground",
  "bg-background",
  "outline",
  "outline-border",
  "hover:text-foreground",
  "hover:bg-muted",
  "focus:outline-border",
  // Dark
  "text-foreground",
  "bg-muted",
  "outline-border",
  "hover:bg-muted",
  "focus:outline-border",
];
const linkClass = [
  "text-foreground",
  "bg-transparent",
  "hover:underline",
  "focus:underline",
  "focus:outline-none",
  "p-0",
  "rounded-none",
  "text-foreground",
  "bg-transparent",
];
// Info badge
const infoClass = [
  // Light
  "text-foreground",
  "bg-info",
  "outline",
  "outline-info",
  "hover:bg-info",
  "focus:outline-info",
  // Dark
  "bg-info",
  "text-foreground",
  "outline-info",
  "hover:bg-info",
  "focus:outline-info",
];
// Success badge
const successClass = [
  // Light
  "text-foreground",
  "bg-success",
  "outline",
  "outline-success",
  "hover:bg-success",
  "focus:outline-success",
  // Dark
  "bg-success",
  "text-foreground",
  "outline-success",
  "hover:bg-success",
  "focus:outline-success",
];
// Warning badge
const warningClass = [
  // Light
  "text-foreground",
  "bg-warning",
  "outline",
  "outline-warning",
  "hover:bg-warning",
  "focus:outline-warning",
  // Dark
  "bg-warning",
  "text-foreground",
  "outline-warning",
  "hover:bg-warning",
  "focus:outline-warning",
];
// Danger badge
const dangerClass = [
  // Light
  "text-foreground",
  "bg-destructive",
  "outline",
  "outline-destructive",
  "hover:bg-destructive",
  "focus:outline-destructive",
  // Dark
  "bg-destructive",
  "text-foreground",
  "outline-destructive",
  "hover:bg-destructive",
  "focus:outline-destructive",
];
// Size classes
const xxs = ["size-7", "p-0.5", "text-xs", "rounded-md"];
const xs = ["size-8", "p-0.5", "text-xs", "rounded-md"];
const sm = ["size-9", "p-2", "text-sm", "rounded-md"];
const base = ["size-10", "p-2", "text-base", "rounded-md"];
const md = ["size-11", "p-2.5", "text-base", "rounded-md"];
const lg = ["size-12", "p-3", "text-base", "rounded-lg"];
const xl = ["size-14", "p-3.5", "text-lg", "rounded-lg"];
---

<button
  class:list={[
    "flex",
    "items-center",
    "justify-center",
    "text-center",
    "shadow-subtle",
    "font-medium",
    "duration-500",
    "ease-in-out",
    "transition-colors",
    "focus:outline-2",
    "focus:outline-offset-2",
    variant === "accent" && accentClass,
    variant === "default" && defaultClass,
    variant === "muted" && mutedClass,
    variant === "text" && textClass,
    variant === "link" && linkClass,
    variant === "info" && infoClass,
    variant === "success" && successClass,
    variant === "warning" && warningClass,
    variant === "danger" && dangerClass,

    size === "xxs" && xxs,
    size === "xs" && xs,
    size === "sm" && sm,
    size === "base" && base,
    size === "md" && md,
    size === "lg" && lg,
    size === "xl" && xl,
    className,
  ]}
  {...rest}
>
  <slot />
  <slot
    name="icon"
    class:list={[
      // only apply shadow-none if variant is link or text
      (variant === "link" || variant === "text") && "shadow-none",
    ]}
  />
</button>
