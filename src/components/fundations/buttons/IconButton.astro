---
const { variant, size, class: className, ...rest } = Astro.props;
// Variant classes
const defaultClass = [
  // Link
  "text-white",
  "bg-base-900",
  "outline",
  "outline-base-900",
  "hover:bg-base-950",
  "focus:outline-base-950",
  // Dark
  "",
  "",
  "",
  "",
  "",
];
const accentClass = [
  // Light
  "text-white",
  "bg-primary/88",
  "outline",
  "outline-primary/88",
  "hover:bg-primary",
  "focus:outline-primary",
  // Dark
  "",
  "",
  "",
  "",
  "",
];
const mutedClass = [
  // Light
  "text-base-600",
  "bg-base-50",
  "outline",
  "outline-base-50",
  "hover:bg-base-200",
  "focus:outline-base-600",
  // Dark
  "",
  "",
  "",
  "",
  "",
];
const outlineClass = [
  // Light
  "text-base-700",
  "bg-white",
  "outline",
  "outline-base-200",
  "hover:shadow-sm",
  "focus:outline-base-900",
  // Dark
  "",
  "",
  "",
  "",
  "",
];
const ghostClass = [
  "text-base-600",
  "bg-transparent",
  "hover:bg-base-100",
  "focus:outline-base-300",
  "",
  "",
  "",
  "",
];
const textClass = [
  "text-base-500",
  "bg-white",
  "outline",
  "outline-base-200",
  "hover:text-primary",
  "hover:bg-base-50",
  "focus:outline-primary/88",
  // Dark
  "",
  "",
  "",
  "",
  "",
];
const linkClass = [
  "text-primary/88",
  "bg-transparent",
  "hover:underline",
  "focus:underline",
  "focus:outline-none",
  "p-0",
  "rounded-none",
  "",
  "",
];
// Info badge
const infoClass = [
  // Light
  "text-white",
  "bg-primary/88",
  "outline",
  "outline-primary/88",
  "hover:bg-primary",
  "focus:outline-primary",
  // Dark
  "",
  "",
  "",
  "",
  "",
];
// Success badge
const successClass = [
  // Light
  "text-white",
  "bg-success/88",
  "outline",
  "outline-success/88",
  "hover:bg-success",
  "focus:outline-success",
  // Dark
  "",
  "",
  "",
  "",
  "",
];
// Warning badge
const warningClass = [
  // Light
  "text-white",
  "bg-warning/88",
  "outline",
  "outline-warning/88",
  "hover:bg-warning",
  "focus:outline-warning",
  // Dark
  "",
  "",
  "",
  "",
  "",
];
// Danger badge
const dangerClass = [
  // Light
  "text-white",
  "bg-destructive/88",
  "outline",
  "outline-destructive/88",
  "hover:bg-destructive",
  "focus:outline-destructive",
  // Dark
  "",
  "",
  "",
  "",
  "",
];
// Size classes
const xxs = ["size-7", "p-0.5", "text-xs", "rounded-md"];
const xs = ["size-8", "p-0.5", "text-xs", "rounded-md"];
const sm = ["size-9", "p-2", "text-sm", "rounded-md"];
const base = ["size-10", "p-2", "text-base", "rounded-md"];
const md = ["size-11", "p-2.5", "text-base", "rounded-md"];
const lg = ["size-12", "p-3", "text-base", "rounded-lg"];
const xl = ["size-14", "p-3.5", "text-lg", "rounded-lg"];
---

<button
  class:list={[
    "flex",
    "items-center",
    "justify-center",
    "text-center",
    "shadow-subtle",
    "font-medium",
    "duration-500",
    "ease-in-out",
    "transition-colors",
    "focus:outline-2",
    "focus:outline-offset-2",
    variant === "accent" && accentClass,
    variant === "default" && defaultClass,
    variant === "muted" && mutedClass,
    variant === "text" && textClass,
    variant === "link" && linkClass,
    variant === "info" && infoClass,
    variant === "success" && successClass,
    variant === "warning" && warningClass,
    variant === "danger" && dangerClass,


    size === "xxs" && xxs,
    size === "xs" && xs,
    size === "sm" && sm,
    size === "base" && base,
    size === "md" && md,
    size === "lg" && lg,
    size === "xl" && xl,
    className,
  ]}
  {...rest}
>
  <slot />
  <slot
    name="icon"
    class:list={[
      // only apply shadow-none if variant is link or text
      (variant === "link" || variant === "text") && "shadow-none",
    ]}
  />
</button>
