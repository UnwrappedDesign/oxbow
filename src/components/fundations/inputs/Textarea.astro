---
const {
  id,
  name,
  label,
  error,
  variant = "default",
  size = "base",
  class: className = "",
  ...rest
} = Astro.props;

const variantClasses = {
  default: [
    "bg-background",
    "border",
    "text-muted-foreground",
    "ring-1",
    "ring-border",
    "placeholder:text-muted-foreground",
    "focus:border-border",
    "focus:outline-none",
    "focus:ring-border",
    "focus:ring-offset-2",
    "focus:ring-2",
    // Dark mode variants
    "bg-background",
    "text-foreground",
    "ring-border",
    "placeholder:text-muted-foreground",
    "focus:border-border",
    "focus:ring-border ",
    "focus:ring-offset-background",
  ],
  dark: [
    "bg-background",
    "text-foreground",
    "border-border",
    "ring-1",
    "ring-border",
    "placeholder:text-muted-foreground",
    "focus:ring-border ",
    "focus:ring-offset-2",
    "focus:border-border",
    "focus:outline-none",
  ],
};

const sizeClasses = {
  base: ["px-4", "py-3", "text-sm", "rounded-md"],
};

let textareaClasses = [
  "block",
  "w-full",
  "resize-y",
  "transition",
  "duration-300",
  "ease-in-out",
  ...sizeClasses[size],
  ...variantClasses[variant],
  ...className.split(" "),
];

const errorTextColor =
  variant === "dark" ? "text-destructive" : "text-destructive";
---

<div class="w-full">
  {
    label && (
      <label
        for={id}
        class="block mb-1 text-sm font-medium text-muted-foreground"
      >
        {label}
      </label>
    )
  }
  <textarea
    {...rest}
    id={id}
    name={name}
    rows={rest.rows || 4}
    class:list={textareaClasses}
    aria-invalid={!!error}
    aria-describedby={error ? `${id}-error` : undefined}></textarea>
  {
    error && (
      <p id={`${id}-error`} class={`mt-1 text-sm ${errorTextColor}`}>
        {error}
      </p>
    )
  }
</div>
