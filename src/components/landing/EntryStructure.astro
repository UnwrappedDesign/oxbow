---
import Text from "@/components/fundations/typography/Text.astro";
import { Image } from "astro:assets";
import type { Template } from "@/data/entries.json";
interface Props {
  entries: Template[];
}
const { entries } = Astro.props; // Make sure entries is correctly passed and used
const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  "/src/screenshots/*.png",
);
const modules = import.meta.glob("@/components/oxbow/**/*.astro", {
  eager: true,
});
const componentBySection = Object.keys(modules).reduce((acc, file) => {
  const [section, subsection] = file
    .replace(/.*\/src\/components\/oxbow\//, "")
    .split("/");
  const path = ["/playground", section, subsection].filter(Boolean).join("/");
  return {
    ...acc,
    [path]: acc[path] ? acc[path] + 1 : 1,
  };
}, {});

const firstScreenshotForLink = (link: string) => {
  const match = link.match(/^\/playground\/([^/]+)\/([^/?#]+)/i);
  if (!match) return undefined;
  const [, section, subsection] = match;
  const base = `${section}_${subsection}_`;
  const exact = `/src/screenshots/${base}01.png`;
  if (screenshots[exact]) return exact;
  return Object.keys(screenshots)
    .filter((key) => key.startsWith(`/src/screenshots/${base}`))
    .sort()[0];
};

// Add quantity to each entry
const entriesWithQuantity = entries
  .map((entry: Template) => {
    const imagePath = firstScreenshotForLink(entry.link);
    if (!imagePath) return null;
    return {
      ...entry,
      image: screenshots[imagePath],
      quantity: componentBySection[entry.link] || 0,
    };
  })
  .filter((entry): entry is NonNullable<typeof entry> => entry !== null)
  // Filter out entries with quantity 0
  .filter((entry) => entry.quantity > 0)
  // Sort alphabetically by component name
  .sort((a, b) => a.name.localeCompare(b.name));
---

<div class="grid grid-cols-1 lg:grid-cols-4 gap-y-12 gap-x-4 mt-8">
  {
    entriesWithQuantity.map((template) => {
      return (
        <div class="relative">
          <a
            title={template.name}
            href={template.link}
            class="absolute inset-0 z-1"
          />

          <Image
            class="object-cover object-top  aspect-16/10 w-full  shadow rounded-xl"
            alt={template.name}
            src={template.image()}
          />
          <div class=" items mt-2">
            <Text
              tag="p"
              variant="textSM"
              class="relative font-medium text-black   dark:text-white"
            >
              {template.name}
            </Text>
            <Text
              tag="p"
              variant="textXS"
              class="relative flex items-center gap-1  2xl:text-sm text-base-500"
            >
              {template.quantity} Components
            </Text>
          </div>
        </div>
      );
    })
  }
</div>
