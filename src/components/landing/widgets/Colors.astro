---
// src/components/ColorCircles.astro
const bg500Shades = [
  "bg-destructive",
  "bg-muted",
  "bg-warning",
  "bg-warning",
  "bg-lime-500",
  "bg-success",
  "bg-success",
  "bg-teal-500",
  "bg-info",
  "bg-info",
  "bg-muted",
  "bg-info",
  "bg-violet-500",
  "bg-muted",
  "bg-pink-500",
  "bg-destructive",
  "bg-muted",
  "bg-muted",
  "bg-muted",
  "bg-muted",
  "bg-muted",
];
---

<div aria-hidden="true" class="flex gap-2 shrink-0">
  {
    bg500Shades.map((shade) => (
      <div class="p-1 rounded-lg outline outline-border hover:-translate-y-12 duration-600">
        <div
          class={`${shade}  h-20 w-10  shrink-0  rounded-md`}
          title={shade}
        />
      </div>
    ))
  }
</div>
