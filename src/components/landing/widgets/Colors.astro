---
// src/components/ColorCircles.astro
const bg500Shades = [
  "bg-destructive/88",
  "bg-warning/88",
  "bg-warning/88",
  "bg-warning/88",
  "bg-success/88",
  "bg-success/88",
  "bg-success/88",
  "bg-info/88",
  "bg-info/88",
  "bg-primary/88",
  "bg-primary/88",
  "bg-primary/88",
  "bg-primary/88",
  "bg-primary/88",
  "bg-destructive/88",
  "bg-destructive/88",
  "bg-base-500",
  "bg-base-500",
  "bg-base-500",
  "bg-base-500",
  "bg-primary/88",
];
---

<div aria-hidden="true" class="flex gap-2 shrink-0">
  {
    bg500Shades.map((shade) => (
      <div class="p-1 rounded-lg outline outline-base-200 hover:-translate-y-12 duration-600 ">
        <div
          class={`${shade}  h-20 w-10  shrink-0  rounded-md`}
          title={shade}
        />
      </div>
    ))
  }
</div>
