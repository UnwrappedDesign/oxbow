---
export const excludeFromObfuscation = [
  "bg-background",
  "bg-muted",
  "ring-2",
  "ring-offset-2",
  "ring-border",
  "ring-border",
  "bg-muted",
  "ring-border",
  "bg-muted",
  "ring-border/30",
  "bg-muted",
  "ring-border/30",
  "bg-muted/20",
  "ring-destructive/30",
  "bg-destructive/20",
  "ring-border/30",
  "bg-muted/20",
  "ring-warning/30",
  "bg-warning",
  "ring-border/30",
  "bg-muted/20",
  "ring-info/30",
  "bg-info",
  "ring-success/30",
  "bg-success",
  "ring-success/30",
  "bg-success/20",
  "text-foreground",
  "bg-background",
  "border-b-2",
  "border-border",
];

export const description =
  "Details with image slider with arrow and step navigation, color, size selector and info tabs with reviews";
import Text from "@/components/fundations/typography/Text.astro";
import Button from "@/components/fundations/buttons/Button.astro";
---

<section class="bg-background">
  <div class="relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div
        x-data="{ activeSlide: 0, slides: ['/store/shoes/airmax/1.png', '/store/shoes/airmax/2.png', '/store/shoes/airmax/3.png', '/store/shoes/airmax/4.png'] }"
        role="region"
        aria-label="Image Slider"
        class="relative flex flex-col gap-4"
      >
        <!-- Slider container -->
        <div class="relative w-full aspect-square">
          <!-- Template for each slide image -->
          <template x-for="(slide, index) in slides" :key="index">
            <div
              x-show="activeSlide === index"
              x-transition:enter="transition ease-out duration-500"
              x-transition:enter-start="opacity-0 transform scale-95"
              x-transition:enter-end="opacity-100 transform scale-100"
              x-transition:leave="transition ease-in duration-500"
              x-transition:leave-start="opacity-100 transform scale-100"
              x-transition:leave-end="opacity-0 transform scale-95"
              class="absolute inset-0 aspect-square"
              :aria-hidden="activeSlide !== index"
            >
              <!-- Slide image -->
              <img
                :src="slide"
                alt="#"
                class="object-cover size-full rounded-2xl"
              />
            </div>
          </template>
        </div>

        <!-- Buttons and Pagination -->
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <!-- Previous slide button -->
            <button
              @click="activeSlide = activeSlide === 0 ? slides.length - 1 : activeSlide - 1"
              class="flex items-center justify-center bg-background border rounded-full transform border-border text-foreground size-10 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-border"
              aria-label="Previous Slide"
            >
              &larr;
            </button>
            <!-- Next slide button -->
            <button
              @click="activeSlide = activeSlide === slides.length - 1 ? 0 : activeSlide + 1"
              class="flex items-center justify-center bg-background border rounded-full transform border-border text-foreground size-10 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-border"
              aria-label="Next Slide"
            >
              &rarr;
            </button>
          </div>
          <!-- Pagination indicators -->
          <div class="flex transform space-x-2">
            <template x-for="(slide, index) in slides" :key="index">
              <button
                @click="activeSlide = index"
                :class="{'bg-background': activeSlide === index, 'bg-muted': activeSlide !== index}"
                class="rounded-full size-3 focus:outline-none"
                :aria-label="'Slide ' + (index + 1)"
                :aria-current="activeSlide === index ? 'true' : 'false'"
              ></button>
            </template>
          </div>
        </div>
      </div>

      <div class="flex flex-col">
        <Text tag="h1" variant="textXL" class="font-medium text-foreground"
          >Nike Air Force 1´07 Fresh</Text
        >
        <Text tag="p" variant="textLG" class="mt-1 text-foreground"
          >$152 <del class="opacity-70">$190</del>
          <span class="text-success">20% Off</span></Text
        >
        <Text tag="p" variant="textSM" class="mt-2 text-muted-foreground">
          Men's shoes
        </Text>
        <Text tag="p" variant="textSM" class="mt-8 text-muted-foreground">
          Hitting the field in the late '60s, adidas airforcewhiteS quickly
          became soccer's "it" shoe.
        </Text>
        <div class="mt-4 grid cols-1 md:grid-cols-2 gap-4">
          <!-- Color Selector -->
          <div x-data="{ activeColor: null }">
            <Text
              tag="p"
              variant="textXS"
              class="uppercase text-muted-foreground"
            >
              Color
            </Text>
            <fieldset
              aria-label="Choose a color"
              class="mt-2"
              x-data="{ 
              colors: [
                { name: ' Black', ring: 'ring-border', bg: 'bg-muted' },
                { name: ' Gray', ring: 'ring-border', bg: 'bg-muted' },
                { name: ' Purple', ring: 'ring-border/30', bg: 'bg-muted' },
                { name: ' Pink', ring: 'ring-border/30', bg: 'bg-muted/20' },
                { name: ' Red', ring: 'ring-destructive/30', bg: 'bg-destructive/20' },
                { name: ' Orange', ring: 'ring-border/30', bg: 'bg-muted/20' },
                { name: ' Yellow', ring: 'ring-warning/30', bg: 'bg-warning' },
                { name: ' Blue', ring: 'ring-info/30', bg: 'bg-info' },
                { name: ' Cyan', ring: 'ring-info/30', bg: 'bg-info' },
                { name: ' Green', ring: 'ring-success/30', bg: 'bg-success' },
                { name: ' Teal', ring: 'ring-success/30', bg: 'bg-success/20' },
              ],
              activeColor: ' Black' 
            }"
            >
              <div class="flex flex-wrap items-center gap-3">
                <template x-for="color in colors" :key="color.name">
                  <label
                    :aria-label="color.name"
                    class="relative -m-0.5 duration-300 flex cursor-pointer items-center justify-center rounded-full p-0.5 focus:outline-none"
                    :class="{ 'ring-2 ring-offset-2 ring-border': activeColor === color.name }"
                  >
                    <input
                      type="radio"
                      name="color-choice"
                      :value="color.name"
                      class="sr-only"
                      @click="activeColor = color.name"
                    />
                    <span
                      aria-hidden="true"
                      class="rounded-full size-6 ring-1"
                      :class="`${color.ring} ${color.bg}`"></span>
                  </label>
                </template>
              </div>
            </fieldset>
          </div>
          <!-- Sizing -->
          <div
            x-data="{
              sizeSystem: 'US',
              activeSize: null,
              sizes: {
                  US: ['6', '7', '8', '9', '10', '11', '12', '13'],
                  EU: ['39', '40', '41', '42', '43', '44', '45', '46']
              }
          }"
          >
            <div class="flex items-center justify-between">
              <Text
                tag="p"
                variant="textXS"
                class="uppercase text-muted-foreground"
              >
                Shoe size
              </Text>
              <div>
                <label for="size-system" class="sr-only">Size System</label>
                <select
                  id="size-system"
                  x-model="sizeSystem"
                  @change="activeSize = null"
                  class="block w-auto h-8 pl-2.5 pr-8 py-2 text-xs text-foreground duration-300 bg-background border border-transparent rounded-lg appearance-none ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2"
                >
                  <option value="US">US</option>
                  <option value="EU">EU</option>
                </select>
              </div>
            </div>
            <div class="mt-2 grid grid-cols-4 gap-2 divide-x divide-border">
              <template x-for="size in sizes[sizeSystem]" :key="size">
                <div>
                  <input
                    type="radio"
                    :id="'size-' + size"
                    :value="size"
                    name="size-choice"
                    x-model="activeSize"
                    class="sr-only peer"
                  />
                  <label
                    :for="'size-'+ size" x-text="size" class="flex items-center justify-center px-3 py-2 text-sm font-medium bg-background cursor-pointer ring-1 ring-border rounded-md duration-300 peer-checked:ring-2 peer-checked:ring-border peer-checked:text-foreground text-foreground peer-checked:ring-offset-2" ></label> </div> </template> </div> </div> </div> <!-- Action Buttons --> <div class="flex flex-row mt-8 gap-2"> <Button size="sm" variant="default" class="w-full">Add to Cart</Button > <Button size="sm" variant="muted" class="w-full">Buy Now</Button> </div> <!-- Free shipping notice --> <Text tag="p" variant="textSM" class="mt-1 text-muted-foreground" >Shop now. Pay in 30 days with Klarna. <a href="#_" class="underline text-foreground">Learn more</a ></Text > <!-- Tab section --> <div x-data="{ tab:'tab1' }"
          class="mt-8 border-b divide-y divide-border border-border"
        >
          <ul
            class="flex text-sm border-b gap-4 text-muted-foreground border-border"
          >
            <li class="-mb-px">
              <a
                @click.prevent="tab = 'tab1'"
                href="#_"
                class="inline-block py-2 font-medium border-b-2 text-muted-foreground border-border"
                :class="{ ' text-muted-foreground border-b-2 border-border' : tab === 'tab1' }"
              >
                Details</a
              >
            </li>
            <li class="-mb-px">
              <a
                @click.prevent="tab = 'tab2'"
                href="#_"
                class="inline-block py-2 font-medium"
                :class="{ ' text-muted-foreground border-b-2 border-border' : tab === 'tab2' }"
              >
                Shipping</a
              >
            </li>
            <li class="-mb-px">
              <a
                @click.prevent="tab = 'tab3'"
                href="#_"
                class="inline-block py-2 font-medium"
                :class="{ ' text-muted-foreground border-b-2 border-border' : tab === 'tab3' }"
              >
                Returns</a
              >
            </li>
            <li class="-mb-px">
              <a
                @click.prevent="tab = 'tab4'"
                href="#_"
                class="inline-block py-2 font-medium"
                :class="{ ' text-muted-foreground border-b-2 border-border' : tab === 'tab4'}" > Reviews</a > </li> </ul> <div class="py-4 pt-4 text-left text-foreground content" > <div x-show="tab==='tab1'">
              <section class="py-4">
                <Text tag="p" variant="sm">
                  This product is crafted from high-quality materials designed
                  for durability and comfort. It features modern design elements
                  and is perfect for everyday use.
                </Text>
                <ul
                  role="list"
                  class="pl-5 mt-4 text-sm list-disc space-y-1 text-muted-foreground marker:text-foreground"
                >
                  <li>Versatile lace configurations</li>
                  <li>Breathable and spacious interior fit</li>
                  <li>Durable leather overlays</li>
                  <li>Cushioned insole for added comfort</li>
                  <li>Reinforced eyelets for secure lacing</li>
                  <li>Stitching built for durability</li>
                  <li>Water-resistant materials</li>
                </ul>

                <Text tag="p" variant="textSM" class="mt-8">
                  <strong class="text-foreground">True to size</strong>.We
                  recommend ordering your usual size.
                </Text>
              </section>
            </div>
            <div x-show="tab==='tab2'" style="display: none;">
              <section class="py-4">
                <Text tag="p" variant="sm">
                  We offer free standard shipping on all orders above $50.
                  Express shipping options are available at checkout for an
                  additional fee.
                </Text>
              </section>
            </div>
            <div x-show="tab==='tab3'" style="display: none;">
              <section class="py-4">
                <Text tag="p" variant="sm">
                  We accept returns within 30 days of purchase. Items must be in
                  their original condition and packaging. Please visit our
                  returns page for more details.
                </Text>
              </section>
            </div>
            <div x-show="tab==='tab4'" style="display: none;">
              <section class="py-4">
                <div
                  class="flex flex-col"
                  x-data="{ 
                    testimonials: [
                      {
                        name: 'Fernando Monte',
                        date: '2025-12-01',
                        datetime: '2025-12-01',
                        img: '/avatars/1.jpg',
                        text: 'The Nike Air Max 90 Black exceeded my expectations! Super comfortable and perfect for both running and casual wear.',
                      },
                      {
                        name: 'Juan  Echanove',
                        date: '2025-11-15',
                        datetime: '2025-11-15',
                        img: '/avatars/2.jpg',
                        text: 'Stylish and lightweight. I wear them everywhere, but the fit was slightly snug at first. Broke in nicely after a few days.',
                      },
                    ] 
                  }"
                >
                  <template
                    x-for="testimonial in testimonials"
                    :key="testimonial.datetime"
                  >
                    <div class="flex py-4 gap-x-4">
                      <div class="flex-none">
                        <img
                          :src="testimonial.img"
                          :alt="testimonial.name"
                          class="rounded-full size-10 bg-muted"
                        />
                      </div>
                      <div>
                        <Text
                          tag="h3"
                          variant="textBase"
                          class="font-medium text-foreground"
                          x-text="testimonial.name"
                        />
                        <Text variant="textXS" class="text-muted-foreground">
                          <time
                            :datetime="testimonial.datetime"
                            x-text="testimonial.date"></time>
                        </Text>
                        <Text
                          tag="p"
                          variant="textSM"
                          class="mt-1 text-muted-foreground"
                          x-text="testimonial.text"
                        />
                      </div>
                    </div>
                  </template>
                </div>
                <div class="flex mt-8">
                  <Button size="sm" variant="muted"> Write a review </Button>
                </div>
              </section>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
