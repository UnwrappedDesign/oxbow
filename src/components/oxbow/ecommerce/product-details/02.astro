---
export const excludeFromObfuscation = [
  "ring-2",
  "ring-border",
  "ring-offset-2",
  "ring-border",
  "bg-muted",
  "ring-border",
  "bg-muted",
  "ring-border/30",
  "bg-muted",
  "ring-border/30",
  "bg-muted/20",
  "ring-destructive/30",
  "bg-destructive/20",
  "ring-border/30",
  "bg-muted/20",
  "ring-warning/30",
  "bg-warning",
  "ring-border",
  "bg-muted",
  "ring-info/30",
  "bg-info",
  "ring-success/30",
  "bg-success",
  "ring-success/30",
  "bg-success/20",
  "text-muted-foreground",
  "group-open:-rotate-45",
];

export const description =
  "Details with image slider on a two column grid, color, size selector and accordion";
import Text from "@/components/fundations/typography/Text.astro";
import Button from "@/components/fundations/buttons/Button.astro";
import Plus from "@/components/fundations/icons/Plus.astro";
const productInfo = [
  {
    title: "Details",
    description:
      "This product is crafted from high-quality materials designed for durability and comfort. It features modern design elements and is perfect for everyday use.",
  },
  {
    title: "Shipping",
    description:
      "We offer free standard shipping on all orders above $50. Express shipping options are available at checkout for an additional fee.",
  },
  {
    title: "Returns",
    description:
      "We accept returns within 30 days of purchase. Items must be in their original condition and packaging. Please visit our returns page for more details.",
  },
];
---

<section class="bg-background">
  <div class="relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Product Image Gallery -->
      <div
        x-data="{ 
                activeImage: 0,
                images: [
                    '/store/shoes/airmax/1.png',
                    '/store/shoes/airmax/2.png',
                    '/store/shoes/airmax/3.png',
                    '/store/shoes/airmax/4.png',
                    '/store/shoes/airmax/5.png',
                    '/store/shoes/airmax/6.png'
                ]
            }"
        class="flex flex-col lg:sticky lg:top-24 lg:self-start gap-2"
      >
        <!-- Main Image -->
        <div
          class="overflow-hidden aspect-square bg-background rounded-2xl"
        >
          <img
            :src="images[activeImage]"
            class="object-cover size-full aspect-square"
            alt="Product image"
          />
        </div>
        <!-- Thumbnails -->
        <div class="w-full grid grid-cols-6 gap-2">
          <template x-for="(image, index) in images" :key="index">
            <button
              @click="activeImage = index"
              :class="{'ring-2 ring-border ': activeImage === index}"
              class="overflow-hidden size-full bg-muted rounded-xl aspect-square"
            >
              <img
                :src="image"
                class="object-cover size-full aspect-square"
                alt="Product thumbnail"
              />
            </button>
          </template>
        </div>
      </div>
      <!-- Product Details -->
      <div class="flex flex-col">
        <div class="flex items-center justify-between text-foreground">
          <Text tag="h1" variant="textXL" class="font-medium"
            >Nike Air Force 1´07 Fresh</Text
          >
          <Text tag="p" variant="textXL ">$190</Text>
        </div>
        <Text tag="p" variant="textBase" class="mt-4 text-muted-foreground">
          Hitting the field in the late '60s, adidas airmaxS quickly became
          soccer's "it" shoe.
        </Text>
        <div class="flex flex-col mt-4 gap-4">
          <!-- Color Selector -->
          <div x-data="{ activeColor: null }">
            <Text
              tag="p"
              variant="textXS"
              class="uppercase text-muted-foreground"
            >
              Color
            </Text>
            <fieldset
              aria-label="Choose a color"
              class="mt-2"
              x-data="{ 
            colors: [
              { name: ' Black', ring: 'ring-border', bg: 'bg-muted' },
    { name: ' Gray', ring: 'ring-border', bg: 'bg-muted' },
    { name: ' Purple', ring: 'ring-border/30', bg: 'bg-muted' },
    { name: ' Pink', ring: 'ring-border/30', bg: 'bg-muted/20' },
    { name: ' Red', ring: 'ring-destructive/30', bg: 'bg-destructive/20' },
    { name: ' Orange', ring: 'ring-border/30', bg: 'bg-muted/20' },
    { name: ' Yellow', ring: 'ring-warning/30', bg: 'bg-warning' },
    { name: ' zinc', ring: 'ring-border', bg: 'bg-muted' },
    { name: ' Cyan', ring: 'ring-info/30', bg: 'bg-info' },
    { name: ' Green', ring: 'ring-success/30', bg: 'bg-success' },
    { name: ' Teal', ring: 'ring-success/30', bg: 'bg-success/20' },
            ],
            activeColor: null 
          }"
            >
              <div class="flex flex-wrap items-center gap-3">
                <template x-for="color in colors" :key="color.name">
                  <label
                    :aria-label="color.name"
                    class="relative -m-0.5 duration-300 flex cursor-pointer items-center justify-center rounded-full p-0.5 focus:outline-none"
                    :class="{ 'ring-2 ring-offset-2 ring-border': activeColor === color.name }"
                  >
                    <input
                      type="radio"
                      name="color-choice"
                      :value="color.name"
                      class="sr-only"
                      @click="activeColor = color.name"
                    />
                    <span
                      aria-hidden="true"
                      class="rounded-full size-6 ring-1"
                      :class="`${color.ring} ${color.bg}`"></span>
                  </label>
                </template>
              </div>
            </fieldset>
          </div>
          <!-- Sizing -->
          <div
            x-data="{
              sizeSystem: 'US',
              activeSize: null,
              sizes: {
                  US: ['6', '7', '8', '9', '10', '11', '12', '13'],
                  EU: ['39', '40', '41', '42', '43', '44', '45', '46']
              }
          }"
          >
            <div class="flex items-center justify-between">
              <Text
                tag="p"
                variant="textXS"
                class="uppercase text-muted-foreground"
              >
                Shoe size
              </Text>
              <div>
                <label for="size-system" class="sr-only">Size System</label>
                <select
                  id="size-system"
                  x-model="sizeSystem"
                  @change="activeSize = null"
                  class="block w-auto h-8 pl-2.5 pr-8 py-2 text-xs text-foreground duration-300 bg-background border border-transparent rounded-lg appearance-none ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2"
                >
                  <option value="US">US</option>
                  <option value="EU">EU</option>
                </select>
              </div>
            </div>
            <div class="mt-2 grid grid-cols-4 gap-2 divide-x divide-border">
              <template x-for="size in sizes[sizeSystem]" :key="size">
                <div>
                  <input
                    type="radio"
                    :id="'size-' + size"
                    :value="size"
                    name="size-choice"
                    x-model="activeSize"
                    class="sr-only peer"
                  />
                  <label
                    :for="'size-' + size"
                    x-text="size"
                    class="flex items-center justify-center px-3 py-2 text-sm font-medium bg-background cursor-pointer ring-1 ring-border rounded-md duration-300 peer-checked:ring-2 peer-checked:ring-border peer-checked:text-muted-foreground text-foreground peer-checked:ring-offset-2"
                  ></label>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-row mt-8 gap-2">
          <Button size="sm" variant="default" class="w-full">Add to Cart</Button
          >
          <Button size="sm" variant="muted" class="w-full">Buy Now</Button>
        </div>
        <!-- Free shipping notice -->
        <Text tag="p" variant="textSM" class="mt-1 text-muted-foreground"
          >Free shipping over $50 if you behave</Text
        >
        <!-- Accordion sections -->
        <div class="mt-8 divide-y divide-border border-y border-border">
          {
            productInfo.map((info) => (
              <details class="cursor-pointer group">
                <Text
                  tag="summary"
                  variant="textSM"
                  class="flex items-center justify-between w-full py-4 font-medium text-left select-none text-foreground hover:text-muted-foreground focus:text-muted-foreground"
                >
                  {info.title}
                  <Plus
                    class="duration-300 ease-out transform group-open:-rotate-45"
                    size="sm"
                  />
                </Text>
                <div class="pb-4">
                  <Text tag="p" variant="textSM" class="text-muted-foreground">
                    {info.description}
                  </Text>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
