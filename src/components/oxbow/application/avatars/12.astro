---
export const description = "Trusted By + Avatars";
---

<section
  class="flex items-center justify-center p-16 bg-background"
>
  <!-- copy:start -->
  <div class="flex flex-col items-center md:flex-row gap-3">
    <div class="flex -space-x-2">
      <img
        src="/avatars/1.jpg"
        alt=""
        class="object-cover rounded-full size-8 ring-2 ring-border"
      />
      <img
        src="/avatars/2.jpg"
        alt=""
        class="object-cover rounded-full size-8 ring-2 ring-border"
      />
      <img
        src="/avatars/3.jpg"
        alt=""
        class="object-cover rounded-full size-8 ring-2 ring-border"
      />
      <span
        class="inline-flex items-center justify-center rounded-full size-8 bg-muted text-muted-foreground ring-2 ring-border"
        >+3</span
      >
    </div>
    <span
      class="flex items-center h-8 px-3 text-xs bg-background rounded-full w-fit ring-1 ring-border text-foreground"
      >Trusted by <span class="mx-1 font-semibold">10k+</span> cuistomeers</span
    >
  </div>
  <!-- copy:end -->
</section>
