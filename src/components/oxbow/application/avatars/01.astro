---
export const freeComponent = true;
---

<div class="flex items-center justify-center bg-background p-14">
  <!-- copy:start -->
  <div x-data="{ error:false, showInitials:false }" class="relative">
    <template x-if="!error">
      <img
        class="inline-block object-cover rounded-full size-16 ring-2 ring-border"
        src="/avatars/1.jpg"
        alt="User avatar"
        @error="error=true"
      />
    </template>
    <template x-if="error">
      <div
        class="inline-flex items-center justify-center rounded-full size-16 bg-muted ring-2 ring-border"
      >
        <span
          x-show="showInitials"
          class="text-foreground"
          aria-label="Avatar initials">MA</span
        >
        <button
          x-show="!showInitials"
          @click="showInitials = true"
          class="px-2 py-1 text-xs border rounded bg-background text-foreground border-border"
          type="button"
        >
          Show initials
        </button>
      </div>
    </template>
  </div>
  <!-- copy:end -->
</div>
