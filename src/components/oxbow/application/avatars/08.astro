---
export const description = "Avatar Group (Dynamic +N)";
---

<section class="flex items-center justify-center bg-background p-14">
  <!-- copy:start -->
  <div x-data="{ people: ['/avatars/1.jpg','/avatars/2.jpg','/avatars/3.jpg','/avatars/4.jpg','/avatars/5.jpg','/avatars/6.jpg'], max: 5 }" class="flex items-center -space-x-2">
    <template x-for="(src, i) in people.slice(0, max)" :key="src">
      <img :src="src" alt="" class="inline-block object-cover rounded-full size-10 ring-2 ring-border" />
    </template>
    <template x-if="people.length > max">
      <span class="inline-flex items-center justify-center rounded-full size-10 bg-muted text-muted-foreground ring-2 ring-border" x-text="'+' + (people.length - max)"></span>
    </template>
  </div>
  <!-- copy:end -->
</section>

