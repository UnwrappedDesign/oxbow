---
import Text from "@/components/fundations/typography/Text.astro";
---

<div class="flex items-center justify-center bg-background p-14">
  <!-- copy:start -->
  <div class="flex-shrink-0 block group">
    <div class="flex items-center gap-2">
      <div>
        <img class="inline-block object-cover rounded-full size-10 ring-2 ring-border" src="/avatars/1.jpg" alt="User" />
      </div>
      <Text
        tag="a"
        href="#_"
        variant="textBase"
        class="font-medium hover:text-foreground text-muted-foreground"
      >
        <Text
          tag="h3"
          variant="textBase"
          class="font-medium text-foreground"
        >
          Michael Andreuzza
        </Text>
        <Text
          tag="p"
          variant="textXS"
          class="font-medium text-muted-foreground"
        >
          example@example.com
        </Text>
      </Text>
    </div>
  </div>
  <!-- copy:end -->
</div>
