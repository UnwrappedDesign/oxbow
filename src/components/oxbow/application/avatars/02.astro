---
import Button from "@/components/fundations/buttons/Button.astro";
---

<div
  class="relative flex items-center justify-center p-12 bg-background"
>
  <!-- copy:start -->
  <div
    class="relative inline-flex items-center gap-3"
    x-data="{ online: true }"
  >
    <span class="relative inline-block">
      <img
        class="object-cover rounded-full size-16 ring-2 ring-border"
        src="/avatars/1.jpg"
        alt="User"
      />
      <span
        :class="online ? 'bg-success' : 'bg-muted'"
        class="absolute top-0 right-0 block rounded-full size-4 ring-2 ring-border"
      ></span>
    </span>
    <Button size="xs" variant="muted" @click="online = !online">
      Toggle
    </Button>
  </div>
  <!-- copy:end -->
</div>
