---
export const excludeFromObfuscation = [
  "opacity-0",
  "opacity-100",
  "translate-x-0",
  "-translate-x-full",
  "sm:translate-x-0",
];
import Logo from "@/components/assets/Logo.astro";
import Button from "@/components/fundations/buttons/Button.astro";
import IconButton from "@/components/fundations/buttons/IconButton.astro";
import X from "@/components/fundations/icons/X.astro";
import Home from "@/components/fundations/icons/Home.astro";
import Mail from "@/components/fundations/icons/Mail.astro";
import Tool from "@/components/fundations/icons/Tool.astro";
import Report from "@/components/fundations/icons/Report.astro";
import Burger from "@/components/fundations/icons/Burger.astro";
import Settings from "@/components/fundations/icons/Settings.astro";
import SearchIcon from "@/components/fundations/icons/Search.astro";
import Lifebuoy from "@/components/fundations/icons/Lifebuoy.astro";
import Clipboard from "@/components/fundations/icons/Clipboard.astro";
import UsersGroup from "@/components/fundations/icons/UsersGroup.astro";
import CircleInfo from "@/components/fundations/icons/CircleInfo.astro";
import ChevronDown from "@/components/fundations/icons/ChevronDown.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
---

<div class="relative bg-background">
  <!-- copy:start -->
  <!-- Mobile top bar -->
  <div class="lg:hidden sticky top-0 z-40 bg-background border-b border-border">
    <div class="flex items-center justify-between px-4 h-12">
      <div class="flex items-center gap-2">
        <Logo class="text-foreground h-6" />
        <span
          class="text-sm font-semibold text-foreground"
          >Oxbow UI</span
        >
      </div>
      <IconButton
        size="xxs"
        variant="muted"
        x-data
        @click="$dispatch('sb02-toggle')"
        aria-label="Open navigation"
      >
        <Burger size="sm" />
      </IconButton>
    </div>
  </div>
  <!-- Shell -->
  <div
    x-data="{
      open:false,
      active:'inbox',
      sections: { queues:true, knowledge:false, tools:false },
      search:'',
      filters: { mine:true, unassigned:false, sla:false },
      tags: { billing:true, bug:false, feature:false }
    }"
    @sb02-toggle.window="open=true"
    @keydown.escape.window="open=false"
    class="relative"
  >
    <!-- Overlay -->
    <div
      class="fixed inset-0 z-40 bg-background/10 transition-opacity duration-200 lg:hidden"
      x-show="open"
      x-transition.opacity
      @click="open=false"
      aria-hidden="true"
    >
    </div>
    <!-- Sidebar panel (distinct from 01: narrower + support use case) -->
    <aside
      class="fixed z-50 inset-y-0 left-0 w-72 lg:w-80 lg:static lg:translate-x-0 transform transition-transform duration-200 -translate-x-full lg:opacity-100 bg-background outline outline-1 outline-border flex flex-col"
      :class="open ? 'translate-x-0' : ''"
    >
      <!-- Header -->
      <div
        class="h-14 shrink-0 flex items-center justify-between px-4 border-b border-border"
      >
        <div class="flex items-center gap-2">
          <Logo class="text-foreground h-8" />
          <div>
            <p class="text-sm font-semibold text-foreground leading-tight">
              Oxbow UI
            </p>
            <p class="text-[0.70rem] text-muted-foreground">Support Console</p>
          </div>
        </div>
        <IconButton
          variant="muted"
          size="xxs"
          @click="open=false"
          aria-label="Close navigation"
          class="lg:hidden"
        >
          <X size="sm" />
        </IconButton>
      </div>
      <!-- Search -->
      <div class="p-3 lg:p-4">
        <label class="relative block">
          <span
            class="absolute inset-y-0 left-0 pl-3 flex items-center text-muted-foreground"
            ><SearchIcon class="size-4" /></span
          >
          <input
            x-model="search"
            placeholder="Search tickets"
            class="w-full pl-9 pr-3 block h-10 px-4 py-2 text-xs bg-background border border-transparent rounded-lg appearance-none text-muted-foreground duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm"
          />
        </label>
      </div>
      <!-- Navigation (scroll area; min-h-0 ensures inner overflow works in flex) -->
      <nav class="flex-1 min-h-0 px-2 lg:px-3 pb-40 overflow-y-auto">
        <p
          class="px-3 lg:px-4 text-[0.70rem] font-semibold tracking-wide text-muted-foreground"
        >
          Support
        </p>
        <ul class="mt-1 space-y-1">
          <li>
            <button
              class="w-full h-9 px-3 rounded-md flex items-center gap-2 text-sm outline outline-1 outline-transparent hover:bg-background/5"
              :class="active==='inbox' ? 'bg-background text-foreground bg-background/10 outline-border/10' : 'text-muted-foreground'"
              @click="active='inbox'"
            >
              <Mail class="size-4" />
              <span>Inbox</span>
              <span
                class="ml-auto text-[0.70rem] px-1.5 py-0.5 rounded text-foreground outline outline-1 outline-border bg-background/10 outline-border/10"
                >10</span
              >
            </button>
          </li>
          <li>
            <button
              class="w-full h-9 px-3 rounded-md flex items-center gap-2 text-sm outline outline-1 outline-transparent hover:bg-background/5"
              :class="active==='dashboard' ? 'bg-background text-foreground bg-background/10 outline-border/10' : 'text-muted-foreground'"
              @click="active='dashboard'"
            >
              <Home class="size-4" />
              <span>Dashboard</span>
            </button>
          </li>
        </ul>
        <div class="pt-3 mt-3 border-t border-border">
          <p
            class="px-3 lg:px-4 text-[0.70rem] font-semibold tracking-wide text-muted-foreground"
          >
            Queues
          </p>
          <ul class="mt-1 space-y-1">
            <li>
              <button
                class="w-full h-9 px-3 rounded-md flex items-center justify-between text-sm text-muted-foreground hover:bg-background/5"
                @click="sections.queues=!sections.queues"
                :aria-expanded="sections.queues"
              >
                <span class="flex items-center gap-2"
                  ><Clipboard class="size-4" /> Ticket queues</span
                >
                <span class="text-muted-foreground"
                  ><ChevronDown
                    x-show="sections.queues"
                    class="size-4"
                  /><ChevronRight
                    x-show="!sections.queues"
                    class="size-4"
                  /></span
                >
              </button>
              <div x-show="sections.queues" x-collapse x-cloak>
                <ul class="mt-1 pl-2 space-y-1">
                  <li>
                    <a
                      href="#_"
                      class="flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                      >Unassigned</a
                    >
                  </li>
                  <li>
                    <a
                      href="#_"
                      class="flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                      >My team</a
                    >
                  </li>
                  <li>
                    <a
                      href="#_"
                      class="flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                      >Escalations <span
                        class="text-[0.70rem] px-1.5 py-0.5 rounded text-foreground outline outline-1 outline-border bg-background/10 outline-border/10"
                        >3</span
                      ></a
                    >
                  </li>
                </ul>
              </div>
            </li>
            <li>
              <button
                class="w-full h-9 px-3 rounded-md flex items-center justify-between text-sm text-muted-foreground hover:bg-background/5"
                @click="sections.knowledge=!sections.knowledge"
                :aria-expanded="sections.knowledge"
              >
                <span class="flex items-center gap-2"
                  ><CircleInfo class="size-4" /> Knowledge</span
                >
                <span class="text-muted-foreground"
                  ><ChevronDown
                    x-show="sections.knowledge"
                    class="size-4"
                  /><ChevronRight
                    x-show="!sections.knowledge"
                    class="size-4"
                  /></span
                >
              </button>
              <div x-show="sections.knowledge" x-collapse x-cloak>
                <ul class="mt-1 pl-2 space-y-1">
                  <li>
                    <a
                      href="#_"
                      class="flex items-center h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                      >Articles</a
                    >
                  </li>
                  <li>
                    <a
                      href="#_"
                      class="flex items-center h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                      >Guides</a
                    >
                  </li>
                  <li>
                    <a
                      href="#_"
                      class="flex items-center h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                      >Playbooks</a
                    >
                  </li>
                </ul>
              </div>
            </li>
            <li>
              <a
                href="#_"
                class="flex items-center gap-2 h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                ><Tool class="size-4" /> Macros</a
              >
            </li>
            <li>
              <a
                href="#_"
                class="flex items-center gap-2 h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                ><Report class="size-4" /> Reports</a
              >
            </li>
          </ul>
        </div>
        <!-- Administration -->
        <div class="pt-3 mt-3 border-t border-border">
          <p
            class="px-3 lg:px-4 text-[0.70rem] font-semibold tracking-wide text-muted-foreground"
          >
            Administration
          </p>
          <ul class="mt-1 space-y-1">
            <li>
              <a
                href="#_"
                class="flex items-center gap-2 h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                ><UsersGroup class="size-4" /> Teams</a
              >
            </li>
            <li>
              <a
                href="#_"
                class="flex items-center gap-2 h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                ><Settings class="size-4" /> Preferences</a
              >
            </li>
            <li>
              <a
                href="#_"
                class="flex items-center gap-2 h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
                ><Lifebuoy class="size-4" /> Help Center</a
              >
            </li>
          </ul>
        </div>
        <!-- Pinned -->
        <div class="pt-3 mt-3 border-t border-border">
          <p
            class="px-3 text-[0.70rem] font-semibold tracking-wide text-muted-foreground"
          >
            Pinned
          </p>
          <ul class="mt-1 space-y-1">
            <li>
              <a
                href="#_"
                class="flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
              >
                <span class="flex items-center gap-2">
                  <Mail class="size-4" />
                  <span>High priority escalation</span>
                </span>
                <span class="text-xs text-destructive">Urgent</span>
              </a>
            </li>
            <li>
              <a
                href="#_"
                class="flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
              >
                <span class="flex items-center gap-2">
                  <Mail class="size-4" />
                  <span>Customer feedback review</span>
                </span>
                <span class="text-xs text-warning">Review</span>
              </a>
            </li>
          </ul>
        </div>
        <!-- Recent Tickets -->
        <div class="pt-3 mt-3 border-t border-border">
          <p
            class="px-3 text-[0.70rem] font-semibold tracking-wide text-muted-foreground"
          >
            Recent Tickets
          </p>
          <ul class="mt-1 space-y-1">
            <li>
              <a
                href="#_"
                class="flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
              >
                <span class="flex items-center gap-2">
                  <Mail class="size-4" />
                  <span>Ticket #1234</span>
                </span>
                <span class="text-xs text-muted-foreground">2m ago</span>
              </a>
            </li>
            <li>
              <a
                href="#_"
                class="flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
              >
                <span class="flex items-center gap-2">
                  <Mail class="size-4" />
                  <span>Ticket #1233</span>
                </span>
                <span class="text-xs text-muted-foreground">5m ago</span>
              </a>
            </li>
            <li>
              <a
                href="#_"
                class="flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
              >
                <span class="flex items-center gap-2">
                  <Mail class="size-4" />
                  <span>Ticket #1232</span>
                </span>
                <span class="text-xs text-muted-foreground">10m ago</span>
              </a>
            </li>
            <li>
              <a
                href="#_"
                class="flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5"
              >
                <span class="flex items-center gap-2">
                  <Mail class="size-4" />
                  <span>Ticket #1231</span>
                </span>
                <span class="text-xs text-muted-foreground">15m ago</span>
              </a>
            </li>
          </ul>
        </div>
      </nav>
      <!-- Sticky footer: pinned at bottom; dropdown overlays upward -->
      <div class="sticky bottom-0 z-10 bg-background border-t border-border">
        <div class="p-3 lg:p-4 space-y-3">
          <div
            class="rounded-lg outline outline-1 outline-border bg-background p-3"
          >
            <p
              class="text-xs font-medium text-foreground"
            >
              Status
            </p>
            <p class="mt-1 text-xs text-muted-foreground">
              Queue health is stable. 2 open incidents.
            </p>
            <div class="mt-2 flex items-center justify-between">
              <Button type="button" variant="outline" size="xxs"
                >View report</Button
              >
              <Button type="button" variant="muted" size="xxs">Dismiss</Button>
            </div>
          </div>
        </div>
        <div class="px-3 pb-3 lg:px-4 lg:pb-4">
          <div x-data="{ open:false }" class="relative">
            <button
              class="w-full flex items-center justify-between gap-3 p-2 rounded-lg hover:bg-background/5"
              @click="open=!open"
            >
              <span class="flex items-center gap-3">
                <img
                  src="/avatars/2.jpg"
                  alt="Avatar"
                  class="size-8 rounded-full"
                />
                <span class="text-left">
                  <span class="block text-sm font-medium text-foreground"
                    >Ricardo S.</span
                  >
                  <span class="block text-xs text-muted-foreground"
                    >ricardo@oxbowui.com</span
                  >
                </span>
              </span>
              <ChevronDown class="size-4 text-muted-foreground" />
            </button>
            <div
              x-show="open"
              x-transition.opacity
              @click.outside="open=false"
              class="absolute left-0 right-0 bottom-14 z-50 rounded-lg bg-background shadow-xl overflow-hidden"
            >
              <div class="p-2 text-sm">
                <a
                  href="#_"
                  class="flex items-center h-9 px-2 rounded-md text-muted-foreground hover:bg-background/5"
                  >View profile</a
                >
                <a
                  href="#_"
                  class="flex items-center h-9 px-2 rounded-md text-muted-foreground hover:bg-background/5"
                  >Account</a
                >
                <a
                  href="#_"
                  class="flex items-center h-9 px-2 rounded-md text-muted-foreground hover:bg-background/5"
                  >Docs</a
                >
              </div>
              <div class="border-t border-border p-2">
                <Button type="button" variant="muted" class="w-full" size="xxs"
                  >Sign out</Button
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>
  <!-- copy:end -->
</div>
