---
export const description = "Outline Toggle";
---

<div class="flex flex-col justify-center mx-auto bg-background p-14">
  <div class="w-full max-w-sm mx-auto">
    <!-- copy:start -->
    <div class="flex flex-col gap-2">
      <!-- Toggle 1 -->
      <div
        class="flex items-center justify-between p-4 border rounded-lg border-border"
      >
        <div>
          <p class="text-sm font-medium text-muted-foreground">
            Notifications <span class="text-muted-foreground"
              >(Email Alerts)</span
            >
          </p>
          <p class="text-sm text-muted-foreground">
            Enable to receive important updates via email.
          </p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" class="sr-only peer" />
          <div
            class="h-6 rounded-full w-11 bg-muted peer peer-checked:bg-muted"
          >
          </div>
          <div
            class="w-5 h-5 bg-muted rounded-full shadow absolute left-1 top-0.5 transition-transform peer-checked:translate-x-5"
          >
          </div>
        </label>
      </div>
    </div>
    <!-- copy:end -->
  </div>
</div>
