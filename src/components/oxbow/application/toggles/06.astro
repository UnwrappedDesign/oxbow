---
export const description = "Toggle with Text Indicators";
export const excludeFromObfuscation = [
  "w-1/2",
  "translate-x-0",
  "translate-x-full",
  "text-foreground",
  "text-muted-foreground",
  "hover:text-foreground",
];
---

<div class="flex flex-col justify-center mx-auto bg-background p-14">
  <!-- copy:start -->

  <div
    class="flex flex-col items-center justify-center"
    x-data="{duration: 'monthly'}"
  >
    <div
      aria-labelledby="pricing-toggle"
      class="relative z-0 inline-flex justify-center w-full p-1 mx-auto mt-8 overflow-hidden bg-background shadow ring-1 ring-border ring-offset-2 ring-offset-background gap-4 lg:mx-0 rounded-md max-w-52"
    >
      <!-- Sliding background -->
      <div
        class="absolute inset-0 bg-muted rounded-md transition-transform duration-200 ease-in-out"
        :class="duration === 'monthly' ? 'w-1/2 translate-x-0' : 'w-1/2 translate-x-full'"
      >
      </div>

      <!-- Monthly Pricing Button -->
      <button
        id="monthly-pricing-button"
        class="relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300"
        :class="duration === 'monthly' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'"
        @click="duration = 'monthly'"
        type="button"
        :aria-pressed="duration === 'monthly'"
      >
        Monthly
      </button>

      <!-- Annual Pricing Button -->
      <button
        id="annual-pricing-button"
        class="relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300"
        :class="duration === 'annual' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'"
        @click="duration = 'annual'"
        type="button"
        :aria-pressed="duration === 'annual'"
      >
        Annual
      </button>
    </div>
  </div>
  <!-- copy:end -->
</div>
