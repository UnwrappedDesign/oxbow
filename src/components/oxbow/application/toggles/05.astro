---
export const description = "Toggle with Text Indicators";
---

<div class="flex flex-col justify-center mx-auto bg-background p-14">
  <div class="w-full max-w-sm mx-auto">
    <!-- copy:start -->
    <div
      class="flex items-center justify-between p-4 border rounded-lg border-border"
    >
      <div class="flex items-start gap-3">
        <img
          src="/images/forms/polar.svg"
          alt="Payment Icon"
          class="rounded size-8"
        />
        <div>
          <p class="text-sm font-medium text-muted-foreground">
            Payment Method <span class="text-muted-foreground"
              >(Credit Card)</span
            >
          </p>
          <p class="text-sm text-muted-foreground">
            Use this option for recurring payments.
          </p>
        </div>
      </div>
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" class="sr-only peer" />
        <div class="h-6 rounded-full w-11 bg-muted peer peer-checked:bg-muted">
        </div>
        <div
          class="w-5 h-5 bg-muted rounded-full shadow absolute left-1 top-0.5 transition-transform peer-checked:translate-x-5"
        >
        </div>
      </label>
    </div>
    <!-- copy:end -->
  </div>
</div>
