---
export const description = "Outline Toggle";
---

<div
  class="flex flex-col justify-center mx-auto bg-background p-14"
>
  <!-- copy:start -->
  <div
    class="flex flex-col items-center justify-center gap-2"
    x-data="{ enabled: false }"
  >
    <label class="relative inline-flex items-center cursor-pointer">
      <input type="checkbox" x-model="enabled" class="sr-only peer" />
      <div
        class="w-12 h-6 border rounded-full border-border peer peer-checked:border-border"
      >
      </div>
      <div
        class="w-5 h-5 bg-muted rounded-full shadow absolute left-1 top-0.5 transition-transform peer-checked:bg-muted peer-checked:translate-x-6"
      >
      </div>
    </label>
    <span
      class="text-sm font-medium text-muted-foreground"
      x-text="enabled ? 'Active' : 'Inactive'"></span>
  </div>
  <!-- copy:end -->
</div>
