---
export const description = "Toggle with Labels";
---

<div class="flex flex-col justify-center mx-auto bg-background p-14">
  <!-- copy:start -->
  <div
    class="flex flex-col items-center justify-center gap-2"
    x-data="{ enabled: false }"
  >
    <span class="text-sm font-medium text-muted-foreground">Off</span>
    <label class="relative inline-flex items-center cursor-pointer">
      <input type="checkbox" x-model="enabled" class="sr-only peer" />
      <div class="h-6 rounded-full w-11 bg-muted peer peer-checked:bg-muted">
      </div>
      <div
        class="w-5 h-5 bg-muted rounded-full shadow absolute left-1 top-0.5 transition-transform peer-checked:translate-x-5"
      >
      </div>
    </label>
    <span class="text-sm font-medium text-muted-foreground">On</span>
  </div>
  <!-- copy:end -->
</div>
