---
export const excludeFromObfuscation = [
  "bg-muted",
  "border-border",
  "text-muted-foreground",
  "sticky",
  "top-0",
];
---

<div class="flex flex-col justify-center p-8 mx-auto bg-background">
  <!-- copy:start -->
  <div
    class="w-full max-w-5xl mx-auto overflow-hidden bg-background border rounded-lg border-border"
  >
    <div class="overflow-auto max-h-80">
      <table class="min-w-full text-xs bg-background">
        <thead
          class="sticky top-0 z-10 bg-background text-foreground"
        >
          <tr>
            <th class="px-3 py-2 font-medium text-left">ID</th>
            <th class="px-3 py-2 font-medium text-left">Title</th>
            <th class="px-3 py-2 font-medium text-left">Owner</th>
            <th class="px-3 py-2 font-medium text-left">Updated</th>
            <th class="px-3 py-2 font-medium text-right">Items</th>
          </tr>
        </thead>
        <tbody>
          {
            Array.from({ length: 40 }).map((_, i) => (
              <tr class="even:bg-background">
                <td class="px-3 py-2 text-muted-foreground">#{i + 1001}</td>
                <td class="px-3 py-2 text-foreground">
                  Collection {i + 1}
                </td>
                <td class="px-3 py-2 text-muted-foreground">
                  owner{i % 7}@example.com
                </td>
                <td class="px-3 py-2 text-muted-foreground">
                  2025-09-{String((i % 28) + 1).padStart(2, "0")}
                </td>
                <td class="px-3 py-2 font-mono text-right text-foreground tabular-nums">
                  {(i * 3) % 50}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
  <!-- copy:end -->
</div>
