---
export const description = "Centered sign in block";
// Fundations
import Text from "@/components/fundations/typography/Text.astro";
import Button from "@/components/fundations/buttons/Button.astro";
import Checkbox from "@/components/fundations/inputs/Checkbox.astro";
import TextInput from "@/components/fundations/inputs/TextInput.astro";
// Icons
import GoogleColor from "@/components/fundations/icons/GoogleColor.astro";
---

<section class="bg-background">
  <div class="px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20">
    <div
      class="max-w-md p-8 mx-auto shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl"
    >
      <div class="text-center lg:text-balance">
        <Text
          tag="h1"
          variant="displaySM"
          class="font-semibold tracking-tight text-foreground"
        >
          Sign in
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-muted-foreground text-balance"
        >
          Welcome back! Fire up that password muscle memory, just like the good
          old dial-up days.
        </Text>
      </div>
      <form class="mt-10 space-y-4">
        <TextInput
          id="email"
          name="email"
          label="Email Address"
          type="email"
          variant="default"
          size="base"
          placeholder="you@example.com"
        />
        <TextInput
          id="password"
          name="password"
          label="Password"
          type="password"
          passwordToggle={true}
          size="base"
          placeholder="••••••••"
          required
        />
        <Checkbox
          id="login-remember"
          name="login-remember"
          label="Remember me for 30 days"
          variant="default"
          size="base"
        />
        <Button fullWidth variant="default" size="base">
          Sign in with email
        </Button>
        <Button
          variant="outline"
          size="base"
          gap="sm"
          class="flex items-center w-full"
        >
          <GoogleColor slot="left-icon" class="size-4" />
          Sign in with Google
        </Button>
      </form>
      <Text
        tag="p"
        variant="textXS"
        class="mt-4 font-medium text-muted-foreground"
      >
        Dont' have an account?
        <a
          href="#_"
          class="font-medium text-foreground hover:text-muted-foreground"
        >
          Sign up
        </a>
      </Text>
    </div>
  </div>
</section>
