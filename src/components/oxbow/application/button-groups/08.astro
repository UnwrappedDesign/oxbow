---

export const description = "Action footer";
import Button from "@/components/fundations/buttons/Button.astro";
import Lock from "@/components/fundations/icons/Lock.astro";
---

<section class="flex items-center justify-center bg-background p-18">
  <!-- copy:start -->
  <div class="flex w-full max-w-xl items-center justify-between rounded-xl border border-border bg-background p-4 shadow-sm">
    <div class="flex flex-col gap-0.5 text-sm">
      <span class="font-medium text-foreground">Lock sprint</span>
      <span class="text-muted-foreground">Freeze scope until next planning session.</span>
    </div>
    <div class="flex items-center gap-2">
      <Button variant="ghost" size="sm" class="gap-2 transition-none">
        Cancel
      </Button>
      <Button variant="accent" size="sm" class="gap-2 transition-none">
        <Lock slot="left-icon" size="sm" />
        Confirm
      </Button>
    </div>
  </div>
  <!-- copy:end -->
</section>
