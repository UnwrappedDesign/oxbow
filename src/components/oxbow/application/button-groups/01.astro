---

export const description = "Counter group (− value +)";
import Button from "@/components/fundations/buttons/Button.astro";
import Minus from "@/components/fundations/icons/Minus.astro";
import Plus from "@/components/fundations/icons/Plus.astro";
---

<section class="flex items-center justify-center bg-background p-18">
  <!-- copy:start -->
  <div
    class="inline-flex items-stretch overflow-hidden rounded-md border border-border bg-background text-sm shadow-sm"
    x-data="{ n: 235 }"
    role="group"
    aria-label="Adjust quantity"
  >
    <Button
      variant="muted"
      size="sm"
      iconOnly
      type="button"
      noRounded
      class="border-r border-border text-muted-foreground transition-none"
      @click="n = Math.max(0, n - 1)"
      aria-label="Decrease"
    >
      <Minus slot="left-icon" size="sm" />
    </Button>
    <span class="flex items-center px-5 font-semibold text-foreground" x-text="n"></span>
    <Button
      variant="accent"
      size="sm"
      iconOnly
      type="button"
      noRounded
      class="border-l border-border transition-none"
      @click="n = n + 1"
      aria-label="Increase"
    >
      <Plus slot="left-icon" size="sm" />
    </Button>
  </div>
  <!-- copy:end -->
</section>
