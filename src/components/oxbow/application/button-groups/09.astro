---
export const description = "Primary/secondary pair";
import Button from "@/components/fundations/buttons/Button.astro";
---

<section
  class="flex items-center justify-center bg-background p-18"
>
  <!-- copy:start -->
  <div
    class="inline-flex overflow-hidden rounded-lg border border-border bg-background text-sm"
    role="group"
    aria-label="Primary and secondary actions"
  >
    <Button
      variant="accent"
      size="sm"
      type="button"
      noRounded
      class="px-5 transition-none"
    >
      Deploy
    </Button>
    <Button
      variant="outline"
      size="sm"
      type="button"
      noRounded
      class="border-l border-border transition-none"
    >
      Cancel
    </Button>
  </div>
  <!-- copy:end -->
</section>
