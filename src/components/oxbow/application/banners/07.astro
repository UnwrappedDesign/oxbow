---
import Button from "@/components/fundations/buttons/Button.astro";
import Text from "@/components/fundations/typography/Text.astro";
---

<div
  class="relative isolate flex flex-col overflow-hidden bg-background px-6 py-2.5 sm:px-3.5"
>
  <Text
    tag="span"
    variant="textSM"
    class="pr-8 font-medium text-foreground text-balance"
  >
    We use cookies and similar technologies to make this site work better for
    you, to show relevant content and ads, and to understand how our visitors
    use the site. By continuing to browse, you agree to our use of cookies. For
    details, see our
    <Text tag="a" href="#_" variant="link">Terms of Service</Text> and
    <Text tag="a" href="#_" variant="link">Privacy Policy</Text>.
  </Text>

  <div class="flex flex-wrap items-center mt-4 sm:flex-row gap-2 border-border">
    <Button variant="outline" size="xs"> Customize </Button>
    <Button variant="outline" size="xs"> Reject </Button>
    <Button variant="accent" size="xs"> Accept </Button>
  </div>
</div>
