---
export const freeComponent = true;
import Button from "@/components/fundations/buttons/Button.astro";
import Text from "@/components/fundations/typography/Text.astro";
---

<section class="h-full p-8 bg-background">
  <!-- copy:start -->
  <div class="overflow-hidden bg-background px-6 py-2.5 sm:px-3.5 rounded-xl">
    <div
      class="flex flex-wrap sm:justify-center sm:items-center gap-x-4 gap-y-2 lg:text-center"
    >
      <Text
        tag="span"
        variant="textSM"
        class="pr-8 font-medium text-foreground lg:pr-0"
      >
        <strong class="font-semibold">Lexington Themes</strong>
        <span>·</span> Free and premium multipage themes and UI Kits crafted with
        Astro JS, and Tailwind CSS.
      </Text>
      <Button class="w-full lg:w-auto" variant="accent" size="xs">
        Visit now
      </Button>
    </div>
  </div>
  <!-- copy:end -->
</section>
