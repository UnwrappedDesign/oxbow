---
export const freeComponent = true;
export const description = "Basic  breadcrumbs";
import Text from "@/components/fundations/typography/Text.astro";
import Home from "@/components/fundations/icons/Home.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
---

<section
  class="flex flex-wrap items-center justify-center h-full bg-background gap-2 p-18"
>
  <!-- copy:start -->
  <nav aria-label="Breadcrumb">
    <ol role="list" class="flex items-center space-x-2">
      <li>
        <Text
          tag="a"
          href="#_"
          variant="textXS"
          class="flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground"
          aria-label="Home"
        >
          <Home size="sm" aria-hidden="true" />
          <span class="sr-only">Home</span>
        </Text>
      </li>
      <li>
        <Text
          tag="a"
          href="#_"
          variant="textXS"
          class="flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground"
        >
          Home
          <ChevronRight size="base" aria-hidden="true" />
        </Text>
      </li>
      <li>
        <Text
          tag="a"
          href="#_"
          variant="textXS"
          class="flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground"
        >
          Work
          <ChevronRight size="base" aria-hidden="true" />
        </Text>
      </li>
      <li>
        <Text
          tag="span"
          variant="textXS"
          aria-current="page"
          class="flex items-center font-medium gap-2 text-foreground"
        >
          Details
        </Text>
      </li>
    </ol>
  </nav>
  <!-- copy:end -->
</section>
