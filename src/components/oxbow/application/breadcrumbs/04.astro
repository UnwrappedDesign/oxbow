---
export const description = "Breadcrumb with outline";
import Text from "@/components/fundations/typography/Text.astro";
import Home from "@/components/fundations/icons/Home.astro";
import Slash from "@/components/fundations/icons/Slash.astro";
---

<section
  class="flex flex-wrap items-center justify-center h-full bg-background gap-2 p-18"
>
  <!-- copy:start -->
  <nav
    aria-label="Breadcrumb"
    class="border inline-flex py-1.5 px-3.5 rounded-lg border-border bg-background"
  >
    <ol role="list" class="flex items-center space-x-2">
      <li>
        <Text
          tag="a"
          href="#_"
          variant="textXS"
          class="flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground"
        >
          <Home size="sm" aria-hidden="true" />
        </Text>
      </li>
      <li>
        <Text
          tag="a"
          href="#_"
          variant="textXS"
          class="flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground"
        >
          <span>Home</span>
          <Slash size="base" aria-hidden="true" />
        </Text>
      </li>
      <li>
        <Text
          tag="a"
          href="#_"
          variant="textXS"
          class="flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground"
        >
          <span>Work</span>
          <Slash size="base" aria-hidden="true" />
        </Text>
      </li>
      <li>
        <Text
          tag="span"
          variant="textXS"
          aria-current="page"
          class="flex items-center font-medium gap-2 text-foreground"
        >
          <span>Details</span>
        </Text>
      </li>
    </ol>
  </nav>
  <!-- copy:end -->
</section>
