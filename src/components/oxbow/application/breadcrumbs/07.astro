---
export const description = "Scrollable Breadcrumb (Overflow)";
import Text from "@/components/fundations/typography/Text.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
---

<section class="flex items-center justify-center bg-background p-18">
  <!-- copy:start -->
  <nav aria-label="Breadcrumb" class="max-w-2xl mx-auto">
    <div class="flex items-center gap-2">
      <Text
        tag="a"
        href="#_"
        class="hidden text-sm text-muted-foreground hover:text-foreground md:block"
        >Home</Text
      >
      <ChevronRight
        size="base"
        class="hidden text-muted-foreground md:block"
        aria-hidden="true"
      />
      <div class="relative flex-1">
        <div
          class="flex overflow-x-auto snap-x snap-mandatory gap-1 scrollbar-thin scrollbar-thumb-muted"
        >
          {
            Array.from({ length: 2 }).map((_, i) => (
              <div class="flex items-center gap-1 snap-start shrink-0">
                <Text
                  tag="a"
                  href="#_"
                  class="text-sm text-muted-foreground hover:text-foreground"
                >
                  Section {i + 1}
                </Text>
                <ChevronRight
                  size="base"
                  class="text-muted-foreground"
                  aria-hidden="true"
                />
              </div>
            ))
          }
          <span class="text-sm font-medium text-foreground" aria-current="page"
            >Current</span
          >
        </div>
      </div>
    </div>
  </nav>
  <!-- copy:end -->
</section>
