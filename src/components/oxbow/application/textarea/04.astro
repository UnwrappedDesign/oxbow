---
export const description = "Readonly textarea";
import Text from "@/components/fundations/typography/Text.astro";
---

<div class="flex flex-col justify-center p-8 mx-auto bg-background">
  <div class="w-full max-w-sm mx-auto">
    <!-- copy:start -->
    <div class="w-full space-y-1">
      <Text
        for="readonly-textarea"
        tag="label"
        variant="textSM"
        class="font-medium text-muted-foreground"
      >
        Read-only textarea
      </Text>
      <textarea
        id="readonly-textarea"
        rows="4"
        placeholder="You cannot edit this"
        class="block w-full px-4 py-2 text-sm text-foreground border border-transparent rounded-lg appearance-none bg-background ring-1 ring-border placeholder:text-muted-foreground focus:outline-none sm:text-sm"
        readonly></textarea>
    </div>
    <!-- copy:end -->
  </div>
</div>
