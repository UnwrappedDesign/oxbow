---
export const description = "Textarea with Auto-Save";
import Text from "@/components/fundations/typography/Text.astro";
---
<div class="flex flex-col justify-center p-8 mx-auto bg-background">
  <div class="w-full max-w-sm mx-auto">
    <!-- copy:start -->
    <div
      class="w-full space-y-1"
      x-data="{ text: '', saved: false }"
      x-init="
        let timeout;
        $watch('text', () => {
          clearTimeout(timeout);
          saved = false;
          timeout = setTimeout(() => saved = true, 2000);
        });
      "
    >
      <Text
        for="autosave-textarea"
        tag="label"
        variant="textSM"
        class="font-medium text-muted-foreground"
      >
        Auto-save textarea
      </Text>
      <textarea
        id="autosave-textarea"
        x-model="text"
        rows="4"
        placeholder="Type your message"
        class="block w-full px-4 py-2 text-sm text-foreground bg-background border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm"
      ></textarea>
      <div
        class="mt-2 text-sm text-muted-foreground"
        x-text="saved ? 'Saved!' : 'Saving...'"
      >
      </div>
    </div>
    <!-- copy:end -->
 </div>
</div>
