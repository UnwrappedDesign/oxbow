---
export const description = "Resizable textarea";
import Text from "@/components/fundations/typography/Text.astro";
---

<div class="flex flex-col justify-center p-8 mx-auto bg-background">
  <div class="w-full max-w-sm mx-auto">
    <!-- copy:start -->
    <div class="w-full space-y-1">
      <Text
        for="resizable-textarea"
        tag="label"
        variant="textSM"
        class="font-medium text-muted-foreground"
      >
        Resizable textarea
      </Text>
      <textarea
        id="resizable-textarea"
        rows="4"
        placeholder="Resize me"
        class="block w-full px-4 py-2 text-sm text-foreground bg-background border border-transparent rounded-lg appearance-none resize duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm"
      ></textarea>
    </div>
    <!-- copy:end -->
  </div>
</div>
