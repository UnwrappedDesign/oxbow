---
export const description = "Disabled textarea";
import Text from "@/components/fundations/typography/Text.astro";
---

<div class="flex flex-col justify-center p-8 mx-auto bg-background">
  <div class="w-full max-w-sm mx-auto">
    <!-- copy:start -->
    <div class="w-full space-y-1">
      <Text
        for="disabled-textarea"
        tag="label"
        variant="textSM"
        class="font-medium text-muted-foreground"
      >
        Disabled textarea
      </Text>
      <textarea
        id="disabled-textarea"
        rows="4"
        placeholder="This textarea is disabled"
        class="block w-full px-4 py-2 text-sm border border-transparent rounded-lg appearance-none bg-background text-foreground ring-1 ring-border placeholder:text-muted-foreground focus:outline-none sm:text-sm"
        disabled></textarea>
    </div>
    <!-- copy:end -->
  </div>
</div>
