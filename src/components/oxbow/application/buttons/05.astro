<section class="flex items-center justify-center h-full p-12 bg-background">
  <!-- copy:start -->
  <div class="flex flex-wrap items-center justify-center gap-3">
    <Button variant="link" size="xs">Link</Button>
    <Button variant="link" size="sm">Link</Button>
    <Button variant="link" size="base">Link</Button>
    <Button variant="link" size="md">Link</Button>
    <Button variant="link" size="lg">Link</Button>
    <Button variant="link" size="xl">Link</Button>
  </div>
  <!-- copy:end -->
</section>
