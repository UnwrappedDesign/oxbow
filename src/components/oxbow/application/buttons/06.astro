import Button from "@/components/fundations/buttons/Button.astro";
---

<section class="flex items-center justify-center h-full p-12 bg-white dark:bg-zinc-900">
  <!-- copy:start -->
  <div class="flex flex-wrap items-center justify-center gap-3">
    <Button variant="muted" size="xs">Muted</Button>
    <Button variant="muted" size="sm">Muted</Button>
    <Button variant="muted" size="base">Muted</Button>
    <Button variant="muted" size="md">Muted</Button>
    <Button variant="muted" size="lg">Muted</Button>
    <Button variant="muted" size="xl">Muted</Button>
  </div>
  <!-- copy:end -->
</section>
