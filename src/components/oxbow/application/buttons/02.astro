---
export const freeComponent = true;
export const description = "Accent button";
import Button from "@/components/fundations/buttons/Button.astro";
---

<section class="flex items-center justify-center h-full p-12 bg-background">
  <!-- copy:start -->
  <div class="flex flex-wrap items-center justify-center gap-3">
    <Button variant="accent" size="xs">Accent</Button>
    <Button variant="accent" size="sm">Accent</Button>
    <Button variant="accent" size="base">Accent</Button>
    <Button variant="accent" size="md">Accent</Button>
    <Button variant="accent" size="lg">Accent</Button>
    <Button variant="accent" size="xl">Accent</Button>
  </div>
  <!-- copy:end -->
</section>
