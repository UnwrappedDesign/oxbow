---
export const freeComponent = true;
export const description = "Outline button";
import Button from "@/components/fundations/buttons/Button.astro";
---

<section class="flex items-center justify-center h-full p-12 bg-white dark:bg-zinc-900">
  <!-- copy:start -->
  <div class="flex flex-wrap items-center justify-center gap-3">
    <Button variant="outline" size="xs">Outline</Button>
    <Button variant="outline" size="sm">Outline</Button>
    <Button variant="outline" size="base">Outline</Button>
    <Button variant="outline" size="md">Outline</Button>
    <Button variant="outline" size="lg">Outline</Button>
    <Button variant="outline" size="xl">Outline</Button>
  </div>
  <!-- copy:end -->
</section>
