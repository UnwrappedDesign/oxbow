---
export const freeComponent = true;
export const description = "Ghost button";
import Button from "@/components/fundations/buttons/Button.astro";
---

<section class="flex items-center justify-center h-full p-12 bg-white dark:bg-zinc-900">
  <!-- copy:start -->
  <div class="flex flex-wrap items-center justify-center gap-3">
    <Button variant="ghost" size="xs">Ghost</Button>
    <Button variant="ghost" size="sm">Ghost</Button>
    <Button variant="ghost" size="base">Ghost</Button>
    <Button variant="ghost" size="md">Ghost</Button>
    <Button variant="ghost" size="lg">Ghost</Button>
    <Button variant="ghost" size="xl">Ghost</Button>
  </div>
  <!-- copy:end -->
</section>
