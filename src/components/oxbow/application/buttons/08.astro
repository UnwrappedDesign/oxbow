---
export const freeComponent = true;
export const description = "Disabled button states";
import Button from "@/components/fundations/buttons/Button.astro";
---

<section class="flex flex-wrap items-center justify-center h-full gap-3 p-12 bg-white dark:bg-zinc-900">
  <!-- copy:start -->
  <div class="flex flex-wrap items-center justify-center gap-3">
    <Button variant="default" size="xs" disabled>Disabled</Button>
    <Button variant="default" size="sm" disabled>Disabled</Button>
    <Button variant="default" size="base" disabled>Disabled</Button>
    <Button variant="default" size="md" disabled>Disabled</Button>
    <Button variant="default" size="lg" disabled>Disabled</Button>
    <Button variant="default" size="xl" disabled>Disabled</Button>
  </div>
  <!-- copy:end -->
</section>
