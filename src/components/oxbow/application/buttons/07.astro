---
export const freeComponent = true;
export const description = "Button with left icon";
import Button from "@/components/fundations/buttons/Button.astro";
import Plus from "@/components/fundations/icons/Plus.astro";
---

<section class="flex items-center justify-center h-full p-12 bg-background">
  <!-- copy:start -->
  <div class="flex flex-wrap items-center justify-center gap-3">
    <Button variant="default" size="xs" gap="xs">
      <Plus slot="left-icon" size="xs" />
      Add item
    </Button>
    <Button variant="default" size="sm" gap="xs">
      <Plus slot="left-icon" size="sm" />
      Add item
    </Button>
    <Button variant="default" size="base" gap="xs">
      <Plus slot="left-icon" size="base" />
      Add item
    </Button>
    <Button variant="default" size="md" gap="xs">
      <Plus slot="left-icon" size="md" />
      Add item
    </Button>
    <Button variant="default" size="lg" gap="xs">
      <Plus slot="left-icon" size="lg" />
      Add item
    </Button>
    <Button variant="default" size="xl" gap="xs">
      <Plus slot="left-icon" size="xl" />
      Add item
    </Button>
  </div>
  <!-- copy:end -->
</section>
