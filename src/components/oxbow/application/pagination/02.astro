---
import Text from "@/components/fundations/typography/Text.astro";
import Button from "@/components/fundations/buttons/Button.astro";
import ChevronLeft from "@/components/fundations/icons/ChevronLeft.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
---

<div
  class="flex flex-col items-center justify-between w-full p-16 mx-auto bg-background gap-8"
>
  <!-- copy:start -->
  <nav aria-label="Pagination">
    <ol role="list" class="relative z-0 inline-flex items-center gap-2">
      <!-- Prev -->
      <li>
        <Button
          iconOnly
          disabled
          aria-label="Go to previous page"
          variant="muted"
          size="xs"
        >
          <ChevronLeft size="xs" slot="left-icon" />
          <span class="sr-only">Previous</span>
        </Button>
      </li>
      <!-- Page numbers -->
      <li>
        <Button
          iconOnly
          variant="muted"
          size="xs"
          aria-current="page"
          aria-label="Page 1, current page"
        >
          1
        </Button>
      </li>
      <li>
        <Button iconOnly variant="muted" size="xs" aria-label="Go to page 2">
          2
        </Button>
      </li>
      <li aria-hidden="true" class="text-muted-foreground">…</li>
      <li>
        <Button iconOnly variant="muted" size="xs" aria-label="Go to page 60">
          60
        </Button>
      </li>
      <!-- Go to page -->
      <li class="items-center hidden md:flex space-x-2">
        <Text
          tag="label"
          variant="textSM"
          class="px-2 text-muted-foreground"
          for="goto-page"
        >
          Go to page
        </Text>
        <input
          id="goto-page"
          type="number"
          min="1"
          max="60"
          inputmode="numeric"
          class="block w-16 h-8 p-1 text-sm text-center text-foreground bg-background border border-transparent rounded shadow appearance-none duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:bg-transparent focus:muted-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm"
          placeholder="60"
          aria-describedby="goto-help"
        />
        <Button variant="default" size="xs" aria-label="Confirm page number">
          Confirm
        </Button>
      </li>
      <!-- Next -->
      <li>
        <Button iconOnly aria-label="Go to next page" variant="muted" size="xs">
          <ChevronRight size="xs" slot="right-icon" />
          <span class="sr-only">Next</span>
        </Button>
      </li>
    </ol>
    <p id="goto-help" class="sr-only">Enter a page number between 1 and 60</p>
  </nav>
  <Text tag="p" variant="textSM" class="text-muted-foreground">
    Showing <strong>1</strong> to <strong>10</strong> of <strong>60</strong> pages
  </Text>
  <!-- copy:end -->
</div>
