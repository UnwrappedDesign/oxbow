---
import Button from "@/components/fundations/buttons/Button.astro";
export const excludeFromObfuscation = [
  "bg-muted",
  "text-muted-foreground",
  "border-b",
  "ring-1",
  "ring-border",
];
---

<div class="flex flex-col justify-center p-12 mx-auto bg-background">
  <!-- Accessible Tabs • Scrollable (overflow-x) with action on right -->
  <div
    x-data="{
      keys: ['overview','projects','packages','team','billing','settings'],
      selected: 'overview',
      focus: 0,
      init(){ this.focus = 0 },
      select(id){ this.selected = id; this.focus = this.keys.indexOf(id) },
      onKeydown(e){
        const last = this.keys.length - 1
        let i = this.focus
        if (e.key==='ArrowRight' || e.key==='ArrowDown') i = i===last?0:i+1
        else if (e.key==='ArrowLeft' || e.key==='ArrowUp') i = i===0?last:i-1
        else if (e.key==='Home') i = 0
        else if (e.key==='End') i = last
        else return
        e.preventDefault(); const id = this.keys[i]; this.focus=i; this.$nextTick(()=>this.$refs['tab-'+id]?.focus())
      }
    }"
    class="w-full max-w-5xl mx-auto"
  >
    <div class="flex items-center justify-between gap-4">
      <div class="relative flex-1 overflow-x-auto overflow-y-hidden">
        <div
          class="border-b min-w-max border-border"
          role="tablist"
          aria-orientation="horizontal"
        >
          <div class="flex text-sm gap-6 text-foreground">
            <template x-for="(id, idx) in keys" :key="id">
              <button
                class="relative pb-2 font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-border"
                :id="'tab-'+id"
                role="tab"
                :aria-selected="selected===id"
                :tabindex="focus===idx?0:-1"
                :aria-controls="'panel-'+id"
                x-ref="tab-[[id]]"
                @click="select(id)"
                @keydown="onKeydown($event)"
                :class="selected===id ? 'text-muted-foreground' : 'hover:text-foreground'"
              >
                <span x-text="id.charAt(0).toUpperCase()+id.slice(1)"></span>
                <span
                  class="absolute left-0 bottom-0 h-[2px] w-full transition-all"
                  :class="selected===id ? 'bg-muted' : 'bg-transparent'"
                  aria-hidden="true"></span>
              </button>
            </template>
          </div>
        </div>
      </div>
      <div class="hidden shrink-0 sm:flex gap-2">
        <Button variant="muted" size="xs" type="button">Export</Button>
        <Button variant="default" size="xs" type="button">New</Button>
      </div>
    </div>

    <div class="pt-4 text-sm text-muted-foreground">
      <template x-for="id in keys" :key="'panel-'+id">
        <section
          x-show="selected===id"
          x-cloak
          role="tabpanel"
          :id="'panel-'+id"
          :aria-labelledby="'tab-'+id"
        >
          <p>
            <span x-text="id.charAt(0).toUpperCase()+id.slice(1)"></span> content
            — replace with your blocks.
          </p>
        </section>
      </template>
    </div>
  </div>
</div>
