---
export const description = "Radio Button Group with Descriptions";
import Text from "@/components/fundations/typography/Text.astro";
---

<div class="flex justify-center p-16 mx-auto bg-background">
  <!-- copy:start -->
  <div class="flex flex-col gap-2" x-data="{ selected: 'option1' }">
    <div class="flex items-start gap-3">
      <input
        id="radio-option1"
        name="radio-group"
        type="radio"
        value="option1"
        x-model="selected"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <div>
        <Text
          for="radio-option1"
          tag="label"
          class="block text-sm font-medium text-muted-foreground"
        >
          Option 1
        </Text>
        <p class="text-sm text-muted-foreground">
          This is the description for option 1.
        </p>
      </div>
    </div>

    <div class="flex items-start gap-3">
      <input
        id="radio-option2"
        name="radio-group"
        type="radio"
        value="option2"
        x-model="selected"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <div>
        <Text
          for="radio-option2"
          tag="label"
          class="block text-sm font-medium text-muted-foreground"
        >
          Option 2
        </Text>
        <p class="text-sm text-muted-foreground">
          This is the description for option 2.
        </p>
      </div>
    </div>

    <div class="mt-2 text-sm text-muted-foreground">
      Selected: <span x-text="selected"></span>
    </div>
  </div>
  <!-- copy:end -->
</div>
