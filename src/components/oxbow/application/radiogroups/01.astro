---
export const freeComponent = true;
export const description = "Basic Radio Button";
import Text from "@/components/fundations/typography/Text.astro";
---

<div class="flex justify-center mx-auto bg-background p-17">
  <!-- copy:start -->
  <div class="flex items-center gap-2">
    <input
      id="basic-radio"
      name="example-radio"
      type="radio"
      class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
    />
    <Text
      for="basic-radio"
      tag="label"
      class="block text-sm text-muted-foreground"
    >
      Basic radio button
    </Text>
  </div>
  <!-- copy:end -->
</div>
