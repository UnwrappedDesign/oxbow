---
export const description = "Radio Button Group with Tool Selection";
---

<div class="flex justify-center p-16 mx-auto bg-background">
  <!-- copy:start -->
  <div class="grid grid-cols-2 gap-2" x-data="{ selectedTool: 'pen' }">
    <div
      class="flex items-center p-4 border rounded-lg gap-3 border-border"
    >
      <input
        id="radio-pen"
        name="tool-selection"
        type="radio"
        value="pen"
        x-model="selectedTool"
        class="text-foreground bg-background border rounded-full shadow size-4 border-border focus:ring-border"
      />
      <label for="radio-pen" class="block text-sm font-medium text-muted-foreground">
        Pen
      </label>
    </div>
    <div
      class="flex items-center p-4 border rounded-lg gap-3 border-border"
    >
      <input
        id="radio-marker"
        name="tool-selection"
        type="radio"
        value="marker"
        x-model="selectedTool"
        class="text-foreground bg-background border rounded-full shadow size-4 border-border focus:ring-border"
      />
      <label for="radio-marker" class="block text-sm font-medium text-muted-foreground">
        Marker
      </label>
    </div>
    <div
      class="flex items-center p-4 border rounded-lg gap-3 border-border"
    >
      <input
        id="radio-highlighter"
        name="tool-selection"
        type="radio"
        value="highlighter"
        x-model="selectedTool"
        class="text-foreground bg-background border rounded-full shadow size-4 border-border focus:ring-border"
      />
      <label
        for="radio-highlighter"
        class="block text-sm font-medium text-muted-foreground"
      >
        Highlighter
      </label>
    </div>
    <div
      class="flex items-center p-4 border rounded-lg gap-3 border-border"
    >
      <input
        id="radio-eraser"
        name="tool-selection"
        type="radio"
        value="eraser"
        x-model="selectedTool"
        class="text-foreground bg-background border rounded-full shadow size-4 border-border focus:ring-border"
      />
      <label for="radio-eraser" class="block text-sm font-medium text-muted-foreground">
        Eraser
      </label>
    </div>
  </div>
  <!-- copy:end -->
</div>
