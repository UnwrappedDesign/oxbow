---
export const excludeFromObfuscation = [
  "text-muted-foreground",
  "text-muted-foreground",
];
export const description = "Radio Group for Theme Selection";
---

<div class="flex justify-center p-16 mx-auto bg-background">
  <div class="mx-auto mx-w-sm">
    <!-- copy:start -->
    <div class="flex flex-col gap-2" x-data="{ theme: 'light' }">
      <p class="text-sm font-medium text-muted-foreground">Choose a theme</p>
      <div class="flex gap-6">
        <!-- Light Theme -->
        <label class="flex flex-col cursor-pointer gap-2">
          <div
            class="flex items-center justify-center rounded ring-1 ring-border bg-background"
          >
            <img
              src="/images/forms/light.png"
              alt="Light theme placeholder"
              class="rounded"
            />
          </div>
          <div class="flex items-center gap-2">
            <input
              type="radio"
              name="theme"
              value="light"
              x-model="theme"
              class="bg-background size-4 text-muted-foreground border-border"
            />
            <span
              class="text-sm font-medium"
              :class="{ 'text-muted-foreground': theme === 'light' }"
            >
              Light
            </span>
          </div>
        </label>

        <!-- Dark Theme -->
        <label class="flex flex-col cursor-pointer gap-2">
          <div
            class="flex items-center justify-center rounded ring-1 ring-border bg-background"
          >
            <img
              src="/images/forms/dark.png"
              alt="Dark theme placeholder"
              class="rounded"
            />
          </div>
          <div class="flex items-center gap-2">
            <input
              type="radio"
              name="theme"
              value="dark"
              x-model="theme"
              class="bg-background size-4 text-muted-foreground border-border"
            />
            <span
              class="text-sm font-medium"
              :class="{ 'text-muted-foreground': theme === 'dark' }"
            >
              Dark
            </span>
          </div>
        </label>

        <!-- System Theme -->
        <label class="flex flex-col cursor-pointer gap-2">
          <div
            class="flex items-center justify-center rounded ring-1 ring-border bg-background"
          >
            <img
              src="/images/forms/system.png"
              alt="System theme placeholder"
              class="rounded"
            />
          </div>
          <div class="flex items-center gap-2">
            <input
              type="radio"
              name="theme"
              value="system"
              x-model="theme"
              class="bg-background size-4 text-muted-foreground border-border"
            />
            <span
              class="text-sm font-medium"
              :class="{ 'text-muted-foreground': theme === 'system' }"
            >
              System
            </span>
          </div>
        </label>
      </div>
    </div>
    <!-- copy:end -->
  </div>
</div>
