---
export const description = "Radio Group for Plan Selection";
import Text from "@/components/fundations/typography/Text.astro";
import Badge from "@/components/fundations/badges/Badge.astro";
---

<div class="flex justify-center p-16 mx-auto bg-background">
  <!-- copy:start -->
  <div class="flex flex-col gap-8" x-data="{ selectedPlan: 'basic' }">
    <div class="flex items-start gap-3">
      <input
        id="radio-basic"
        name="plan"
        type="radio"
        value="basic"
        x-model="selectedPlan"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <div>
        <label
          for="radio-basic"
          class="block text-sm font-medium text-muted-foreground"
        >
          Basic
        </label>
        <p class="text-sm text-muted-foreground">$10/month for basic features.</p>
      </div>
    </div>
    <div class="flex items-start gap-3">
      <input
        id="radio-pro"
        name="plan"
        type="radio"
        value="pro"
        x-model="selectedPlan"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <div>
        <label for="radio-pro" class="block text-sm font-medium text-muted-foreground">
          Pro
          <Badge variant="default" size="xs" class="ml-2"> Popular </Badge>
        </label>
        <p class="text-sm text-muted-foreground">$30/month for advanced features.</p>
      </div>
    </div>
    <div class="flex items-start gap-3">
      <input
        id="radio-enterprise"
        name="plan"
        type="radio"
        value="enterprise"
        x-model="selectedPlan"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <div>
        <label
          for="radio-enterprise"
          class="block text-sm font-medium text-muted-foreground"
        >
          Enterprise
        </label>
        <p class="text-sm text-muted-foreground">Custom pricing for enterprises.</p>
      </div>
    </div>
  </div>
  <!-- copy:end -->
</div>
