---
export const description = "Radio Group for Server Location";
import Text from "@/components/fundations/typography/Text.astro";
import Badge from "@/components/fundations/badges/Badge.astro";
---

<div class="flex justify-center mx-auto bg-background p-17">
  <!-- copy:start -->
  <div class="flex gap-6" x-data="{ location: 'usa' }">
    <div class="flex items-center gap-3">
      <input
        id="radio-usa"
        name="server-location"
        type="radio"
        value="usa"
        x-model="location"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <label for="radio-usa" class="block text-sm text-muted-foreground">USA</label>
    </div>
    <div class="flex items-center gap-3">
      <input
        id="radio-europe"
        name="server-location"
        type="radio"
        value="europe"
        x-model="location"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <label for="radio-europe" class="block text-sm text-muted-foreground"
        >Europe</label
      >
    </div>
    <div class="flex items-center gap-3">
      <input
        id="radio-asia"
        name="server-location"
        type="radio"
        value="asia"
        x-model="location"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <label for="radio-asia" class="block text-sm text-muted-foreground">Asia</label>
    </div>
  </div>
  <!-- copy:end -->
</div>
