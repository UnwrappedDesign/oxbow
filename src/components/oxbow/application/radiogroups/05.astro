---
export const description = "Radio Group with Toggle Details";
import Text from "@/components/fundations/typography/Text.astro";
---

<div class="flex justify-center mx-auto bg-background p-15">
  <!-- copy:start -->
  <div
    class="flex flex-col w-full max-w-2xl mx-auto lg:flex-row gap-12"
    x-data="{ selected: 'monthly' }"
  >
    <div class="space-y-4">
      <div class="flex items-start gap-3">
        <input
          id="radio-monthly"
          name="radio-toggle-group"
          type="radio"
          value="monthly"
          x-model="selected"
          class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
        />
        <div>
          <Text
            for="radio-monthly"
            tag="label"
            class="block text-sm font-medium text-muted-foreground"
          >
            Monthly Plan
          </Text>
          <p class="text-sm text-muted-foreground">
            Pay $10 per month.
          </p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <input
          id="radio-yearly"
          name="radio-toggle-group"
          type="radio"
          value="yearly"
          x-model="selected"
          class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
        />
        <div>
          <Text
            for="radio-yearly"
            tag="label"
            class="block text-sm font-medium text-muted-foreground"
          >
            Yearly Plan
          </Text>
          <p class="text-sm text-muted-foreground">
            Pay $100 per year and save 20%.
          </p>
        </div>
      </div>
    </div>
    <div class="text-sm text-muted-foreground">
      <div x-show="selected === 'monthly'">
        Monthly plan is flexible and easy to cancel anytime!
      </div>
      <div x-show="selected === 'yearly'">
        Yearly plan offers a better deal for long-term use!
      </div>
    </div>
  </div>
  <!-- copy:end -->
</div>
