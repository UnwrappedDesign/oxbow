---
export const description = "Inline Radio Button Group";
import Text from "@/components/fundations/typography/Text.astro";
---

<div class="flex justify-center p-16 mx-auto bg-background">
  <!-- copy:start -->
  <div class="flex flex-col gap-2" x-data="{ selected: 'small' }">
    <div class="flex items-center gap-3">
      <input
        id="radio-small"
        name="inline-radio"
        type="radio"
        value="small"
        x-model="selected"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <Text
        for="radio-small"
        tag="label"
        class="block text-sm text-muted-foreground"
      >
        Small
      </Text>
    </div>

    <div class="flex items-center gap-3">
      <input
        id="radio-medium"
        name="inline-radio"
        type="radio"
        value="medium"
        x-model="selected"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <Text
        for="radio-medium"
        tag="label"
        class="block text-sm text-muted-foreground"
      >
        Medium
      </Text>
    </div>

    <div class="flex items-center gap-3">
      <input
        id="radio-large"
        name="inline-radio"
        type="radio"
        value="large"
        x-model="selected"
        class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
      />
      <Text
        for="radio-large"
        tag="label"
        class="block text-sm text-muted-foreground"
      >
        Large
      </Text>
    </div>

    <div class="mt-2 text-sm text-muted-foreground">
      Selected size: <span x-text="selected"></span>
    </div>
  </div>
  <!-- copy:end -->
</div>
