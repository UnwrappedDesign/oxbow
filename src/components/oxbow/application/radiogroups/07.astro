---
export const description = "Radio Button Group for Payment Methods";
import Text from "@/components/fundations/typography/Text.astro";
---

<div class="flex justify-center p-16 mx-auto bg-background">
  <!-- copy:start -->
  <div class="w-full max-w-sm mx-auto">
    <div
      class="flex flex-col w-full gap-2"
      x-data="{ paymentMethod: 'credit-card' }"
    >
      <div
        class="flex items-center p-4 border rounded-lg gap-3 border-border"
      >
        <input
          id="radio-credit-card"
          name="payment-method"
          type="radio"
          value="credit-card"
          x-model="paymentMethod"
          class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
        />
        <label
          for="radio-credit-card"
          class="block text-sm font-medium text-muted-foreground"
        >
          Credit Card
        </label>
      </div>
      <div
        class="flex items-center p-4 border rounded-lg gap-3 border-border"
      >
        <input
          id="radio-debit-card"
          name="payment-method"
          type="radio"
          value="debit-card"
          x-model="paymentMethod"
          class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
        />
        <label
          for="radio-debit-card"
          class="block text-sm font-medium text-muted-foreground"
        >
          Debit Card
        </label>
      </div>
      <div
        class="flex items-center p-4 border rounded-lg gap-3 border-border"
      >
        <input
          id="radio-wallet"
          name="payment-method"
          type="radio"
          value="wallet"
          x-model="paymentMethod"
          class="text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border"
        />
        <label
          for="radio-wallet"
          class="block text-sm font-medium text-muted-foreground"
        >
          Wallet
        </label>
      </div>
    </div>
  </div>
  <!-- copy:end -->
</div>
