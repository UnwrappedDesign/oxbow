---
export const description = "Destructive Action Confirmation";
import Text from "@/components/fundations/typography/Text.astro";
---

<section
  class="flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2"
>
  <!-- copy:start -->
  <div class="flex flex-col w-full max-w-md gap-2" x-data="{ confirm: false }">
    <div class="flex items-start gap-3">
      <input
        id="confirm-delete"
        name="confirm-delete"
        type="checkbox"
        x-model="confirm"
        class="text-foreground rounded shadow size-4 border-border focus:ring-border bg-background checked:bg-muted"
      />
      <div>
        <Text
          for="confirm-delete"
          tag="label"
          class="block text-sm text-foreground"
        >
          I understand this action cannot be undone
        </Text>
        <p class="text-xs text-muted-foreground">
          This will permanently delete the item.
        </p>
      </div>
    </div>
    <div class="flex gap-2">
      <button
        type="button"
        :disabled="!confirm"
        class="px-3 py-1.5 text-sm rounded bg-destructive text-foreground disabled:opacity-50 disabled:cursor-not-allowed"
        @click="alert('Deleted')"
      >
        Delete
      </button>
      <span class="self-center text-xs text-muted-foreground">
        <span x-text="confirm ? 'Ready to delete' : 'Please confirm'"></span>
      </span>
    </div>
  </div>
  <!-- copy:end -->
</section>
