---
export const description = "Checkbox with Disabled State";
import Text from "@/components/fundations/typography/Text.astro";
---

<section
  class="flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2"
>
  <!-- copy:start -->
  <div class="flex items-center gap-2">
    <input
      id="disabled-checkbox"
      name="disabled-checkbox"
      type="checkbox"
      class="text-foreground rounded shadow opacity-50 size-4 border-border focus:ring-border disabled:cursor-not-allowed disabled:bg-background"
      disabled
    />
    <Text
      for="disabled-checkbox"
      tag="label"
      class="block text-sm cursor-not-allowed text-muted-foreground"
    >
      Disabled checkbox
    </Text>
  </div>
  <!-- copy:end -->
</section>
