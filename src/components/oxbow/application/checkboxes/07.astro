---
export const description = "Dependent Checkbox (Prerequisite)";
import Text from "@/components/fundations/typography/Text.astro";
---

<section
  class="flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2"
>
  <!-- copy:start -->
  <div
    class="flex flex-col w-full max-w-md gap-2"
    x-data="{ agreed: false, marketing: false }"
  >
    <div class="flex items-start gap-3">
      <input
        id="dep-agree"
        name="dep-agree"
        type="checkbox"
        x-model="agreed"
        class="text-foreground rounded shadow size-4 border-border focus:ring-border bg-background checked:bg-muted"
      />
      <Text
        for="dep-agree"
        tag="label"
        class="block text-sm text-muted-foreground"
      >
        I agree to data processing
      </Text>
    </div>
    <div class="flex items-start pl-6 gap-3">
      <input
        id="dep-marketing"
        name="dep-marketing"
        type="checkbox"
        x-model="marketing"
        :disabled="!agreed"
        class="text-foreground rounded shadow size-4 border-border focus:ring-border disabled:opacity-50 disabled:cursor-not-allowed bg-background checked:bg-muted"
      />
      <div>
        <Text
          for="dep-marketing"
          tag="label"
          class="block text-sm text-muted-foreground"
        >
          Receive marketing emails <span
            class="text-muted-foreground">(Optional)</span
          >
        </Text>
        <p class="text-xs text-muted-foreground">
          Requires consent above.
        </p>
      </div>
    </div>
  </div>
  <!-- copy:end -->
</section>
