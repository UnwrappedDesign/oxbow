---
export const description = "Weekday Pills Selector";
---

<section
  class="flex flex-wrap items-center justify-center h-full bg-background gap-2 p-14"
>
  <!-- copy:start -->
  <div
    class="flex flex-col w-full max-w-md gap-3"
    x-data="{ days: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], selected: [] }"
  >
    <div class="flex flex-wrap items-center gap-2">
      <template x-for="d in days" :key="d">
        <div>
          <input
            type="checkbox"
            class="sr-only peer"
            :id="`day-`+d"
            :value="d"
            x-model="selected"
          />
          <label
            :for="`day-`+d"
            :title="d"
            class="inline-flex items-center justify-center w-10 h-10 text-sm bg-background border rounded-full select-none border-border text-muted-foreground transition-all cursor-pointer peer-checked:ring-2 peer-checked:ring-border peer-checked:ring-offset-2 ring-offset-background peer-focus-visible:ring-2 peer-focus-visible:ring-border peer-focus-visible:ring-offset-2"
          >
            <span x-text="d[0]"></span>
          </label>
        </div>
      </template>
    </div>
  </div>
  <!-- copy:end -->
</section>
