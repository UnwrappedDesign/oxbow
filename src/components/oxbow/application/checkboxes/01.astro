---
export const freeComponent = true;
export const description = "Basic Checkbox with State Tracking";
import Text from "@/components/fundations/typography/Text.astro";
---

<section
  class="flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2"
>
  <!-- copy:start -->
  <div class="flex items-center gap-2" x-data="{ checked: false }">
    <input
      id="basic-checkbox"
      name="basic-checkbox"
      type="checkbox"
      x-model="checked"
      class="text-foreground rounded shadow size-4 border-border focus:ring-border bg-background checked:bg-muted"
    />
    <Text
      for="basic-checkbox"
      tag="label"
      class="block text-sm text-muted-foreground"
    >
      Basic checkbox (<span x-text="checked ? 'Checked' : 'Unchecked'"></span>)
    </Text>
  </div>
  <!-- copy:end -->
</section>
