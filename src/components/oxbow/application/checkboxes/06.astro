---
export const description = "Checkbox Group with Max Selection";
import Text from "@/components/fundations/typography/Text.astro";
---

<section
  class="flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2"
>
  <!-- copy:start -->
  <div
    class="flex flex-col w-full max-w-md gap-2"
    x-data="{
      options: ['UI', 'API', 'Docs', 'Analytics', 'Billing'],
      selected: [],
      limit: 2,
      isDisabled(opt){ return !this.selected.includes(opt) && this.selected.length >= this.limit }
    }"
  >
    <div class="text-xs text-muted-foreground">Select up to 2</div>
    <template x-for="option in options" :key="option">
      <div class="flex items-center gap-3">
        <input
          type="checkbox"
          :id="`limit-` + option"
          :value="option"
          x-model="selected"
          :disabled="isDisabled(option)"
          class="text-foreground rounded shadow size-4 border-border focus:ring-border disabled:opacity-50 disabled:cursor-not-allowed bg-background checked:bg-muted"
        />
        <Text
          :for="`limit-` + option"
          tag="label"
          class="block text-sm text-muted-foreground"
          x-text="option"
        />
      </div>
    </template>
    <div class="mt-2 text-sm text-muted-foreground">
      Selected: <span
        class="text-muted-foreground"
        x-text="selected.join(', ')"></span>
    </div>
  </div>
  <!-- copy:end -->
</section>
