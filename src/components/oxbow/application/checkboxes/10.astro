---
export const description = "Checkbox with Expansion";
import Text from "@/components/fundations/typography/Text.astro";
---

<section
  class="flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2"
>
  <!-- copy:start -->
  <div class="flex flex-col w-full gap-1" x-data="{ expanded: false }">
    <div class="flex items-start gap-3">
      <input
        id="terms-acceptance-checkbox"
        name="terms-acceptance-checkbox"
        type="checkbox"
        @change="expanded = !expanded"
        class="text-foreground rounded shadow size-4 border-border focus:ring-border bg-background checked:bg-muted"
      />
      <div>
        <Text
          for="terms-acceptance-checkbox"
          tag="label"
          class="block text-sm font-medium text-muted-foreground"
        >
          Accept terms and conditions
        </Text>
        <Text tag="p" variant="textSM" class="text-muted-foreground">
          Please review and accept the terms and conditions to proceed.
        </Text>
      </div>
    </div>
    <div
      x-show="expanded"
      class="mt-2 text-sm ml-7 text-muted-foreground"
    >
      By checking this box, you confirm that you have read and agreed to the
      terms and conditions of our service.
    </div>
  </div>
  <!-- copy:end -->
</section>
