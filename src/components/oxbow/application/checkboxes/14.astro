---
export const description = "At Least One Required (Group)";
import Text from "@/components/fundations/typography/Text.astro";
---

<section
  class="flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2"
>
  <!-- copy:start -->
  <form
    class="flex flex-col w-full max-w-md gap-2"
    x-data="{ options: ['Email', 'SMS', 'Push'], selected: [], submitted: false }"
    @submit.prevent="submitted = true; if (selected.length === 0) return; alert('Saved')"
  >
    <div class="text-sm text-foreground">
      Notify me via (choose at least one)
    </div>
    <template x-for="opt in options" :key="opt">
      <div class="flex items-center gap-3">
        <input
          type="checkbox"
          :id="`notify-` + opt"
          :value="opt"
          x-model="selected"
          :aria-invalid="submitted && selected.length === 0"
          aria-describedby="notify-error"
          class="text-foreground rounded shadow size-4 border-border focus:ring-border bg-background checked:bg-muted"
        />
        <Text
          :for="`notify-` + opt"
          tag="label"
          class="block text-sm text-muted-foreground"
          x-text="opt"
        />
      </div>
    </template>
    <p
      id="notify-error"
      x-show="submitted && selected.length === 0"
      class="text-xs text-destructive"
      role="alert"
    >
      Select at least one notification method.
    </p>
    <div class="flex gap-2">
      <button
        type="submit"
        class="px-3 py-1.5 text-sm rounded bg-muted text-foreground"
        >Save Preferences</button
      >
      <span
        class="self-center text-xs text-muted-foreground"
        x-text="selected.join(', ') || 'None selected'"></span>
    </div>
  </form>
  <!-- copy:end -->
</section>
