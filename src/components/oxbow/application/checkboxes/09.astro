---
export const description = "List Item with Trailing Checkbox";
import Text from "@/components/fundations/typography/Text.astro";
---

<section
  class="flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2"
>
  <!-- copy:start -->
  <div
    class="flex items-center justify-between w-full max-w-md p-3 bg-background border rounded gap-2 border-border"
  >
    <div class="flex flex-col">
      <Text
        for="row-checkbox"
        tag="label"
        class="block text-sm text-foreground"
      >
        Weekly summary emails
      </Text>
      <p class="text-xs text-muted-foreground">
        Receive one email every Friday.
      </p>
    </div>
    <input
      id="row-checkbox"
      name="row-checkbox"
      type="checkbox"
      class="text-foreground rounded shadow size-4 border-border focus:ring-border bg-background checked:bg-muted"
    />
  </div>
  <!-- copy:end -->
</section>
