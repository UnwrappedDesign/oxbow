---
export const freeComponent = true;
export const description = "simple Sign up block ";

// Fundations
import Text from "@/components/fundations/typography/Text.astro";
import Button from "@/components/fundations/buttons/Button.astro";
import TextInput from "@/components/fundations/inputs/TextInput.astro";
---

<section class="bg-background">
  <div class="px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20">
    <div class="max-w-md p-8 mx-auto bg-background rounded-xl">
      <div class="text-center">
        <Text
          tag="h1"
          variant="displaySM"
          class="font-semibold tracking-tight text-foreground"
        >
          Sign up, no nonsense
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-2 text-muted-foreground text-balance"
        >
          Just your email and a password. That’s it. You’re in.
        </Text>
      </div>
      <form class="mt-10 space-y-4">
        <TextInput
          id="email"
          name="email"
          label="Email Address"
          type="email"
          variant="default"
          size="base"
          placeholder="you@example.com"
        />
        <TextInput
          id="password"
          name="password"
          label="Password"
          type="password"
          passwordToggle={true}
          size="base"
          placeholder="••••••••"
          required
        />
        <Text
          tag="p"
          variant="textXS"
          class="font-medium text-muted-foreground"
        >
          By creating an account, you agree to our
          <a
            href="#_"
            class="font-medium text-foreground hover:text-muted-foreground"
          >
            Terms of service
          </a>
          and
          <a href="#_" class="font-medium text-foreground hover:text-muted-foreground">
            Privacy Policy
          </a>
        </Text>
        <Button fullWidth variant="default" size="base">
          Create account
        </Button>
      </form>
      <Text
        tag="p"
        variant="textXS"
        class="mt-4 font-medium text-muted-foreground"
      >
        Already have an account?
        <a
          href="#_"
          class="font-medium text-foreground hover:text-muted-foreground"
        >
          Sign in
        </a>
      </Text>
    </div>
  </div>
</section>
