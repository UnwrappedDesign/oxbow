---
import Text from "@/components/fundations/typography/Text.astro";
---

<div
  class="flex flex-col justify-center p-12 mx-auto bg-background text-muted-foreground"
>
  <div class="flex flex-col gap-8">
    <!-- copy:start -->
    <Text tag="h4" variant="displayMD">
      This is an H4 heading with display MD variant.
    </Text>
    <!-- copy:end -->
    <small class="order-first text-base font-medium text-muted-foreground">
      Classes: text-xl leading-tight tracking-tight sm:text-2xl md:text-3xl
      lg:text-4xl
    </small>
  </div>
</div>
