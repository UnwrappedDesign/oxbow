---
export const freeComponent = true;
import Text from "@/components/fundations/typography/Text.astro";
---

<div
  class="flex flex-col justify-center p-12 mx-auto bg-background text-muted-foreground"
>
  <div class="flex flex-col gap-8">
    <!-- copy:start -->
    <Text tag="p" variant="textXS">
      This is a paragraph with text XS variant.
    </Text>
    <!-- copy:end -->
    <small class="order-first text-base font-medium">
      Classes: text-xs leading-normal
    </small>
  </div>
</div>
