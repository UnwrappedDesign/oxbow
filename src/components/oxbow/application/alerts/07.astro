---
import Text from "@/components/fundations/typography/Text.astro";
import CircleInfo from "@/components/fundations/icons/CircleInfo.astro";
---

<div class="flex items-center justify-center p-8 bg-background">
  <!-- copy:start -->
  <div
    class="relative w-full p-8 text-info border border-info/20 bg-info/20 border-info rounded-xl"
  >
    <div class="flex gap-2">
      <div class="flex-shrink-0">
        <CircleInfo size="base" slot="icon" />
      </div>
      <div>
        <div>
          <Text
            tag="p"
            variant="textBase"
            class="font-medium text-whit"
          >
            Neutral alert!
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="font-medium text-info"
          >
            A new feature is available. You will be notified when it is ready.
          </Text>
        </div>
      </div>
    </div>
  </div>
  <!-- copy:end -->
</div>
