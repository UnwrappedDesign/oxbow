---
import Button from "@/components/fundations/buttons/Button.astro";
import Text from "@/components/fundations/typography/Text.astro";
import CircleInfo from "@/components/fundations/icons/CircleInfo.astro";
---

<div class="flex items-center justify-center p-8 bg-background">
  <!-- copy:start -->
  <div
    class="relative w-full p-8 text-muted-foreground rounded-xl bg-background"
  >
    <div class="flex gap-2">
      <div class="flex-shrink-0">
        <CircleInfo size="base" slot="icon" />
      </div>
      <div>
        <Text
          tag="p"
          variant="textBase"
          class="font-medium text-foreground"
        >
          Neutral alert!
        </Text>
        <Text
          tag="p"
          variant="textSM"
          class="font-medium text-muted-foreground"
        >
          A new feature is available. You will be notified when it is ready.
        </Text>
        <div class="flex items-center mt-4 gap-2">
          <Button variant="accent" size="xs"> View Updates </Button>
          <Button variant="outline" size="xs"> Remind me later </Button>
        </div>
      </div>
    </div>
  </div>
  <!-- copy:end -->
</div>
