---
import Text from "@/components/fundations/typography/Text.astro";
import AlertTriangle from "@/components/fundations/icons/AlertTriangle.astro";
---

<div class="flex items-center justify-center p-8 bg-background">
  <!-- copy:start -->
  <div
    role="alert"
    class="relative w-full p-8 border border-warning/20 text-warning bg-warning/20 border-warning rounded-xl"
  >
    <div class="flex gap-2">
      <div class="flex-shrink-0">
        <AlertTriangle size="base" slot="icon" />
      </div>
      <div>
        <Text
          tag="p"
          variant="textBase"
          class="font-medium text-foreground"
        >
          Warning!
        </Text>
        <Text tag="p" variant="textSM" class="font-medium text-warning">
          This action cannot be undone. Please proceed with caution
        </Text>
      </div>
    </div>
  </div>
  <!-- copy:end -->
</div>
