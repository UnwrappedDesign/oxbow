---
import Text from "@/components/fundations/typography/Text.astro";
import AlertTriangle from "@/components/fundations/icons/AlertTriangle.astro";
---

<div class="flex items-center justify-center p-8 bg-background">
  <!-- copy:start -->
  <div
    role="alert"
    class="relative w-full p-8 border border-destructive/20 rounded-xl bg-destructive/20 border-destructive"
  >
    <div class="flex flex-col sm:flex-row gap-2">
      <div class="flex-shrink-0">
        <AlertTriangle size="base" slot="icon" class="text-destructive" />
      </div>
      <div>
        <Text
          tag="p"
          variant="textBase"
          class="font-medium text-foreground"
        >
          Warning! rose, time for a giggle Break!!
        </Text>

        <ul role="list">
          <li class="list-disc space-y-1">
            <Text tag="p" variant="textSM" class="font-medium text-destructive">
              Your password must be at least 8 characters, because even
              passwords need a little length to protect their secrets.
            </Text>
          </li>
          <li class="list-disc space-y-1">
            <Text tag="p" variant="textSM" class="font-medium text-destructive">
              Your password must include at least one pro wrestling finishing
              move, so you can 'pin' down your security like a champ
            </Text>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <!-- copy:end -->
</div>
