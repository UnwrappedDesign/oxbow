---
import Text from "@/components/fundations/typography/Text.astro";
import CircleCheck from "@/components/fundations/icons/CircleCheck.astro";
---

<div class="flex items-center justify-center p-8 bg-background">
  <!-- copy:start -->
  <div
    role="alert"
    class="relative w-full p-8 border border-success/20 text-success bg-success/20 border-success rounded-xl"
  >
    <div class="flex gap-2">
      <div class="flex-shrink-0">
        <CircleCheck size="base" slot="icon" />
      </div>
      <div>
        <Text
          tag="p"
          variant="textBase"
          class="font-medium text-foreground"
        >
          Success
        </Text>
        <Text tag="p" variant="textSM" class="font-medium text-success">
          Your changes have been saved.
        </Text>
      </div>
    </div>
  </div>
  <!-- copy:end -->
</div>
