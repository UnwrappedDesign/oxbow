---
export const description = "Centered CTA with logo and text";
// Assets
import Logo from "@/components/assets/Logo.astro";

// Fundations
import Text from "@/components/fundations/typography/Text.astro";
import Button from "@/components/fundations/buttons/Button.astro";
---

<section class="bg-background">
  <div class="px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20">
    <div
      class="relative p-8 shadow bg-linear-180 outline outline-border from-muted to-background lg:p-16 rounded-xl"
    >
      <div class="max-w-xl mx-auto text-center lg:text-balance">
        <div class="absolute inset-x-0 z-10 flex justify-center -top-10">
          <div class="inline-block p-4 rounded-2xl bg-muted">
            <Logo class="h-12 text-foreground" />
          </div>
        </div>
        <Text
          tag="h2"
          variant="displayMD"
          class="mt-12 font-semibold tracking-tight text-foreground lg:text-balance"
        >
          Unlock your team's potential
        </Text>
        <Text
          tag="p"
          variant="textSM"
          class="mt-4 text-muted-foreground lg:text-balance"
        >
          Simple, powerful tools to help you collaborate, organize, and launch
          faster. No clutter, just what you need to succeed.
        </Text>
        <div
          class="flex flex-wrap items-center justify-center mt-8 text-foreground gap-y-2 gap-x-8"
        >
          <Text tag="p" variant="textSM">Trusted by thousands</Text>

          <Text tag="p" variant="textSM">100% focused on your growth</Text>

          <Text tag="p" variant="textSM"
            >Independently built, always improving</Text
          >
        </div>

        <Button
          variant="default"
          size="base"
          gap="xs"
          class="flex mx-auto mt-8 w-fit"
          >Try it free <span aria-hidden="true">—</span>No credit card needed</Button
        >
      </div>
    </div>
  </div>
</section>
