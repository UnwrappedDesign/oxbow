---
export const excludeFromObfuscation = [
  "w-1/2",
  "translate-x-0",
  "translate-x-full",
  "text-muted-foreground",
  "text-foreground",
  "focus:text-foreground",
  "hover:text-foreground",
];

export const description = "Single usage based pricing card";
// Fundations
import Text from "@/components/fundations/typography/Text.astro";
import Button from "@/components/fundations/buttons/Button.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
import Clock from "@/components/fundations/icons/Clock.astro";
import Refresh from "@/components/fundations/icons/Refresh.astro";
import Database from "@/components/fundations/icons/Database.astro";
import Lifebuoy from "@/components/fundations/icons/Lifebuoy.astro";
import Brain from "@/components/fundations/icons/Brain.astro";
import ArrowIteration from "@/components/fundations/icons/ArrowIteration.astro";
import Lock from "@/components/fundations/icons/Lock.astro";
const pricingTiers = [
  { amount: "5,000", monthly: "$29", annual: "$19" },
  { amount: "7,500", monthly: "$39", annual: "$27" },
  { amount: "10,000", monthly: "$49", annual: "$35" },
  { amount: "12,500", monthly: "$59", annual: "$42" },
];
---

<section x-data="{ duration: 'monthly' }" class="bg-background">
  <div class="px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20">
    <div class="items-end grid grid-cols-1 lg:grid-cols-2">
      <div>
        <Text
          tag="h1"
          variant="displaySM"
          class="font-semibold tracking-tight text-foreground lg:text-balance"
        >
          Equip your business with world class software
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-2 font-medium text-muted-foreground lg:text-balance"
        >
          Choose a plan that works the best for you and your team. Start small,
          upgrade when you need to.
        </Text>
      </div>
      <div
        aria-labelledby="pricing-toggle"
        class="relative z-0 inline-flex justify-center w-full p-1 mx-auto mt-8 overflow-hidden bg-background shadow ring-1 ring-border ring-offset-2 gap-4 lg:mx-0 rounded-md max-w-52 ring-offset-background lg:ml-auto"
      >
        <div
          class="absolute inset-0 bg-muted rounded-md ring-1 ring-border/60 shadow-sm transition-transform duration-200 ease-in-out"
          :class="duration === 'monthly' ? 'w-1/2 translate-x-0' : 'w-1/2 translate-x-full'"
        >
        </div>
        <button
          class="relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300"
          :class="duration === 'monthly' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground focus:text-foreground'"
          @click="duration = 'monthly'"
          type="button"
          :aria-pressed="duration === 'monthly'"
        >
          Monthly
        </button>
        <button
          class="relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300"
          :class="duration === 'annual' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground focus:text-foreground'"
          @click="duration = 'annual'"
          type="button"
          :aria-pressed="duration === 'annual'"
        >
          Annual
        </button>
      </div>
    </div>
    <div class="flex flex-col mt-8 gap-2">
      <div
        class="p-4 overflow-hidden shadow bg-background outline outline-border rounded-xl"
      >
        <div class="grid md:grid-cols-12">
          <div class="p-4 md:col-span-7 sm:p-8">
            <div class="flex items-center gap-2">
              <Text
                tag="h2"
                variant="textLG"
                class="font-medium text-foreground"
              >
                AI Add-Ons —
                <span class="font-normal text-muted-foreground">
                  Oxbow UI gives your AI tools the upgrade they didn't know they
                  needed.
                </span>
              </Text>
            </div>
            <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-4">
              <div class="flex items-center text-sm gap-2">
                <div class="text-muted-foreground">
                  <Clock size="sm" />
                </div>
                <span class="text-muted-foreground">
                  <span class="font-medium text-foreground">30 day</span> model retention
                </span>
              </div>

              <div class="flex items-center text-sm gap-2">
                <div class="text-muted-foreground">
                  <Refresh size="base" />
                </div>
                <span class="text-muted-foreground">
                  <span class="font-medium text-foreground">5,000</span> AI calls/month
                </span>
              </div>

              <div class="flex items-center text-sm gap-2">
                <div class="text-muted-foreground">
                  <Database size="base" />
                </div>
                <span class="text-muted-foreground"
                  >Custom model rebuilding</span
                >
              </div>

              <div class="flex items-center text-sm gap-2">
                <div class="text-muted-foreground">
                  <Lifebuoy size="base" />
                </div>
                <span class="text-muted-foreground"
                  >Training validation included</span
                >
              </div>

              <div class="flex items-center text-sm gap-2">
                <div class="text-muted-foreground">
                  <Brain size="base" />
                </div>
                <span class="text-muted-foreground"
                  >Real-time inference feedback</span
                >
              </div>

              <div class="flex items-center text-sm gap-2">
                <div class="text-muted-foreground">
                  <Lock size="base" />
                </div>
                <span class="text-muted-foreground"
                  >One-click prompt tuning</span
                >
              </div>
            </div>

            <div class="flex mt-12 gap-2">
              <Button variant="default" size="sm"> Start Using AI </Button>
              <Button variant="muted" size="sm"> Get a Demo </Button>
            </div>
          </div>
          <div
            class="flex flex-col justify-between h-full bg-background md:col-span-5 outline outline-border rounded-xl"
          >
            <div class="p-4 grid grid-cols-2">
              <Text
                tag="h3"
                variant="textBase"
                class="font-semibold text-foreground">Monthly requests</Text
              >
              <Text
                tag="p"
                variant="textSM"
                class="font-semibold text-right text-muted-foreground"
                >Pricing</Text
              >
            </div>
            <div class="divide-y divide-border">
              {
                pricingTiers.map((tier) => (
                  <div class="p-4 grid grid-cols-2">
                    <div class="font-medium text-muted-foreground">
                      {tier.amount}
                    </div>
                    <div class="font-medium text-right text-foreground">
                      <Text
                        tag="p"
                        variant="textBase"
                        class="font-medium text-foreground"
                      >
                        <span
                          data-monthly={tier.monthly}
                          data-annual={tier.annual}
                          x-text="$el.dataset[duration]"
                        />
                        <span x-show="duration==='monthly'">/m</span>
                        <span
                          x-show="duration==='annual'"
                          style="display: none"
                        >
                          /m
                        </span>
                      </Text>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
      <div class="p-4 shadow bg-background outline outline-border rounded-xl">
        <div
          class="flex flex-col lg:flex-row gap-4 lg:justify-between lg:items-center"
        >
          <div class="flex flex-col items-start sm:flex-row gap-2">
            <div
              class="p-3 bg-background rounded-lg outline outline-border text-foreground"
            >
              <Plus size="base" />
            </div>
            <div>
              <Text
                tag="h2"
                variant="textLG"
                class="font-medium text-foreground">Enterprise</Text
              >
              <Text tag="p" variant="textSM" class="text-muted-foreground">
                Built for teams that move fast, break stuff, and need more
                firepower than your average startup plan allows.
              </Text>
            </div>
          </div>

          <Button variant="muted" size="sm"> Contact Us </Button>
        </div>
      </div>
    </div>
  </div>
</section>
