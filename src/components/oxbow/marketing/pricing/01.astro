---
export const description = "Pricing section with two tiers";
export const freeComponent = true;
export const excludeFromObfuscation = [
  "w-1/2",
  "translate-x-0",
  "translate-x-full",
  "text-muted-foreground",
  "text-foreground",
  "focus:text-foreground",
  "hover:text-foreground",
];
// Components
import Text from "@/components/fundations/typography/Text.astro";
import Button from "@/components/fundations/buttons/Button.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
import Lock from "@/components/fundations/icons/Lock.astro";
import Bulb from "@/components/fundations/icons/Bulb.astro";
import CircleCheck from "@/components/fundations/icons/CircleCheck.astro";
import ApiApp from "@/components/fundations/icons/ApiApp.astro";
import UserPlus from "@/components/fundations/icons/UserPlus.astro";
import UsersGroup from "@/components/fundations/icons/UsersGroup.astro";
import SettingsExclamation from "@/components/fundations/icons/SettingsExclamation.astro";
// Pricing array with direct icon components
const pricingOptions = [
  {
    id: "core",
    title: "Core",
    monthly: "$29.00",
    annual: "$19.00",
    description:
      "For solo builders, side project warriors, and anyone who just wants the essentials without the enterprise bloat.",
    button: {
      text: "Get Started",
      variant: "alternative",
    },
    features: [
      { icon: UsersGroup, text: "1 Teams" },
      { icon: SettingsExclamation, text: "50 issues" },
      { icon: UserPlus, text: "Unlimited members" },
      { icon: ApiApp, text: "Slack, GitHub, and API access" },
    ],
  },
  {
    id: "momentum",
    title: "Momentum",
    monthly: "$49.00",
    annual: "$39.00",
    description:
      "Perfect for growing teams that need more power, more flexibility, and fewer excuses to miss a deadline.",
    button: {
      text: "Get Started",
      variant: "oxbowDefault",
    },
    features: [
      { icon: Plus, text: "All Core plan features" },
      { icon: Bulb, text: "Insights" },
      { icon: UserPlus, text: "Unlimited teams" },
      { icon: Lock, text: "Private teams and guest" },
    ],
  },
];
---

<section x-data="{ duration: 'monthly' }" class="bg-background">
  <div class="px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20">
    <div class="max-w-md mx-auto text-center">
      <Text
        tag="h1"
        variant="displayMD"
        class="font-semibold tracking-tight text-foreground text-balance"
      >
        Give your team tools that don't suck
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="mt-2 font-medium text-muted-foreground text-balance"
      >
        Start with what you need, skip what you don't. Scale up when
        spreadsheets stop cutting it.
      </Text>
      <!-- Pricing Toggle -->
      <div
        aria-labelledby="pricing-toggle"
        class="relative z-0 inline-flex justify-center w-full p-1 mx-auto mt-8 overflow-hidden bg-background shadow ring-1 ring-border ring-offset-2 gap-4 lg:mx-0 rounded-md max-w-52 ring-offset-background"
      >
        <div
          class="absolute inset-0 bg-muted rounded-md ring-1 ring-border/60 shadow-sm transition-transform duration-200 ease-in-out"
          :class="duration === 'monthly' ? 'w-1/2 translate-x-0' : 'w-1/2 translate-x-full'"
        >
        </div>
        <button
          class="relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300"
          :class="duration === 'monthly' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground focus:text-foreground'"
          @click="duration = 'monthly'"
          type="button"
          :aria-pressed="duration === 'monthly'"
        >
          Monthly
        </button>
        <button
          class="relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300"
          :class="duration === 'annual' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground focus:text-foreground'"
          @click="duration = 'annual'"
          type="button"
          :aria-pressed="duration === 'annual'"
        >
          Annual
        </button>
      </div>
    </div>
    <!-- Pricing Cards -->
    <div class="max-w-2xl mx-auto mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        pricingOptions.map((tier) => (
          <div class="flex flex-col justify-between h-full p-8 shadow bg-background outline outline-border rounded-xl">
            <div>
              <div class="flex flex-col">
                <Text
                  tag="h3"
                  variant="textBase"
                  class="font-medium text-foreground"
                >
                  {tier.title}
                </Text>
                <Text
                  variant="displaySM"
                  class="flex items-baseline mt-4 font-medium tracking-tighter text-foreground"
                >
                  <span
                    data-monthly={tier.monthly}
                    data-annual={tier.annual}
                    x-text="$el.dataset[duration]"
                  />
                  <span class="text-sm font-normal tracking-normal text-muted-foreground">
                    <span x-show="duration === 'monthly'">/month</span>
                    <span x-show="duration === 'annual'" style="display: none;">
                      /annually
                    </span>
                  </span>
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  class="mt-2 text-muted-foreground"
                >
                  {tier.description}
                </Text>
                <div class="w-full mt-4">
                  <Button
                    class="w-full"
                    variant={
                      tier.button.variant as
                        | "alternative"
                        | "accent"
                        | "default"
                        | "link"
                        | "oxbowDefault"
                        | "oxbowMuted"
                        | "oxbowAccent"
                        | "oxbowOutline"
                        | "accentDark"
                        | "muted"
                        | "text"
                        | "outline"
                        | "ghost"
                    }
                    size="sm"
                  >
                    {tier.button.text}
                  </Button>
                </div>
              </div>
              <div class="mt-8">
                <Text
                  tag="p"
                  variant="textXS"
                  class="font-medium uppercase text-muted-foreground"
                >
                  {tier.title === "Momentum"
                    ? "Everything in Core plus:"
                    : "Core plan includes:"}
                </Text>
                <ul
                  class="flex flex-col mt-4 text-sm text-muted-foreground gap-y-3"
                  role="list"
                >
                  {tier.features.map((feature, index) => (
                    <li class="flex items-center gap-2">
                      <feature.icon size="sm" />
                      <span>{feature.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <div class="flex items-center pt-4 mt-4 border-t gap-2 border-border">
              <CircleCheck size="sm" class="text-muted-foreground" />
              <Text
                tag="p"
                variant="textSM"
                class="font-medium text-muted-foreground"
              >
                No credit card required
              </Text>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
