---
import Button from "@/components/fundations/buttons/Button.astro";
import Text from "@/components/fundations/typography/Text.astro";
---

<section class="bg-background">
  <div class="px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20">
    <div class="max-w-2xl lg:text-balance">
      <Text
        tag="h2"
        variant="displayMD"
        class="font-semibold tracking-tight text-foreground lg:text-balance"
      >
        Empower your finances with our unmatched value
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="mt-2 font-medium text-muted-foreground"
      >
        Experience low fees, unwavering commitment, and massive earnings with a
        service trusted by over 60 million users.
      </Text>
    </div>
    <div class="flex flex-wrap items-center mt-8 gap-2 lg:ml-auto">
      <Button variant="default" size="sm"> Get started </Button>
      <Button variant="muted" size="sm"> Learn more </Button>
    </div>
    <div class="items-end grid grid-cols-1 md:grid-cols-3 gap-6">
      <div
        class="flex flex-col justify-between shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl lg:gap-12"
      >
        <div class="order-last w-full p-8 border-t border-border">
          <Text
            tag="p"
            variant="display2XL"
            class="font-mono font-medium text-foreground"
          >
            30%
          </Text>
        </div>
        <div class="p-8 sm:shrink lg:flex-none">
          <Text tag="h3" variant="textBase" class="font-medium text-foreground">
            Working Individuals
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="mt-2 font-medium text-muted-foreground"
          >
            We’re dedicated to delivering outstanding service and value.
          </Text>
        </div>
      </div>
      <div
        class="flex flex-col justify-between shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl lg:gap-28"
      >
        <div class="order-last w-full p-8 border-t border-border">
          <Text
            tag="p"
            variant="display2XL"
            class="font-mono font-medium text-foreground"
          >
            90%
          </Text>
        </div>
        <div class="p-8 sm:shrink lg:flex-none">
          <Text tag="h3" variant="textBase" class="font-medium text-foreground">
            Massive Earnings
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="mt-2 font-medium text-muted-foreground"
          >
            Reap the benefits with substantial returns.
          </Text>
        </div>
      </div>
      <div
        class="flex flex-col justify-between shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl lg:gap-44"
      >
        <div class="order-last w-full p-8 border-t border-border">
          <Text
            tag="p"
            variant="display2XL"
            class="font-mono font-medium text-foreground"
          >
            8%
          </Text>
        </div>
        <div class="p-8 sm:shrink lg:flex-none">
          <Text tag="h3" variant="textBase" class="font-medium text-foreground">
            Super low fee
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="mt-2 font-medium text-muted-foreground"
          >
            Enjoy significant savings with our extremely low fee structure.
          </Text>
        </div>
      </div>
    </div>
  </div>
</section>
