---
import Text from "@/components/fundations/typography/Text.astro";
import Kicker from "@/components/fundations/typography/Kicker.astro";
---

<section class="bg-background">
  <div class="px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20">
    <div class="h-full grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
      <div
        class="relative flex flex-col justify-between h-full overflow-hidden shadow bg-background outline outline-border rounded-xl"
      >
        <div class="relative p-8">
          <Kicker> Integration </Kicker>
          <Text
            tag="h3"
            variant="textBase"
            class="mt-4 font-medium text-foreground"
          >
            Connect with ease
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="mt-2 font-medium text-muted-foreground"
          >
            Effortlessly link your favorite tools and platforms for a truly
            unified workflow.
          </Text>
        </div>
        <div class="mx-8 -bottom-2 -right-8">
          <img
            class="w-full h-full shadow rounded-t-xl"
            src="/widgets/sliders.svg"
            alt=""
          />
        </div>
      </div>
      <div
        class="relative flex flex-col justify-between h-full overflow-hidden shadow bg-background outline outline-border rounded-xl"
      >
        <div class="relative p-8">
          <Kicker> Planning </Kicker>
          <Text
            tag="h3"
            variant="textBase"
            class="mt-4 font-medium text-foreground"
          >
            Plan your day
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="mt-2 font-medium text-muted-foreground"
          >
            Stay organized and ahead with smart scheduling and automated
            reminders for every task.
          </Text>
        </div>
        <div class="mx-8 -bottom-2 -right-8">
          <img
            class="w-full h-full shadow rounded-t-xl"
            src="/widgets/calendar.svg"
            alt=""
          />
        </div>
      </div>
      <div
        class="relative flex flex-col justify-between h-full overflow-hidden shadow bg-background outline outline-border rounded-xl"
      >
        <div class="relative p-8">
          <Kicker> Features </Kicker>
          <Text
            tag="h3"
            variant="textBase"
            class="mt-4 font-medium text-foreground"
          >
            Powerful features
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="mt-2 font-medium text-muted-foreground"
          >
            Unlock advanced capabilities to streamline your processes and boost
            productivity every step of the way.
          </Text>
        </div>
        <div class="mx-8 -bottom-2 -right-8">
          <img
            class="w-full h-full shadow rounded-t-xl"
            src="/widgets/progressCircles.svg"
            alt=""
          />
        </div>
      </div>
    </div>
    <div class="h-full mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
      <div
        class="relative flex flex-col justify-center h-full overflow-hidden shadow bg-background outline outline-border rounded-xl"
      >
        <div class="relative p-8">
          <Kicker> Sync </Kicker>
          <Text
            tag="h3"
            variant="textBase"
            class="mt-4 font-medium text-foreground"
          >
            Always in sync
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="mt-2 font-medium text-muted-foreground"
          >
            All your changes are saved automatically, so you never lose your
            progress or momentum.
          </Text>
        </div>
      </div>
      <div
        class="relative flex flex-col justify-center h-full overflow-hidden shadow bg-background outline outline-border rounded-xl"
      >
        <div class="relative p-8">
          <Kicker> Navigation </Kicker>
          <Text
            tag="h3"
            variant="textBase"
            class="mt-4 font-medium text-foreground"
          >
            Effortless navigation
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="mt-2 font-medium text-muted-foreground"
          >
            Instantly find what you need and customize your workspace with
            intuitive controls and shortcuts.
          </Text>
        </div>
      </div>
    </div>
  </div>
</section>
