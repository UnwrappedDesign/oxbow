---
import Text from "@/components/fundations/typography/Text.astro";
const history = [
  {
    title: "Create your account",
    copy: `Sign up in seconds with your email and password to get started.`,
  },
  {
    title: "Verify your identity",
    copy: `Secure your account by confirming your details with a quick ID upload.`,
  },
  {
    title: "Connect your bank",
    copy: `Link your bank in a few clicks to manage all your finances seamlessly.`,
  },
  {
    title: "Explore features",
    copy: `Dive into our tools and insights to optimize your financial journey.`,
  },
];
---

<section class="bg-background">
  <div class="px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20">
    <div class="max-w-xl mx-auto">
      <Text
        tag="h2"
        variant="displayMD"
        class="font-semibold tracking-tight text-foreground text-balance"
      >
        Get set up in four simple steps
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="mt-2 font-medium text-muted-foreground"
      >
        Complete these quick steps to launch your account and start managing
        your finances in no time.
      </Text>
    </div>
    <div class="relative max-w-xl mx-auto mt-12">
      <div
        data-orientation="vertical"
        class="shrink-0 data-[orientation=horizontal]:h-px data-[orientation=horizontal]:w-full data-[orientation=vertical]:h-full data-[orientation=vertical]:w-px bg-background absolute left-2 top-0"
      >
      </div>
      <div class="relative max-w-xl mx-auto space-y-4">
        {
          history.map((item, index) => (
            <div class="relative pl-8">
              <div class="absolute top-0 flex items-center justify-center rounded-full bg-background -left-2 size-4">
                <span class="text-sm font-medium text-foreground">
                  {index + 1}
                </span>
              </div>
              <div class="p-4 ml-8 shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl">
                <Text
                  tag="h3"
                  variant="textBase"
                  class="font-semibold tracking-tight text-foreground"
                >
                  {item.title}
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-muted-foreground lg:text-balance"
                >
                  {item.copy}
                </Text>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
