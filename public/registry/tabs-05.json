    {
      "name": "05.astro",
      "path": "oxbow/application/tabs/05.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"bg-muted\",\n  \"text-muted-foreground\",\n  \"border-b\",\n  \"bg-muted\",\n];\n---\n\n<div class=\"flex flex-col justify-center p-12 mx-auto bg-background\">\n  <!-- Accessible Tabs • Full-width sliding underline -->\n  <div\n    x-data=\"{\n      keys: ['overview','projects','packages'],\n      selected: 'overview',\n      focus: 0,\n      init(){ this.focus = 0 },\n      select(id){ this.selected = id; this.focus = this.keys.indexOf(id) },\n      onKeydown(e){\n        const last = this.keys.length - 1\n        let i = this.focus\n        if (e.key==='ArrowRight' || e.key==='ArrowDown') i = i===last?0:i+1\n        else if (e.key==='ArrowLeft' || e.key==='ArrowUp') i = i===0?last:i-1\n        else if (e.key==='Home') i = 0\n        else if (e.key==='End') i = last\n        else return\n        e.preventDefault()\n        const id = this.keys[i]\n        this.focus = i\n        this.$nextTick(()=>this.$refs['tab-'+id]?.focus())\n      }\n    }\"\n    class=\"w-full max-w-xl mx-auto\"\n  >\n    <div\n      class=\"relative border-b border-border\"\n      role=\"tablist\"\n      aria-orientation=\"horizontal\"\n    >\n      <div\n        class=\"text-sm grid grid-cols-3 text-foreground\"\n      >\n        <template x-for=\"(id, idx) in keys\" :key=\"id\">\n          <button\n            class=\"py-2 font-medium text-center focus:outline-none focus-visible:ring-2 focus-visible:ring-border\"\n            :id=\"'tab-'+id\"\n            role=\"tab\"\n            :aria-selected=\"selected===id\"\n            :tabindex=\"focus===idx ? 0 : -1\"\n            :aria-controls=\"'panel-'+id\"\n            x-ref=\"tab-[[id]]\"\n            @click=\"select(id)\"\n            @keydown=\"onKeydown($event)\"\n            :class=\"selected===id ? 'text-muted-foreground' : 'hover:text-foreground'\"\n          >\n            <span\n              x-text=\"id==='overview' ? 'Overview' : id==='projects' ? 'Projects' : 'Packages'\"\n            ></span>\n          </button>\n        </template>\n      </div>\n      <div class=\"absolute left-0 bottom-0 h-[2px] w-full\">\n        <div\n          class=\"h-full bg-muted transition-all duration-300\"\n          :style=\"{ width: (100/keys.length)+'%', left: (100/keys.length)*focus+'%' }\"\n        >\n        </div>\n      </div>\n    </div>\n    <div class=\"pt-4 text-sm text-muted-foreground\">\n      <section\n        x-show=\"selected==='overview'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-overview'\"\n        aria-labelledby=\"tab-overview\"\n      >\n        <p>Overview content — metrics and quick navigation.</p>\n      </section>\n      <section\n        x-show=\"selected==='projects'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-projects'\"\n        aria-labelledby=\"tab-projects\"\n      >\n        <p>Projects content — tasks, lists, and ownership.</p>\n      </section>\n      <section\n        x-show=\"selected==='packages'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-packages'\"\n        aria-labelledby=\"tab-packages\"\n      >\n        <p>Packages content — builds, releases, and release notes.</p>\n      </section>\n    </div>\n  </div>\n</div>\n"
    }
  ],
