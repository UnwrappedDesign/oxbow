      "content": "---\nexport const freeComponent = true;\nexport const excludeFromObfuscation = [\"flex\", \"hidden\"];\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport Burger from \"@/components/fundations/icons/Burger.astro\";\nimport Logo from \"@/components/assets/Logo.astro\";\n---\n\n<!-- copy:start -->\n<header\n  class=\"w-full bg-background border-b border-border\"\n>\n  <!-- Utility bar -->\n  <div\n    class=\"hidden border-b md:block border-border bg-background/60\"\n  >\n    <div\n      class=\"flex items-center justify-between px-6 mx-auto text-xs max-w-screen-xl md:px-10 lg:px-16 h-9 text-muted-foreground\"\n    >\n      <div class=\"flex items-center gap-2\">\n        <span\n          >Contact:\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textXS\"\n            class=\"font-medium text-muted-foreground hover:text-foreground\"\n            >hello@acme.com</Text\n          ></span\n        >\n        <span aria-hidden class=\"w-px h-3 bg-muted\"></span>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXs\"\n          class=\"font-medium text-muted-foreground hover:text-foreground\"\n          >Support</Text\n        >\n      </div>\n      <div class=\"flex items-center gap-3\">\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXs\"\n          class=\"font-medium text-muted-foreground hover:text-foreground\"\n          >Status</Text\n        >\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXS\"\n          class=\"font-medium text-muted-foreground hover:text-foreground\"\n          >Docs</Text\n        >\n      </div>\n    </div>\n  </div>\n  <!-- Main bar -->\n  <div\n    x-data=\"{ open:false }\"\n    class=\"px-6 mx-auto max-w-screen-xl md:px-10 lg:px-16\"\n  >\n    <div class=\"flex items-center justify-between h-14 gap-3\">\n      <a href=\"#_\" class=\"inline-flex items-center gap-2\"\n        ><Logo class=\"text-foreground h-7\" /><span class=\"sr-only\"\n          >Home</span\n        ></a\n      >\n      <nav\n        id=\"nav-05\"\n        aria-label=\"Primary\"\n        class=\"items-center hidden ml-auto md:flex gap-4\"\n      >\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground hover:text-foreground\"\n          >Overview</Text\n        >\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground hover:text-foreground\"\n          >Products</Text\n        >\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground hover:text-foreground\"\n          >Pricing</Text\n        >\n      </nav>\n      <div class=\"items-center hidden md:flex gap-4\">\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground hover:text-foreground\"\n          >Sign in</Text\n        >\n        <Button variant=\"muted\" size=\"xs\">Create account</Button>\n        <Button variant=\"default\" size=\"xs\">Create account</Button>\n      </div>\n      <IconButton\n        class=\"md:hidden\"\n        @click=\"open=!open\"\n        :aria-expanded=\"open\"\n        aria-controls=\"nav-05m\"\n        variant=\"muted\"\n        size=\"xs\"\n      >\n        <Burger size=\"xs\" slot=\"icon\" />\n      </IconButton>\n    </div>\n    <div\n      id=\"nav-05m\"\n      :class=\"{ 'grid': open, 'hidden': !open }\"\n      class=\"hidden pb-4 grid-cols-1 gap-2 md:hidden\"\n    >\n      <Button variant=\"muted\" size=\"xs\">Overview</Button>\n      <Button variant=\"muted\" size=\"xs\">Products</Button>\n      <Button variant=\"muted\" size=\"xs\">Pricing</Button>\n      <Button variant=\"muted\" size=\"xs\">Sign in</Button>\n      <Button variant=\"default\" size=\"xs\">Create</Button>\n    </div>\n  </div>\n</header>\n<!-- copy:end -->\n"
    }
