      "name": "04.astro",
      "path": "oxbow/application/tabs/04.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"border-l-2\",\n  \"border-base-600\",\n  \"text-base-600\",\n  \"bg-base-50\",\n];\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-white \">\n  <!-- Accessible Tabs • Vertical sidebar style -->\n  <div\n    x-data=\"{\n      keys: ['overview','projects','packages'],\n      selected: 'overview',\n      focus: 0,\n      init(){ this.focus = 0; },\n      select(id){ this.selected = id; this.focus = this.keys.indexOf(id); },\n      onKeydown(e){\n        const last = this.keys.length - 1;\n        let i = this.focus;\n        if (e.key==='ArrowDown'){ i = i === last ? 0 : i+1; }\n        else if (e.key==='ArrowUp'){ i = i === 0 ? last : i-1; }\n        else if (e.key==='Home'){ i = 0; }\n        else if (e.key==='End'){ i = last; }\n        else { return; }\n        e.preventDefault();\n        const id = this.keys[i];\n        this.focus = i;\n        this.$nextTick(() => this.$refs['tab-'+id]?.focus());\n      }\n    }\"\n    class=\"w-full max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12\"\n  >\n    <div>\n      <div\n        role=\"tablist\"\n        aria-orientation=\"vertical\"\n        class=\"flex md:flex-col gap-1\"\n      >\n        <template x-for=\"(id, idx) in keys\" :key=\"id\">\n          <button\n            class=\"w-full px-3 py-2 text-sm font-medium text-left rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-base-500/50\"\n            :id=\"'tab-'+id\"\n            role=\"tab\"\n            :aria-selected=\"selected===id\"\n            :tabindex=\"focus===idx ? 0 : -1\"\n            :aria-controls=\"'panel-'+id\"\n            x-ref=\"tab-[[id]]\"\n            @click=\"select(id)\"\n            @keydown=\"onKeydown($event)\"\n            :class=\"selected===id ? 'bg-base-50 text-base-600 md:pl-2' : 'text-base-600 hover:text-base-900 '\"\n          >\n            <span\n              x-text=\"id==='overview' ? 'Overview' : id==='projects' ? 'Projects' : 'Packages'\"\n            ></span>\n          </button>\n        </template>\n      </div>\n    </div>\n    <div class=\"text-sm text-base-500 md:col-span-2\">\n      <section\n        x-show=\"selected==='overview'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-overview'\"\n        aria-labelledby=\"tab-overview\"\n      >\n        <p>Overview content — KPIs and health checks.</p>\n      </section>\n      <section\n        x-show=\"selected==='projects'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-projects'\"\n        aria-labelledby=\"tab-projects\"\n      >\n        <p>Projects content — roadmaps and planning.</p>\n      </section>\n      <section\n        x-show=\"selected==='packages'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-packages'\"\n        aria-labelledby=\"tab-packages\"\n      >\n        <p>Packages content — deployment channels and permissions.</p>\n      </section>\n    </div>\n  </div>\n</div>\n"
    }
  ],
