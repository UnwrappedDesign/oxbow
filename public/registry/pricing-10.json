  "files": [
    {
      "name": "10.astro",
      "path": "oxbow/marketing/pricing/10.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"w-1/2\",\n  \"translate-x-0\",\n  \"translate-x-full\",\n  \"text-muted-foreground\",\n  \"text-foreground\",\n  \"focus:text-foreground\",\n  \"hover:text-foreground\",\n];\n\nexport const description = \"Pricing section with two  columns comparison table\";\n\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Wrapper from \"@/components/fundations/containers/Wrapper.astro\";\n// Icons\nimport Badge from \"@/components/fundations/badges/Badge.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\nimport CircleX from \"@/components/fundations/icons/CircleX.astro\";\nimport Analytics from \"@/components/fundations/icons/Analytics.astro\";\nimport UserPlus from \"@/components/fundations/icons/UserPlus.astro\";\nimport Lifebuoy from \"@/components/fundations/icons/Lifebuoy.astro\";\nimport Refresh from \"@/components/fundations/icons/Refresh.astro\";\nimport Brain from \"@/components/fundations/icons/Brain.astro\";\nimport ArrowIteration from \"@/components/fundations/icons/ArrowIteration.astro\";\nimport Code from \"@/components/fundations/icons/Code.astro\";\nimport Tools from \"@/components/fundations/icons/Tools.astro\";\n\n// Components\nimport PricingToggle from \"@/components/fundations/buttonGroups/PricingToggle.astro\";\n---\n\n<section x-data=\"{ duration: 'monthly' }\" class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <p class=\"text-center text-muted-foreground lg:hidden\">\n      Pricing table for desktop use\n    </p>\n    <!---- Use only from xl: -->\n    <div class=\"hidden lg:block\">\n      <div class=\"flex flex-col max-w-sm text-center md:text-left\">\n        <Text\n          tag=\"h1\"\n          variant=\"displayMD\"\n          class=\"font-semibold tracking-tight text-foreground text-balance\"\n        >\n          Equip your business with great software\n        </Text>\n        <div\n          aria-labelledby=\"pricing-toggle\"\n          class=\"relative z-0 inline-flex w-full p-1 mx-auto mt-8 ml-auto overflow-hidden bg-background shadow justify-right ring-1 ring-border ring-offset-2 gap-4 lg:mx-0 rounded-md max-w-52 ring-offset-background\"\n        >\n          <div\n            class=\"absolute inset-0 bg-muted rounded-md ring-1 ring-border/60 shadow-sm transition-transform duration-200 ease-in-out\"\n            :class=\"duration === 'monthly' ? 'w-1/2 translate-x-0' : 'w-1/2 translate-x-full'\"\n          >\n          </div>\n          <button\n            class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n            :class=\"duration === 'monthly' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground focus:text-foreground'\"\n            @click=\"duration = 'monthly'\"\n            type=\"button\"\n            :aria-pressed=\"duration === 'monthly'\"\n          >\n            Monthly\n          </button>\n          <button\n            class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n            :class=\"duration === 'annual' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground focus:text-foreground'\"\n            @click=\"duration = 'annual'\"\n            type=\"button\"\n            :aria-pressed=\"duration === 'annual'\"\n          >\n            Annual\n          </button>\n        </div>\n      </div>\n      <table class=\"w-full mt-8 text-center bg-transparent mx-autom\">\n        <thead>\n          <tr class=\"align-top\">\n            <th class=\"w-1/3\"></th>\n            <th class=\"relative w-1/3 p-1 pr-0 font-normal text-left\">\n              <div\n                aria-hidden=\"true\"\n                class=\"absolute inset-y-0 right-0 hidden w-full bg-background rounded-tl-xl sm:block\"\n              >\n              </div>\n              <div class=\"relative p-6 sm:p-4 sm:pb-5 lg:p-6\">\n                <div class=\"flex items-start justify-between w-full\">\n                  <div>\n                    <Text\n                      tag=\"h3\"\n                      variant=\"textBase\"\n                      class=\"font-semibold text-foreground\"\n                    >\n                      Core\n                    </Text>\n                    <Text\n                      tag=\"p\"\n                      variant=\"textSM\"\n                      class=\"mt-1 text-muted-foreground\"\n                    >\n                      This subscription tier caters to individuals.\n                    </Text>\n                  </div>\n                </div>\n                <div class=\"mt-8\">\n                  <p\n                    class=\"text-4xl font-medium sm:text-xl md:text-4xl text-foreground\"\n                  >\n                  </p>\n                  <div class=\"flex items-center gap-x-4\">\n                    <p\n                      class=\"text-4xl font-medium sm:text-xl md:text-4xl text-foreground\"\n                    >\n                      <span\n                        data-monthly=\"$29\"\n                        data-annual=\"$19\"\n                        x-text=\"$el.dataset[duration]\"></span>\n                    </p>\n                    <div class=\"text-xs font-medium capitalize text-foreground\">\n                      <span x-show=\"duration === 'monthly'\">\n                        <span x-show=\"duration === 'monthly'\">\n                          month</span\n                        ></span\n                      >\n                      <span\n                        x-show=\"duration === 'annual'\"\n                        style=\"display: none;\"\n                      >\n                        annually</span\n                      >\n                      <Text\n                        tag=\"p\"\n                        variant=\"textXS\"\n                        class=\"text-muted-foreground\">USD + Local taxes</Text\n                      >\n                    </div>\n                  </div>\n                  <div class=\"mt-8\">\n                    <Button class=\"w-full\" variant=\"default\" size=\"sm\">\n                      Get Started\n                    </Button>\n                  </div>\n                </div>\n              </div>\n            </th>\n            <th class=\"relative w-1/3 p-1 pl-0 font-normal text-left\">\n              <div\n                aria-hidden=\"true\"\n                class=\"absolute inset-y-0 right-0 hidden w-full bg-muted rounded-tr-xl sm:block\"\n              >\n              </div>\n              <div class=\"relative p-6 sm:p-4 sm:pb-5 lg:p-6\">\n                <div class=\"flex items-start justify-between w-full\">\n                  <div>\n                    <Text\n                      tag=\"h3\"\n                      variant=\"textBase\"\n                      class=\"font-semibold text-foreground\"\n                    >\n                      Momentum\n                    </Text>\n                    <Text\n                      tag=\"p\"\n                      variant=\"textSM\"\n                      class=\"mt-1 text-muted-foreground\"\n                    >\n                      Designed for businesses.\n                    </Text>\n                  </div>\n                  <Badge variant=\"muted\" size=\"xs\"> Popular </Badge>\n                </div>\n                <div class=\"mt-8\">\n                  <div class=\"flex items-center gap-x-4\">\n                    <p\n                      class=\"text-4xl font-medium text-foreground sm:text-xl md:text-4xl\"\n                    >\n                      <span\n                        data-monthly=\"$49\"\n                        data-annual=\"$39\"\n                        x-text=\"$el.dataset[duration]\"></span>\n                    </p>\n                    <div class=\"text-xs font-medium capitalize text-foreground\">\n                      <span x-show=\"duration === 'monthly'\">\n                        <span x-show=\"duration === 'monthly'\">\n                          month</span\n                        ></span\n                      >\n                      <span\n                        x-show=\"duration === 'annual'\"\n                        style=\"display: none;\"\n                      >\n                        annually</span\n                      >\n                      <Text\n                        tag=\"p\"\n                        variant=\"textXS\"\n                        class=\"text-muted-foreground\">USD + Local taxes</Text\n                      >\n                    </div>\n                  </div>\n                  <div class=\"mt-8\">\n                    <Button class=\"w-full\" variant=\"default\" size=\"sm\">\n                      Get Started\n                    </Button>\n                  </div>\n                </div>\n              </div>\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Analytics size=\"sm\" />\n                Analytics\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t border-border bg-background text-foreground\"\n              >3</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t border-border text-foreground bg-muted\"\n              >10</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n            >\n              <div class=\"flex items-center gap-2\">\n                <UserPlus size=\"sm\" />Accounts\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t border-border bg-background text-foreground\"\n              >5</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t border-border text-foreground bg-muted\"\n              >10</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n            >\n              <div class=\"flex items-center gap-2\">\n                <ArrowIteration size=\"sm\" />Integrations\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t border-border bg-background text-foreground\"\n              >2</td\n            >\n            <td\n              class=\"px-2 border-t border-border text-foreground bg-muted\"\n            >\n              <CircleCheck size=\"sm\" class=\"mx-auto\" />\n            </td>\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Brain size=\"sm\" />Programs\n              </div>\n            </th>\n            <td\n              class=\"px-2 border-t border-border bg-background text-foreground\"\n            >\n              <CircleX size=\"sm\" class=\"mx-auto\" />\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t border-border text-foreground bg-muted\"\n              >1</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Refresh size=\"sm\" />Deployments\n              </div>\n            </th>\n            <td\n              class=\"px-2 border-t border-border bg-background text-foreground\"\n            >\n              <CircleX size=\"sm\" class=\"mx-auto\" />\n            </td>\n            <td\n              class=\"px-2 border-t border-border text-foreground bg-muted\"\n            >\n              <CircleCheck size=\"sm\" class=\"mx-auto\" />\n            </td>\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Code size=\"sm\" />Advanced Checkpoints\n              </div>\n            </th>\n            <td\n              class=\"px-2 border-t border-border bg-background text-foreground\"\n            >\n              <CircleX size=\"sm\" class=\"mx-auto\" />\n            </td>\n            <td\n              class=\"px-2 border-t border-border text-foreground bg-muted\"\n            >\n              <CircleCheck size=\"sm\" class=\"mx-auto\" />\n            </td>\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Tools size=\"sm\" />Reporting tools\n              </div>\n            </th>\n            <td\n              class=\"px-2 border-t border-border bg-background text-foreground\"\n            >\n              <CircleX size=\"sm\" class=\"mx-auto\" />\n            </td>\n            <td\n              class=\"px-2 border-t border-border text-foreground bg-muted\"\n            >\n              <CircleCheck size=\"sm\" class=\"mx-auto\" />\n            </td>\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n              ><div class=\"flex items-center gap-2\">\n                <Lifebuoy size=\"sm\" />Support\n              </div></th\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t border-border bg-background text-foreground\"\n              >Discord community</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t border-border text-foreground bg-muted\"\n              >Live chat</td\n            >\n          </tr>\n          <tr class=\"align-top\">\n            <th class=\"border-t border-border\"></th>\n            <th\n              class=\"w-1/4 px-2 py-6 border-t border-border bg-background rounded-bl-xl\"\n            >\n            </th>\n            <th\n              class=\"w-1/4 px-2 py-6 border-t rounded-br-xl border-border bg-background\"\n            >\n            </th>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</section>\n"
    }
  ],
