{
  "name": "timeline-01",
  "type": "component",
  "description": "timeline block 01",
  "category": "marketing",
  "section": "timeline",
  "variant": 1,
  "aliases": [
    "timeline",
    "timeline 1",
    "timeline 01"
  ],
  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/marketing/timeline/01.astro",
      "content": "---\nexport const freeComponent = true;\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\n// Timeline events data\nconst events = [\n  {\n    date: \"01.08.2025\",\n    title: \"The dawn of version 3.0.0\",\n    description:\n      \"This monumental update unveils a revamped interface, AI-powered tools, and seamless app integrations.\",\n  },\n  {\n    date: \"01.09.2025\",\n    title: \"Version 3.1.0: The Cosmic Leap\",\n    description:\n      \"Experience faster processing, enhanced customization, and stellar-themed visual enhancements.\",\n  },\n  {\n    date: \"02.15.2025\",\n    title: \"Launch of Version 4.0\",\n    description:\n      \"Introducing Version 4.0 with AI-driven insights and real-time analytics for smarter decision-making.\",\n  },\n  {\n    date: \"06.30.2025\",\n    title: \"Release of Version 4.1: Ubiquitous AI\",\n    description:\n      \"Experience AI at every touchpoint with new integrations, performance boosts, and expanded features.\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <div class=\"max-w-xl mx-auto text-center lg:text-balance\">\n      <Kicker> Tagline </Kicker>\n      <Text\n        tag=\"h2\"\n        variant=\"displayMD\"\n        class=\"mt-4 font-semibold tracking-tight text-foreground\"\n      >\n        Product milestones & launches\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-4 font-medium text-muted-foreground\"\n      >\n        Trace our journey from the inaugural release through every major feature\n        update.\n      </Text>\n    </div>\n    <div class=\"flex flex-col mx-auto mt-12 grid-cols-9 md:grid\">\n      {\n        events.map((item, idx) =>\n          idx % 2 === 0 ? (\n            <div class=\"flex flex-row-reverse md:contents\">\n              <div class=\"my-4 ml-auto col-start-1 col-end-5\">\n                <div class=\"relative p-4 shadow size-full bg-linear-180 outline outline-border from-muted to-background rounded-xl\">\n                  <Kicker>\n                    <time datetime={item.date}>{item.date}</time>\n                  </Kicker>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textBase\"\n                    class=\"mt-4 font-semibold tracking-tight text-foreground\"\n                  >\n                    {item.title}\n                  </Text>\n                  <Text\n                    tag=\"p\"\n                    variant=\"textSM\"\n                    class=\"mt-2 text-muted-foreground lg:text-balance\"\n                  >\n                    {item.description}\n                  </Text>\n                </div>\n              </div>\n              <div class=\"relative mr-10 col-start-5 col-end-6 md:mx-auto\">\n                <div class=\"flex items-center justify-center w-3 h-full\">\n                  <div class=\"h-full w-[0.05rem] bg-border pointer-events-none\" />\n                </div>\n                <div class=\"absolute -mt-3 rounded-full size-3 outline-2 outline-border bg-muted top-1/2\" />\n              </div>\n            </div>\n          ) : (\n            <div class=\"flex md:contents\">\n              <div class=\"relative mr-10 col-start-5 col-end-6 md:mx-auto\">\n                <div class=\"flex items-center justify-center w-3 h-full\">\n                  <div class=\"h-full w-[0.05rem] bg-border pointer-events-none\" />\n                </div>\n                <div class=\"absolute -mt-3 rounded-full size-3 outline-2 outline-border bg-muted top-1/2\" />\n              </div>\n              <div class=\"my-4 mr-auto col-start-6 col-end-10\">\n                <div class=\"relative p-4 shadow size-full bg-linear-180 outline outline-border from-muted to-background rounded-xl\">\n                  <Kicker>\n                    <time datetime={item.date}>{item.date}</time>\n                  </Kicker>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textBase\"\n                    class=\"mt-4 font-semibold tracking-tight text-foreground\"\n                  >\n                    {item.title}\n                  </Text>\n                  <Text\n                    tag=\"p\"\n                    variant=\"textSM\"\n                    class=\"mt-2 text-muted-foreground lg:text-balance\"\n                  >\n                    {item.description}\n                  </Text>\n                </div>\n              </div>\n            </div>\n          ),\n        )\n      }\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
