      "name": "09.astro",
      "path": "oxbow/application/emptyStates/09.astro",
      "content": "---\nexport const description = \"Task Management Empty State\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<div\n  class=\"flex items-center justify-center p-8 py-24 bg-white \"\n>\n  <!-- copy:start -->\n  <div class=\"text-center\">\n    <div class=\"flex items-center justify-between\">\n      <Text tag=\"h3\" variant=\"textSM\" class=\"font-medium \"\n        >My tasks</Text\n      >\n      <Button size=\"xs\" variant=\"muted\"> Add Task </Button>\n    </div>\n    <div class=\"mt-2 grid grid-cols-1 lg:grid-cols-3 gap-2\">\n      <div class=\"flex flex-col p-4 bg-base-50 rounded-xl\">\n        <Text\n          tag=\"h3\"\n          variant=\"textSM\"\n          class=\"font-medium text-destructive/88 \">To do</Text\n        >\n\n        <Text\n          tag=\"p\"\n          variant=\"textXS\"\n          class=\"mt-12 text-center text-base-400 \"\n          >No tasks yet</Text\n        >\n      </div>\n      <div class=\"flex flex-col p-4 bg-base-50 rounded-xl\">\n        <Text\n          tag=\"h3\"\n          variant=\"textSM\"\n          class=\"font-medium text-warning/88 \"\n          >In progress</Text\n        >\n\n        <Text tag=\"p\" class=\"mt-12 text-center text-base-400 \"\n          >No tasks in progress</Text\n        >\n      </div>\n      <div class=\"flex flex-col p-4 bg-base-50 rounded-xl\">\n        <Text\n          tag=\"h3\"\n          variant=\"textSM\"\n          class=\"font-medium text-success/88 \">Completed</Text\n        >\n\n        <Text tag=\"p\" class=\"mt-12 text-center text-base-400 \"\n          >No completed tasks</Text\n        >\n      </div>\n    </div>\n    <div class=\"mt-12 text-center\">\n      <Text tag=\"p\" variant=\"textSM\" class=\"text-base-600 \">\n        Need inspiration? Try one of these starter tasks:\n      </Text>\n      <div class=\"flex flex-col justify-center mt-4 sm:flex-row gap-2\">\n        <Button size=\"xs\" variant=\"muted\" class=\"w-full\"> Plan project </Button>\n        <Button size=\"xs\" variant=\"muted\" class=\"w-full\">\n          Set up meeting\n        </Button>\n        <Button size=\"xs\" variant=\"muted\" class=\"w-full\">\n          Create timeline\n        </Button>\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
