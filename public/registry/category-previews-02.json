      "content": "---\nexport const description = \"Category cards in bento style\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-32 mx-auto md:px-12 lg:px-24 max-w-7xl\">\n    <div class=\"mt-12 grid grid-cols-1 gap-2 lg:items-center lg:grid-cols-2\">\n      <div class=\"relative overflow-hidden group rounded-2xl aspect-square\">\n        <img\n          src=\"/store/shoes/airmax/3.png\"\n          alt=\"#_\"\n          class=\"absolute object-cover size-full group-hover:opacity-75\"\n        />\n        <div\n          aria-hidden=\"true\"\n          class=\"absolute inset-0 bg-gradient-to-b from-transparent to-white/50 \"\n        >\n        </div>\n\n        <div class=\"absolute inset-0 flex items-end justify-center p-6\">\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"font-semibold text-base-900 \"\n          >\n            <a href=\"#_\">\n              <span class=\"absolute inset-0\"></span>\n              Trainers\n            </a>\n          </Text>\n        </div>\n      </div>\n      <div class=\"h-full grid grid-cols-1 gap-2 lg:grid-cols-2\">\n        <div class=\"relative overflow-hidden group rounded-2xl\">\n          <img\n            src=\"/store/backpacks/3.jpeg\"\n            alt=\"#_\"\n            class=\"absolute object-cover size-full group-hover:opacity-75\"\n          />\n          <div\n            aria-hidden=\"true\"\n            class=\"absolute inset-0 bg-gradient-to-b from-transparent to-white/50 \"\n          >\n          </div>\n\n          <div class=\"absolute inset-0 flex items-end justify-center p-6\">\n            <Text\n              tag=\"p\"\n              variant=\"textBase\"\n              class=\"font-semibold text-base-900 \"\n            >\n              <a href=\"#_\">\n                <span class=\"absolute inset-0\"></span>\n                Backpacks\n              </a>\n            </Text>\n          </div>\n        </div>\n        <div\n          class=\"h-full grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-1\"\n        >\n          <div class=\"relative overflow-hidden group rounded-2xl aspect-square\">\n            <img\n              src=\"/store/jackets/1.png\"\n              alt=\"#_\"\n              class=\"absolute object-cover size-full group-hover:opacity-75\"\n            />\n            <div\n              aria-hidden=\"true\"\n              class=\"absolute inset-0 bg-gradient-to-b from-transparent to-white/50 \"\n            >\n            </div>\n\n            <div class=\"absolute inset-0 flex items-end justify-center p-6\">\n              <Text\n                tag=\"p\"\n                variant=\"textBase\"\n                class=\"font-semibold text-base-900 \"\n              >\n                <a href=\"#_\">\n                  <span class=\"absolute inset-0\"></span>\n                  Jackets\n                </a>\n              </Text>\n            </div>\n          </div>\n          <div class=\"relative overflow-hidden group rounded-2xl aspect-square\">\n            <img\n              src=\"/store/shoes/airmax/3.png\"\n              alt=\"#_\"\n              class=\"absolute object-cover size-full group-hover:opacity-75\"\n            />\n            <div\n              aria-hidden=\"true\"\n              class=\"absolute inset-0 bg-gradient-to-b from-transparent to-white/50 \"\n            >\n            </div>\n\n            <div class=\"absolute inset-0 flex items-end justify-center p-6\">\n              <Text\n                tag=\"p\"\n                variant=\"textBase\"\n                class=\"font-semibold text-base-900 \"\n              >\n                <a href=\"#_\">\n                  <span class=\"absolute inset-0\"></span>\n                  Trainers\n                </a>\n              </Text>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
