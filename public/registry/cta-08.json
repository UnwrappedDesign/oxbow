  "files": [
    {
      "name": "08.astro",
      "path": "oxbow/marketing/cta/08.astro",
      "content": "---\nexport const description = \"Splited CTA with text-and image\";\n// Assets\nimport { Image } from \"astro:assets\";\nimport Activity from \"@/images/assets/activity.svg\";\n// Foundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Wrapper from \"@/components/fundations/containers/Wrapper.astro\";\n// Icons\nimport Check from \"@/components/fundations/icons/Check.astro\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div\n      class=\"items-center max-w-md mx-auto grid grid-cols-1 gap-12 lg:gap-24 lg:max-w-none md:grid-cols-2\"\n    >\n      <div class=\"max-w-xl lg:text-balance lg:order-last\">\n        <Text\n          tag=\"h2\"\n          variant=\"displayMD\"\n          class=\"font-semibold tracking-tight text-foreground lg:text-balance\"\n        >\n          Bring order to your day.\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"mt-4 text-muted-foreground lg:text-balance\"\n        >\n          We won’t claim to solve everything, but you’ll look (and feel) more\n          organized than ever. Sometimes that’s all you need.\n        </Text>\n\n        <div class=\"flex flex-col mt-8 gap-4\">\n          <div class=\"flex items-center gap-2 text-muted-foreground\">\n            <div\n              class=\"p-2 text-foreground rounded-lg bg-background outline outline-border\"\n            >\n              <Check size=\"sm\" />\n            </div>\n\n            <Text tag=\"p\" variant=\"textSM\">\n              Dashboards that impress in meetings—even if you have to explain\n              them later.\n            </Text>\n          </div>\n          <div class=\"flex items-center gap-2 text-muted-foreground\">\n            <div\n              class=\"p-2 text-foreground rounded-lg bg-background outline outline-border\"\n            >\n              <Check size=\"sm\" />\n            </div>\n            <Text tag=\"p\" variant=\"textSM\">\n              Tasks that organize themselves, so you can focus on what matters\n              (or just scroll in peace).\n            </Text>\n          </div>\n          <div class=\"flex items-center gap-2 text-muted-foreground\">\n            <div\n              class=\"p-2 text-foreground rounded-lg bg-background outline outline-border\"\n            >\n              <Check size=\"sm\" />\n            </div>\n            <Text tag=\"p\" variant=\"textSM\">\n              Notifications that keep you informed—without the stress.\n            </Text>\n          </div>\n          <div class=\"flex items-center gap-2 text-muted-foreground\">\n            <div\n              class=\"p-2 text-foreground rounded-lg bg-background outline outline-border\"\n            >\n              <Check size=\"sm\" />\n            </div>\n            <Text tag=\"p\" variant=\"textSM\">\n              A UI so simple you’ll think something’s missing. (It’s not—it’s\n              just that clean.)\n            </Text>\n          </div>\n        </div>\n\n        <div class=\"flex mt-12\">\n          <Button variant=\"accent\" size=\"base\"> Get Started Today </Button>\n        </div>\n      </div>\n\n      <div class=\"h-full\">\n        <Image\n          src={Activity}\n          width={600}\n          height={800}\n          alt=\"Product showcase\"\n          loading=\"eager\"\n          decoding=\"async\"\n          class=\"w-full rounded-lg shadow outline outline-border\"\n        />\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
