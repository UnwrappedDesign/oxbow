      "content": "---\nexport const description = \"Checkbox with Label and Description\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2\"\n  x-data=\"{ checked: false }\"\n>\n  <!-- copy:start -->\n  <div class=\"flex flex-col gap-1\">\n    <div class=\"flex items-start gap-3\">\n      <div class=\"relative\">\n        <input\n          id=\"checkbox-with-description\"\n          name=\"checkbox-with-description\"\n          type=\"checkbox\"\n          x-model=\"checked\"\n          class=\"bg-background border-2 rounded appearance-none size-4 border-border checked:bg-muted checked:border-border focus:ring-2 focus:ring-border focus:ring-offset-2 focus:ring-offset-background\"\n        />\n        <svg\n          class=\"absolute inset-0 w-4 h-4 pointer-events-none transition-opacity\"\n          :class=\"{ 'opacity-100 text-foreground': checked, 'opacity-0': !checked }\"\n          viewBox=\"0 0 16 16\"\n          fill=\"currentColor\"\n        >\n          <path\n            d=\"M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 0 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z\"\n          ></path>\n        </svg>\n      </div>\n      <div>\n        <Text\n          for=\"checkbox-with-description\"\n          tag=\"label\"\n          class=\"block text-sm font-medium text-muted-foreground\"\n        >\n          Subscribe to newsletter <span class=\"text-muted-foreground\"\n            >(Optional)</span\n          >\n        </Text>\n        <Text tag=\"p\" variant=\"textSM\" class=\"text-muted-foreground\">\n          Stay updated with our latest news, articles, and offers by subscribing\n          to our newsletter.\n        </Text>\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
