{
  "name": "select-05",
  "type": "component",
  "description": "Conditional styling",
  "category": "application",
  "section": "select",
  "variant": 5,
  "aliases": [
    "select",
    "select 5",
    "select 05"
  ],
  "files": [
    {
      "name": "05.astro",
      "path": "oxbow/application/select/05.astro",
      "content": "---\nexport const description = \"Conditional styling\";\nexport const excludeFromObfuscation = [\n  \"ring-success/88\",\n  \"ring-primary/88\",\n  \"ring-destructive/88\",\n  \"bg-success/16\",\n  \"bg-primary/16\",\n  \"bg-destructive/16\",\n  \"bg-base-50\",\n];\nimport Select from \"@/components/fundations/inputs/Select.astro\";\nconst countryOptions = [\n  { label: \"United States\", value: \"us\" },\n  { label: \"Canada\", value: \"ca\" },\n  { label: \"United Kingdom\", value: \"uk\" },\n  { label: \"Australia\", value: \"au\" },\n  { label: \"Germany\", value: \"de\" },\n  { label: \"France\", value: \"fr\" },\n  { label: \"Japan\", value: \"jp\" },\n];\n---\n\n<div class=\"flex justify-center p-16 mx-auto bg-white \">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div\n      class=\"flex flex-col w-full max-w-sm\"\n      x-data=\"{ \n         selectedOption: '',\n         getSelectClass() {\n           return {\n             'ring-success/88': this.selectedOption === 'us',\n             'ring-primary/88': this.selectedOption === 'ca',\n             'ring-destructive/88': this.selectedOption === 'uk'\n           };\n         }\n       }\"\n    >\n      <Select\n        id=\"styled-select\"\n        name=\"styled-select\"\n        label=\"Select with Dynamic Styling\"\n        options={countryOptions}\n        xModel=\"selectedOption\"\n        xData=\"{ selectClass: getSelectClass() }\"\n        xEffect=\"selectClass = getSelectClass()\"\n        class=\"w-full\"\n        xOn={{ change: \"selectClass = getSelectClass()\" }}\n      />\n\n      <div\n        class=\"flex items-center p-4 mt-2 rounded-md gap-2\"\n        :class=\"{\n        'bg-success/16 ': selectedOption === 'us',\n        'bg-primary/16 ': selectedOption === 'ca',\n        'bg-destructive/16 ': selectedOption === 'uk',\n        'bg-base-50 ': !['us', 'ca', 'uk'].includes(selectedOption)\n       }\"\n      >\n        <p class=\"text-xs font-medium text-base-500 \">\n          Selected option: <span x-text=\"selectedOption || 'None'\"></span>\n        </p>\n        <p\n          x-show=\"selectedOption === 'us'\"\n          x-transition\n          class=\"hidden text-xs font-medium text-success/88 \"\n          :class=\"{ 'hidden': selectedOption !== 'us' }\"\n        >\n          You selected the United States!\n        </p>\n        <p\n          x-show=\"selectedOption === 'ca'\"\n          x-transition\n          class=\"hidden text-xs font-medium text-primary/88 \"\n          :class=\"{ 'hidden': selectedOption !== 'ca' }\"\n        >\n          You selected Canada!\n        </p>\n        <p\n          x-show=\"selectedOption === 'uk'\"\n          x-transition\n          class=\"hidden text-xs font-medium text-destructive/88 \"\n          :class=\"{ 'hidden': selectedOption !== 'uk' }\"\n        >\n          You selected the United Kingdom!\n        </p>\n      </div>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
