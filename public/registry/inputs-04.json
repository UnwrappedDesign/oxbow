      "content": "---\nexport const description = \"Email input\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n---\n\n<section class=\"justify-center h-full bg-background gap-2 p-15\">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <TextInput\n      id=\"email\"\n      name=\"email\"\n      label=\"Email address input hint\"\n      type=\"email\"\n      hint=\"Optional\"\n      variant=\"default\"\n      size=\"base\"\n      placeholder=\"you@example.com\"\n      required\n      showLeftIcon={false}\n    />\n    <!-- copy:end -->\n  </div>\n</section>\n"
