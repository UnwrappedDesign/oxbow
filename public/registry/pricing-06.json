  "files": [
    {
      "name": "06.astro",
      "path": "oxbow/marketing/pricing/06.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"w-1/2\",\n  \"translate-x-0\",\n  \"translate-x-full\",\n  \"text-base-600\",\n  \"focus:text-base-900 \",\n  \"hover:text-base-900 \",\n];\n\nexport const description = \"Pricing section with three tiers and table\";\n// Components\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Select from \"@/components/fundations/inputs/Select.astro\";\nimport Wrapper from \"@/components/fundations/containers/Wrapper.astro\";\n// Icons (import all used ones)\nimport Edit from \"@/components/fundations/icons/Edit.astro\";\nimport Bulb from \"@/components/fundations/icons/Bulb.astro\";\nimport ApiApp from \"@/components/fundations/icons/ApiApp.astro\";\nimport Refresh from \"@/components/fundations/icons/Refresh.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\nimport Analytics from \"@/components/fundations/icons/Analytics.astro\";\nimport Program from \"@/components/fundations/icons/Program.astro\";\nimport Plug from \"@/components/fundations/icons/Plug.astro\";\nimport Brain from \"@/components/fundations/icons/Brain.astro\";\nimport Code from \"@/components/fundations/icons/Code.astro\";\nimport Tools from \"@/components/fundations/icons/Tools.astro\";\nimport Lifebuoy from \"@/components/fundations/icons/Lifebuoy.astro\";\nimport UsersGroup from \"@/components/fundations/icons/UsersGroup.astro\";\n---\n\n<section x-data=\"{ duration: 'monthly' }\" class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-md mx-auto text-center\">\n      <Text\n        tag=\"h1\"\n        variant=\"displayMD\"\n        class=\"font-semibold tracking-tight text-base-900 text-balance \"\n      >\n        Give your team tools that don't suck\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-2 font-medium text-base-600 text-balance \"\n      >\n        Start with what you need, skip what you don't. Scale up when\n        spreadsheets stop cutting it.\n      </Text>\n      <!-- Pricing Toggle -->\n      <div\n        aria-labelledby=\"pricing-toggle\"\n        class=\"relative z-0 inline-flex justify-center w-full p-1 mx-auto mt-8 overflow-hidden bg-white shadow ring-1 ring-base-200 ring-offset-2 gap-4 lg:mx-0 rounded-md max-w-52 \"\n      >\n        <div\n          class=\"absolute inset-0 bg-base-50 rounded-md transition-transform duration-200 ease-in-out\"\n          :class=\"duration === 'monthly' ? 'w-1/2 translate-x-0' : 'w-1/2 translate-x-full'\"\n        >\n        </div>\n        <button\n          class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n          :class=\"duration === 'monthly' ? 'text-base-600 ' : 'focus:text-base-900 hover:text-base-900 '\"\n          @click=\"duration = 'monthly'\"\n          type=\"button\"\n          :aria-pressed=\"duration === 'monthly'\"\n        >\n          Monthly\n        </button>\n        <button\n          class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n          :class=\"duration === 'annual' ? 'text-base-600 ' : 'focus:text-base-900 hover:text-base-900 '\"\n          @click=\"duration = 'annual'\"\n          type=\"button\"\n          :aria-pressed=\"duration === 'annual'\"\n        >\n          Annual\n        </button>\n      </div>\n    </div>\n    <div class=\"mt-12 grid grid-cols-1 md:grid-cols-2 gap-4\">\n      <div\n        class=\"p-8 shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl lg:p-12\"\n      >\n        <div>\n          <div class=\"flex flex-col\">\n            <Text\n              tag=\"h3\"\n              variant=\"displaySM\"\n              class=\"font-semibold tracking-tight text-base-900 \"\n              >Core</Text\n            >\n            <div class=\"flex items-center mt-8 gap-2\">\n              <Text\n                tag=\"p\"\n                variant=\"displayMD\"\n                class=\"font-medium text-base-900 \"\n              >\n                <span\n                  data-monthly=\"$29\"\n                  data-annual=\"$19\"\n                  x-text=\"$el.dataset[duration]\"></span>\n              </Text>\n              <div class=\"text-xs font-medium text-base-600 \">\n                <div class=\"font-medium\">\n                  <span class=\"capitalize\" x-show=\"duration==='monthly'\"\n                    >month</span\n                  >\n                  <span\n                    class=\"capitalize\"\n                    x-show=\"duration==='annual'\"\n                    style=\"display: none\">annually</span\n                  >\n                </div>\n                <p>USD + Local taxes</p>\n              </div>\n            </div>\n          </div>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 text-base-600 \"\n          >\n            Essential AI copywriting tools to boost your content creation.\n          </Text>\n        </div>\n        <div class=\"mt-4\">\n          <Button size=\"base\" variant=\"default\" class=\"w-full\">\n            Start free trial\n          </Button>\n        </div>\n        <div\n          class=\"flex flex-col py-8 mt-8 border-t border-base-200 gap-4\"\n        >\n          <div class=\"flex flex-col items-start sm:flex-row gap-4\">\n            <div\n              class=\"p-2 text-primary/88 bg-white rounded-lg outline outline-base-100 \"\n            >\n              <Refresh size=\"sm\" />\n            </div>\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-base-900 \"\n            >\n              Content Generation\n              <span aria-hidden=\"true\">—</span>\n              <span class=\"font-normal text-base-600 \">\n                Generate blog posts, social media content, and basic marketing\n                copy.\n              </span>\n            </Text>\n          </div>\n          <div class=\"flex flex-col items-start sm:flex-row gap-4\">\n            <div\n              class=\"p-2 text-primary/88 bg-white rounded-lg outline outline-base-100 \"\n            >\n              <Edit size=\"sm\" />\n            </div>\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-base-900 \"\n            >\n              AI Writing Assistant\n              <span aria-hidden=\"true\">—</span>\n              <span class=\"font-normal text-base-600 \">\n                Basic grammar checking and style suggestions for your content.\n              </span>\n            </Text>\n          </div>\n        </div>\n        <div class=\"pt-4 border-t border-base-200 \">\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"font-medium text-base-900 \">Word Credits</Text\n          >\n          <div class=\"mt-4 space-y-4\">\n            <Select\n              id=\"core-credits\"\n              name=\"core-credits\"\n              label=\"Core Credits per project\"\n              value=\"10\"\n              variant=\"default\"\n              size=\"base\"\n              class=\"w-full\"\n              options={[\n                { label: \"10/project\", value: \"10\" },\n                { label: \"20/project\", value: \"20\" },\n                { label: \"50/project\", value: \"50\" },\n              ]}\n            />\n            <Select\n              id=\"core-projects\"\n              name=\"core-projects\"\n              label=\"Projects\"\n              value=\"10\"\n              variant=\"default\"\n              size=\"base\"\n              class=\"w-full\"\n              options={[\n                { label: \"10/project\", value: \"10\" },\n                { label: \"20/project\", value: \"20\" },\n                { label: \"50/project\", value: \"50\" },\n              ]}\n            />\n            <div class=\"flex items-center justify-between\">\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"text-base-600 \">Max Templates</Text\n              >\n              <Text tag=\"p\" variant=\"textSM\">\n                <span class=\"font-medium text-base-900 \">5</span>\n                <span class=\"text-base-600 \"\n                  >(10,000 words each)</span\n                >\n              </Text>\n            </div>\n            <div class=\"flex items-center justify-between\">\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"text-base-600 \"\n                >Price per 1,000 words</Text\n              >\n              <Text tag=\"p\" variant=\"textSM\">\n                <span class=\"font-medium text-base-900 \">$2</span\n                >\n                <span class=\"text-base-600 \"\n                  >(after credits)</span\n                >\n              </Text>\n            </div>\n          </div>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"pt-8 mt-8 text-sm border-t border-base-200 text-base-600 \"\n          >\n            All plans include our basic AI model trained on general copywriting\n            principles. Upgrade for access to industry-specific models.\n          </Text>\n        </div>\n        <div\n          class=\"flex items-center pt-4 mt-4 border-t gap-2 border-base-200 \"\n        >\n          <CircleCheck size=\"sm\" class=\"text-base-500\" />\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-600 \"\n          >\n            Refunds are available for all paid plans.\n          </Text>\n        </div>\n      </div>\n      <div\n        class=\"p-8 shadow bg-linear-180 outline outline-primary/24 from-primary/16 to-primary/24 rounded-xl lg:p-12\"\n      >\n        <div>\n          <div class=\"flex flex-col\">\n            <Text\n              tag=\"h3\"\n              variant=\"displaySM\"\n              class=\"font-semibold tracking-tight text-base-900 \"\n            >\n              Pro\n            </Text>\n            <div class=\"flex items-center mt-8 gap-2\">\n              <Text\n                tag=\"p\"\n                variant=\"displayMD\"\n                class=\"font-medium text-base-900 \"\n              >\n                <span\n                  data-monthly=\"$59\"\n                  data-annual=\"$45\"\n                  x-text=\"$el.dataset[duration]\"></span>\n              </Text>\n              <div class=\"text-xs font-medium text-base-600 \">\n                <div class=\"font-medium\">\n                  <span class=\"capitalize\" x-show=\"duration==='monthly'\"\n                    >month</span\n                  >\n                  <span\n                    class=\"capitalize\"\n                    x-show=\"duration==='annual'\"\n                    style=\"display: none\">annually</span\n                  >\n                </div>\n                <p>USD + Local taxes</p>\n              </div>\n            </div>\n          </div>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 text-base-600 \"\n          >\n            Advanced AI tools for professional writers &amp; content teams.\n          </Text>\n        </div>\n        <div class=\"mt-4\">\n          <Button size=\"base\" variant=\"default\" class=\"w-full\"\n            >Start free trial</Button\n          >\n        </div>\n        <div\n          class=\"flex flex-col py-8 mt-8 border-t border-base-200 gap-4\"\n        >\n          <div class=\"flex flex-col items-start sm:flex-row gap-4\">\n            <div\n              class=\"p-2 text-primary/88 bg-white rounded-lg outline outline-base-100 \"\n            >\n              <Refresh size=\"sm\" />\n            </div>\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-base-900 \"\n            >\n              Unlimited Generation\n              <span aria-hidden=\"true\">—</span>\n              <span class=\"font-normal text-base-600 \">\n                Create long-form content without token limits.\n              </span>\n            </Text>\n          </div>\n          <div class=\"flex flex-col items-start sm:flex-row gap-4\">\n            <div\n              class=\"p-2 text-primary/88 bg-white rounded-lg outline outline-base-100 \"\n            >\n              <Edit size=\"sm\" />\n            </div>\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-base-900 \"\n            >\n              AI Editor+\n              <span aria-hidden=\"true\">—</span>\n              <span class=\"font-normal text-base-600 \">\n                Access tone shifting, rephrasing, and advanced style\n                suggestions.\n              </span>\n            </Text>\n          </div>\n          <div class=\"flex flex-col items-start sm:flex-row gap-4\">\n            <div\n              class=\"p-2 text-primary/88 bg-white rounded-lg outline outline-base-100 \"\n            >\n              <Bulb size=\"sm\" />\n            </div>\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-base-900 \"\n            >\n              Smart Templates\n              <span aria-hidden=\"true\">—</span>\n              <span class=\"font-normal text-base-600 \">\n                Industry-specific prompts for ads, landing pages, and more.\n              </span>\n            </Text>\n          </div>\n          <div class=\"flex flex-col items-start sm:flex-row gap-4\">\n            <div\n              class=\"p-2 text-primary/88 bg-white rounded-lg outline outline-base-100 \"\n            >\n              <ApiApp size=\"sm\" />\n            </div>\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-base-900 \"\n            >\n              API Access\n              <span aria-hidden=\"true\">—</span>\n              <span class=\"font-normal text-base-600 \">\n                Integrate your AI flows directly with your app or CMS.\n              </span>\n            </Text>\n          </div>\n        </div>\n        <div class=\"pt-4 border-t border-base-200 \">\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"font-medium text-base-900 \"\n          >\n            Word Credits\n          </Text>\n          <div class=\"mt-4 space-y-4\">\n            <Select\n              id=\"pro-credits\"\n              name=\"pro-credits\"\n              label=\"Pro Credits per project\"\n              value=\"50\"\n              variant=\"default\"\n              size=\"base\"\n              class=\"w-full\"\n              options={[\n                { label: \"50/project\", value: \"50\" },\n                { label: \"100/project\", value: \"100\" },\n                { label: \"200/project\", value: \"200\" },\n              ]}\n            />\n            <Select\n              id=\"pro-projects\"\n              name=\"pro-projects\"\n              label=\"Projects\"\n              value=\"20\"\n              variant=\"default\"\n              size=\"base\"\n              class=\"w-full\"\n              options={[\n                { label: \"10\", value: \"10\" },\n                { label: \"20\", value: \"20\" },\n                { label: \"50\", value: \"50\" },\n              ]}\n            />\n            <div class=\"flex items-center justify-between\">\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"text-base-500 \">Max Templates</Text\n              >\n              <Text tag=\"p\" variant=\"textSM\">\n                <span class=\"font-medium text-base-900 \">25</span\n                >\n                <span class=\"text-base-500 \"\n                  >(25,000 words each)</span\n                >\n              </Text>\n            </div>\n            <div class=\"flex items-center justify-between\">\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"text-base-500 \"\n                >Price per 1,000 words</Text\n              >\n              <Text tag=\"p\" variant=\"textSM\">\n                <span class=\"font-medium text-base-900 \">$1</span\n                >\n                <span class=\"text-base-500 \"\n                  >(after credits)</span\n                >\n              </Text>\n            </div>\n          </div>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"pt-8 mt-8 text-sm border-t border-base-200 text-base-500 \"\n          >\n            Pro plans include access to our advanced AI models, fine-tuned for\n            marketing, legal, tech, and more.\n          </Text>\n        </div>\n        <div\n          class=\"flex items-center pt-4 mt-4 border-t gap-2 border-base-200 \"\n        >\n          <CircleCheck size=\"sm\" class=\"text-base-500\" />\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-600 \"\n          >\n            Refunds are available for all paid plans.\n          </Text>\n        </div>\n      </div>\n    </div>\n    <div class=\"mt-8 overflow-hidden overflow-x-auto\">\n      <table class=\"min-w-[640px] w-full table-auto border-collapse text-sm\">\n        <thead>\n          <tr>\n            <th class=\"sr-only\">Feature</th>\n            <th\n              class=\"py-3 text-base font-semibold text-center text-base-900 \"\n            >\n              Core\n            </th>\n            <th\n              class=\"py-3 font-semibold text-center text-Base text-base-900 \"\n            >\n              Pro\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <th\n              class=\"py-4 pl-4 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Analytics size=\"sm\" />\n                Analytics\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >3</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >10</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-4 pl-4 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <UsersGroup size=\"sm\" />\n                Accounts\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >5</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >10</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-4 pl-4 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Plug size=\"sm\" />\n                Integrations\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >2</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >YES</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-4 pl-4 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Program size=\"sm\" />\n                Programs\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >NO</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >1</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-4 pl-4 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Brain size=\"sm\" />\n                Deployments\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >NO</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >YES</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-4 pl-4 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Code size=\"sm\" />\n                Advanced Checkpoints\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >NO</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >YES</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-4 pl-4 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Tools size=\"sm\" />\n                Reporting tools\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >NO</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >YES</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-4 pl-4 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Lifebuoy size=\"sm\" />\n                Support\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >Discord community</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium text-center bg-white border-t text-base-900 border-base-200 \"\n              >Live chat</td\n            >\n          </tr>\n          <tr class=\"align-top\">\n            <th class=\"border-t border-base-200 \"></th>\n            <th\n              class=\"w-1/4 px-2 py-4 border-t border-base-200 \"\n            >\n              <Button class=\"w-full\" variant=\"muted\" size=\"sm\">\n                Start free trial\n              </Button>\n            </th>\n            <th\n              class=\"w-1/4 px-2 py-4 border-t border-base-200 \"\n            >\n              <Button class=\"w-full\" variant=\"muted\" size=\"sm\">\n                Start free trial\n              </Button>\n            </th>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</section>\n"
    }
