  "files": [
    {
      "name": "09.astro",
      "path": "oxbow/ecommerce/product-lists/09.astro",
      "content": "---\nexport const description =\n  \"Simple cards with overlayed add to cart and like cta\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Heart from \"@/components/fundations/icons/Heart.astro\";\nimport Cart from \"@/components/fundations/icons/Cart.astro\";\nconst products = [\n  {\n    image: \"/store/jackets/1.png\",\n    title: \"Contrast Hooded Puch Pocket\",\n    price: \"$140.00\",\n    discountedPrice: \"$99.00\",\n    description: \"23 Different Colors\",\n    link: \"#_\",\n  },\n  {\n    image: \"/store/jackets/2.png\",\n    title: \"Relaxed Shirt jacket\",\n    price: \"$280.00\",\n    discountedPrice: \"$149.00\",\n    description: \"40 Different Colors\",\n    link: \"#_\",\n  },\n  {\n    image: \"/store/jackets/3.png\",\n    title: \"Padded Soft Bomber\",\n    price: \"$120.00\",\n    discountedPrice: \"$80.00\",\n    description: \"10 Different Colors\",\n    link: \"#_\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <div class=\"relative grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n      {\n        products.map((article) => (\n          <div class=\"relative\">\n            <div class=\"relative aspect-[8/10] w-full overflow-hidden rounded-lg\">\n              <img\n                src={article.image}\n                alt=\"#_\"\n                class=\"object-cover size-full\"\n              />\n            </div>\n            <div class=\"relative mt-2\">\n              <div class=\"flex items-center justify-between w-full\">\n                <Text\n                  tag=\"h3\"\n                  variant=\"textSM\"\n                  class=\"font-medium text-foreground\"\n                >\n                  {article.title}\n                </Text>\n                <Text\n                  tag=\"p\"\n                  variant=\"textSM\"\n                  class=\"relative flex items-center text-muted-foreground gap-x-1\"\n                >\n                  {article.price}\n                </Text>\n              </div>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"text-muted-foreground\"\n              >\n                {article.description}\n                <a href=\"#_\">\n                  <span class=\"absolute inset-0\" />\n                </a>\n              </Text>\n            </div>\n            <div class=\"absolute inset-x-0 top-0 flex items-end justify-end p-4 overflow-hidden rounded-lg\">\n              <div class=\"flex items-center gap-x-1\">\n                <button class=\"text-muted-foreground\">\n                  <Heart size=\"sm\" />\n                </button>\n                <button class=\"text-muted-foreground\">\n                  <Cart size=\"sm\" />\n                </button>\n              </div>\n            </div>\n          </div>\n        ))\n      }\n    </div>\n  </div>\n</section>\n"
    }
  ],
