      "name": "06.astro",
      "path": "oxbow/marketing/bento-grids/06.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nconst listItems = [\"Revolutionizing communication\", \"Enhancing productivity\"];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div\n      class=\"grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-3\"\n    >\n      <div\n        class=\"relative flex items-center justify-center h-full p-8 overflow-hidden text-center shadow bg-background outline outline-border rounded-xl\"\n      >\n        <div>\n          <img\n            class=\"mx-auto h-14\"\n            src=\"/images/oxbow/oxbowLogo.png\"\n            alt=\"#_\"\n          />\n          <Text\n            tag=\"h3\"\n            variant=\"textXL\"\n            class=\"mt-24 font-medium text-foreground\"\n          >\n            Connect your app\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-2 font-medium text-muted-foreground text-balance\"\n          >\n            Connection secure, fast and easy. You can disconnect at any time.\n          </Text>\n\n          <Button size=\"sm\" variant=\"muted\" class=\"flex mx-auto mt-8 w-fit\">\n            See our integrations\n          </Button>\n        </div>\n      </div>\n      <div class=\"flex flex-col gap-2\">\n        <img\n          src=\"/widgets/sliders.svg\"\n          alt=\"#_\"\n          class=\"shadow size-full rounded-2xl\"\n        />\n        <div\n          class=\"relative flex items-center justify-center h-full p-8 overflow-hidden shadow bg-background outline outline-border rounded-xl\"\n        >\n          <ul\n            class=\"text-base font-medium list-none space-y-1 text-foreground\"\n            role=\"list\"\n          >\n            {\n              listItems.map((item, index) => (\n                <li>\n                  <div class=\"flex items-center gap-2\">\n                    <CircleCheck class=\"text-foreground\" size=\"sm\" />\n                    <Text tag=\"span\" variant=\"textSM\">\n                      {item}\n                    </Text>\n                  </div>\n                </li>\n              ))\n            }\n          </ul>\n        </div>\n      </div>\n      <div\n        class=\"relative flex flex-col justify-between h-full overflow-hidden shadow lg:row-span-2 bg-background outline outline-border rounded-xl\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Connections </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-foreground\"\n          >\n            Effortless connections\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Instantly link your favorite apps and services for a seamless,\n            unified experience.\n          </Text>\n        </div>\n        <div class=\"ml-8 -bottom-2 -right-8\">\n          <img\n            class=\"w-full h-full shadow rounded-tl-xl\"\n            src=\"/widgets/device.svg\"\n            alt=\"\"\n          />\n        </div>\n      </div>\n\n      <div\n        class=\"relative flex flex-col justify-between h-full overflow-hidden shadow bg-background outline outline-border rounded-xl lg:row-span-2\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Planning </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-foreground\"\n          >\n            Plan ahead\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Organize your day with smart scheduling and let automation handle\n            the rest.\n          </Text>\n        </div>\n        <div class=\"ml-8 -bottom-2 -right-8\">\n          <img\n            class=\"w-full h-full shadow rounded-tl-xl\"\n            src=\"/widgets/activity.svg\"\n            alt=\"\"\n          />\n        </div>\n      </div>\n      <img\n        src=\"/widgets/calendar.svg\"\n        class=\"object-cover shadow rounded-2xl size-full\"\n        alt=\"\"\n      />\n\n      <div\n        class=\"relative flex flex-col items-center justify-center p-8 overflow-hidden text-center shadow bg-background outline outline-border rounded-xl md:col-span-2 lg:py-20\"\n      >\n        <div class=\"relative items-center text-balance\">\n          <Kicker> Collaboration </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"displayMD\"\n            class=\"mt-4 font-semibold tracking-tight text-foreground\"\n          >\n            Work together, anywhere\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Collaborate in real time, share ideas, and keep your team in sync—no\n            matter where you are.\n          </Text>\n          <div\n            class=\"flex flex-wrap items-center justify-center mx-auto mt-8 gap-2\"\n          >\n            <Button variant=\"accent\" size=\"sm\"> Get started </Button>\n            <Button variant=\"muted\" size=\"sm\"> Learn more </Button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
