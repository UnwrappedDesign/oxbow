  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/ecommerce/category-previews/04.astro",
      "content": "---\nexport const description =\n  \"Simple cards with description and link below image and auto height\";\n\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst products = [\n  {\n    image: \"/store/shoes/airmax/1.png\",\n    title: \"Trainers\",\n  },\n  {\n    image: \"/store/jackets/1.png\",\n    title: \"Hoodies\",\n    link: \"#_\",\n  },\n  {\n    image: \"/store/backpacks/1.jpeg\",\n    title: \"Backpacks\",\n  },\n  {\n    image: \"/store/backpacks/2.jpeg\",\n    title: \"Backpacks\",\n  },\n];\n---\n\n<section class=\"bg-white \">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <div class=\"relative grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4\">\n      {\n        products.map((article) => (\n          <div>\n            <div class=\"relative\">\n              <div class=\"relative w-full overflow-hidden rounded-lg \">\n                <img\n                  src={article.image}\n                  alt=\"#_\"\n                  class=\"object-cover size-full\"\n                />\n              </div>\n              <div class=\"relative mt-2\">\n                <div class=\"flex items-center justify-between w-full\">\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textSM\"\n                    class=\"font-medium text-base-900 \"\n                  >\n                    {article.title}\n                  </Text>\n                </div>\n                <div\n                  class=\"flex items-center gap-1 \n \"\n                >\n                  <Text\n                    tag=\"a\"\n                    variant=\"textSM\"\n                    class=\" text-base-500 \"\n                  >\n                    Shop now\n                  </Text>\n                </div>\n              </div>\n            </div>\n          </div>\n        ))\n      }\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
