      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"h-full grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3\">\n      <div\n        class=\"relative flex flex-col justify-between h-full overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Integration </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Connect with ease\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Effortlessly link your favorite tools and platforms for a truly\n            unified workflow.\n          </Text>\n        </div>\n        <div class=\"mx-8 -bottom-2 -right-8\">\n          <img\n            class=\"w-full h-full shadow rounded-t-xl\"\n            src=\"/widgets/sliders.svg\"\n            alt=\"\"\n          />\n        </div>\n      </div>\n      <div\n        class=\"relative flex flex-col justify-between h-full overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Planning </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Plan your day\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Stay organized and ahead with smart scheduling and automated\n            reminders for every task.\n          </Text>\n        </div>\n        <div class=\"mx-8 -bottom-2 -right-8\">\n          <img\n            class=\"w-full h-full shadow rounded-t-xl\"\n            src=\"/widgets/calendar.svg\"\n            alt=\"\"\n          />\n        </div>\n      </div>\n      <div\n        class=\"relative flex flex-col justify-between h-full overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Features </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Powerful features\n          </Text>\n          <Text tag=\"p\" variant=\"textSM\" class=\"mt-2 font-medium text-base-500\">\n            Unlock advanced capabilities to streamline your processes and boost\n            productivity every step of the way.\n          </Text>\n        </div>\n        <div class=\"mx-8 -bottom-2 -right-8\">\n          <img\n            class=\"w-full h-full shadow rounded-t-xl\"\n            src=\"/widgets/progressCircles.svg\"\n            alt=\"\"\n          />\n        </div>\n      </div>\n    </div>\n    <div class=\"h-full mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2\">\n      <div\n        class=\"relative flex flex-col justify-center h-full overflow-hidden shadow bg-linear-180 outline outline-primary/24 from-primary/16 to-primary/24 rounded-xl\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Sync </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Always in sync\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            All your changes are saved automatically, so you never lose your\n            progress or momentum.\n          </Text>\n        </div>\n      </div>\n      <div\n        class=\"relative flex flex-col justify-center h-full overflow-hidden shadow bg-linear-180 outline outline-primary/24 from-primary/16 to-primary/24 rounded-xl\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Navigation </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Effortless navigation\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Instantly find what you need and customize your workspace with\n            intuitive controls and shortcuts.\n          </Text>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
