  ],
  "files": [
    {
      "name": "12.astro",
      "path": "oxbow/application/textarea/12.astro",
      "content": "---\nexport const description = \"Textarea with save draft\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-white \">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"w-full space-y-2\" x-data=\"{ text: '', draft: '' }\">\n      <div>\n        <Text\n          for=\"save-draft-textarea\"\n          tag=\"label\"\n          variant=\"textSM\"\n          class=\"font-medium text-base-500 \"\n        >\n          Save draft textarea\n        </Text>\n        <textarea\n          id=\"save-draft-textarea\"\n          x-model=\"text\"\n          rows=\"4\"\n          placeholder=\"Type your message\"\n          class=\"block w-full px-4 py-2 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n        ></textarea>\n      </div>\n      <div class=\"flex items-center mt-2 gap-2\">\n        <Button\n          type=\"button\"\n          class=\"ml-auto\"\n          @click=\"text = draft\"\n          variant=\"muted\"\n          size=\"sm\"\n        >\n          Load Draft\n        </Button>\n        <Button type=\"button\" @click=\"draft = text\" variant=\"accent\" size=\"sm\">\n          Save Draft\n        </Button>\n      </div>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
  ],
