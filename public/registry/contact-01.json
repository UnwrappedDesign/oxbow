    {
      "name": "01.astro",
      "path": "oxbow/marketing/contact/01.astro",
      "content": "---\nexport const freeComponent = true;\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\nimport CreditCard from \"@/components/fundations/icons/CreditCard.astro\";\nimport News from \"@/components/fundations/icons/News.astro\";\nimport Lifebuoy from \"@/components/fundations/icons/Lifebuoy.astro\";\nimport UserPlus from \"@/components/fundations/icons/UserPlus.astro\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-xl mx-auto text-center lg:text-balance\">\n      <Kicker>Let’s Connect</Kicker>\n      <Text\n        tag=\"h1\"\n        variant=\"displayMD\"\n        class=\"mt-12 font-semibold tracking-tight text-foreground lg:text-balance\"\n      >\n        Reach out—your ideas matter to us\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-4 lg:text-balance text-muted-foreground\"\n      >\n        Whether you have a question, a partnership in mind, or just want to say\n        hello, we’re here and ready to listen. Let’s build something great\n        together.\n      </Text>\n    </div>\n    <div\n      class=\"mt-12 text-center grid sm:grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4 lg:gap-x-8 lg:gap-y-16\"\n    >\n      <div>\n        <div class=\"flex flex-col gap-2\">\n          <CreditCard\n            class=\"mx-auto text-foreground\"\n            size=\"base\"\n          />\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-8 font-medium text-foreground\"\n          >\n            Sales\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"font-medium text-muted-foreground\"\n          >\n            Curious about how Oxbow UI can elevate your business? Let’s talk\n            solutions tailored for you.\n          </Text>\n        </div>\n        <Text\n          href=\"#_\"\n          class=\"flex items-center justify-center mt-4 text-sm font-medium gap-2 text-foreground hover:text-foreground\"\n        >\n          Talk to sales\n          <ChevronRight size=\"sm\" />\n        </Text>\n      </div>\n      <div>\n        <div>\n          <Lifebuoy\n            class=\"mx-auto text-foreground\"\n            size=\"base\"\n          />\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-8 font-medium text-foreground\"\n          >\n            Support\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"font-medium text-muted-foreground\"\n          >\n            Need help or have a question? Our support team is here to make your\n            experience smooth and stress-free.\n          </Text>\n        </div>\n        <Text\n          href=\"#_\"\n          class=\"flex items-center justify-center mt-4 text-sm font-medium gap-2 text-foreground hover:text-foreground\"\n        >\n          Talk to support\n          <ChevronRight size=\"sm\" />\n        </Text>\n      </div>\n      <div>\n        <div>\n          <News class=\"mx-auto text-foreground\" size=\"base\" />\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-8 font-medium text-foreground\"\n          >\n            Press\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"font-medium text-muted-foreground\"\n          >\n            For media inquiries, interviews, or creative collaborations, we’re\n            always open to new stories and ideas.\n          </Text>\n        </div>\n        <Text\n          href=\"#_\"\n          class=\"flex items-center justify-center mt-4 text-sm font-medium gap-2 text-foreground hover:text-foreground\"\n        >\n          Talk to press\n          <ChevronRight size=\"sm\" />\n        </Text>\n      </div>\n      <div>\n        <div>\n          <UserPlus\n            class=\"mx-auto text-foreground\"\n            size=\"base\"\n          />\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-8 font-medium text-foreground\"\n          >\n            Partners\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"font-medium text-muted-foreground\"\n          >\n            Interested in teaming up? Share your vision and let’s explore how we\n            can create something impactful together.\n          </Text>\n        </div>\n        <Text\n          href=\"#_\"\n          class=\"flex items-center justify-center mt-4 text-sm font-medium gap-2 text-foreground hover:text-foreground\"\n        >\n          Meet our partners\n          <ChevronRight size=\"sm\" />\n        </Text>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
