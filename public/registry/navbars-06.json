    {
      "name": "06.astro",
      "path": "oxbow/application/navbars/06.astro",
      "content": "---\nexport const freeComponent = true;\nexport const excludeFromObfuscation = [\"flex\", \"hidden\"];\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport Burger from \"@/components/fundations/icons/Burger.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport FlyoutLinkBox from \"@/components/fundations/wrappers/FlyoutLinkBox.astro\";\nimport Refresh from \"@/components/fundations/icons/Refresh.astro\";\nimport User from \"@/components/fundations/icons/User.astro\";\n---\n<div class=\"bg-white pb-100\">\n  <!-- copy:start -->\n  <header\n    class=\"w-full bg-white border-b border-base-200 \"\n  >\n    <div\n      x-data=\"{ open:false, user:false, isDarkTheme: document.documentElement.classList.contains('dark') }\"\n      class=\"px-6 mx-auto max-w-screen-xl md:px-10 lg:px-16\"\n    >\n      <div class=\"flex items-center justify-between h-16 gap-3\">\n        <a href=\"#_\" class=\"inline-flex items-center gap-2\"\n          ><Logo class=\"text-black h-7 \" /><span class=\"sr-only\"\n            >Home</span\n          ></a\n        >\n        <nav aria-label=\"Primary\" class=\"items-center hidden md:flex gap-4\">\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-600 hover:text-base-900\"\n            >Dashboard</Text\n          >\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-600 hover:text-base-900\"\n            >Projects</Text\n          >\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-600 hover:text-base-900\"\n            >Teams</Text\n          >\n        </nav>\n        <div class=\"items-center hidden md:flex gap-2\">\n          <Button\n            variant=\"muted\"\n            size=\"xs\"\n            @click=\"isDarkTheme=!isDarkTheme; document.documentElement.classList.toggle('dark', isDarkTheme)\"\n            >Toggle theme</Button\n          >\n          <div x-data=\"{open:false}\" class=\"relative\">\n            <IconButton\n              variant=\"muted\"\n              size=\"xs\"\n              @click=\"open=!open\"\n              @keydown.escape.window=\"open=false\"\n              :aria-expanded=\"open\"\n            >\n              <User size=\"sm\" slot=\"icon\" />\n            </IconButton>\n            <div\n              x-show=\"open\"\n              x-transition\n              @click.outside=\"open=false\"\n              class=\"absolute right-0 z-30 flex flex-col p-4 mt-2 bg-white shadow-lg top-full w-70 rounded-xl outline outline-base-900/5 gap-4\"\n            >\n              <FlyoutLinkBox\n                href=\"#_\"\n                icon={Refresh}\n                title=\"Profile\"\n                description=\"Update your profile\"\n              />\n              <FlyoutLinkBox\n                href=\"#_\"\n                icon={Refresh}\n                title=\"Settings\"\n                description=\"Update your settings\"\n              />\n              <FlyoutLinkBox\n                href=\"#_\"\n                icon={Refresh}\n                title=\"Sign out\"\n                description=\"Sign out from your accoiunt\"\n              />\n            </div>\n          </div>\n        </div>\n        <IconButton\n          class=\"md:hidden\"\n          @click=\"open=!open\"\n          :aria-expanded=\"open\"\n          aria-controls=\"nav-06\"\n          variant=\"muted\"\n          size=\"xs\"\n        >\n          <Burger size=\"xs\" slot=\"icon\" />\n        </IconButton>\n      </div>\n      <div\n        id=\"nav-06\"\n        :class=\"{ 'grid': open, 'hidden': !open }\"\n        class=\"hidden pb-4 grid-cols-1 gap-2 md:hidden\"\n      >\n        <Button variant=\"muted\" size=\"xs\">Dashboard</Button>\n        <Button variant=\"muted\" size=\"xs\">Projects</Button>\n        <Button variant=\"muted\" size=\"xs\">Teams</Button>\n        <Button\n          variant=\"muted\"\n          size=\"xs\"\n          @click=\"isDarkTheme=!isDarkTheme; document.documentElement.classList.toggle('dark', isDarkTheme)\"\n          >Toggle theme</Button\n        >\n        <Button size=\"xs\" variant=\"default\">Sign out</Button>\n      </div>\n    </div>\n  </header>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
