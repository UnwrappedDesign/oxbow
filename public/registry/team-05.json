      "name": "05.astro",
      "path": "oxbow/marketing/team/05.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\nimport XBrand from \"@/components/fundations/icons/XBrand.astro\";\nimport LinkedinBrand from \"@/components/fundations/icons/LinkedinBrand.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <ul\n      role=\"list\"\n      class=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8\"\n    >\n      <li>\n        <div class=\"flex flex-col gap-4\">\n          <img\n            class=\"object-cover rounded-xl aspect-[4/3]\"\n            src=\"/avatars/1.jpg\"\n            alt=\"#_\"\n          />\n          <div>\n            <div class=\"flex items-center justify-between\">\n              <Text\n                variant=\"textBase\"\n                tag=\"h3\"\n                class=\"font-semibold text-base-900 \"\n              >\n                Michael Andreuzza\n              </Text>\n              <div class=\"flex items-center gap-2\">\n                <Text\n                  tag=\"a\"\n                  href=\"#_\"\n                  variant=\"textBase\"\n                  class=\"font-medium hover:text-primary/88 text-base-500 \"\n                >\n                  <XBrand size=\"sm\" />\n                </Text>\n                <Text\n                  tag=\"a\"\n                  href=\"#_\"\n                  variant=\"textBase\"\n                  class=\"font-medium hover:text-primary/88 text-base-500 \"\n                >\n                  <LinkedinBrand size=\"sm\" />\n                </Text>\n              </div>\n            </div>\n            <Text\n              tag=\"p\"\n              variant=\"textXS\"\n              class=\"font-medium text-base-500 \"\n            >\n              Creator of Oxbow UI.com\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"mt-4 font-medium text-base-500 \"\n            >\n              Michael is a visionary leader with over a decade of experience in\n              creating dynamic and user-friendly websites.\n            </Text>\n          </div>\n        </div>\n      </li>\n      <li\n        class=\"flex flex-col items-center justify-center order-first lg:col-span-2 lg:p-12 bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl lg:order-none\"\n      >\n        <div class=\"text-center lg:text-balance\">\n          <Text\n            tag=\"h2\"\n            variant=\"displayMD\"\n            class=\"font-semibold tracking-tight text-base-900 text-balance\"\n          >\n            Get to know the people behind our team\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-500 \"\n          >\n            Our talented team combines creativity, expertise, and dedication to\n            bring innovative solutions to life and empower your projects.\n          </Text>\n        </div>\n      </li>\n      <li>\n        <div class=\"flex flex-col gap-4\">\n          <img\n            class=\"object-cover rounded-xl aspect-[4/3]\"\n            src=\"/avatars/2.jpg\"\n            alt=\"#_\"\n          />\n          <div>\n            <div class=\"flex items-center justify-between\">\n              <Text\n                variant=\"textBase\"\n                tag=\"h3\"\n                class=\"font-semibold text-base-900\"\n              >\n                Juan Echanove\n              </Text>\n              <div class=\"flex items-center gap-2\">\n                <Text\n                  tag=\"a\"\n                  href=\"#_\"\n                  variant=\"textBase\"\n                  class=\"font-medium hover:text-primary/88 text-base-500 \"\n                >\n                  <XBrand size=\"sm\" />\n                </Text>\n                <Text\n                  tag=\"a\"\n                  href=\"#_\"\n                  variant=\"textBase\"\n                  class=\"font-medium hover:text-primary/88 text-base-500 \"\n                >\n                  <LinkedinBrand size=\"sm\" />\n                </Text>\n              </div>\n            </div>\n            <Text tag=\"p\" variant=\"textXS\" class=\"font-medium text-base-500\">\n              Founder of Pay Oneeer\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"mt-4 font-medium text-base-500\"\n            >\n              Juan is the founder of Pay Oneeer, a leading fintech company and\n              deep understanding of financial technology.\n            </Text>\n          </div>\n        </div>\n      </li>\n      <li class=\"lg:col-span-2\">\n        <div class=\"flex flex-col gap-4\">\n          <img\n            class=\"object-cover rounded-xl aspect-[4/3]\"\n            src=\"/avatars/3.jpg\"\n            alt=\"#_\"\n          />\n          <div>\n            <div class=\"flex items-center justify-between\">\n              <Text\n                variant=\"textBase\"\n                tag=\"h3\"\n                class=\"font-semibold text-base-900 \"\n              >\n                Anna Muska\n              </Text>\n              <div class=\"flex items-center gap-2\">\n                <Text\n                  tag=\"a\"\n                  href=\"#_\"\n                  variant=\"textBase\"\n                  class=\"font-medium hover:text-primary/88 text-base-500 \"\n                >\n                  <XBrand size=\"sm\" />\n                </Text>\n                <Text\n                  tag=\"a\"\n                  href=\"#_\"\n                  variant=\"textBase\"\n                  class=\"font-medium hover:text-primary/88 text-base-500 \"\n                >\n                  <LinkedinBrand size=\"sm\" />\n                </Text>\n              </div>\n            </div>\n            <Text\n              tag=\"p\"\n              variant=\"textXS\"\n              class=\"font-medium text-base-500 \"\n            >\n              Founder of Fesla\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"mt-4 font-medium text-base-500 \"\n            >\n              Elona is a trailblazing entrepreneur and the founder of Fesla, an\n              innovative company pushing the boundaries of technology and\n              sustainability. She is committed to driving change and making a\n              positive impact on the world.\n            </Text>\n          </div>\n        </div>\n      </li>\n      <li class=\"lg:col-span-2\">\n        <div class=\"flex flex-col gap-4\">\n          <img\n            class=\"object-cover rounded-xl aspect-[4/3]\"\n            src=\"/avatars/4.jpg\"\n            alt=\"#_\"\n          />\n          <div>\n            <div class=\"flex items-center justify-between\">\n              <Text\n                variant=\"textBase\"\n                tag=\"h3\"\n                class=\"font-semibold text-base-900 \"\n              >\n                Heidi Herrera\n              </Text>\n              <div class=\"flex items-center gap-2\">\n                <Text\n                  tag=\"a\"\n                  href=\"#_\"\n                  variant=\"textBase\"\n                  class=\"font-medium hover:text-primary/88 text-base-500 \"\n                >\n                  <XBrand size=\"sm\" />\n                </Text>\n                <Text\n                  tag=\"a\"\n                  href=\"#_\"\n                  variant=\"textBase\"\n                  class=\"font-medium hover:text-primary/88 text-base-500 \"\n                >\n                  <LinkedinBrand size=\"sm\" />\n                </Text>\n              </div>\n            </div>\n            <Text\n              tag=\"p\"\n              variant=\"textXS\"\n              class=\"font-medium text-base-500 \"\n            >\n              COO at Pff Inc\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"mt-4 font-medium text-base-500 \"\n            >\n              Messina is the Chief Operating Officer at Pff Inc. With a keen eye\n              for detail and exceptional organizational skills, she ensures the\n              smooth and efficient operation of the company, driving growth and\n              success.\n            </Text>\n          </div>\n        </div>\n      </li>\n    </ul>\n  </div>\n</section>\n"
    }
  ],
