  "files": [
    {
      "name": "10.astro",
      "path": "oxbow/application/textarea/10.astro",
      "content": "---\nexport const description = \"Textarea with Live Word Limit\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-white \">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div\n      class=\"w-full space-y-1\"\n      x-data=\"{ text: '', maxWords: 20 }\"\n      x-init=\"$watch('text', () => text = text.split(/\\s+/).slice(0, maxWords).join(' '))\"\n    >\n      <Text\n        for=\"word-limit-textarea\"\n        tag=\"label\"\n        variant=\"textSM\"\n        class=\"font-medium text-base-500 \"\n      >\n        Live word limit\n      </Text>\n      <textarea\n        id=\"word-limit-textarea\"\n        x-model=\"text\"\n        rows=\"4\"\n        placeholder=\"Limit to 20 words\"\n        class=\"block w-full px-4 py-2 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n      ></textarea>\n    </div>\n    <!-- copy:end -->\n </div>\n</div>\n"
    }
  ],
