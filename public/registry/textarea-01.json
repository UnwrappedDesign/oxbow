      "name": "01.astro",
      "path": "oxbow/application/textarea/01.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"Dynamic character limit with warning\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-white \">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"w-full space-y-1\" x-data=\"{ text: '', maxLength: 100 }\">\n      <Text\n        for=\"input-char-limit\"\n        tag=\"label\"\n        variant=\"textSM\"\n        class=\"font-medium text-base-500\"\n      >\n        Message\n      </Text>\n      <textarea\n        id=\"input-char-limit\"\n        name=\"input-char-limit\"\n        x-model=\"text\"\n        :maxlength=\"maxLength\"\n        rows=\"4\"\n        placeholder=\"Enter your message\"\n        class=\"block w-full px-4 py-2 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n      ></textarea>\n      <div class=\"mt-2 text-sm text-base-500\">\n        <span x-text=\"text.length\"></span> / <span x-text=\"maxLength\"></span> characters\n      </div>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
