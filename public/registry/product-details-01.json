  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/ecommerce/product-details/01.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"Simple details with CTA\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <div class=\"items-center mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8\">\n      <!-- Product Image Gallery -->\n      <img\n        src=\"/store/shoes/airmax/1.png\"\n        class=\"size-full aspect-[16/10] object-cover object-center rounded-2xl lg:col-span-2\"\n        alt=\"Product image\"\n      />\n      <!-- Product Details -->\n      <div class=\"flex flex-col gap-8\">\n        <div>\n          <Text tag=\"p\" variant=\"displayXL\" class=\"text-foreground\"\n            >$190</Text\n          >\n          <Text\n            tag=\"h1\"\n            variant=\"displaySM\"\n            class=\"mt-12 font-medium text-foreground\">Nike Air Max</Text\n          >\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-1 text-muted-foreground\"\n          >\n            Black\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-4 text-muted-foreground lg:text-balance\"\n          >\n            Hitting the field in the late '60s, adidas airmaxS quickly became\n            soccer's \"it\" shoe.\n          </Text>\n        </div>\n\n        <!-- Action Buttons -->\n        <div class=\"flex mt-8\">\n          <Button size=\"sm\" variant=\"default\">Add to Cart</Button>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
