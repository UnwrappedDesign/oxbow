      "path": "oxbow/application/button-groups/05.astro",
      "content": "---\n\nexport const description = \"Split button\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport ChevronDown from \"@/components/fundations/icons/ChevronDown.astro\";\n---\n\n<section class=\"flex items-center justify-center bg-background p-18\">\n  <!-- copy:start -->\n  <div\n    class=\"inline-flex overflow-hidden rounded-md border border-border bg-background text-sm shadow-sm\"\n    role=\"group\"\n    aria-label=\"Run or schedule action\"\n  >\n    <Button\n      variant=\"accent\"\n      size=\"sm\"\n      type=\"button\"\n      noRounded\n      class=\"px-5 transition-none\"\n    >\n      Run report\n    </Button>\n    <Button\n      variant=\"muted\"\n      size=\"sm\"\n      iconOnly\n      type=\"button\"\n      noRounded\n      class=\"border-l border-border transition-none\"\n      aria-label=\"More options\"\n    >\n      <ChevronDown slot=\"left-icon\" size=\"sm\" />\n    </Button>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
