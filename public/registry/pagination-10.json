{
  "name": "pagination-10",
  "type": "component",
  "description": "Go to Page + Size Select",
  "category": "application",
  "section": "pagination",
  "variant": 10,
  "aliases": [
    "pagination",
    "pagination 10"
  ],
  "files": [
    {
      "name": "10.astro",
      "path": "oxbow/application/pagination/10.astro",
      "content": "---\nexport const description = \"Go to Page + Size Select\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Select from \"@/components/fundations/inputs/Select.astro\";\n---\n\n<section class=\"flex justify-center p-16 bg-white \">\n  <!-- copy:start -->\n  <nav\n    aria-label=\"Pagination\"\n    x-data=\"{ page: 1, total: 12, size: 10, input: '' }\"\n    class=\"w-full grid grid-cols-1 lg:grid-cols-2 gap-3 sm:items-center sm:justify-between\"\n  >\n    <!-- Group A: Prev / Page X of Y / Next -->\n    <div\n      class=\"flex items-center justify-between w-full sm:justify-start gap-2\"\n    >\n      <Button\n        size=\"xs\"\n        variant=\"muted\"\n        :disabled=\"page===1\"\n        @click=\"page=Math.max(1,page-1)\">Previous</Button\n      >\n      <span class=\"text-sm text-base-600 \"\n        >Page <span x-text=\"page\"></span> of <span x-text=\"total\"></span></span\n      >\n      <Button\n        size=\"xs\"\n        variant=\"muted\"\n        :disabled=\"page===total\"\n        @click=\"page=Math.min(total,page+1)\">Next</Button\n      >\n    </div>\n\n    <!-- Group B: Go to input and Per-page select -->\n    <div\n      class=\"flex-col hidden w-full md:flex gap-2 sm:w-fit sm:flex-row sm:items-center lg:ml-auto\"\n    >\n      <div\n        class=\"flex items-center text-sm gap-2 text-base-600 \"\n      >\n        Go to\n        <input\n          x-model=\"input\"\n          type=\"number\"\n          min=\"1\"\n          :max=\"total\"\n          class=\"w-20 h-8 px-2 text-sm bg-white border rounded border-base-300 \"\n          :placeholder=\"page\"\n        />\n        <Button\n          size=\"xs\"\n          variant=\"default\"\n          @click=\"const n=Number(input)||page; page=Math.min(total,Math.max(1,n))\"\n          >Go</Button\n        >\n      </div>\n      <div\n        class=\"flex items-center text-sm gap-2 text-base-600 \"\n      >\n        Per page\n        <div class=\"w-24\">\n          <Select id=\"per-page\" name=\"per-page\" size=\"xs\" xModel=\"size\">\n            <option value=\"10\">10</option>\n            <option value=\"25\">25</option>\n            <option value=\"50\">50</option>\n          </Select>\n        </div>\n      </div>\n    </div>\n  </nav>\n  <!-- copy:end -->\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
