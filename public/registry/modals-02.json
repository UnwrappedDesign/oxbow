{
  "name": "modals-02",
  "type": "component",
  "description": "Choose AI Chat Plan",
  "category": "application",
  "section": "modals",
  "variant": 2,
  "aliases": [
    "modals",
    "modals 2",
    "modals 02",
    "modal",
    "modal 2",
    "modal 02"
  ],
  "files": [
    {
      "name": "02.astro",
      "path": "oxbow/application/modals/02.astro",
      "content": "---\nexport const description = \"Choose AI Chat Plan\";\nexport const excludeFromObfuscation = [\n  \"opacity-0\",\n  \"opacity-100\",\n  \"translate-y-4\",\n  \"sm:translate-y-0\",\n  \"sm:scale-95\",\n];\nimport Stacked from \"@/components/fundations/icons/Stacked.astro\";\nimport Check from \"@/components/fundations/icons/Check.astro\";\nimport X from \"@/components/fundations/icons/X.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div\n  class=\"p-8 pt-12 pb-120 bg-white flex items-center justify-center\"\n>\n  <!-- Copy:start -->\n  <!--\n// Make sure to change  \"open: false\",  to  open: true. On the z-data=\"{}\".\n-->\n  <div\n    class=\"w-full max-w-xl mx-auto\"\n    x-data=\"{\n      open:true,\n      selected:'basic',\n      dontShow:false,\n      show(){ this.open=true; },\n      close(){ this.open=false; },\n      confirm(){\n        window.dispatchEvent(new CustomEvent('pricing:selected', { detail:{ plan:this.selected, dontShow:this.dontShow } }));\n        this.close();\n      }\n    }\"\n  >\n    <Button\n      variant=\"default\"\n      size=\"sm\"\n      type=\"button\"\n      class=\"mx-auto\"\n      @click=\"show()\">Choose AI Plan</Button\n    >\n\n    <!-- Backdrop -->\n    <div\n      x-show=\"open\"\n      x-transition.opacity\n      class=\"fixed inset-0 z-40 bg-black/40 \"\n      aria-hidden=\"true\"\n      @click=\"close()\"\n    >\n    </div>\n\n    <!-- Dialog -->\n    <div\n      x-show=\"open\"\n      x-transition:enter=\"transition ease-out duration-200\"\n      x-transition:enter-start=\"opacity-0\"\n      x-transition:enter-end=\"opacity-100\"\n      x-transition:leave=\"transition ease-in duration-150\"\n      x-transition:leave-start=\"opacity-100\"\n      x-transition:leave-end=\"opacity-0\"\n      class=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"plan-title\"\n      @keydown.escape.window.prevent=\"close()\"\n    >\n      <div\n        x-show=\"open\"\n        @click.outside=\"close()\"\n        x-transition:enter=\"transition ease-out duration-200\"\n        x-transition:enter-start=\"translate-y-4 sm:translate-y-0 sm:scale-95\"\n        x-transition:enter-end=\"translate-y-0 sm:scale-100\"\n        x-transition:leave=\"transition ease-in duration-150\"\n        x-transition:leave-start=\"opacity-100\"\n        x-transition:leave-end=\"opacity-0\"\n        class=\"w-full sm:max-w-xl rounded-2xl bg-white shadow-xl outline outline-1 outline-black/5 \"\n      >\n        <!-- Header -->\n        <div\n          class=\"flex items-center justify-between px-5 py-4 border-b border-base-100 \"\n        >\n          <div class=\"flex items-start gap-3\">\n            <div\n              class=\"size-9 rounded-full grid place-items-center bg-base-100 text-base-700 \"\n            >\n              <Stacked size=\"sm\" />\n            </div>\n            <div>\n              <Text\n                tag=\"h2\"\n                variant=\"textSM\"\n                id=\"plan-title\"\n                class=\"font-semibold text-base-900 \"\n              >\n                Choose Your AI Chat Plan\n              </Text>\n              <Text\n                tag=\"p\"\n                variant=\"textXS\"\n                class=\"text-base-600 \"\n              >\n                Unlock the power of AI conversations with flexible plans.\n              </Text>\n            </div>\n          </div>\n          <IconButton\n            variant=\"text\"\n            size=\"xxs\"\n            aria-label=\"Close\"\n            @click=\"close()\"><X size=\"sm\" /></IconButton\n          >\n        </div>\n\n        <!-- Content -->\n        <div class=\"p-5\">\n          <div class=\"flex flex-col gap-4\">\n            <!-- Basic card -->\n            <button\n              type=\"button\"\n              @click=\"selected='basic'\"\n              :class=\"selected==='basic' ? 'outline-2 outline-primary/88 bg-base-50 ' : 'outline-2 outline-base-200 bg-white '\"\n              class=\"text-left w-full rounded-xl p-4 hover:bg-base-50 grid grid-cols-1 md:grid-cols-2 gap-y-4\"\n            >\n              <div class=\"flex items-start justify-between\">\n                <div>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textXL\"\n                    class=\"font-semibold text-base-900 \"\n                  >\n                    $5/mth\n                  </Text>\n                  <Text\n                    tag=\"p\"\n                    variant=\"textSM\"\n                    class=\"text-sm font-medium text-base-800 \"\n                  >\n                    Basic Chat\n                  </Text>\n                  <Text\n                    tag=\"p\"\n                    variant=\"textXS\"\n                    class=\"text-base-500 \"\n                  >\n                    Billed monthly\n                  </Text>\n                </div>\n              </div>\n              <ul class=\"space-y-1 text-sm text-base-700 \">\n                <li class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" class=\"text-primary\" /> 100 AI messages per month\n                </li>\n                <li class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" class=\"text-primary\" /> Standard response quality\n                </li>\n                <li class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" class=\"text-primary\" /> Basic chat history\n                </li>\n                <li class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" class=\"text-primary\" /> Email support\n                </li>\n              </ul>\n            </button>\n\n            <!-- Business card -->\n            <button\n              type=\"button\"\n              @click=\"selected='business'\"\n              :class=\"selected==='business' ? 'outline-2 outline-primary/88 bg-base-50 ' : 'outline-2 outline-base-200 bg-white '\"\n              class=\"text-left w-full rounded-xl p-4 hover:bg-base-50 grid grid-cols-1 md:grid-cols-2 gap-y-4\"\n            >\n              <div class=\"flex items-start justify-between\">\n                <div>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textXL\"\n                    class=\"font-semibold text-base-900 \"\n                  >\n                    $15/mth\n                  </Text>\n                  <Text\n                    tag=\"p\"\n                    variant=\"textSM\"\n                    class=\"font-medium text-base-800 \"\n                  >\n                    Pro Chat\n                  </Text>\n                  <Text\n                    tag=\"p\"\n                    variant=\"textXS\"\n                    class=\"text-base-500 \"\n                  >\n                    Billed monthly\n                  </Text>\n                </div>\n              </div>\n              <ul class=\"space-y-1 text-sm text-base-700 \">\n                <li class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" class=\"text-primary\" /> Unlimited AI messages\n                </li>\n                <li class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" class=\"text-primary\" /> Advanced AI responses\n                </li>\n                <li class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" class=\"text-primary\" /> Full chat history\n                </li>\n                <li class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" class=\"text-primary\" /> Priority support\n                </li>\n              </ul>\n            </button>\n          </div>\n        </div>\n\n        <!-- Footer -->\n        <div\n          class=\"px-5 py-4 border-t border-base-100 flex items-center gap-3\"\n        >\n          <label\n            class=\"inline-flex items-center gap-2 text-sm text-base-700 \"\n          >\n            <input\n              type=\"checkbox\"\n              class=\"rounded border-base-300 text-primary focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 shadow size-4\"\n              x-model=\"dontShow\"\n            />\n            Don't show again\n          </label>\n\n          <div class=\"ml-auto flex items-center gap-2\">\n            <Button variant=\"outline\" size=\"xxs\" type=\"button\" @click=\"close()\"\n              >Cancel</Button\n            >\n            <Button variant=\"accent\" size=\"xxs\" type=\"button\" @click=\"confirm()\"\n              >Confirm</Button\n            >\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <!-- Copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
