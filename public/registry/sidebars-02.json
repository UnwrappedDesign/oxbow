{
  "name": "sidebars-02",
  "type": "component",
  "description": "sidebars block 02",
  "category": "application",
  "section": "sidebars",
  "variant": 2,
  "aliases": [
    "sidebars",
    "sidebars 2",
    "sidebars 02",
    "sidebar",
    "sidebar 2",
    "sidebar 02"
  ],
  "files": [
    {
      "name": "02.astro",
      "path": "oxbow/application/sidebars/02.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"opacity-0\",\n  \"opacity-100\",\n  \"translate-x-0\",\n  \"-translate-x-full\",\n  \"sm:translate-x-0\",\n];\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport X from \"@/components/fundations/icons/X.astro\";\nimport Home from \"@/components/fundations/icons/Home.astro\";\nimport Mail from \"@/components/fundations/icons/Mail.astro\";\nimport Tool from \"@/components/fundations/icons/Tool.astro\";\nimport Report from \"@/components/fundations/icons/Report.astro\";\nimport Burger from \"@/components/fundations/icons/Burger.astro\";\nimport Settings from \"@/components/fundations/icons/Settings.astro\";\nimport SearchIcon from \"@/components/fundations/icons/Search.astro\";\nimport Lifebuoy from \"@/components/fundations/icons/Lifebuoy.astro\";\nimport Clipboard from \"@/components/fundations/icons/Clipboard.astro\";\nimport UsersGroup from \"@/components/fundations/icons/UsersGroup.astro\";\nimport CircleInfo from \"@/components/fundations/icons/CircleInfo.astro\";\nimport ChevronDown from \"@/components/fundations/icons/ChevronDown.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\n---\n\n<div class=\"relative bg-white \">\n  <!-- copy:start -->\n  <!-- Mobile top bar -->\n  <div\n    class=\"lg:hidden sticky top-0 z-40 bg-white border-b border-base-200 \"\n  >\n    <div class=\"flex items-center justify-between px-4 h-12\">\n      <div class=\"flex items-center gap-2\">\n        <Logo class=\"text-base-900 h-6\" />\n        <span\n          class=\"text-sm\n          font-semibold\n          text-base-800\n          \"\n          >Oxbow UI</span\n        >\n      </div>\n      <IconButton\n        size=\"xxs\"\n        variant=\"muted\"\n        x-data\n        @click=\"$dispatch('sb02-toggle')\"\n        aria-label=\"Open navigation\"\n      >\n        <Burger size=\"sm\" />\n      </IconButton>\n    </div>\n  </div>\n  <!-- Shell -->\n  <div\n    x-data=\"{\n      open:false,\n      active:'inbox',\n      sections: { queues:true, knowledge:false, tools:false },\n      search:'',\n      filters: { mine:true, unassigned:false, sla:false },\n      tags: { billing:true, bug:false, feature:false }\n    }\"\n    @sb02-toggle.window=\"open=true\"\n    @keydown.escape.window=\"open=false\"\n    class=\"relative\"\n  >\n    <!-- Overlay -->\n    <div\n      class=\"fixed inset-0 z-40 bg-black/40 transition-opacity duration-200 lg:hidden\"\n      x-show=\"open\"\n      x-transition.opacity\n      @click=\"open=false\"\n      aria-hidden=\"true\"\n    >\n    </div>\n    <!-- Sidebar panel (distinct from 01: narrower + support use case) -->\n    <aside\n      class=\"fixed inset-y-0 left-0 z-50 w-72 lg:w-80 h-dvh lg:h-dvh lg:relative lg:inset-auto lg:left-auto transform transition-transform duration-200 -translate-x-full lg:translate-x-0 bg-white outline outline-1 outline-base-200 flex flex-col overflow-hidden\"\n      :class=\"open ? 'translate-x-0' : ''\"\n    >\n      <!-- Header -->\n      <div\n        class=\"h-14 shrink-0 flex items-center justify-between px-4 border-b border-base-100 \"\n      >\n        <div class=\"flex items-center gap-2\">\n          <Logo class=\"text-base-900 h-8\" />\n          <div>\n            <p\n              class=\"text-sm font-semibold text-base-900 leading-tight\"\n            >\n              Oxbow UI\n            </p>\n            <p class=\"text-[0.70rem] text-base-500 \">\n              Support Console\n            </p>\n          </div>\n        </div>\n        <IconButton\n          variant=\"muted\"\n          size=\"xxs\"\n          @click=\"open=false\"\n          aria-label=\"Close navigation\"\n          class=\"lg:hidden\"\n        >\n          <X size=\"sm\" />\n        </IconButton>\n      </div>\n      <!-- Search -->\n      <div class=\"p-3 lg:p-4\">\n        <label class=\"relative block\">\n          <span\n            class=\"absolute inset-y-0 left-0 pl-3 flex items-center text-base-500 \"\n            ><SearchIcon class=\"size-4\" /></span\n          >\n          <input\n            x-model=\"search\"\n            placeholder=\"Search tickets\"\n            class=\"w-full h-9 pl-9 pr-3 block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n          />\n        </label>\n      </div>\n      <!-- Navigation (scroll area; min-h-0 ensures inner overflow works in flex) -->\n      <nav class=\"flex-1 min-h-0 px-2 lg:px-3 pb-40 overflow-y-auto\">\n        <p\n          class=\"px-3 lg:px-4 text-[0.70rem] font-semibold tracking-wide text-base-500 \"\n        >\n          Support\n        </p>\n        <ul class=\"mt-1 space-y-1\">\n          <li>\n            <button\n              class=\"w-full h-9 px-3 rounded-md flex items-center gap-2 text-sm outline outline-1 outline-transparent hover:bg-base-50 \"\n              :class=\"active==='inbox' ? 'bg-white text-base-900 outline-white/10' : 'text-base-700 '\"\n              @click=\"active='inbox'\"\n            >\n              <Mail class=\"size-4\" />\n              <span>Inbox</span>\n              <span\n                class=\"ml-auto text-[0.70rem] px-1.5 py-0.5 rounded bg-white text-base-900 outline outline-1 outline-base-200 \"\n                >10</span\n              >\n            </button>\n          </li>\n          <li>\n            <button\n              class=\"w-full h-9 px-3 rounded-md flex items-center gap-2 text-sm outline outline-1 outline-transparent hover:bg-base-50 \"\n              :class=\"active==='dashboard' ? 'bg-white text-base-900 outline-white/10' : 'text-base-700 '\"\n              @click=\"active='dashboard'\"\n            >\n              <Home class=\"size-4\" />\n              <span>Dashboard</span>\n            </button>\n          </li>\n        </ul>\n        <div class=\"pt-3 mt-3 border-t border-base-100 \">\n          <p\n            class=\"px-3 lg:px-4 text-[0.70rem] font-semibold tracking-wide text-base-500 \"\n          >\n            Queues\n          </p>\n          <ul class=\"mt-1 space-y-1\">\n            <li>\n              <button\n                class=\"w-full h-9 px-3 rounded-md flex items-center justify-between text-sm text-base-700 hover:bg-base-50 \"\n                @click=\"sections.queues=!sections.queues\"\n                :aria-expanded=\"sections.queues\"\n              >\n                <span class=\"flex items-center gap-2\"\n                  ><Clipboard class=\"size-4\" /> Ticket queues</span\n                >\n                <span class=\"text-base-500 \"\n                  ><ChevronDown\n                    x-show=\"sections.queues\"\n                    class=\"size-4\"\n                  /><ChevronRight\n                    x-show=\"!sections.queues\"\n                    class=\"size-4\"\n                  /></span\n                >\n              </button>\n              <div x-show=\"sections.queues\" x-collapse x-cloak>\n                <ul class=\"mt-1 pl-2 space-y-1\">\n                  <li>\n                    <a\n                      href=\"#_\"\n                      class=\"flex items-center justify-between h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                      >Unassigned</a\n                    >\n                  </li>\n                  <li>\n                    <a\n                      href=\"#_\"\n                      class=\"flex items-center justify-between h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                      >My team</a\n                    >\n                  </li>\n                  <li>\n                    <a\n                      href=\"#_\"\n                      class=\"flex items-center justify-between h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                      >Escalations <span\n                        class=\"text-[0.70rem] px-1.5 py-0.5 rounded bg-white text-base-900 outline outline-1 outline-base-200 \"\n                        >3</span\n                      ></a\n                    >\n                  </li>\n                </ul>\n              </div>\n            </li>\n            <li>\n              <button\n                class=\"w-full h-9 px-3 rounded-md flex items-center justify-between text-sm text-base-700 hover:bg-base-50 \"\n                @click=\"sections.knowledge=!sections.knowledge\"\n                :aria-expanded=\"sections.knowledge\"\n              >\n                <span class=\"flex items-center gap-2\"\n                  ><CircleInfo class=\"size-4\" /> Knowledge</span\n                >\n                <span class=\"text-base-500 \"\n                  ><ChevronDown\n                    x-show=\"sections.knowledge\"\n                    class=\"size-4\"\n                  /><ChevronRight\n                    x-show=\"!sections.knowledge\"\n                    class=\"size-4\"\n                  /></span\n                >\n              </button>\n              <div x-show=\"sections.knowledge\" x-collapse x-cloak>\n                <ul class=\"mt-1 pl-2 space-y-1\">\n                  <li>\n                    <a\n                      href=\"#_\"\n                      class=\"flex items-center h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                      >Articles</a\n                    >\n                  </li>\n                  <li>\n                    <a\n                      href=\"#_\"\n                      class=\"flex items-center h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                      >Guides</a\n                    >\n                  </li>\n                  <li>\n                    <a\n                      href=\"#_\"\n                      class=\"flex items-center h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                      >Playbooks</a\n                    >\n                  </li>\n                </ul>\n              </div>\n            </li>\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center gap-2 h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                ><Tool class=\"size-4\" /> Macros</a\n              >\n            </li>\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center gap-2 h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                ><Report class=\"size-4\" /> Reports</a\n              >\n            </li>\n          </ul>\n        </div>\n        <!-- Administration -->\n        <div class=\"pt-3 mt-3 border-t border-base-100 \">\n          <p\n            class=\"px-3 lg:px-4 text-[0.70rem] font-semibold tracking-wide text-base-500 \"\n          >\n            Administration\n          </p>\n          <ul class=\"mt-1 space-y-1\">\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center gap-2 h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                ><UsersGroup class=\"size-4\" /> Teams</a\n              >\n            </li>\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center gap-2 h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                ><Settings class=\"size-4\" /> Preferences</a\n              >\n            </li>\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center gap-2 h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n                ><Lifebuoy class=\"size-4\" /> Help Center</a\n              >\n            </li>\n          </ul>\n        </div>\n        <!-- Quick filters -->\n        <div class=\"pt-3 mt-3 border-t border-base-100 \">\n          <p\n            class=\"px-3 text-[0.70rem] font-semibold tracking-wide text-base-500 \"\n          >\n            Quick filters\n          </p>\n          <div class=\"px-3 mt-2 flex flex-wrap gap-2\">\n            <button\n              @click=\"filters.mine=!filters.mine\"\n              class=\"h-7 px-2 rounded-md text-xs\"\n              :class=\"filters.mine ? 'bg-white text-base-900 ' : 'text-base-600 hover:bg-base-50 '\"\n              >My open</button\n            >\n            <button\n              @click=\"filters.unassigned=!filters.unassigned\"\n              class=\"h-7 px-2 rounded-md text-xs\"\n              :class=\"filters.unassigned ? 'bg-white text-base-900 ' : 'text-base-600 hover:bg-base-50 '\"\n              >Unassigned</button\n            >\n            <button\n              @click=\"filters.sla=!filters.sla\"\n              class=\"h-7 px-2 rounded-md text-xs\"\n              :class=\"filters.sla ? 'bg-white text-base-900 ' : 'text-base-600 hover:bg-base-50 '\"\n              >SLA</button\n            >\n          </div>\n        </div>\n        <!-- Tags -->\n        <div class=\"pt-3 mt-3 border-t border-base-100 \">\n          <p\n            class=\"px-3 text-[0.70rem] font-semibold tracking-wide text-base-500 \"\n          >\n            Tags\n          </p>\n          <ul class=\"mt-1 space-y-1\">\n            <li>\n              <button\n                @click=\"tags.billing=!tags.billing\"\n                class=\"w-full h-8 px-3 rounded-md flex items-center justify-between text-xs text-base-700 hover:bg-base-50 \"\n              >\n                <span>billing</span>\n                <span\n                  class=\"text-[0.70rem] px-1.5 py-0.5 rounded bg-white text-base-900 outline outline-1 outline-base-200 \"\n                  >18</span\n                >\n              </button>\n            </li>\n            <li>\n              <button\n                @click=\"tags.bug=!tags.bug\"\n                class=\"w-full h-8 px-3 rounded-md flex items-center justify-between text-xs text-base-700 hover:bg-base-50 \"\n              >\n                <span>bug</span>\n                <span\n                  class=\"text-[0.70rem] px-1.5 py-0.5 rounded bg-white text-base-900 outline outline-1 outline-base-200 \"\n                  >12</span\n                >\n              </button>\n            </li>\n            <li>\n              <button\n                @click=\"tags.feature=!tags.feature\"\n                class=\"w-full h-8 px-3 rounded-md flex items-center justify-between text-xs text-base-700 hover:bg-base-50 \"\n              >\n                <span>feature</span>\n                <span\n                  class=\"text-[0.70rem] px-1.5 py-0.5 rounded bg-white text-base-900 outline outline-1 outline-base-200 \"\n                  >7</span\n                >\n              </button>\n            </li>\n          </ul>\n        </div>\n        <!-- Pinned -->\n        <div class=\"pt-3 mt-3 border-t border-base-100 \">\n          <p\n            class=\"px-3 text-[0.70rem] font-semibold tracking-wide text-base-500 \"\n          >\n            Pinned\n          </p>\n          <ul class=\"mt-1 space-y-1\">\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center justify-between h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n              >\n                <span class=\"flex items-center gap-2\">\n                  <Mail class=\"size-4\" />\n                  <span>High priority escalation</span>\n                </span>\n                <span class=\"text-xs text-destructive \"\n                  >Urgent</span\n                >\n              </a>\n            </li>\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center justify-between h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n              >\n                <span class=\"flex items-center gap-2\">\n                  <Mail class=\"size-4\" />\n                  <span>Customer feedback review</span>\n                </span>\n                <span class=\"text-xs text-warning \"\n                  >Review</span\n                >\n              </a>\n            </li>\n          </ul>\n        </div>\n        <!-- Recent Tickets -->\n        <div class=\"pt-3 mt-3 border-t border-base-100 \">\n          <p\n            class=\"px-3 text-[0.70rem] font-semibold tracking-wide text-base-500 \"\n          >\n            Recent Tickets\n          </p>\n          <ul class=\"mt-1 space-y-1\">\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center justify-between h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n              >\n                <span class=\"flex items-center gap-2\">\n                  <Mail class=\"size-4\" />\n                  <span>Ticket #1234</span>\n                </span>\n                <span class=\"text-xs text-base-500 \"\n                  >2m ago</span\n                >\n              </a>\n            </li>\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center justify-between h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n              >\n                <span class=\"flex items-center gap-2\">\n                  <Mail class=\"size-4\" />\n                  <span>Ticket #1233</span>\n                </span>\n                <span class=\"text-xs text-base-500 \"\n                  >5m ago</span\n                >\n              </a>\n            </li>\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center justify-between h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n              >\n                <span class=\"flex items-center gap-2\">\n                  <Mail class=\"size-4\" />\n                  <span>Ticket #1232</span>\n                </span>\n                <span class=\"text-xs text-base-500 \"\n                  >10m ago</span\n                >\n              </a>\n            </li>\n            <li>\n              <a\n                href=\"#_\"\n                class=\"flex items-center justify-between h-9 px-3 rounded-md text-sm text-base-700 hover:bg-base-50 \"\n              >\n                <span class=\"flex items-center gap-2\">\n                  <Mail class=\"size-4\" />\n                  <span>Ticket #1231</span>\n                </span>\n                <span class=\"text-xs text-base-500 \"\n                  >15m ago</span\n                >\n              </a>\n            </li>\n          </ul>\n        </div>\n        <!-- Shortcuts -->\n        <div class=\"pt-3 mt-3 border-t border-base-100 \">\n          <p\n            class=\"px-3 text-[0.70rem] font-semibold tracking-wide text-base-500 \"\n          >\n            Shortcuts\n          </p>\n          <div class=\"px-3 mt-2 flex flex-wrap gap-2\">\n            <button\n              class=\"h-7 px-2 rounded-md text-xs text-base-600 hover:bg-base-50 \"\n            >\n              New ticket\n            </button>\n            <button\n              class=\"h-7 px-2 rounded-md text-xs text-base-600 hover:bg-base-50 \"\n            >\n              Bulk assign\n            </button>\n            <button\n              class=\"h-7 px-2 rounded-md text-xs text-base-600 hover:bg-base-50 \"\n            >\n              Export\n            </button>\n            <button\n              class=\"h-7 px-2 rounded-md text-xs text-base-600 hover:bg-base-50 \"\n            >\n              Archive\n            </button>\n          </div>\n        </div>\n      </nav>\n      <!-- Sticky footer: pinned at bottom; dropdown overlays upward -->\n      <div class=\"sticky bottom-0 z-10 bg-white border-t border-base-100 \">\n        <div class=\"p-3 lg:p-4 space-y-3\">\n          <div class=\"rounded-lg outline outline-1 outline-base-200 bg-white p-3\">\n            <p class=\"text-xs font-medium text-base-700 \">Status</p>\n            <p class=\"mt-1 text-xs text-base-500 \">Queue health is stable. 2 open incidents.</p>\n            <div class=\"mt-2 flex items-center justify-between\">\n              <Button type=\"button\" variant=\"outline\" size=\"xxs\">View report</Button>\n              <Button type=\"button\" variant=\"muted\" size=\"xxs\">Dismiss</Button>\n            </div>\n          </div>\n        </div>\n        <div class=\"px-3 pb-3 lg:px-4 lg:pb-4\">\n          <div x-data=\"{ open:false }\" class=\"relative\">\n            <button class=\"w-full flex items-center justify-between gap-3 p-2 rounded-lg hover:bg-base-50 \" @click=\"open=!open\">\n              <span class=\"flex items-center gap-3\">\n                <img src=\"/avatars/2.jpg\" alt=\"Avatar\" class=\"size-8 rounded-full\" />\n                <span class=\"text-left\">\n                  <span class=\"block text-sm font-medium text-base-900 \">Ricardo S.</span>\n                  <span class=\"block text-xs text-base-500 \">ricardo@oxbowui.com</span>\n                </span>\n              </span>\n              <ChevronDown class=\"size-4 text-base-600 \" />\n            </button>\n            <div x-show=\"open\" x-transition.opacity @click.outside=\"open=false\" class=\"absolute left-0 right-0 bottom-14 z-50 rounded-lg bg-white shadow-xl overflow-hidden\">\n              <div class=\"p-2 text-sm\">\n                <a href=\"#_\" class=\"flex items-center h-9 px-2 rounded-md text-base-700 hover:bg-base-50 \">View profile</a>\n                <a href=\"#_\" class=\"flex items-center h-9 px-2 rounded-md text-base-700 hover:bg-base-50 \">Account</a>\n                <a href=\"#_\" class=\"flex items-center h-9 px-2 rounded-md text-base-700 hover:bg-base-50 \">Docs</a>\n              </div>\n              <div class=\"border-t border-base-100 p-2\">\n                <Button type=\"button\" variant=\"muted\" class=\"w-full\" size=\"xxs\">Sign out</Button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </aside>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
