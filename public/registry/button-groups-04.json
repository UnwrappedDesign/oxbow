      "name": "04.astro",
      "path": "oxbow/application/button-groups/04.astro",
      "content": "---\n\nexport const description = \"Icon toolbar\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Search from \"@/components/fundations/icons/Search.astro\";\nimport Refresh from \"@/components/fundations/icons/Refresh.astro\";\nimport Settings from \"@/components/fundations/icons/Settings.astro\";\nimport Download from \"@/components/fundations/icons/Download.astro\";\n---\n\n<section class=\"flex items-center justify-center bg-background p-18\">\n  <!-- copy:start -->\n  <div\n    class=\"inline-flex items-center overflow-hidden rounded-full border border-border bg-background shadow-sm\"\n    role=\"toolbar\"\n    aria-label=\"Table actions\"\n  >\n    <Button\n      variant=\"icon\"\n      size=\"sm\"\n      iconOnly\n      type=\"button\"\n      noRounded\n      class=\"border-r border-border transition-none\"\n      aria-label=\"Search\"\n    >\n      <Search slot=\"left-icon\" size=\"sm\" />\n    </Button>\n    <Button\n      variant=\"icon\"\n      size=\"sm\"\n      iconOnly\n      type=\"button\"\n      noRounded\n      class=\"border-r border-border transition-none\"\n      aria-label=\"Refresh\"\n    >\n      <Refresh slot=\"left-icon\" size=\"sm\" />\n    </Button>\n    <Button\n      variant=\"icon\"\n      size=\"sm\"\n      iconOnly\n      type=\"button\"\n      noRounded\n      class=\"border-r border-border transition-none\"\n      aria-label=\"Settings\"\n    >\n      <Settings slot=\"left-icon\" size=\"sm\" />\n    </Button>\n    <Button\n      variant=\"accent\"\n      size=\"sm\"\n      iconOnly\n      type=\"button\"\n      noRounded\n      class=\"transition-none\"\n      aria-label=\"Download\"\n    >\n      <Download slot=\"left-icon\" size=\"sm\" />\n    </Button>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
  ],
