  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/marketing/contact/03.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-xl mx-auto text-center lg:text-balance\">\n      <Kicker>Get in Touch</Kicker>\n      <Text\n        tag=\"h1\"\n        variant=\"displayMD\"\n        class=\"mt-12 font-semibold tracking-tight text-base-900 lg:text-balance\"\n      >\n        Reach out to our team today\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-4 lg:text-balance text-base-500 \"\n      >\n        We’re here to answer your questions, discuss your ideas, or help you get\n        started. Let’s connect and make something great happen together.\n      </Text>\n    </div>\n    <dl\n      class=\"relative max-w-2xl mx-auto mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2\"\n    >\n      <div\n        class=\"relative flex flex-col justify-between h-full shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl group\"\n      >\n        <a class=\"absolute inset-0\" href=\"#_\"> </a>\n        <dt\n          class=\"flex items-center justify-between w-full p-8 text-lg font-medium tracking-tight text-base-900 \"\n        >\n          Send us an email\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"24\"\n            height=\"24\"\n            viewBox=\"0 0 24 24\"\n            fill=\"currentColor\"\n            class=\"icon icon-tabler icons-tabler-filled icon-tabler-circle-arrow-right group-hover:-rotate-45 duration-300\"\n            ><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path><path\n              d=\"M12 2l.324 .005a10 10 0 1 1 -.648 0l.324 -.005zm.613 5.21a1 1 0 0 0 -1.32 1.497l2.291 2.293h-5.584l-.117 .007a1 1 0 0 0 .117 1.993h5.584l-2.291 2.293l-.083 .094a1 1 0 0 0 1.497 1.32l4 -4l.073 -.082l.064 -.089l.062 -.113l.044 -.11l.03 -.112l.017 -.126l.003 -.075l-.007 -.118l-.029 -.148l-.035 -.105l-.054 -.113l-.071 -.111a1.008 1.008 0 0 0 -.097 -.112l-4 -4z\"\n            ></path></svg\n          >\n        </dt>\n        <dd\n          class=\"p-8 text-sm border-t text-balance text-base-600 border-base-200 \"\n        >\n          Please contact us by sending an email or the contact below.\n        </dd>\n      </div>\n      <div\n        class=\"relative flex flex-col justify-between h-full shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl group\"\n      >\n        <a class=\"absolute inset-0\" href=\"#_\"> </a>\n        <dt\n          class=\"flex items-center justify-between w-full p-8 text-lg font-medium tracking-tight text-base-900 \"\n        >\n          Join us\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"24\"\n            height=\"24\"\n            viewBox=\"0 0 24 24\"\n            fill=\"currentColor\"\n            class=\"icon icon-tabler icons-tabler-filled icon-tabler-circle-arrow-right group-hover:-rotate-45 duration-300\"\n            ><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path><path\n              d=\"M12 2l.324 .005a10 10 0 1 1 -.648 0l.324 -.005zm.613 5.21a1 1 0 0 0 -1.32 1.497l2.291 2.293h-5.584l-.117 .007a1 1 0 0 0 .117 1.993h5.584l-2.291 2.293l-.083 .094a1 1 0 0 0 1.497 1.32l4 -4l.073 -.082l.064 -.089l.062 -.113l.044 -.11l.03 -.112l.017 -.126l.003 -.075l-.007 -.118l-.029 -.148l-.035 -.105l-.054 -.113l-.071 -.111a1.008 1.008 0 0 0 -.097 -.112l-4 -4z\"\n            ></path></svg\n          >\n        </dt>\n        <dd\n          class=\"p-8 text-sm border-t text-balance text-base-600 border-base-200 \"\n        >\n          Be a part of our welcoming and supportive community on Circle.\n        </dd>\n      </div>\n    </dl>\n    <form action=\"#\" method=\"POST\" class=\"max-w-xl mx-auto mt-12\">\n      <div class=\"mt-12 grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2\">\n        <div>\n          <label\n            for=\"first-name\"\n            class=\"text-sm font-medium text-base-500 \"\n          >\n            First name\n          </label>\n          <div class=\"mt-1\">\n            <input\n              type=\"text\"\n              name=\"first-name\"\n              id=\"first-name\"\n              autocomplete=\"given-name\"\n              required\n              aria-required=\"true\"\n              aria-describedby=\"first-name-error\"\n              placeholder=\"Your first name\"\n              class=\"block w-full h-10 px-4 py-2 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n            />\n            <span id=\"first-name-error\" class=\"hidden text-sm text-destructive\">\n              Please enter your first name.\n            </span>\n          </div>\n        </div>\n        <div>\n          <label\n            for=\"last-name\"\n            class=\"text-sm font-medium text-base-500 \"\n          >\n            Last name\n          </label>\n          <div class=\"mt-1\">\n            <input\n              type=\"text\"\n              name=\"last-name\"\n              id=\"last-name\"\n              autocomplete=\"family-name\"\n              required\n              aria-required=\"true\"\n              aria-describedby=\"last-name-error\"\n              placeholder=\"Your last name\"\n              class=\"block w-full h-10 px-4 py-2 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n            />\n            <span id=\"last-name-error\" class=\"hidden text-sm text-destructive\">\n              Please enter your last name.\n            </span>\n          </div>\n        </div>\n        <div class=\"sm:col-span-2\">\n          <label\n            for=\"compant\"\n            class=\"text-sm font-medium text-base-500 \"\n          >\n            Company name\n          </label>\n          <div class=\"mt-1\">\n            <input\n              type=\"text\"\n              name=\"company\"\n              id=\"company\"\n              autocomplete=\"organization\"\n              aria-describedby=\"company-error\"\n              placeholder=\"Your company\"\n              class=\"block w-full h-10 px-4 py-2 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n            />\n            <span id=\"company-error\" class=\"hidden text-sm text-destructive\">\n              Please enter your company name.\n            </span>\n          </div>\n        </div>\n        <div class=\"sm:col-span-2\">\n          <label\n            for=\"phone-number\"\n            class=\"text-sm font-medium text-base-500 \"\n          >\n            Phone number\n          </label>\n          <div class=\"relative mt-2.5\">\n            <div class=\"absolute inset-y-0 left-0 flex items-center\">\n              <label for=\"country\" class=\"sr-only\">Country</label>\n              <select\n                id=\"country\"\n                name=\"country\"\n                aria-label=\"Country code\"\n                class=\"h-full py-0 pl-4 bg-transparent border-0 rounded-md pr-9 text-base-400 focus:ring-2 focus:ring-inset focus:ring-primary sm:text-sm\"\n              >\n                <option value=\"IT\">Italy</option>\n                <option value=\"ES\">Spain</option>\n                <option value=\"JP\">Japan</option>\n              </select>\n            </div>\n            <input\n              type=\"tel\"\n              name=\"phone-number\"\n              id=\"phone-number\"\n              autocomplete=\"tel\"\n              aria-describedby=\"phone-number-description\"\n              placeholder=\"123-456-7890\"\n              class=\"block w-full h-10 px-4 py-2 pl-24 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n            />\n            <p id=\"phone-number-description\" class=\"sr-only\">\n              Enter your phone number including the country code.\n            </p>\n          </div>\n        </div>\n        <div class=\"sm:col-span-2\">\n          <label\n            for=\"email\"\n            class=\"text-sm font-medium text-base-500 \"\n          >\n            Email\n          </label>\n          <div class=\"mt-1\">\n            <input\n              type=\"email\"\n              name=\"email\"\n              id=\"email\"\n              autocomplete=\"email\"\n              required\n              aria-required=\"true\"\n              aria-describedby=\"email-error\"\n              placeholder=\"Your email\"\n              class=\"block w-full h-10 px-4 py-2 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n            />\n            <span id=\"email-error\" class=\"hidden text-sm text-destructive\">\n              Please enter a valid email address.\n            </span>\n          </div>\n        </div>\n        <div class=\"sm:col-span-2\">\n          <label\n            for=\"message\"\n            class=\"text-sm font-medium text-base-500 \"\n          >\n            Message\n          </label>\n          <div class=\"mt-1\">\n            <textarea\n              name=\"message\"\n              id=\"message\"\n              rows=\"5\"\n              aria-describedby=\"message-error\"\n              placeholder=\"Your message\"\n              class=\"block w-full px-4 py-2 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n            ></textarea>\n            <span id=\"message-error\" class=\"hidden text-sm text-destructive\">\n              Please enter your message.\n            </span>\n          </div>\n        </div>\n      </div>\n      <Button class=\"w-full mt-8\" variant=\"default\" size=\"base\">\n        Submit\n      </Button>\n      <div class=\"flex items-center mt-4 gap-3\">\n        <input\n          id=\"agreement\"\n          name=\"agreement\"\n          type=\"checkbox\"\n          class=\"text-primary rounded shadow size-4 border-base-300 focus:ring-primary\"\n        />\n        <label\n          for=\"agreement\"\n          class=\"block ml-3 text-sm text-base-500 \"\n        >\n          You agree to our\n          <a\n            href=\"#_\"\n            class=\"ont-medium text-base-900 hover:text-primary \"\n          >\n            Terms of service\n          </a>\n          and\n          <a\n            href=\"#_\"\n            class=\"ont-medium text-base-900 hover:text-primary \"\n          >\n            Privacy Policy\n          </a>\n        </label>\n      </div>\n    </form>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
