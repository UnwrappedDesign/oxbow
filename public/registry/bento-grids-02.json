    {
      "name": "02.astro",
      "path": "oxbow/marketing/bento-grids/02.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nconst data = [\n  { src: \"/integrations/1.svg\", alt: \"integration 1\" },\n  { src: \"/integrations/2.svg\", alt: \"integration 2\" },\n  { src: \"/integrations/3.svg\", alt: \"integration 3\" },\n  { src: \"/integrations/4.svg\", alt: \"integration 4\" },\n  { src: \"/integrations/5.svg\", alt: \"integration 5\" },\n  { src: \"/integrations/6.svg\", alt: \"integration 6\" },\n  { src: \"/integrations/7.svg\", alt: \"integration 7\" },\n  { src: \"/integrations/8.svg\", alt: \"integration 8\" },\n  { src: \"/integrations/9.svg\", alt: \"integration 9\" },\n  { src: \"/integrations/10.svg\", alt: \"integration 10\" },\n  { src: \"/integrations/11.svg\", alt: \"integration 11\" },\n  { src: \"/integrations/12.svg\", alt: \"integration 12\" },\n  { src: \"/integrations/13.svg\", alt: \"integration 13\" },\n  { src: \"/integrations/14.svg\", alt: \"integration 14\" },\n  { src: \"/integrations/15.svg\", alt: \"integration 15\" },\n  { src: \"/integrations/16.svg\", alt: \"integration 16\" },\n  { src: \"/integrations/17.svg\", alt: \"integration 17\" },\n  { src: \"/integrations/18.svg\", alt: \"integration 18\" },\n  { src: \"/integrations/19.svg\", alt: \"integration 19\" },\n  { src: \"/integrations/20.svg\", alt: \"integration 20\" },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"grid grid-cols-1 gap-2 lg:grid-cols-2\">\n      <div class=\"h-full grid grid-cols-1 gap-2 lg:grid-cols-2\">\n        <div\n          class=\"h-full grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-1\"\n        >\n          <div\n            class=\"p-8 shadow bg-background outline outline-border rounded-xl\"\n          >\n            <Kicker> Integration </Kicker>\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"mt-4 font-medium text-foreground\"\n            >\n              Easy Integration\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"mt-2 font-medium text-muted-foreground\"\n            >\n              Integrating with existing systems is smooth and hassle-free,\n              thanks to our incredible flexible approach.\n            </Text>\n          </div>\n          <div\n            class=\"items-center p-8 overflow-hidden shadow bg-background outline outline-border rounded-xl\"\n          >\n            <div\n              class=\"[-webkit-mask-image:radial-gradient(56.81%_53.42%_at_50%_46.58%,_rgba(217,217,217,0.9)_24.36%,rgba(217,217,217,0)_100%)]\"\n            >\n              <div class=\"flex flex-wrap justify-evenly gap-2\">\n                {\n                  data.map((item) => (\n                    <img class=\"w-auto h-auto\" alt={item.alt} src={item.src} />\n                  ))\n                }\n              </div>\n            </div>\n          </div>\n        </div>\n        <div class=\"relative flex flex-col items-center justify-center\">\n          <img\n            class=\"relative object-cover h-full rounded-xl\"\n            src=\"/bgs/3.jpeg\"\n            alt=\"\"\n          />\n          <div class=\"absolute bottom-0 w-full p-4\">\n            <Button size=\"sm\" variant=\"outline\" class=\"w-full\">\n              See our integrations\n            </Button>\n          </div>\n        </div>\n      </div>\n      <div class=\"h-full grid grid-cols-1 gap-2 lg:grid-cols-2\">\n        <div\n          class=\"relative flex flex-col justify-between h-full overflow-hidden shadow bg-background outline outline-border rounded-xl\"\n        >\n          <div class=\"relative p-8 mt-auto\">\n            <Kicker> Features </Kicker>\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"mt-4 font-medium text-foreground\"\n            >\n              Functionality\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"mt-2 font-medium text-muted-foreground\"\n            >\n              Equipped with advanced features and tools, our solution\n              effortlessly manages complex tasks and workflows.\n            </Text>\n          </div>\n          <div class=\"ml-8 -mb-4 lg:absolute -top-2 -right-8\">\n            <img\n              class=\"w-full h-full shadow rounded-l-xl\"\n              src=\"/widgets/sliders.svg\"\n              alt=\"\"\n            />\n          </div>\n        </div>\n        <div\n          class=\"relative flex flex-col justify-between h-full overflow-hidden shadow bg-background outline outline-border rounded-xl\"\n        >\n          <div class=\"relative p-8\">\n            <Kicker> Planning </Kicker>\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"mt-4 font-medium text-foreground\"\n            >\n              Plan smarter, not harder\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"mt-2 font-medium text-muted-foreground\"\n            >\n              Organize your schedule with intelligent automation and never miss\n              a beat, no matter how busy your day gets.\n            </Text>\n          </div>\n          <div class=\"ml-8 -mb-4 lg:absolute -bottom-4 -right-8\">\n            <img\n              class=\"h-full shadow rounded-l-xl\"\n              src=\"/widgets/calendar.svg\"\n              alt=\"\"\n            />\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
