    {
      "name": "07.astro",
      "path": "oxbow/application/navbars/07.astro",
      "content": "---\nexport const freeComponent = true;\nexport const excludeFromObfuscation = [\"flex\", \"hidden\"];\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport Burger from \"@/components/fundations/icons/Burger.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport ChevronDown from \"@/components/fundations/icons/ChevronDown.astro\";\nimport FlyoutLinkBox from \"@/components/fundations/wrappers/FlyoutLinkBox.astro\";\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\n---\n\n<div class=\"bg-white pb-100\">\n  <!-- copy:start -->\n  <header\n    class=\"w-full bg-white border-b border-base-200 \"\n  >\n    <div\n      x-data=\"{ open:false, cats:false }\"\n      class=\"px-6 mx-auto max-w-screen-xl md:px-10 lg:px-16\"\n    >\n      <div class=\"flex items-center justify-between h-16 gap-3\">\n        <a href=\"#_\" class=\"inline-flex items-center gap-2\"\n          ><Logo class=\"text-black h-7 \" /><span class=\"sr-only\"\n            >Home</span\n          ></a\n        >\n        <div class=\"items-center hidden md:flex gap-2\">\n          <div x-data=\"{open:false}\" class=\"relative\">\n            <Button\n              size=\"xs\"\n              variant=\"ghost\"\n              @click=\"open=!open\"\n              @keydown.escape.window=\"open=false\"\n              :aria-expanded=\"open\"\n              class=\"flex items-center justify-between gap-2\"\n              >Categories\n              <ChevronDown\n                size=\"sm\"\n                slot=\"right-icon\"\n                :class=\"open ? '-rotate-180' : ''\"\n                class=\"duration-300 ease-out transform\"\n              />\n            </Button>\n            <div\n              x-show=\"open\"\n              x-transition\n              @click.outside=\"open=false\"\n              class=\"absolute left-0 top-full z-30 mt-2 w-[680px] rounded-xl border border-base-200 bg-white shadow-subtle p-4 grid grid-cols-3 gap-3\"\n            >\n              <FlyoutLinkBox\n                href=\"#_\"\n                title=\"Men\"\n                description=\"Clothing & accessories\"\n              />\n              <FlyoutLinkBox\n                href=\"#_\"\n                title=\"Women\"\n                description=\"Latest arrivals\"\n              />\n              <FlyoutLinkBox href=\"#_\" title=\"Kids\" description=\"New season\" />\n              <FlyoutLinkBox\n                href=\"#_\"\n                title=\"Home\"\n                description=\"Decor & furniture\"\n              />\n              <FlyoutLinkBox\n                href=\"#_\"\n                title=\"Electronics\"\n                description=\"Gadgets & audio\"\n              />\n              <FlyoutLinkBox\n                href=\"#_\"\n                title=\"Sports\"\n                description=\"Outdoor & fitness\"\n              />\n            </div>\n          </div>\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-600 hover:text-base-900\"\n            >Deals</Text\n          >\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-600 hover:text-base-900\"\n            >New</Text\n          >\n        </div>\n        <div class=\"items-center hidden md:flex gap-2\">\n          <Button variant=\"muted\" size=\"xs\">Cart (2)</Button>\n          <Button variant=\"accent\" size=\"xs\">Checkout</Button>\n        </div>\n        <IconButton\n          class=\"md:hidden\"\n          @click=\"open=!open\"\n          :aria-expanded=\"open\"\n          aria-controls=\"nav-07\"\n          variant=\"muted\"\n          size=\"xs\"\n        >\n          <Burger size=\"xs\" slot=\"icon\" />\n        </IconButton>\n      </div>\n      <div\n        id=\"nav-07\"\n        :class=\"{ 'grid': open, 'hidden': !open }\"\n        class=\"hidden pb-4 grid-cols-1 gap-2 md:hidden\"\n      >\n        <details>\n          <summary\n            class=\"items-start justify-between w-full text-sm font-medium text-left select-none grid grid-cols-4 text-base-900 hover:text-base-500 focus:text-base-500 \"\n            ><span class=\"col-span-3\">Categories</span>\n            <Plus\n              class=\"ml-auto duration-300 ease-out transform group-open:-rotate-45 group-open:text-primary \"\n              size=\"sm\"\n            />\n          </summary>\n          <div\n            class=\"py-2 pt-2 text-sm text-base-500 space-y-2\"\n          >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-base-500 \">Men</Text\n            >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-base-500 \">Women</Text\n            >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-base-500 \">Kids</Text\n            >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-base-500 \">Home</Text\n            >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-base-500 \"\n              >Electronics</Text\n            >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-base-500 \">Sports</Text\n            >\n          </div>\n        </details>\n\n        <Button variant=\"muted\" size=\"xs\">Deals</Button>\n        <Button variant=\"muted\" size=\"xs\">NEw</Button>\n        <Button variant=\"muted\" size=\"xs\">Cart (2)</Button>\n        <Button variant=\"accent\" size=\"xs\">Checkout</Button>\n      </div>\n    </div>\n  </header>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
