      "name": "07.astro",
      "path": "oxbow/application/button-groups/07.astro",
      "content": "---\n\nexport const description = \"View toggle\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Grid from \"@/components/fundations/icons/Grid.astro\";\nimport List from \"@/components/fundations/icons/List.astro\";\nimport Chart from \"@/components/fundations/icons/Analytics.astro\";\n---\n\n<section class=\"flex items-center justify-center bg-background p-18\">\n  <!-- copy:start -->\n  <div\n    class=\"inline-flex overflow-hidden rounded-full border border-border bg-background text-sm shadow-sm\"\n    role=\"group\"\n    aria-label=\"Change view mode\"\n  >\n    <Button variant=\"accent\" size=\"sm\" type=\"button\" noRounded aria-pressed=\"true\">\n      <Grid slot=\"left-icon\" size=\"sm\" />\n      Grid\n    </Button>\n    <Button\n      variant=\"muted\"\n      size=\"sm\"\n      type=\"button\"\n      noRounded\n      aria-pressed=\"false\"\n    >\n      <List slot=\"left-icon\" size=\"sm\" />\n      List\n    </Button>\n    <Button\n      variant=\"muted\"\n      size=\"sm\"\n      type=\"button\"\n      noRounded\n      aria-pressed=\"false\"\n    >\n      <Chart slot=\"left-icon\" size=\"sm\" />\n      Insights\n    </Button>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
