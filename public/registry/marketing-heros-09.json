  "files": [
    {
      "name": "09.astro",
      "path": "oxbow/marketing/marketing-heros/09.astro",
      "content": "---\nexport const description = \"Simple with center text and image\";\nimport { Image } from \"astro:assets\";\nimport DashboardLight from \"@/images/assets/dashboardLight.svg\";\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nconst stats = [\n  {\n    label: \"Working Individuals\",\n    value: \"30%\",\n  },\n  {\n    label: \"Super low fee\",\n    value: \"40%\",\n  },\n  {\n    label: \"Great Commitment\",\n    value: \"50%\",\n  },\n  {\n    label: \"Massive Earnings\",\n    value: \"60M\",\n  },\n];\n---\n\n<section class=\"overflow-hidden bg-white lg:p-8 \">\n  <div\n    class=\"w-full px-8 py-20 pb-0 mx-auto overflow-hidden md:px-12 lg:px-42 2xl:max-w-7xl bg-linear-45 from-base-50 to-base-100 lg:rounded-xl\"\n  >\n    <div class=\"max-w-xl\">\n      <Kicker\n        showLink={true}\n        href=\"#_\"\n        linkText=\"See all features\"\n        class=\"text-primary/88 \"\n      >\n        Less busywork, more results\n      </Kicker>\n      <Text\n        tag=\"h2\"\n        variant=\"displayMD\"\n        class=\"mt-12 font-semibold tracking-tight text-base-900 lg:text-balance\"\n      >\n        Collaboration that just works\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textSM\"\n        class=\"mt-4 text-base-500 lg:text-balance\"\n      >\n        Launch projects, invite your team, and keep everything in sync—without\n        the headaches.\n      </Text>\n\n      <div class=\"flex flex-wrap items-center mt-8 gap-2\">\n        <Button variant=\"accent\" size=\"sm\">Start now</Button>\n        <Button variant=\"muted\" size=\"sm\">See pricing</Button>\n      </div>\n    </div>\n    <div class=\"mt-12 grid grid-cols-2 gap-4 sm:grid-cols-2 md:grid-cols-4\">\n      {\n        stats.map((stat) => (\n          <div class=\"flex flex-col\">\n            <Text\n              tag=\"p\"\n              variant=\"textBase\"\n              class=\"font-medium  text-base-900 \"\n            >\n              {stat.value}\n            </Text>\n            <Text\n              tag=\"h3\"\n              variant=\"textSM\"\n              class=\"font-medium  text-base-500 \"\n            >\n              {stat.label}\n            </Text>\n          </div>\n        ))\n      }\n    </div>\n    <div\n      class=\"relative mt-4 overflow-hidden rounded-t-lg shadow outline outline-base-200 \"\n    >\n      <Image\n        width={1200}\n        height={1200}\n        loading=\"eager\"\n        decoding=\"async\"\n        alt=\"dashboard\"\n        src={DashboardLight}\n        class=\"object-cover h-full -mb-12\"\n      />\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
