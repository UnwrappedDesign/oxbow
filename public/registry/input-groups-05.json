  "files": [
    {
      "name": "05.astro",
      "path": "oxbow/application/input-groups/05.astro",
      "content": "---\nexport const description = \"Quick search input group\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n// Icons\nimport Command from \"@/components/fundations/icons/Command.astro\";\n---\n\n<section class=\"justify-center h-full bg-background gap-2 p-15\">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"flex w-full\">\n      <TextInput\n        id=\"search\"\n        name=\"search\"\n        type=\"search\"\n        placeholder=\"Search...\"\n        variant=\"default\"\n        size=\"sm\"\n        noRoundedRight\n        isGrouped\n        class=\"flex-1\"\n      />\n      <Button\n        onlyIconSize=\"sm\"\n        type=\"submit\"\n        size=\"sm\"\n        variant=\"outline\"\n        noRoundedLeft={true}\n      >\n        <Command slot=\"left-icon\" size=\"sm\" />\n      </Button>\n    </div>\n    <!-- copy:end -->\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
