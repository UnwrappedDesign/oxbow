      "content": "---\nexport const description = \"No Results Found State\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<div\n  class=\"flex items-center justify-center p-8 py-24 bg-background\"\n>\n  <!-- copy:start -->\n  <div>\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"24\"\n      height=\"24\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      class=\"mx-auto icon icon-tabler icons-tabler-outline icon-tabler-search size-6 text-muted-foreground\"\n      ><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path><path\n        d=\"M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\"></path><path\n        d=\"M21 21l-6 -6\"></path></svg\n    >\n    <Text\n      tag=\"h3\"\n      variant=\"textBase\"\n      class=\"mt-8 font-medium text-center text-foreground\"\n    >\n      No Matches Found\n    </Text>\n    <Text\n      tag=\"p\"\n      variant=\"textSM\"\n      class=\"w-2/3 mx-auto mt-2 font-medium text-center text-muted-foreground text-balance\"\n    >\n      We couldn't find any results for your search. Try adjusting your keywords\n      or filters.\n    </Text>\n    <div class=\"flex flex-col justify-center mt-4 sm:flex-row gap-3\">\n      <Button class=\"\" size=\"xs\" variant=\"default\"> Clear Filters </Button>\n      <Button class=\"\" size=\"xs\" variant=\"muted\"> Expand Search </Button>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
