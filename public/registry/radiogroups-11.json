{
  "name": "radiogroups-11",
  "type": "component",
  "description": "Radio Group for Theme Selection",
  "category": "application",
  "section": "radiogroups",
  "variant": 11,
  "aliases": [
    "radiogroups",
    "radiogroups 11",
