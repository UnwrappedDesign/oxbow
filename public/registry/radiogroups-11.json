  "files": [
    {
      "name": "11.astro",
      "path": "oxbow/application/radiogroups/11.astro",
      "content": "---\nexport const excludeFromObfuscation = [\"text-base-600\", \"text-base-500\"];\nexport const description = \"Radio Group for Theme Selection\";\n---\n\n<div class=\"flex justify-center p-16 mx-auto bg-white \">\n  <div class=\"mx-auto mx-w-sm\">\n    <!-- copy:start -->\n    <div class=\"flex flex-col gap-2\" x-data=\"{ theme: 'light' }\">\n      <p class=\"text-sm font-medium text-base-500 \">\n        Choose a theme\n      </p>\n      <div class=\"flex gap-6\">\n        <!-- Light Theme -->\n        <label class=\"flex flex-col cursor-pointer gap-2\">\n          <div\n            class=\"flex items-center justify-center rounded ring-1 ring-base-100 bg-base-50 \"\n          >\n            <img\n              src=\"/images/forms/light.png\"\n              alt=\"Light theme placeholder\"\n              class=\"rounded\"\n            />\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <input\n              type=\"radio\"\n              name=\"theme\"\n              value=\"light\"\n              x-model=\"theme\"\n              class=\"bg-white size-4 accent-base-600 border-base-300 \"\n            />\n            <span\n              class=\"text-sm font-medium\"\n              :class=\"{ 'text-base-600 ': theme === 'light', 'text-base-500 ': theme !== 'light' }\"\n            >\n              Light\n            </span>\n          </div>\n        </label>\n\n        <!-- Dark Theme -->\n        <label class=\"flex flex-col cursor-pointer gap-2\">\n          <div\n            class=\"flex items-center justify-center rounded ring-1 ring-base-100 bg-base-50 \"\n          >\n            <img\n              src=\"/images/forms/dark.png\"\n              alt=\"Dark theme placeholder\"\n              class=\"rounded\"\n            />\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <input\n              type=\"radio\"\n              name=\"theme\"\n              value=\"dark\"\n              x-model=\"theme\"\n              class=\"bg-white size-4 accent-base-600 border-base-300 \"\n            />\n            <span\n              class=\"text-sm font-medium\"\n              :class=\"{ 'text-base-600 ': theme === 'dark', 'text-base-500 ': theme !== 'dark' }\"\n            >\n              Dark\n            </span>\n          </div>\n        </label>\n\n        <!-- System Theme -->\n        <label class=\"flex flex-col cursor-pointer gap-2\">\n          <div\n            class=\"flex items-center justify-center rounded ring-1 ring-base-100 bg-base-50 \"\n          >\n            <img\n              src=\"/images/forms/system.png\"\n              alt=\"System theme placeholder\"\n              class=\"rounded\"\n            />\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <input\n              type=\"radio\"\n              name=\"theme\"\n              value=\"system\"\n              x-model=\"theme\"\n              class=\"bg-white size-4 accent-base-600 border-base-300 \"\n            />\n            <span\n              class=\"text-sm font-medium\"\n              :class=\"{ 'text-base-600 ': theme === 'system', 'text-base-500 ': theme !== 'system' }\"\n            >\n              System\n            </span>\n          </div>\n        </label>\n      </div>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
  ],
