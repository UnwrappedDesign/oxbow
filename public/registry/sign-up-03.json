{
  "name": "sign-up-03",
  "type": "component",
  "description": "Split screen signup with testimonial",
  "category": "application",
  "section": "sign-up",
  "variant": 3,
  "aliases": [
    "sign up",
    "sign up 3",
    "sign up 03"
  ],
  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/application/sign-up/03.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"ring-border\",\n  \"outline-border\",\n  \"outline-border\",\n];\n\nexport const description = \"Split screen signup with testimonial\";\n// Assets\nimport { Image } from \"astro:assets\";\nimport A1 from \"@/images/avatars/avatar1.jpeg\";\nimport Placeholder from \"@/images/gradients/3.jpeg\";\n// Fundations\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n// Icons\nimport Check from \"@/components/fundations/icons/Check.astro\";\n---\n\n<div class=\"flex h-screen bg-background\">\n  <div class=\"flex items-center justify-center w-full lg:w-2/3\">\n    <div class=\"w-full max-w-md py-24 lg:py-32\">\n      <div>\n        <Text\n          tag=\"h1\"\n          variant=\"displaySM\"\n          class=\"font-semibold tracking-tight text-foreground\"\n        >\n          Create your account\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-2 text-muted-foreground text-balance\"\n        >\n          Join the party. Set up your account the old-fashioned way—email,\n          password, done.\n        </Text>\n      </div>\n      <form class=\"mt-10 space-y-4\">\n        <div\n          x-data=\"{\nradioGroupSelectedValue: null,\nradioGroupOptions: [\n  {\n    title: 'Projects',\n    value: 'projects'\n  },\n  {\n    title: 'Designs',\n    value: 'design'\n  },\n]\n}\"\n          class=\"flex flex-wrap pb-4 border-b gap-y-2 gap-x-8 border-border\"\n          role=\"radiogroup\"\n          aria-labelledby=\"radio-group-label\"\n        >\n          <span id=\"radio-group-label\" class=\"sr-only\"\n            >Choose your work status</span\n          >\n          <template x-for=\"(option, index) in radioGroupOptions\" :key=\"index\">\n            <div>\n              <input\n                type=\"radio\"\n                :id=\"'radio-' + option.value\"\n                name=\"radio-group\"\n                :value=\"option.value\"\n                x-model=\"radioGroupSelectedValue\"\n                class=\"sr-only\"\n                :aria-describedby=\"'ttile-' + option.value\"\n              />\n              <label\n                :for=\"'radio-' + option.value\"\n                class=\"block cursor-pointer\"\n                :class=\"{ 'ring-border': radioGroupSelectedValue === option.value }\"\n              >\n                <div class=\"rounded-lg\" tabindex=\"-1\">\n                  <div class=\"flex items-center gap-2\">\n                    <div\n                      class=\"flex items-center justify-center text-foreground bg-background rounded shadow size-4 outline outline-border\"\n                      :class=\"{ 'outline-border': radioGroupSelectedValue === option.value }\"\n                      aria-hidden=\"true\"\n                    >\n                      <Check\n                        x-show=\"radioGroupSelectedValue === option.value\"\n                        size=\"xs\"\n                        class=\"text-foreground\"\n                      />\n                    </div>\n                    <Text\n                      tag=\"span\"\n                      variant=\"textSM\"\n                      x-text=\"option.title\"\n                      class=\"font-medium text-foreground\"\n                    />\n                  </div>\n                </div>\n              </label>\n            </div>\n          </template>\n        </div>\n        <TextInput\n          id=\"email\"\n          name=\"email\"\n          label=\"Email Address\"\n          type=\"email\"\n          variant=\"default\"\n          size=\"base\"\n          placeholder=\"you@example.com\"\n        />\n        <TextInput\n          id=\"password\"\n          name=\"password\"\n          label=\"Password\"\n          type=\"password\"\n          passwordToggle={true}\n          size=\"base\"\n          placeholder=\"••••••••\"\n          required\n        />\n        <TextInput\n          id=\"confirm-password\"\n          name=\"confirmPassword\"\n          label=\"Confirm Password\"\n          type=\"password\"\n          passwordToggle={true}\n          size=\"base\"\n          placeholder=\"••••••••\"\n          required\n        />\n        <Text\n          tag=\"p\"\n          variant=\"textXS\"\n          class=\"font-medium text-muted-foreground\"\n        >\n          By creating an account, you agree to our\n          <a\n            href=\"#_\"\n            class=\"font-medium text-foreground hover:text-muted-foreground\"\n          >\n            Terms of service\n          </a>\n          and\n          <a\n            href=\"#_\"\n            class=\"font-medium text-foreground hover:text-muted-foreground\"\n          >\n            Privacy Policy\n          </a>\n        </Text>\n        <Button fullWidth variant=\"default\" size=\"base\">\n          Create account\n        </Button>\n      </form>\n      <Text\n        tag=\"p\"\n        variant=\"textXS\"\n        class=\"mt-4 font-medium text-muted-foreground\"\n      >\n        Already have an account?\n        <a\n          href=\"#_\"\n          class=\"font-medium text-foreground hover:text-muted-foreground\"\n        >\n          Sign in\n        </a>\n      </Text>\n    </div>\n  </div>\n  <div\n    class=\"relative hidden overflow-hidden bg-background border-8 border-border lg:block lg:w-1/3 lg:order-first\"\n  >\n    <Image\n      width={1200}\n      height={1200}\n      src={Placeholder}\n      alt=\"Background\"\n      aria-hidden=\"true\"\n      class=\"object-cover object-center w-full h-full rounded-2xl grayscale\"\n    />\n    <div\n      aria-hidden=\"true\"\n      class=\"absolute inset-0 pointer-events-none bg-background/80 rounded-2xl\"\n    >\n    </div>\n    <div class=\"absolute inset-0 flex flex-col items-start justify-between p-8\">\n      <div>\n        <a href=\"#_\">\n          <span class=\"sr-only\">Back to home</span>\n          <Logo\n            class=\"h-12 mx-auto text-foreground md:mx-0\"\n            aria-hidden=\"true\"\n          /></a\n        >\n        <Text\n          tag=\"h1\"\n          variant=\"textXL\"\n          class=\"mt-12 font-semibold text-shadow-sm text-balance\"\n        >\n          Go ahead, start your \"journey.\"\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"mt-2 text-shadow-sm\"\n        >\n          Join the internet's favorite club of freelancers and business owners—\n          because what could possibly go wrong?\n        </Text>\n      </div>\n      <div>\n        <div\n          class=\"w-full p-6 shadow bg-background/20 backdrop-blur rounded-xl\"\n        >\n          <div class=\"relative flex flex-col gap-2\">\n            <Text tag=\"h3\" variant=\"textBase\" class=\"text-foreground\">\n              \"I've seen enough UI kits to last a lifetime. Oxbow's the first\n              one that didn't make me roll my eyes.\"\n            </Text>\n            <div class=\"flex items-center mt-2 gap-4\">\n              <Image\n                src={A1}\n                alt=\"#_\"\n                width={1000}\n                height={1000}\n                aria-hidden=\"true\"\n                class=\"object-cover object-top rounded-full size-10\"\n              />\n              <div>\n                <Text\n                  tag=\"p\"\n                  variant=\"textBase\"\n                  class=\"font-semibold text-foreground\"\n                >\n                  Johan Snällström\n                </Text>\n                <Text\n                  tag=\"p\"\n                  variant=\"textXS\"\n                  class=\"text-muted-foreground\"\n                >\n                  Software Engineer\n                </Text>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
