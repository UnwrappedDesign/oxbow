      "path": "oxbow/marketing/bento-grids/07.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-32 mx-auto md:px-12 lg:px-24 max-w-7xl\">\n    <div class=\"grid grid-cols-1 md:grid-cols-4 gap-2 lg:grid-cols-6\">\n      <div\n        class=\"flex flex-col justify-between h-full overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl md:col-span-2 md:row-span-2\"\n      >\n        <div class=\"mx-8 -top-2\">\n          <img\n            class=\"w-full h-full shadow rounded-b-xl\"\n            src=\"/widgets/activity.svg\"\n            alt=\"\"\n          />\n        </div>\n        <div class=\"relative p-8\">\n          <Kicker> Integration </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Effortless integration\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Connect your favorite tools in seconds and keep your workflow\n            unified and simple.\n          </Text>\n        </div>\n      </div>\n      <img\n        class=\"object-cover object-left shadow rounded-2xl size-full\"\n        src=\"/widgets/hits.svg\"\n        alt=\"#_\"\n      />\n\n      <img\n        class=\"object-cover object-left shadow rounded-2xl md:row-span-1 lg:row-span-1 size-full\"\n        src=\"/widgets/device.svg\"\n        alt=\"#_\"\n      />\n      <div\n        class=\"relative flex flex-col justify-center h-full p-8 overflow-hidden text-center shadow bg-linear-180 outline outline-primary/24 from-primary/16 to-primary/24 rounded-xl md:col-span-2\"\n      >\n        <div>\n          <img\n            class=\"h-12 mx-auto\"\n            src=\"/images/oxbow/oxbowLogo.png\"\n            alt=\"#_\"\n          />\n          <Text\n            tag=\"h3\"\n            variant=\"textXL\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Connect your app\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textzinc\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Connection secure, fast and easy. You can disconnect at any time.\n          </Text>\n          <div class=\"flex justify-center mt-8\">\n            <Button size=\"sm\" variant=\"muted\" class=\"\">\n              See our integrations\n            </Button>\n          </div>\n        </div>\n      </div>\n\n      <div\n        class=\"flex flex-col justify-between h-full overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl md:row-span-2 lg:col-span-2\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Experience </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Unified experience\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Enjoy a seamless journey across all your apps and devices, with\n            everything working together.\n          </Text>\n        </div>\n        <div class=\"mx-8 -bottom-2\">\n          <img\n            class=\"w-full h-full shadow rounded-t-xl\"\n            src=\"/widgets/activity.svg\"\n            alt=\"\"\n          />\n        </div>\n      </div>\n\n      <div\n        class=\"flex flex-col justify-between h-full overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl md:row-span-2 lg:col-span-2\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Scheduling </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Smart scheduling\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Let automation handle your calendar and reminders, so you can focus\n            on what matters most.\n          </Text>\n        </div>\n        <div class=\"mx-8 -bottom-2 -\">\n          <img\n            class=\"w-full h-full shadow rounded-t-xl\"\n            src=\"/widgets/report.svg\"\n            alt=\"\"\n          />\n        </div>\n      </div>\n      <img\n        src=\"/widgets/progressCircles.svg\"\n        alt=\"#_\"\n        class=\"shadow size-full rounded-2xl lg:col-span-2\"\n      />\n\n      <div\n        class=\"p-8 shadow bg-linear-180 outline outline-primary/24 from-primary/16 to-primary/24 rounded-xl lg:col-span-3\"\n      >\n        <Text\n          tag=\"h3\"\n          variant=\"textBase\"\n          class=\"font-medium text-base-900 \"\n        >\n          Always in sync\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"mt-2 font-medium text-base-500 \"\n        >\n          All your changes are saved automatically, so you never lose your\n          progress or momentum.\n        </Text>\n      </div>\n\n      <div\n        class=\"p-8 shadow bg-linear-180 outline outline-primary/24 from-primary/16 to-primary/24 rounded-xl lg:col-span-3\"\n      >\n        <Text\n          tag=\"h3\"\n          variant=\"textBase\"\n          class=\"font-medium text-base-900 \"\n        >\n          Plan your day\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"mt-2 font-medium text-base-500 \"\n        >\n          Stay organized and ahead with smart scheduling and automated reminders\n          for every task.\n        </Text>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
