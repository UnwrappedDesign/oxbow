      "path": "oxbow/application/buttons/07.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"Button with left icon\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\n---\n\n<section class=\"flex items-center justify-center h-full p-12 bg-background\">\n  <!-- copy:start -->\n  <div class=\"flex flex-wrap items-center justify-center gap-3\">\n    <Button variant=\"default\" size=\"xs\" gap=\"xs\">\n      <Plus slot=\"left-icon\" size=\"xs\" />\n      Add item\n    </Button>\n    <Button variant=\"default\" size=\"sm\" gap=\"xs\">\n      <Plus slot=\"left-icon\" size=\"sm\" />\n      Add item\n    </Button>\n    <Button variant=\"default\" size=\"base\" gap=\"xs\">\n      <Plus slot=\"left-icon\" size=\"base\" />\n      Add item\n    </Button>\n    <Button variant=\"default\" size=\"md\" gap=\"xs\">\n      <Plus slot=\"left-icon\" size=\"md\" />\n      Add item\n    </Button>\n    <Button variant=\"default\" size=\"lg\" gap=\"xs\">\n      <Plus slot=\"left-icon\" size=\"lg\" />\n      Add item\n    </Button>\n    <Button variant=\"default\" size=\"xl\" gap=\"xs\">\n      <Plus slot=\"left-icon\" size=\"xl\" />\n      Add item\n    </Button>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
