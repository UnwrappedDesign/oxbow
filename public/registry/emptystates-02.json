      "content": "---\nexport const description = \"Enhanced file upload empty state\";\n\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<div\n  class=\"flex flex-col items-center justify-center p-8 py-24 bg-background\"\n>\n  <!-- copy:start -->\n  <Text\n    tag=\"h3\"\n    variant=\"textSM\"\n    class=\"font-medium text-center text-foreground\"\n    >Upload Your Files</Text\n  >\n  <div\n    class=\"flex flex-col items-center justify-center w-full max-w-lg mx-auto mt-4\"\n  >\n    <label\n      for=\"dropzone-file\"\n      class=\"flex flex-col items-center justify-center w-full py-6 bg-background border border-dashed rounded-lg cursor-pointer border-border hover:bg-background transition-colors duration-200 ease-in-out\"\n    >\n      <div class=\"flex flex-col items-center justify-center p-8\">\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"24\"\n          height=\"24\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          class=\"text-foreground icon icon-tabler icons-tabler-outline icon-tabler-cloud-upload size-8\"\n        >\n          <path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path>\n          <path\n            d=\"M7 18a4.6 4.4 0 0 1 0 -9a5 4.5 0 0 1 11 2h1a3.5 3.5 0 0 1 0 7h-1\"\n          ></path>\n          <path d=\"M9 15l3 -3l3 3\"></path>\n          <path d=\"M12 12l0 9\"></path>\n        </svg>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"mt-2 font-semibold text-muted-foreground\"\n        >\n          Click to upload or drag and drop\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textXs\"\n          class=\"mt-2 text-muted-foreground\"\n        >\n          SVG, PNG, JPG, or GIF (MAX. 800x400px)\n        </Text>\n      </div>\n      <input id=\"dropzone-file\" type=\"file\" class=\"hidden\" multiple />\n    </label>\n\n    <div class=\"w-full bg-muted rounded-full h-1.5 mt-4\">\n      <div\n        class=\"bg-muted h-1.5 rounded-full\"\n        style=\"width: 10%\"\n      >\n      </div>\n    </div>\n    \n    <Button size=\"base\" variant=\"default\" class=\"w-full mt-4 ml-auto\" > Browse files </Button>\n\n    <div class=\"w-full mt-8\">\n      <Text tag=\"h3\" variant=\"textSM\" class=\"mb-2 font-semibold text-muted-foreground\">\n        Recently Uploaded\n      </Text>\n      <div class=\"p-4 text-center border-t border-border\">\n        <Text tag=\"p\" variant=\"textSM\" class=\"text-muted-foreground\"\n          >No files uploaded yet</Text\n        >\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
