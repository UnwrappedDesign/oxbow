  "files": [
    {
      "name": "02.astro",
      "path": "oxbow/application/select/02.astro",
      "content": "---\nexport const description = \"Basic x-model Example\";\nimport Select from \"@/components/fundations/inputs/Select.astro\";\n// Remove duplicate imports\nconst countryOptions = [\n  { label: \"United States\", value: \"us\" },\n  { label: \"Canada\", value: \"ca\" },\n  { label: \"United Kingdom\", value: \"uk\" },\n  { label: \"Australia\", value: \"au\" },\n  { label: \"Germany\", value: \"de\" },\n  { label: \"France\", value: \"fr\" },\n  { label: \"Japan\", value: \"jp\" },\n];\n---\n\n<div class=\"flex justify-center p-16 mx-auto bg-white \">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div\n      class=\"flex flex-col w-full max-w-sm gap-2\"\n      x-data=\"{ selectedCountry: 'ca' }\"\n    >\n      <Select\n        id=\"country\"\n        name=\"country\"\n        label=\"Country\"\n        options={countryOptions}\n        xModel=\"selectedCountry\"\n        class=\"w-full\"\n      />\n\n      <p class=\"text-xs font-medium text-base-500\">\n        Selected country: <span class=\"uppercase\" x-text=\"selectedCountry\"\n        ></span>\n      </p>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
  ],
