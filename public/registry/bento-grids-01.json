      "path": "oxbow/marketing/bento-grids/01.astro",
      "content": "---\nexport const freeComponent = true;\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"grid grid-cols-1 gap-2 lg:items-center lg:grid-cols-2\">\n      <div\n        class=\"relative flex flex-col items-center justify-center h-full p-8 overflow-hidden text-center shadow lg:py-20 bg-background outline outline-border rounded-xl\"\n      >\n        <div class=\"relative items-center text-balance\">\n          <img\n            class=\"mx-auto h-14\"\n            src=\"/images/oxbow/oxbowLogo.png\"\n            alt=\"#_\"\n          />\n\n          <Text\n            tag=\"h3\"\n            variant=\"displayMD\"\n            class=\"mt-24 font-semibold tracking-tight text-foreground\"\n          >\n            Welcome to the future of collaboration\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Instantly connect, share, and create with your team in a secure,\n            dynamic environment built for innovation.\n          </Text>\n\n          <Button variant=\"accent\" size=\"sm\" class=\"mx-auto mt-8 w-fit\">\n            Try it now\n          </Button>\n        </div>\n      </div>\n      <div class=\"h-full grid grid-cols-1 gap-2 lg:grid-cols-2\">\n        <div\n          class=\"relative flex flex-col justify-between h-full overflow-hidden shadow bg-background outline outline-border rounded-xl\"\n        >\n          <div class=\"relative p-8\">\n            <Kicker> Sync </Kicker>\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"mt-4 font-medium text-foreground\"\n            >\n              Real-Time Sync\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"mt-2 font-medium text-muted-foreground\"\n            >\n              Keep your projects up to date with instant updates and seamless\n              integration across all your favorite tools.\n            </Text>\n          </div>\n          <div class=\"ml-8 -mb-4 lg:absolute -bottom-4 -right-8\">\n            <img\n              class=\"h-full shadow rounded-l-xl\"\n              src=\"/widgets/calendar.svg\"\n              alt=\"\"\n            />\n          </div>\n        </div>\n        <div\n          class=\"h-full grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-1\"\n        >\n          <div\n            class=\"flex flex-col justify-between h-full shadow bg-background outline outline-border rounded-xl\"\n          >\n            <div class=\"flex items-center p-8\">\n              <Text\n                tag=\"span\"\n                variant=\"textBase\"\n                class=\"font-medium text-foreground\"\n              >\n                24/7\n              </Text>\n            </div>\n            <div class=\"p-8 border-t border-border/10\">\n              <Text\n                tag=\"h3\"\n                variant=\"textBase\"\n                class=\"font-medium text-foreground\"\n              >\n                Support\n              </Text>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-muted-foreground\"\n              >\n                Our expert team is always available to help you overcome\n                challenges and reach your goals.\n              </Text>\n            </div>\n          </div>\n          <div\n            class=\"flex flex-col justify-between h-full shadow bg-background outline outline-border rounded-xl\"\n          >\n            <div class=\"w-full p-8\">\n              <Text\n                tag=\"span\"\n                variant=\"textBase\"\n                class=\"font-medium text-foreground\"\n              >\n                Infinite\n              </Text>\n            </div>\n            <div class=\"p-8 border-t border-border/10\">\n              <Text\n                tag=\"h3\"\n                variant=\"textBase\"\n                class=\"font-medium text-foreground\"\n              >\n                Growth\n              </Text>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-muted-foreground\"\n              >\n                Unlock new opportunities and scale your business with powerful\n                analytics and actionable insights.\n              </Text>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
