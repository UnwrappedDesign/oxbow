  "files": [
    {
      "name": "07.astro",
      "path": "oxbow/marketing/testimonials/07.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst data1 = [\n  {\n    name: \"Fernando Monte\",\n    title: \"Creator of Oxbow UI.com\",\n    testimonial:\n      \"Being in the financial industry, we were always looking for ways to enhance our transactions' security and efficiency.\",\n    imgSrc: \"/avatars/1.jpg\",\n  },\n  {\n    name: \"Juan Echanove\",\n    title: \"Founder of Pay Oneeer\",\n    testimonial:\n      \"Oxbow UI is a platform that allows you to create a customized landing page for your business. \",\n    imgSrc: \"/avatars/2.jpg\",\n  },\n  {\n    name: \"Hanako Yamada\",\n    title: \"Founder of Fesla\",\n    testimonial:\n      \"With Oxbow UI, we can create a customized landing page for our business that showcases our products and services in the best possible way.\",\n    imgSrc: \"/avatars/3.jpg\",\n  },\n];\nconst data2 = [\n  {\n    name: \"Sarah Jenkins\",\n    title: \"Marketing Manager at BrightTech\",\n    testimonial:\n      \"Oxbow UI has significantly improved our online presence and customer engagement. The ease of creating a professional landing page is unmatched, and we've seen a significant increase in traffic and conversions.\",\n    imgSrc: \"/avatars/4.jpg\",\n  },\n  {\n    name: \"Sandra Kimmel\",\n    title: \"CEO of Tech Innovators\",\n    testimonial:\n      \"Oxbow UI's user-friendly interface has allowed us to quickly set up landing pages that attract and retain customers. It's a game-changer for our marketing efforts.\",\n    imgSrc: \"/avatars/6.jpg\",\n  },\n  {\n    name: \"Emily Taylor\",\n    title: \"Creative Director at Artify\",\n    testimonial:\n      \"Using Oxbow UI, we have been able to craft visually stunning landing pages that effectively showcase our artistic projects and attract new clients.\",\n    imgSrc: \"/avatars/5.jpg\",\n  },\n];\nconst data3 = [\n  {\n    name: \"Robert Langdon\",\n    title: \"Professor at Harvard University\",\n    testimonial:\n      \"Oxbow UI has allowed us to create informative landing pages for our educational programs, providing a seamless experience for our students.\",\n    imgSrc: \"/avatars/8.jpg\",\n  },\n  {\n    name: \"Louis Wonger\",\n    title: \"CTO of Innovatech\",\n    testimonial:\n      \"With Oxbow UI, we've built landing pages that effectively communicate our tech solutions.\",\n    imgSrc: \"/avatars/10.jpg\",\n  },\n  {\n    name: \"Antonio Garcia\",\n    title: \"Owner of Cafe Buenavista\",\n    testimonial:\n      \"Thanks to Oxbow UI, our cafe's online presence has been elevated, attracting more customers with beautifully designed landing pages.\",\n    imgSrc: \"/avatars/9.jpg\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <ul\n      role=\"list\"\n      class=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2\"\n    >\n      <li>\n        <ul role=\"list\" class=\"flex flex-col gap-2\">\n          {\n            data1.map((member) => (\n              <>\n                <li class=\"flex flex-col h-full p-8 shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl\">\n                  <figure class=\"flex flex-col h-full gap-4\">\n                    <div>\n                      <figcaption class=\"flex items-center justify-between\">\n                        <div class=\"flex items-center gap-4\">\n                          <img\n                            class=\"object-cover rounded-full size-12\"\n                            src={member.imgSrc}\n                            alt=\"#_\"\n                          />\n                          <div>\n                            <Text\n                              tag=\"h3\"\n                              variant=\"textBase\"\n                              class=\"font-semibold text-foreground\"\n                            >\n                              {member.name}\n                            </Text>\n                            <Text\n                              tag=\"p\"\n                              variant=\"textSM\"\n                              class=\"font-medium text-muted-foreground\"\n                            >\n                              {member.title}\n                            </Text>\n                          </div>\n                        </div>\n                      </figcaption>\n                      <div>\n                        <Text\n                          tag=\"blockquote\"\n                          variant=\"textSM\"\n                          class=\"mt-4 font-medium text-foreground\"\n                        >\n                          \"{member.testimonial}\"\n                        </Text>\n                      </div>\n                    </div>\n                  </figure>\n                </li>\n              </>\n            ))\n          }\n        </ul>\n      </li>\n      <li>\n        <ul role=\"list\" class=\"flex-col hidden sm:flex gap-2\">\n          {\n            data2.map((member) => (\n              <>\n                <li class=\"flex flex-col h-full p-8 shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl\">\n                  <figure class=\"flex flex-col h-full gap-4\">\n                    <div>\n                      <figcaption class=\"flex items-center justify-between\">\n                        <div class=\"flex items-center gap-4\">\n                          <img\n                            class=\"object-cover rounded-full size-12\"\n                            src={member.imgSrc}\n                            alt=\"#_\"\n                          />\n                          <div>\n                            <Text\n                              tag=\"h3\"\n                              variant=\"textBase\"\n                              class=\"font-medium text-foreground\"\n                            >\n                              {member.name}\n                            </Text>\n                            <Text\n                              tag=\"p\"\n                              variant=\"textXS\"\n                              class=\"font-medium text-muted-foreground\"\n                            >\n                              {member.title}\n                            </Text>\n                          </div>\n                        </div>\n                      </figcaption>\n                      <div>\n                        <Text\n                          tag=\"blockquote\"\n                          variant=\"textBase\"\n                          class=\"mt-4 italic font-medium text-foreground\"\n                        >\n                          \"{member.testimonial}\"\n                        </Text>\n                      </div>\n                    </div>\n                  </figure>\n                </li>\n              </>\n            ))\n          }\n        </ul>\n      </li>\n      <li>\n        <ul role=\"list\" class=\"flex-col hidden xl:flex gap-2\">\n          {\n            data3.map((member) => (\n              <>\n                <li class=\"flex flex-col h-full p-8 shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl\">\n                  <figure class=\"flex flex-col h-full gap-4\">\n                    <div>\n                      <figcaption class=\"flex items-center justify-between\">\n                        <div class=\"flex items-center gap-4\">\n                          <img\n                            class=\"object-cover rounded-full size-12\"\n                            src={member.imgSrc}\n                            alt=\"#_\"\n                          />\n                          <div>\n                            <Text\n                              tag=\"h3\"\n                              variant=\"textBase\"\n                              class=\"font-medium text-foreground\"\n                            >\n                              {member.name}\n                            </Text>\n                            <Text\n                              tag=\"p\"\n                              variant=\"textXS\"\n                              class=\"font-medium text-muted-foreground\"\n                            >\n                              {member.title}\n                            </Text>\n                          </div>\n                        </div>\n                      </figcaption>\n                      <div>\n                        <Text\n                          tag=\"blockquote\"\n                          variant=\"textBase\"\n                          class=\"mt-4 italic font-medium text-foreground\"\n                        >\n                          \"{member.testimonial}\"\n                        </Text>\n                      </div>\n                    </div>\n                  </figure>\n                </li>\n              </>\n            ))\n          }\n        </ul>\n      </li>\n    </ul>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
