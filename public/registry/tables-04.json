  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/application/tables/04.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport ChevronLeft from \"@/components/fundations/icons/ChevronLeft.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-white \">\n  <!-- copy:start -->\n  <div\n    class=\"mx-auto flow-root max-w-7xl\"\n    x-data=\"{\n      page: 1,\n      size: 3,\n      rows: [\n        { name: 'Navy', img: '/images/navy.png', price: '$129.00', status: 'Paid', statusType: 'success', sales: 40, revenue: '$3900' },\n        { name: 'Flabbergasted', img: '/images/flabbergasted.png', price: '$129.00', status: 'Paid', statusType: 'success', sales: 60, revenue: '$5940' },\n        { name: 'Outkast', img: '/images/outkast.png', price: '$129.00', status: 'Canceled', statusType: 'danger', sales: 80, revenue: '€7920.00' },\n        { name: 'Bundle', img: '/images/bundle.png', price: '$199.00', status: 'Pending', statusType: 'warning', sales: 553, revenue: '€9940.00' },\n      ],\n      pages() { return Math.max(1, Math.ceil(this.rows.length / this.size)); },\n      pageRows() { const s = (this.page - 1) * this.size; return this.rows.slice(s, s + this.size); }\n    }\"\n  >\n    <div class=\"-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8\">\n      <div class=\"inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8\">\n        <div class=\"flex justify-center\">\n          <table class=\"min-w-[900px] text-sm\">\n            <thead class=\"bg-base-100 \">\n              <tr>\n                <th\n                  scope=\"col\"\n                  class=\"px-3 py-2 font-medium text-left text-base-900 \"\n                >\n                  Name\n                  <th\n                    scope=\"col\"\n                    class=\"px-3 py-2 font-medium text-left text-base-900 \"\n                  >\n                    Price\n                  </th>\n                  <th\n                    scope=\"col\"\n                    class=\"px-3 py-2 font-medium text-left text-base-900 \"\n                  >\n                    Status\n                  </th>\n                  <th\n                    scope=\"col\"\n                    class=\"px-3 py-2 font-medium text-left text-base-900 \"\n                  >\n                    Total Sales\n                  </th>\n                  <th\n                    scope=\"col\"\n                    class=\"px-3 py-2 font-medium text-right text-base-900 \"\n                  >\n                    Total revenue\n                  </th>\n                  <th scope=\"col\" class=\"relative py-3.5 pl-3 pr-4 sm:pr-0\">\n                    <span class=\"sr-only\">Edit</span>\n                  </th>\n                </th>\n              </tr>\n              <tbody class=\"divide-y divide-base-200 \">\n                <template x-for=\"r in pageRows()\" :key=\"r.name\">\n                  <tr>\n                    <td\n                      class=\"py-2 pl-3 pr-3 text-sm font-medium tracking-tighter truncate whitespace-nowrap sm:pl-0 text-base-900 \"\n                    >\n                      <span class=\"flex items-center gap-2\">\n                        <img\n                          class=\"inline-block rounded h-14\"\n                          :src=\"r.img\"\n                          :alt=\"r.name\"\n                        />\n                        <span x-text=\"r.name\"></span>\n                      </span>\n                    </td>\n                    <td\n                      class=\"px-3 py-2 text-sm font-medium whitespace-nowrap text-base-500 \"\n                      x-text=\"r.price\"></td>\n                    <td\n                      class=\"max-w-xs px-3 py-2 overflow-hidden whitespace-nowrap\"\n                      :class=\"r.status==='Paid' ? 'text-success ' : r.status==='Canceled' ? 'text-destructive ' : 'text-warning '\"\n                      x-text=\"r.status\"></td>\n                    <td\n                      class=\"px-3 py-2 text-sm font-medium whitespace-nowrap text-base-500\"\n                      x-text=\"r.sales\"></td>\n                    <td\n                      class=\"px-3 py-2 font-mono text-sm font-medium text-right whitespace-nowrap text-base-900 \"\n                      x-text=\"r.revenue\"></td>\n                  </tr>\n                </template>\n                <tr x-show=\"pageRows().length===0\">\n                  <td\n                    colspan=\"6\"\n                    class=\"px-3 py-2 text-center text-base-500 \"\n                    >No results</td\n                  >\n                </tr>\n              </tbody>\n            </thead>\n          </table>\n        </div>\n      </div>\n      <nav\n        class=\"flex gap-2 lg:items-center lg:justify-between px-4 mt-4 sm:px-0 mx-auto max-w-[900px] pb-2\"\n      >\n        <Button\n          gap=\"xs\"\n          size=\"xs\"\n          variant=\"muted\"\n          class=\"w-fit\"\n          :disabled=\"page<=1\"\n          @click=\"page=Math.max(1,page-1)\"\n        >\n          <ChevronLeft size=\"sm\" slot=\"icon\" slot=\"left-icon\" />\n          Previous\n        </Button>\n        <div class=\"hidden text-sm lg:flex lg:gap-2 text-base-500\">\n          Page <span x-text=\"page\"></span> of <span x-text=\"pages()\"></span>\n        </div>\n        <Button\n          gap=\"xs\"\n          size=\"xs\"\n          variant=\"muted\"\n          class=\"w-fit\"\n          :disabled=\"page>=pages()\"\n          @click=\"page=Math.min(pages(),page+1)\"\n        >\n          Next\n          <ChevronRight size=\"sm\" slot=\"icon\" slot=\"right-icon\" />\n        </Button>\n      </nav>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
