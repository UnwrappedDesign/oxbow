      "path": "oxbow/application/emptyStates/01.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"With add button\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\n---\n\n<div\n  class=\"flex items-center justify-center p-8 py-24 bg-background\"\n>\n  <!-- copy:start -->\n  <div class=\"w-full max-w-2xl mx-auto text-center lg:text-balance\">\n    <Text\n      tag=\"h3\"\n      variant=\"textBase\"\n      class=\"font-medium text-foreground\"\n    >\n      Begin by crafting your first survey question\n    </Text>\n    <Text\n      tag=\"p\"\n      variant=\"textSM\"\n      class=\"mt-2 font-medium text-muted-foreground\"\n    >\n      Add a question to your survey that participants will see as they begin.\n    </Text>\n    <ul\n      class=\"flex flex-col justify-center mt-4 text-sm text-muted-foreground md:flex-row gap-4\"\n    >\n      <li class=\"flex items-center gap-2\">\n        <CircleCheck\n          size=\"sm\"\n          slot=\"icon\"\n          class=\"text-muted-foreground\"\n        />\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground\"\n        >\n          Age group\n        </Text>\n      </li>\n      <li class=\"flex items-center gap-2\">\n        <CircleCheck\n          size=\"sm\"\n          slot=\"icon\"\n          class=\"text-muted-foreground\"\n        />\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground\"\n        >\n          Primary interests\n        </Text>\n      </li>\n      <li class=\"flex items-center gap-2\">\n        <CircleCheck\n          size=\"sm\"\n          slot=\"icon\"\n          class=\"text-muted-foreground\"\n        />\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground\"\n        >\n          Location\n        </Text>\n      </li>\n    </ul>\n    <Button class=\"mx-auto mt-8\" gap=\"xs\" size=\"sm\" variant=\"accent\">\n      <Plus size=\"sm\" slot=\"icon\" slot=\"left-icon\" />\n      Add a new question\n    </Button>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
