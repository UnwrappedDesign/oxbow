{
  "name": "pagination-06",
  "type": "component",
  "description": "Minimal Arrows Only",
  "category": "application",
  "section": "pagination",
  "variant": 6,
  "aliases": [
    "pagination",
    "pagination 6",
    "pagination 06"
  ],
  "files": [
    {
      "name": "06.astro",
      "path": "oxbow/application/pagination/06.astro",
      "content": "---\nexport const description = \"Minimal Arrows Only\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport ChevronLeft from \"@/components/fundations/icons/ChevronLeft.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\nimport ChevronsLeft from \"@/components/fundations/icons/ChevronsLeft.astro\";\nimport ChevronsRight from \"@/components/fundations/icons/ChevronsRight.astro\";\n---\n\n<section class=\"flex justify-center p-16 bg-white \">\n  <!-- copy:start -->\n  <nav\n    aria-label=\"Pagination\"\n    x-data=\"{ page: 1, total: 10 }\"\n    class=\"flex items-center gap-2\"\n  >\n    <Button\n      size=\"xs\"\n      variant=\"muted\"\n      iconOnly\n      :disabled=\"page===1\"\n      @click=\"page=1\"\n      aria-label=\"First page\"\n    >\n      <ChevronsLeft size=\"xs\" slot=\"left-icon\" />\n      <span class=\"sr-only\">Previous</span>\n    </Button>\n    <Button\n      size=\"xs\"\n      variant=\"muted\"\n      iconOnly\n      :disabled=\"page===1\"\n      @click=\"page=Math.max(1,page-1)\"\n      aria-label=\"Previous page\"\n      ><ChevronLeft size=\"xs\" slot=\"left-icon\" /></Button\n    >\n    <span\n      class=\"w-10 text-sm text-center text-base-600 \"\n      x-text=\"page\"></span>\n    <Button\n      size=\"xs\"\n      variant=\"muted\"\n      iconOnly\n      :disabled=\"page===total\"\n      @click=\"page=Math.min(total,page+1)\"\n      aria-label=\"Next page\"><ChevronRight size=\"xs\" slot=\"left-icon\" /></Button\n    >\n    <Button\n      size=\"xs\"\n      variant=\"muted\"\n      iconOnly\n      :disabled=\"page===total\"\n      @click=\"page=total\"\n      aria-label=\"Last page\"\n    >\n      <ChevronsRight size=\"xs\" slot=\"right-icon\" />\n      <span class=\"sr-only\">Next</span></Button\n    >\n  </nav>\n  <!-- copy:end -->\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
