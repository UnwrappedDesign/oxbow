    {
      "name": "04.astro",
      "path": "oxbow/application/radiogroups/04.astro",
      "content": "---\nexport const description = \"Inline Radio Button Group\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div class=\"flex justify-center p-16 mx-auto bg-background\">\n  <!-- copy:start -->\n  <div class=\"flex flex-col gap-2\" x-data=\"{ selected: 'small' }\">\n    <div class=\"flex items-center gap-3\">\n      <input\n        id=\"radio-small\"\n        name=\"inline-radio\"\n        type=\"radio\"\n        value=\"small\"\n        x-model=\"selected\"\n        class=\"text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border\"\n      />\n      <Text\n        for=\"radio-small\"\n        tag=\"label\"\n        class=\"block text-sm text-muted-foreground\"\n      >\n        Small\n      </Text>\n    </div>\n\n    <div class=\"flex items-center gap-3\">\n      <input\n        id=\"radio-medium\"\n        name=\"inline-radio\"\n        type=\"radio\"\n        value=\"medium\"\n        x-model=\"selected\"\n        class=\"text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border\"\n      />\n      <Text\n        for=\"radio-medium\"\n        tag=\"label\"\n        class=\"block text-sm text-muted-foreground\"\n      >\n        Medium\n      </Text>\n    </div>\n\n    <div class=\"flex items-center gap-3\">\n      <input\n        id=\"radio-large\"\n        name=\"inline-radio\"\n        type=\"radio\"\n        value=\"large\"\n        x-model=\"selected\"\n        class=\"text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border\"\n      />\n      <Text\n        for=\"radio-large\"\n        tag=\"label\"\n        class=\"block text-sm text-muted-foreground\"\n      >\n        Large\n      </Text>\n    </div>\n\n    <div class=\"mt-2 text-sm text-muted-foreground\">\n      Selected size: <span x-text=\"selected\"></span>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
