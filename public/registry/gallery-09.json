      "name": "09.astro",
      "path": "oxbow/marketing/gallery/09.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport { Image } from \"astro:assets\";\nimport g1 from \"@/images/gallery/1.png\";\nimport g2 from \"@/images/gallery/2.png\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 lg:col-span-4\">\n      <div class=\"flex flex-col justify-center p-12 text-center\">\n        <Text\n          variant=\"displayLG\"\n          tag=\"h2\"\n          class=\"font-semibold tracking-tight text-foreground sm:text-balance\"\n        >\n          Explore our visual showcase\n        </Text>\n        <Text\n          variant=\"textSM\"\n          tag=\"p\"\n          class=\"mt-2 font-medium text-muted-foreground sm:text-balance\"\n        >\n          A curated collection of images capturing the essence of our brand and\n          the stories we tell.\n        </Text>\n      </div>\n      <Image\n        width={500}\n        height={500}\n        src={g1}\n        alt=\"#_\"\n        class=\"object-cover size-full aspect-square\"\n      />\n      <Image\n        width={500}\n        height={500}\n        src={g2}\n        alt=\"#_\"\n        class=\"object-cover size-full aspect-square\"\n      />\n      <div class=\"flex flex-col justify-center p-12 text-center\">\n        <Text\n          variant=\"textSM\"\n          tag=\"p\"\n          class=\"font-medium text-muted-foreground sm:text-balance\"\n        >\n          Our smart contract automation feature simplifies complex business\n          processes by encoding contract terms and conditions into\n          self-executing code.\n        </Text>\n        <Button variant=\"default\" size=\"sm\" class=\"mx-auto mt-8 w-fit\">\n          See all images\n        </Button>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
