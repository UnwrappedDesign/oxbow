      "name": "12.astro",
      "path": "oxbow/marketing/features/12.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\nimport CircleX from \"@/components/fundations/icons/CircleX.astro\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"items-end pb-8 grid grid-cols-4\">\n      <div class=\"col-span-4 max-w-[460px] md:col-span-2\">\n        <Text\n          tag=\"h2\"\n          variant=\"displayMD\"\n          class=\"font-semibold tracking-tight text-foreground text-balance\"\n        >\n          Embrace security from today onwards\n        </Text>\n      </div>\n      <div\n        class=\"hidden text-base font-semibold text-center col-span-1 md:block text-foreground\"\n      >\n        Oxbow\n      </div>\n      <div\n        class=\"hidden text-base font-semibold text-center col-span-1 md:block text-foreground\"\n      >\n        Other processors\n      </div>\n    </div>\n    <div\n      class=\"border-y divide-y border-border divide-border\"\n    >\n      <div class=\"items-start py-6 grid grid-flow-row-dense grid-cols-4 gap-4\">\n        <Text\n          tag=\"h3\"\n          variant=\"textBase\"\n          class=\"order-1 font-semibold text-foreground col-span-3 md:col-span-2 lg:col-span-1\"\n        >\n          Detailed rejection information\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"order-4 font-medium text-muted-foreground col-span-3 md:col-span-2 lg:order-2 lg:col-span-1\"\n        >\n          Immediately receive in-depth rejection codes and notes.\n        </Text>\n        <div class=\"order-2 justify-self-center lg:order-3\">\n          <CircleCheck\n            class=\"text-foreground\"\n            size=\"lg\"\n            slot=\"icon\"\n          />\n        </div>\n        <div class=\"order-3 hidden md:block justify-self-center lg:order-4\">\n          <CircleX\n            class=\"text-muted-foreground\"\n            size=\"lg\"\n            slot=\"icon\"\n          />\n        </div>\n      </div>\n      <div class=\"items-start py-6 grid grid-flow-row-dense grid-cols-4 gap-4\">\n        <Text\n          tag=\"h3\"\n          variant=\"textBase\"\n          class=\"order-1 font-semibold text-foreground col-span-3 md:col-span-2 lg:col-span-1\"\n        >\n          Transaction identification\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"order-4 mt-2 font-medium text-muted-foreground col-span-3 md:col-span-2 lg:order-2 lg:col-span-1\"\n        >\n          Receive a distinctive transfer identifier from the RTP.\n        </Text>\n        <div class=\"order-2 justify-self-center lg:order-3\">\n          <CircleCheck\n            class=\"text-foreground\"\n            size=\"lg\"\n            slot=\"icon\"\n          />\n        </div>\n        <div class=\"order-3 hidden md:block justify-self-center lg:order-4\">\n          <CircleX\n            class=\"text-muted-foreground\"\n            size=\"lg\"\n            slot=\"icon\"\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
