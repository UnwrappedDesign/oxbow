    {
      "name": "08.astro",
      "path": "oxbow/application/navbars/08.astro",
      "content": "---\nexport const freeComponent = true;\nexport const excludeFromObfuscation = [\"flex\", \"hidden\"];\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport Burger from \"@/components/fundations/icons/Burger.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport ChevronDown from \"@/components/fundations/icons/ChevronDown.astro\";\nimport FlyoutLinkBox from \"@/components/fundations/wrappers/FlyoutLinkBox.astro\";\n---\n\n<div class=\"bg-background pb-100\">\n  <!-- copy:start -->\n  <header\n    class=\"w-full mx-auto bg-background border-b border-border\"\n  >\n    <div\n      x-data=\"{ open:false, proj:false }\"\n      class=\"px-6 py-2 mx-auto max-w-screen-xl md:px-10 lg:px-16\"\n    >\n      <div class=\"flex items-center gap-3\">\n        <!-- Project switcher -->\n        <div x-data=\"{open:false}\" class=\"relative\">\n          <Button\n            size=\"xs\"\n            variant=\"ghost\"\n            @click=\"open=!open\"\n            @keydown.escape.window=\"open=false\"\n            :aria-expanded=\"open\"\n            class=\"flex items-center justify-between gap-2\"\n          >\n            <span class=\"rounded-full size-2 bg-success\"></span>\n            Tailwind CSS v4\n            <ChevronDown\n              size=\"sm\"\n              slot=\"right-icon\"\n              :class=\"open ? '-rotate-180' : ''\"\n              class=\"duration-300 ease-out transform\"\n            />\n          </Button>\n          <div\n            x-show=\"open\"\n            x-transition\n            @click.outside=\"open=false\"\n            class=\"absolute left-0 z-30 flex flex-col p-4 mt-2 bg-background shadow-lg top-full w-80 rounded-xl outline outline-border/10 gap-4\"\n          >\n            <FlyoutLinkBox\n              href=\"#_\"\n              title=\"Tailwind CSS v4\"\n              description=\"Latest version\"\n            />\n            <FlyoutLinkBox\n              href=\"#_\"\n              title=\"Tailwind CSS v3.5\"\n              description=\"Latest version\"\n            />\n            <FlyoutLinkBox\n              href=\"#_\"\n              title=\"Tailwind CSS v3\"\n              description=\"Latest version\"\n            />\n          </div>\n        </div>\n        <!-- Center tabs -->\n        <nav\n          aria-label=\"Primary\"\n          class=\"items-center hidden mx-auto text-xs md:flex gap-5\"\n        >\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textSM\"\n            class=\"font-medium text-muted-foreground hover:text-foreground\"\n            >Overview</Text\n          >\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textSM\"\n            class=\"font-medium text-muted-foreground hover:text-foreground\"\n            >Graphs</Text\n          >\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textSM\"\n            class=\"font-medium text-muted-foreground hover:text-foreground\"\n            >Backups</Text\n          >\n        </nav>\n        <!-- Actions -->\n        <div class=\"flex items-center ml-auto gap-2\">\n          <div\n            class=\"items-center hidden text-xs md:flex gap-2 text-muted-foreground\"\n          >\n            <span class=\"inline-flex items-center gap-1\"\n              ><span class=\"size-1.5 rounded-full bg-success\"></span> Online</span\n            >\n            <span>99.9%</span>\n            <span>45ms</span>\n          </div>\n          <Button variant=\"default\" size=\"xs\">New</Button>\n          <IconButton\n            class=\"md:hidden\"\n            @click=\"open=!open\"\n            :aria-expanded=\"open\"\n            aria-controls=\"nav-10\"\n            variant=\"muted\"\n            size=\"xs\"><Burger size=\"xs\" slot=\"icon\" /></IconButton\n          >\n        </div>\n      </div>\n      <!-- Mobile menu -->\n      <nav\n        id=\"nav-10\"\n        :class=\"{ 'block': open, 'hidden': !open }\"\n        class=\"hidden mt-2 md:hidden space-y-2\"\n        aria-label=\"Mobile\"\n      >\n        <Button variant=\"muted\" size=\"xs\" class=\"w-full\">Overview</Button>\n        <Button variant=\"muted\" size=\"xs\" class=\"w-full\">Graphs</Button>\n        <Button variant=\"accent\" size=\"xs\" class=\"w-full\">Backups</Button>\n      </nav>\n    </div>\n  </header>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
