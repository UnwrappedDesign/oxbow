      "content": "---\nexport const description = \"Checkbox with Disabled State\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full p-24 bg-white gap-2 \"\n>\n  <!-- copy:start -->\n  <div class=\"flex items-center gap-2\">\n    <input\n      id=\"disabled-checkbox\"\n      name=\"disabled-checkbox\"\n      type=\"checkbox\"\n      class=\"text-primary rounded shadow opacity-50 size-4 border-base-300 focus:ring-primary disabled:cursor-not-allowed disabled:bg-base-100 \"\n      disabled\n    />\n    <Text\n      for=\"disabled-checkbox\"\n      tag=\"label\"\n      class=\"block text-sm cursor-not-allowed text-base-400 \"\n    >\n      Disabled checkbox\n    </Text>\n  </div>\n  <!-- copy:end -->\n</section>\n"
