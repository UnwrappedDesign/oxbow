  "files": [
    {
      "name": "11.astro",
      "path": "oxbow/application/tabs/11.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"border-l-2\",\n  \"border-border\",\n  \"text-muted-foreground\",\n  \"bg-muted\",\n  \"ring-1\",\n  \"ring-border\",\n];\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-background\">\n  <!-- Vertical Tabs • Sidebar with counts -->\n  <div\n    x-data=\"{\n      keys: ['overview','projects','packages','team'],\n      selected: 'overview',\n      focus: 0,\n      init(){ this.focus = 0 },\n      select(id){ this.selected = id; this.focus = this.keys.indexOf(id) },\n      onKeydown(e){\n        const last=this.keys.length-1; let i=this.focus;\n        if(e.key==='ArrowDown') i=i===last?0:i+1;\n        else if(e.key==='ArrowUp') i=i===0?last:i-1;\n        else if(e.key==='Home') i=0; else if(e.key==='End') i=last; else return;\n        e.preventDefault(); const id=this.keys[i]; this.focus=i; this.$nextTick(()=>this.$refs['tab-'+id]?.focus());\n      }\n    }\"\n    class=\"w-full max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12\"\n  >\n    <aside>\n      <div\n        role=\"tablist\"\n        aria-orientation=\"vertical\"\n        class=\"flex md:flex-col gap-1\"\n      >\n        <template x-for=\"(id, idx) in keys\" :key=\"id\">\n          <button\n            class=\"flex items-center justify-between w-full px-3 py-2 text-sm font-medium text-left rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-border\"\n            :id=\"'tab-'+id\"\n            role=\"tab\"\n            :aria-selected=\"selected===id\"\n            :tabindex=\"focus===idx?0:-1\"\n            :aria-controls=\"'panel-'+id\"\n            x-ref=\"tab-[[id]]\"\n            @click=\"select(id)\"\n            @keydown=\"onKeydown($event)\"\n            :class=\"selected===id ? 'bg-background md:pl-2 text-foreground' : 'text-muted-foreground hover:text-foreground'\"\n          >\n            <span x-text=\"id.charAt(0).toUpperCase()+id.slice(1)\"></span>\n            <span\n              class=\"ml-3 inline-flex items-center px-1.5 h-5 text-[0.70rem] rounded-full border\"\n              :class=\"selected===id ? 'text-foreground' : 'text-muted-foreground'\"\n              x-text=\"id==='projects'? '12' : id==='packages' ? '7' : '3'\"\n            ></span>\n          </button>\n        </template>\n      </div>\n    </aside>\n    <main class=\"pt-1 text-sm text-muted-foreground md:col-span-2\">\n      <template x-for=\"id in keys\" :key=\"'panel-'+id\">\n        <section\n          x-show=\"selected===id\"\n          x-cloak\n          role=\"tabpanel\"\n          :id=\"'panel-'+id\"\n          :aria-labelledby=\"'tab-'+id\"\n          class=\"p-4 border rounded-lg border-border\"\n        >\n          <p>\n            <span x-text=\"id.charAt(0).toUpperCase()+id.slice(1)\"></span> content\n            — vertical sidebar with counts.\n          </p>\n        </section>\n      </template>\n    </main>\n  </div>\n</div>\n"
    }
  ],
