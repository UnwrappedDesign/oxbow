      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport XBrand from \"@/components/fundations/icons/XBrand.astro\";\nimport LinkedinBrand from \"@/components/fundations/icons/LinkedinBrand.astro\";\nimport YoutubeBrand from \"@/components/fundations/icons/YoutubeBrand.astro\";\nimport GithubBrand from \"@/components/fundations/icons/GithubBrand.astro\";\n---\n\n<div class=\"flex items-center justify-center bg-white p-14 \">\n  <!-- copy:start -->\n  <div class=\"flex-shrink-0 block group\">\n    <div class=\"flex flex-col items-center text-center gap-2\">\n      <div>\n        <img\n          class=\"inline-block object-cover rounded-full size-16 ring-2 ring-white \"\n          src=\"/avatars/1.jpg\"\n          alt=\"User\"\n        />\n      </div>\n      <Text\n        tag=\"a\"\n        href=\"#_\"\n        variant=\"textBase\"\n        class=\"font-medium hover:text-primary text-base-500 \"\n      >\n        <Text\n          tag=\"h3\"\n          variant=\"textBase\"\n          class=\"font-medium text-base-900 \"\n        >\n          Michael Andreuzza\n        </Text>\n        <Text tag=\"p\" variant=\"textXS\" class=\"font-medium text-base-400\">\n          example@example.com\n        </Text>\n      </Text>\n      <nav\n        aria-labelledby=\"social-icons-heading\"\n        role=\"navigation\"\n        class=\"flex items-center gap-4 text-base-500\"\n      >\n        <Text id=\"social-icons-heading\" class=\"sr-only\">\n          Follow us on social media\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"font-medium hover:text-primary/88 text-base-500 \"\n        >\n          <XBrand size=\"sm\" />\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"font-medium hover:text-primary/88 text-base-500 \"\n        >\n          <LinkedinBrand size=\"sm\" />\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"font-medium hover:text-primary/88 text-base-500 \"\n        >\n          <GithubBrand size=\"sm\" />\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"font-medium hover:text-primary/88 text-base-500 \"\n        >\n          <YoutubeBrand size=\"sm\" />\n        </Text>\n      </nav>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
