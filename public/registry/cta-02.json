      "path": "oxbow/marketing/cta/02.astro",
      "content": "---\nexport const description = \"Centered CTA with logo and text\";\n// Assets\nimport Logo from \"@/components/assets/Logo.astro\";\n\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div\n      class=\"relative p-8 shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 lg:p-16 rounded-xl\"\n    >\n      <div class=\"max-w-xl mx-auto text-center lg:text-balance\">\n        <div class=\"absolute inset-x-0 z-10 flex justify-center -top-10\">\n          <div\n            class=\"inline-block p-4 rounded-2xl bg-base-900 \"\n          >\n            <Logo class=\"h-12 text-white \" />\n          </div>\n        </div>\n        <Text\n          tag=\"h2\"\n          variant=\"displayMD\"\n          class=\"mt-12 font-semibold tracking-tight text-base-900 lg:text-balance\"\n        >\n          Unlock your team's potential\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"mt-4 text-base-600 lg:text-balance\"\n        >\n          Simple, powerful tools to help you collaborate, organize, and launch\n          faster. No clutter, just what you need to succeed.\n        </Text>\n        <div\n          class=\"flex flex-wrap items-center justify-center mt-8 text-base-900 gap-y-2 gap-x-8\"\n        >\n          <Text tag=\"p\" variant=\"textSM\">Trusted by thousands</Text>\n\n          <Text tag=\"p\" variant=\"textSM\">100% focused on your growth</Text>\n\n          <Text tag=\"p\" variant=\"textSM\"\n            >Independently built, always improving</Text\n          >\n        </div>\n\n        <Button\n          variant=\"default\"\n          size=\"base\"\n          gap=\"xs\"\n          class=\"flex mx-auto mt-8 w-fit\"\n          >Try it free <span aria-hidden=\"true\">—</span>No credit card needed</Button\n        >\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
