  "files": [
    {
      "name": "09.astro",
      "path": "oxbow/application/input-groups/09.astro",
      "content": "---\nexport const description = \"Quantity input group\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n// Icons\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\nimport Minus from \"@/components/fundations/icons/Minus.astro\";\n---\n\n<section class=\"justify-center h-full bg-white gap-2 p-15 \">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"w-full space-y-1\" x-data=\"{ count: 0 }\">\n      <label class=\"text-sm font-medium text-base-500\"> Quantity </label>\n      <div class=\"flex items-center\">\n        <Button\n          @click=\"count--\"\n          variant=\"outline\"\n          onlyIconSize=\"sm\"\n          noRoundedRight\n        >\n          <Minus slot=\"left-icon\" size=\"sm\" />\n        </Button>\n        <TextInput\n          size=\"sm\"\n          isGrouped={true}\n          noRounded={true}\n          type=\"number\"\n          id=\"input-plus-minus\"\n          name=\"input-plus-minus\"\n          x-model=\"count\"\n          readonly\n        />\n        <Button\n          @click=\"count++\"\n          variant=\"outline\"\n          onlyIconSize=\"sm\"\n          no\n          noRoundedLeft\n        >\n          <Plus slot=\"right-icon\" size=\"sm\" />\n        </Button>\n      </div>\n    </div>\n    <!-- copy:end -->\n  </div>\n</section>\n"
    }
  ],
