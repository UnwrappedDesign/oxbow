  "files": [
    {
      "name": "17.astro",
      "path": "oxbow/application/textarea/17.astro",
      "content": "---\nexport const description = \"Textarea with Inline Tags\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-background\">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div\n      class=\"w-full space-y-2\"\n      x-data=\"{ text: '', tags: ['#Important', '#Todo'] }\"\n    >\n      <div>\n        <Text\n          for=\"inline-tags-textarea\"\n          tag=\"label\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground\"\n        >\n          Inline tags\n        </Text>\n        <textarea\n          id=\"inline-tags-textarea\"\n          x-model=\"text\"\n          rows=\"4\"\n          placeholder=\"Type and use inline tags\"\n          class=\"block w-full px-4 py-2 text-sm text-foreground bg-background border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n        ></textarea>\n      </div>\n      <div class=\"flex mt-2 gap-2\">\n        <template x-for=\"tag in tags\" :key=\"tag\">\n          <Button\n            @click=\"text += tag + ' '\"\n            x-text=\"tag\"\n            type=\"button\"\n            variant=\"muted\"\n            size=\"xs\"\n          >\n            Clear\n          </Button>\n        </template>\n      </div>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
  ],
