      "path": "oxbow/marketing/pricing/11.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"w-1/2\",\n  \"translate-x-0\",\n  \"translate-x-full\",\n  \"text-base-900\",\n  \"focus:text \",\n  \"hover:text-base-900\",\n];\n\nexport const description =\n  \"Pricing section with three cards on feature comparison table\";\n\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Wrapper from \"@/components/fundations/containers/Wrapper.astro\";\n// Icons\nimport Check from \"@/components/fundations/icons/Check.astro\";\n// Components\nimport PricingToggle from \"@/components/fundations/buttonGroups/PricingToggle.astro\";\n---\n\n<section x-data=\"{ duration: 'monthly' }\" class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <p class=\"text-center text-base-500 lg:hidden\">\n      Pricing table for desktop use\n    </p>\n    <!---- Use only from xl: -->\n    <div class=\"hidden lg:block\">\n      <div\n        class=\"text-center md:text-left grid grid-cols-1 gap-12 md:grid-cols-2 md:items-end\"\n      >\n        <Text\n          tag=\"h1\"\n          variant=\"displayMD\"\n          class=\"font-medium tracking-tight text-base-900 text-balance \"\n        >\n          Equip your business with world class software\n        </Text>\n        <div\n          aria-labelledby=\"pricing-toggle\"\n          class=\"relative z-0 inline-flex justify-center w-full p-1 overflow-hidden bg-white shadow ring-1 ring-base-200 ring-offset-2 gap-4 rounded-md max-w-52 lg:ml-auto\"\n        >\n          <div\n            class=\"absolute inset-0 bg-base-50 rounded-md transition-transform duration-200 ease-in-out\"\n            :class=\"duration === 'monthly' ? 'w-1/2 translate-x-0' : 'w-1/2 translate-x-full'\"\n          >\n          </div>\n          <button\n            class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n            :class=\"duration === 'monthly' ? 'text-base-600 ' : 'focus:text-base-900 hover:text-base-900 '\"\n            @click=\"duration = 'monthly'\"\n            type=\"button\"\n            :aria-pressed=\"duration === 'monthly'\"\n          >\n            Monthly\n          </button>\n          <button\n            class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n            :class=\"duration === 'annual' ? 'text-base-600 ' : 'focus:text-base-900 hover:text-base-900 '\"\n            @click=\"duration = 'annual'\"\n            type=\"button\"\n            :aria-pressed=\"duration === 'annual'\"\n          >\n            Annual\n          </button>\n        </div>\n      </div>\n      <table class=\"w-full mx-auto mt-8 text-center bg-transparent\">\n        <thead>\n          <tr class=\"align-top\">\n            <th class=\"w-1/4\"> </th>\n            <th class=\"relative w-1/4 p-1 pr-0 font-normal text-left\">\n              <div\n                aria-hidden=\"true\"\n                class=\"absolute inset-y-0 right-0 hidden w-full\"\n              >\n              </div>\n              <div class=\"relative pb-4 pr-2\">\n                <div class=\"flex items-start justify-between w-full\">\n                  <div>\n                    <Text\n                      tag=\"h3\"\n                      variant=\"textBase\"\n                      class=\"font-semibold text-base-900 \"\n                    >\n                      Core\n                    </Text>\n                    <Text\n                      tag=\"p\"\n                      variant=\"textSM\"\n                      class=\"mt-1 text-base-500 \"\n                    >\n                      For individuals\n                    </Text>\n                  </div>\n                </div>\n                <div class=\"mt-8\">\n                  <p\n                    class=\"text-4xl font-medium sm:text-xl md:text-4xl text-base-900 \"\n                  >\n                  </p>\n                  <div class=\"flex items-center gap-x-4\">\n                    <p\n                      class=\"text-4xl font-medium sm:text-xl md:text-4xl text-base-900 \"\n                    >\n                      <span\n                        data-monthly=\"$29\"\n                        data-annual=\"$19\"\n                        x-text=\"$el.dataset[duration]\"></span>\n                    </p>\n                    <div\n                      class=\"text-xs font-medium capitalize text-base-900 \"\n                    >\n                      <span x-show=\"duration === 'monthly'\">\n                        <span x-show=\"duration === 'monthly'\">\n                          month</span\n                        ></span\n                      >\n                      <span\n                        x-show=\"duration === 'annual'\"\n                        style=\"display: none;\"\n                      >\n                        annually</span\n                      >\n                      <Text\n                        tag=\"p\"\n                        variant=\"textSM\"\n                        class=\"text-base-500 \"\n                        >USD + Local taxes</Text\n                      >\n                    </div>\n                  </div>\n                  <div class=\"mt-8\">\n                    <Button class=\"w-full\" variant=\"outline\" size=\"sm\">\n                      Get Started\n                    </Button>\n                  </div>\n                </div>\n              </div>\n            </th>\n            <th class=\"relative w-1/4 p-1 px-0 font-normal text-left\">\n              <div\n                aria-hidden=\"true\"\n                class=\"absolute inset-y-0 right-0 hidden w-full sm:block\"\n              >\n              </div>\n              <div class=\"relative px-2 pb-4\">\n                <div>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textBase\"\n                    class=\"font-medium text-base-900 \"\n                  >\n                    Momentum\n                  </Text>\n                  <Text\n                    tag=\"p\"\n                    variant=\"textSM\"\n                    class=\"mt-1 text-base-500 \"\n                  >\n                    For small businesses\n                  </Text>\n                </div>\n                <div class=\"mt-8\">\n                  <div class=\"flex items-center gap-x-4\">\n                    <p\n                      class=\"text-4xl font-medium text-base-900 sm:text-xl md:text-4xl\"\n                    >\n                      <span\n                        data-monthly=\"$49\"\n                        data-annual=\"$39\"\n                        x-text=\"$el.dataset[duration]\"></span>\n                    </p>\n                    <div\n                      class=\"text-xs font-medium capitalize text-base-900 \"\n                    >\n                      <span x-show=\"duration === 'monthly'\">\n                        <span x-show=\"duration === 'monthly'\">\n                          month</span\n                        ></span\n                      >\n                      <span\n                        x-show=\"duration === 'annual'\"\n                        style=\"display: none;\"\n                      >\n                        annually</span\n                      >\n                      <Text\n                        tag=\"p\"\n                        variant=\"textSM\"\n                        class=\"text-base-500 \"\n                        >USD + Local taxes</Text\n                      >\n                    </div>\n                  </div>\n                  <div class=\"mt-8\">\n                    <Button class=\"w-full\" variant=\"defult\" size=\"sm\">\n                      Get Started\n                    </Button>\n                  </div>\n                </div>\n              </div>\n            </th>\n            <th class=\"relative w-1/4 p-1 pl-0 font-normal text-left\">\n              <div\n                aria-hidden=\"true\"\n                class=\"absolute inset-y-0 right-0 hidden w-full rounded-tr-xl sm:block\"\n              >\n              </div>\n              <div class=\"relative pb-4 pl-2\">\n                <div class=\"flex items-start justify-between w-full\">\n                  <div>\n                    <Text\n                      tag=\"h3\"\n                      variant=\"textBase\"\n                      class=\"font-semibold text-base-900 \"\n                    >\n                      Growth\n                    </Text>\n                    <Text\n                      tag=\"p\"\n                      variant=\"textSM\"\n                      class=\"mt-1 text-base-500 \"\n                    >\n                      For big companies\n                    </Text>\n                  </div>\n                </div>\n                <div class=\"mt-8\">\n                  <p\n                    class=\"text-4xl font-medium sm:text-xl md:text-4xl text-base-900 \"\n                  >\n                  </p>\n                  <div class=\"flex items-center gap-x-4\">\n                    <p\n                      class=\"text-4xl font-medium sm:text-xl md:text-4xl text-base-900 \"\n                    >\n                      <span\n                        data-monthly=\"$99\"\n                        data-annual=\"$129\"\n                        x-text=\"$el.dataset[duration]\"></span>\n                    </p>\n                    <div\n                      class=\"text-xs font-medium capitalize text-base-900 \"\n                    >\n                      <span x-show=\"duration === 'monthly'\">\n                        <span x-show=\"duration === 'monthly'\">\n                          month</span\n                        ></span\n                      >\n                      <span\n                        x-show=\"duration === 'annual'\"\n                        style=\"display: none;\"\n                      >\n                        annually</span\n                      >\n                      <Text\n                        tag=\"p\"\n                        variant=\"textSM\"\n                        class=\"text-base-500 \"\n                        >USD + Local taxes</Text\n                      >\n                    </div>\n                  </div>\n                  <div class=\"mt-8\">\n                    <Button class=\"w-full\" variant=\"outline\" size=\"sm\">\n                      Get Started\n                    </Button>\n                  </div>\n                </div>\n              </div>\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr class=\"overflow-hidden\">\n            <th\n              scope=\"colgroup\"\n              colspan=\"4\"\n              class=\"py-4 text-base font-medium text-left leading-6 text-base-900 border-y border-base-200 \"\n            >\n              Usage\n            </th>\n          </tr>\n\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left text-base-500 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />\n                Analytics\n              </div>\n            </th>\n            <td class=\"px-2 text-xs font-medium text-base-900 \"\n              >3</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t border-primary/24 bg-primary/16 text-base-900\"\n              >10</td\n            >\n            <td class=\"px-2 text-xs font-medium text-base-900 \"\n              >Unlimited</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />Accounts\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >5</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t border-primary/24 bg-primary/16 text-base-900\"\n              >10</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >Unlimited</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />Integrations\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >2</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t border-primary/24 bg-primary/16 text-base-900\"\n            >\n              YES\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >Unlimited</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />Programs\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n            >\n              NO\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t border-primary/24 bg-primary/16 text-base-900\"\n              >1</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >Unlimited</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />Deployments\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n            >\n              NO\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t border-primary/24 bg-primary/16 text-base-900\"\n            >\n              YES\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >Unlimited</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />Advanced Checkpoints\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n            >\n              NO\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t border-primary/24 bg-primary/16 text-base-900\"\n            >\n              YES\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >Unlimited</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />Reporting tools\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n            >\n              NO\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t border-primary/24 bg-primary/16 text-base-900\"\n            >\n              YES\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >Unlimited</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n              ><div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />Support\n              </div></th\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >Discord community</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium text-white border-t border-primary/24 bg-primary/16 text-base-900\"\n              >Live chat</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >Unlimited</td\n            >\n          </tr>\n\n          <tr class=\"overflow-hidden\">\n            <th\n              scope=\"colgroup\"\n              colspan=\"4\"\n              class=\"py-4 text-base font-medium text-left leading-6 text-base-900 border-y border-base-200 \"\n            >\n              Features\n            </th>\n          </tr>\n\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left text-base-500 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />\n                Service agreement\n              </div>\n            </th>\n            <td class=\"px-2 text-xs font-medium text-base-900 \"\n              >No</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium text-white border-t border-primary/24 bg-primary/16 text-base-900\"\n              >No</td\n            >\n            <td class=\"px-2 text-xs font-medium text-base-900 \"\n              >YES</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />Dedicted Manager\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >No</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t border-primary/24 bg-primary/16 text-base-900\"\n              >Yes</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >Yes</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />Onboarding sessions\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >No</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t border-primary/24 bg-primary/16 text-base-900\"\n            >\n              No\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 \"\n              >Yes</td\n            >\n          </tr>\n          <tr>\n            <th\n              class=\"py-3 text-sm font-medium text-left border-t text-base-900 border-base-200 \"\n            >\n              <div class=\"flex items-center gap-2\">\n                <Check size=\"sm\" />Dedicated support channel\n              </div>\n            </th>\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 rounded-bl-xl\"\n            >\n              No\n            </td>\n            <td\n              class=\"px-2 text-xs font-medium border-t border-primary/24 bg-primary/16 text-base-900\"\n              >No</td\n            >\n            <td\n              class=\"px-2 text-xs font-medium border-t text-base-900 border-base-200 rounded-br-xl\"\n              >Yes</td\n            >\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</section>\n"
