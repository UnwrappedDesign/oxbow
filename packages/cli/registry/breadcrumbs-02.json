{
  "name": "breadcrumbs-02",
  "type": "component",
  "description": "Breadcrumb with dropdown menu",
  "category": "application",
  "section": "breadcrumbs",
  "variant": 2,
  "aliases": [
    "breadcrumbs",
    "breadcrumbs 2",
    "breadcrumbs 02",
    "breadcrumb",
    "breadcrumb 2",
    "breadcrumb 02"
  ],
  "files": [
    {
      "name": "02.astro",
      "path": "oxbow/application/breadcrumbs/02.astro",
      "content": "---\nexport const description = \"Breadcrumb with dropdown menu\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\nimport ThreeDots from \"@/components/fundations/icons/ThreeDots.astro\";\nimport User from \"@/components/fundations/icons/User.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full bg-background gap-2 p-18\"\n>\n  <!-- copy:start -->\n  <nav aria-label=\"Breadcrumb\">\n    <ol role=\"list\" class=\"flex items-center space-x-2\">\n      <li>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXS\"\n          class=\"flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground\"\n        >\n          Home\n          <ChevronRight size=\"base\" aria-hidden=\"true\" />\n        </Text>\n      </li>\n\n      <li class=\"relative flex items-center\">\n        <!-- Teleportable, self-contained dropdown -->\n        <div\n          x-data=\"{\n            open: false,\n            style: '',\n            gap: 8,\n            align() {\n              const btn = this.$refs.trigger;\n              if (!btn) return;\n              const r = btn.getBoundingClientRect();\n              const left = r.left;                // left-align (change to r.left + r.width/2 for centered)\n              const top  = r.bottom + this.gap;   // just under the button\n              const minw = Math.max(128, r.width);// keep at least 128px\n              this.style = `position:fixed; left:${left}px; top:${top}px; min-width:${minw}px;`;\n            },\n            toggle() {\n              if (this.open) { this.open = false; return; }\n              this.align(); requestAnimationFrame(() => { this.open = true; this.$nextTick(()=> this.$refs.firstItem && this.$refs.firstItem.focus()); });\n            },\n            close() { this.open = false; }\n          }\"\n          x-init=\"\n            const realign = () => { if (open) align() };\n            window.addEventListener('resize', realign);\n            window.addEventListener('scroll', realign, { passive: true });\n          \"\n          class=\"flex items-center gap-2\"\n        >\n          <button\n            x-ref=\"trigger\"\n            @click=\"toggle\"\n            :aria-expanded=\"open\"\n            aria-haspopup=\"menu\"\n            aria-controls=\"bc-overflow-menu\"\n            aria-label=\"Open breadcrumb menu\"\n            class=\"flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors\"\n          >\n            <ThreeDots size=\"base\" />\n          </button>\n          <ChevronRight\n            size=\"base\"\n            class=\"text-muted-foreground\"\n            aria-hidden=\"true\"\n          />\n\n          <!-- Backdrop to catch outside clicks -->\n          <div\n            x-show=\"open\"\n            x-transition.opacity\n            class=\"fixed inset-0 z-[999]\"\n            style=\"display:none\"\n            @click=\"close\"\n            @keydown.escape.window=\"close\"\n            aria-hidden=\"true\"\n          >\n          </div>\n\n          <!-- The menu, teleported to body to avoid clipping -->\n          <template x-teleport=\"body\">\n            <div\n              x-show=\"open\"\n              :style=\"style\"\n              style=\"display:none\"\n              id=\"bc-overflow-menu\"\n              class=\"z-[1000]\"\n              role=\"menu\"\n              @keydown.escape.window=\"close\"\n              tabindex=\"-1\"\n              x-transition:enter=\"transition ease-out duration-200\"\n              x-transition:enter-start=\"opacity-0 translate-y-1\"\n              x-transition:enter-end=\"opacity-100 translate-y-0\"\n              x-transition:leave=\"transition ease-in duration-150\"\n              x-transition:leave-start=\"opacity-100 translate-y-0\"\n              x-transition:leave-end=\"opacity-0 translate-y-1\"\n            >\n              <div\n                class=\"w-32 overflow-hidden bg-background shadow-lg rounded-xl ring-1 ring-border divide-y divide-border\"\n              >\n                <div class=\"p-1.5\">\n                  <Text\n                    tag=\"a\"\n                    href=\"#_\"\n                    variant=\"textSM\"\n                    role=\"menuitem\"\n                    tabindex=\"-1\"\n                    x-ref=\"firstItem\"\n                    class=\"flex items-center p-2 rounded-lg hover:bg-background hover:text-foreground gap-2 text-muted-foreground\"\n                    @click=\"close\"\n                  >\n                    <User size=\"sm\" />\n                    Profile\n                  </Text>\n                </div>\n                <div class=\"p-1.5 bg-background\">\n                  <Button\n                    class=\"w-full\"\n                    variant=\"outline\"\n                    size=\"xs\"\n                    role=\"menuitem\"\n                    tabindex=\"-1\"\n                    @click=\"close\"\n                  >\n                    Sign out\n                  </Button>\n                </div>\n              </div>\n            </div>\n          </template>\n        </div>\n      </li>\n\n      <li>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXS\"\n          class=\"flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground\"\n        >\n          Help Center\n        </Text>\n      </li>\n    </ol>\n  </nav>\n  <!-- copy:end -->\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
