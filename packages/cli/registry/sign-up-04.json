{
  "name": "sign-up-04",
  "type": "component",
  "description": "Split screen signup with customers",
  "category": "application",
  "section": "sign-up",
  "variant": 4,
  "aliases": [
    "sign up",
    "sign up 4",
    "sign up 04"
  ],
  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/application/sign-up/04.astro",
      "content": "---\nexport const description = \"Split screen signup with customers\";\n\n// Assets\nimport { Image } from \"astro:assets\";\nimport Placeholder from \"@/images/gradients/3.jpeg\";\nimport One from \"@/images/brandsLight/1.svg\";\nimport Two from \"@/images/brandsLight/2.svg\";\nimport Three from \"@/images/brandsLight/3.svg\";\nimport Four from \"@/images/brandsLight/4.svg\";\n\n// Fundations\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Select from \"@/components/fundations/inputs/Select.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\nconst logos = [One, Two, Three, Four];\n---\n\n<div class=\"flex h-screen bg-background\">\n  <div class=\"flex items-center justify-center w-full lg:w-1/2\">\n    <div class=\"w-full max-w-md p-8 py-24 lg:py-32\">\n      <div>\n        <Text\n          tag=\"h1\"\n          variant=\"displaySM\"\n          class=\"font-semibold tracking-tight text-foreground\"\n        >\n          Create your account\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-2 text-muted-foreground text-balance\"\n        >\n          Join the party. Set up your account the old-fashioned way—email,\n          password, done.\n        </Text>\n      </div>\n      <form class=\"mt-10 space-y-4\">\n        <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n          <TextInput\n            class=\"w-full\"\n            id=\"name\"\n            name=\"name\"\n            label=\"Full Name\"\n            type=\"text\"\n            variant=\"default\"\n            size=\"base\"\n            placeholder=\"John Doe\"\n          /><TextInput\n            id=\"last-name\"\n            name=\"lastName\"\n            label=\"Last Name\"\n            type=\"text\"\n            variant=\"default\"\n            size=\"base\"\n            placeholder=\"Doe\"\n          />\n\n          <!-- Country Select -->\n          <Select\n            class=\"w-full\"\n            id=\"country\"\n            name=\"country\"\n            label=\"Select a country\"\n            variant=\"default\"\n            options={[\n              { value: \"\", label: \"Select your country\" },\n              { value: \"us\", label: \"United States\" },\n              { value: \"ca\", label: \"Canada\" },\n              { value: \"gb\", label: \"United Kingdom\" },\n              { value: \"de\", label: \"Germany\" },\n              { value: \"fr\", label: \"France\" },\n              { value: \"in\", label: \"India\" },\n              { value: \"au\", label: \"Australia\" },\n              { value: \"br\", label: \"Brazil\" },\n              { value: \"jp\", label: \"Japan\" },\n              { value: \"za\", label: \"South Africa\" },\n            ]}\n          />\n\n          <!-- State Select -->\n          <Select\n            class=\"w-full\"\n            id=\"state\"\n            name=\"state\"\n            label=\"Select a state\"\n            variant=\"default\"\n            options={[\n              { value: \"\", label: \"Select your state\" },\n              { value: \"AL\", label: \"Alabama\" },\n              { value: \"AK\", label: \"Alaska\" },\n              { value: \"AZ\", label: \"Arizona\" },\n              { value: \"AR\", label: \"Arkansas\" },\n              { value: \"CA\", label: \"California\" },\n              { value: \"CO\", label: \"Colorado\" },\n              { value: \"CT\", label: \"Connecticut\" },\n              { value: \"DE\", label: \"Delaware\" },\n              { value: \"FL\", label: \"Florida\" },\n              { value: \"GA\", label: \"Georgia\" },\n              { value: \"HI\", label: \"Hawaii\" },\n              { value: \"ID\", label: \"Idaho\" },\n              { value: \"IL\", label: \"Illinois\" },\n              { value: \"IN\", label: \"Indiana\" },\n              { value: \"IA\", label: \"Iowa\" },\n              { value: \"KS\", label: \"Kansas\" },\n              { value: \"KY\", label: \"Kentucky\" },\n              { value: \"LA\", label: \"Louisiana\" },\n              { value: \"ME\", label: \"Maine\" },\n            ]}\n          />\n          <TextInput\n            class=\"w-full\"\n            id=\"phone\"\n            name=\"phone\"\n            label=\"Phone Number\"\n            type=\"tel\"\n            variant=\"default\"\n            size=\"base\"\n            placeholder=\"(123) 456-7890\"\n          />\n\n          <TextInput\n            class=\"w-full\"\n            id=\"email\"\n            name=\"email\"\n            label=\"Email Address\"\n            type=\"email\"\n            variant=\"default\"\n            size=\"base\"\n            placeholder=\"you@example.com\"\n          />\n          <TextInput\n            class=\"w-full\"\n            id=\"password\"\n            name=\"password\"\n            label=\"Password\"\n            type=\"password\"\n            passwordToggle={true}\n            size=\"base\"\n            placeholder=\"••••••••\"\n            required\n          />\n          <TextInput\n            class=\"w-full\"\n            id=\"confirm-password\"\n            name=\"confirmPassword\"\n            label=\"Confirm Password\"\n            type=\"password\"\n            passwordToggle={true}\n            size=\"base\"\n            placeholder=\"••••••••\"\n            required\n          />\n        </div>\n        <Text\n          tag=\"p\"\n          variant=\"textXS\"\n          class=\"font-medium text-muted-foreground\"\n        >\n          By creating an account, you agree to our\n          <a\n            href=\"#_\"\n            class=\"font-medium text-foreground hover:text-muted-foreground\"\n          >\n            Terms of service\n          </a>\n          and\n          <a\n            href=\"#_\"\n            class=\"font-medium text-foreground hover:text-muted-foreground\"\n          >\n            Privacy Policy\n          </a>\n        </Text>\n        <Button fullWidth variant=\"default\" size=\"base\">\n          Create account\n        </Button>\n      </form>\n      <Text\n        tag=\"p\"\n        variant=\"textXS\"\n        class=\"mt-4 font-medium text-muted-foreground\"\n      >\n        Already have an account?\n        <a\n          href=\"#_\"\n          class=\"font-medium text-foreground hover:text-muted-foreground\"\n        >\n          Sign in\n        </a>\n      </Text>\n    </div>\n  </div>\n  <div class=\"relative hidden overflow-hidden lg:block lg:w-1/2\">\n    <Image\n      width={1200}\n      height={1200}\n      src={Placeholder}\n      alt=\"Background\"\n      aria-hidden=\"true\"\n      class=\"object-cover object-center w-full h-full bg-background grayscale\"\n    />\n    <div\n      aria-hidden=\"true\"\n      class=\"absolute inset-0 pointer-events-none bg-background/80\"\n    >\n    </div>\n    <div class=\"absolute inset-0 flex flex-col items-start justify-between p-8\">\n      <div>\n        <a href=\"#_\">\n          <span class=\"sr-only\">Back to home</span>\n          <Logo\n            class=\"h-12 mx-auto text-foreground md:mx-0\"\n            aria-hidden=\"true\"\n          /></a\n        >\n        <Text\n          tag=\"h1\"\n          variant=\"displaySM\"\n          class=\"mt-24 font-semibold text-shadow-sm text-balance\"\n        >\n          Go ahead, start your \"journey.\"\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"mt-2 text-shadow-sm\"\n        >\n          Join the internet’s favorite club of freelancers and business owners—\n          because what could possibly go wrong?\n        </Text>\n      </div>\n\n      <div class=\"w-full grid grid-cols-4 gap-8\">\n        {\n          logos.map((logo) => (\n            <Image\n              class=\"max-h-3\"\n              src={logo}\n              alt=\"#_\"\n              width={158}\n              height={48}\n            />\n          ))\n        }\n      </div>\n    </div>\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
