{
  "name": "sidebars-01",
  "type": "component",
  "description": "sidebars block 01",
  "category": "application",
  "section": "sidebars",
  "variant": 1,
  "aliases": [
    "sidebars",
    "sidebars 1",
    "sidebars 01",
    "sidebar",
    "sidebar 1",
    "sidebar 01"
  ],
  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/application/sidebars/01.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  // x-transition & responsive utilities used by Alpine\n  \"opacity-0\",\n  \"opacity-100\",\n  \"translate-x-0\",\n  \"-translate-x-full\",\n  \"sm:translate-x-0\",\n  \"pointer-events-none\",\n  \"pointer-events-auto\",\n];\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport X from \"@/components/fundations/icons/X.astro\";\nimport Home from \"@/components/fundations/icons/Home.astro\";\nimport Grid from \"@/components/fundations/icons/Grid.astro\";\nimport Report from \"@/components/fundations/icons/Report.astro\";\nimport Burger from \"@/components/fundations/icons/Burger.astro\";\nimport SearchIcon from \"@/components/fundations/icons/Search.astro\";\nimport Settings from \"@/components/fundations/icons/Settings.astro\";\nimport Lifebuoy from \"@/components/fundations/icons/Lifebuoy.astro\";\nimport FileDots from \"@/components/fundations/icons/FileDots.astro\";\nimport Clipboard from \"@/components/fundations/icons/Clipboard.astro\";\nimport UsersGroup from \"@/components/fundations/icons/UsersGroup.astro\";\nimport CircleInfo from \"@/components/fundations/icons/CircleInfo.astro\";\nimport ChevronDown from \"@/components/fundations/icons/ChevronDown.astro\";\nimport ExternalLink from \"@/components/fundations/icons/ExternalLink.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\n---\n\n<div class=\"relative bg-background\">\n  <!-- copy:start -->\n  <!-- Mobile top bar -->\n  <div class=\"lg:hidden sticky top-0 z-40 bg-background border-b border-border\">\n    <div class=\"flex items-center justify-between px-4 h-12\">\n      <div class=\"flex items-center gap-2\">\n        <Logo class=\"text-foreground h-6\" />\n        <span\n          class=\"text-sm font-semibold text-foreground\"\n          >Oxbow UI</span\n        >\n      </div>\n      <IconButton\n        size=\"xxs\"\n        variant=\"muted\"\n        x-data\n        @click=\"$dispatch('sidebar-toggle')\"\n        aria-label=\"Open navigation\"\n      >\n        <Burger size=\"sm\" />\n      </IconButton>\n    </div>\n  </div>\n  <!-- Shell manages sidebar open/close -->\n  <div\n    x-data=\"{\n      open: false,\n      sections: { collections: true, recent: false, team: false },\n      search: '',\n      active: 'overview',\n      recent: [\n        { title: 'Getting Started Guide', type: 'guide', time: '2h ago' },\n        { title: 'API Documentation', type: 'doc', time: '1d ago' },\n        { title: 'User Onboarding Flow', type: 'article', time: '3d ago' },\n      ],\n      notifications: 5,\n    }\"\n    @sidebar-toggle.window=\"open = true\"\n    @keydown.escape.window=\"open=false\"\n    class=\"relative\"\n  >\n    <!-- Overlay for mobile -->\n    <div\n      class=\"fixed inset-0 z-40 bg-background/10 transition-opacity duration-200 lg:hidden\"\n      x-show=\"open\"\n      x-transition.opacity\n      @click=\"open=false\"\n      aria-hidden=\"true\"\n    >\n    </div>\n    <!-- Sidebar panel -->\n    <aside\n      class=\"fixed z-50 inset-y-0 left-0 w-72 lg:w-80 lg:static lg:translate-x-0 transform transition-transform duration-200 -translate-x-full lg:opacity-100 bg-background outline outline-1 outline-border flex flex-col\"\n      :class=\"open ? 'translate-x-0' : ''\"\n      x-trap.noscroll.inert=\"open && window.innerWidth < 1024\"\n    >\n      <!-- Header -->\n      <div\n        class=\"h-14 shrink-0 flex items-center justify-between px-4 lg:px-5 border-b border-border\"\n      >\n        <div class=\"flex items-center gap-2\">\n          <Logo class=\"text-foreground h-8\" />\n          <div>\n            <p class=\"text-sm font-semibold text-foreground leading-tight\">\n              Oxbow UI\n            </p>\n            <p class=\"text-[0.70rem] text-muted-foreground\">Knowledge Studio</p>\n          </div>\n        </div>\n        <button\n          class=\"lg:hidden p-2 rounded-md outline outline-1 outline-border text-foreground\"\n          @click=\"open=false\"\n          aria-label=\"Close navigation\"\n        >\n          <X />\n        </button>\n      </div>\n      <!-- Search -->\n      <div class=\"p-3 lg:p-4\">\n        <label class=\"relative block\">\n          <span\n            class=\"absolute inset-y-0 left-0 pl-3 flex items-center text-muted-foreground\"\n            ><SearchIcon class=\"size-4\" /></span\n          >\n          <input\n            x-model=\"search\"\n            placeholder=\"Find anything…\"\n            class=\"w-full pl-9 pr-3 block h-10 px-4 py-2 text-xs bg-background border border-transparent rounded-lg appearance-none text-muted-foreground duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n          />\n          <!-- Shortcut hint intentionally omitted for demo scope -->\n        </label>\n      </div>\n      <!-- Nav (make this the scrolling region; leave room for sticky footer) -->\n      <nav class=\"flex-1 px-2 lg:px-3 pb-40 overflow-y-auto\">\n        <ul class=\"space-y-1\">\n          <li>\n            <button\n              class=\"w-full h-9 px-3 rounded-md flex items-center gap-2 text-sm outline outline-1 outline-transparent hover:bg-background/5\"\n              :class=\"active==='overview' ? 'bg-background/10 text-foreground outline-border/10' : 'text-muted-foreground'\"\n              @click=\"active='overview'\"\n            >\n              <Home class=\"size-4\" />\n              <span>Overview</span>\n            </button>\n          </li>\n          <li>\n            <button\n              class=\"w-full h-9 px-3 rounded-md flex items-center gap-2 text-sm outline outline-1 outline-transparent hover:bg-background/5\"\n              :class=\"active==='workspace' ? 'bg-background/10 text-foreground outline-border/10' : 'text-muted-foreground'\"\n              @click=\"active='workspace'\"\n            >\n              <Grid class=\"size-4\" />\n              <span>Workspace</span>\n            </button>\n          </li>\n          <!-- Collections collapsible -->\n          <li class=\"pt-2 mt-2 border-t border-border\">\n            <button\n              class=\"w-full h-9 px-3 rounded-md flex items-center justify-between text-sm text-muted-foreground hover:bg-background/5\"\n              @click=\"sections.collections = !sections.collections\"\n              :aria-expanded=\"sections.collections\"\n            >\n              <span class=\"flex items-center gap-2\">\n                <Clipboard class=\"size-4\" />\n                <span>Collections</span>\n              </span>\n              <span class=\"text-muted-foreground\">\n                <ChevronDown x-show=\"sections.collections\" class=\"size-4\" />\n                <ChevronRight x-show=\"!sections.collections\" class=\"size-4\" />\n              </span>\n            </button>\n            <div x-show=\"sections.collections\" x-collapse>\n              <ul class=\"mt-1 pl-2 space-y-1\">\n                <li>\n                  <a\n                    href=\"#_\"\n                    class=\"group flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n                  >\n                    <span class=\"flex items-center gap-2\"\n                      ><FileDots class=\"size-4\" /> Drafts</span\n                    >\n                    <span\n                      class=\"text-[0.70rem] px-1.5 py-0.5 rounded text-foreground outline outline-1 outline-border bg-background/10 outline-border/10\"\n                      >18</span\n                    >\n                  </a>\n                </li>\n                <li>\n                  <a\n                    href=\"#_\"\n                    class=\"group flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n                  >\n                    <span class=\"flex items-center gap-2\"\n                      ><FileDots class=\"size-4\" /> Published</span\n                    >\n                    <span\n                      class=\"text-[0.70rem] px-1.5 py-0.5 rounded text-foreground outline outline-1 outline-border bg-background/10 outline-border/10\"\n                      >64</span\n                    >\n                  </a>\n                </li>\n                <li>\n                  <a\n                    href=\"#_\"\n                    class=\"group flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n                  >\n                    <span class=\"flex items-center gap-2\"\n                      ><FileDots class=\"size-4\" /> Archived</span\n                    >\n                    <span\n                      class=\"text-[0.70rem] px-1.5 py-0.5 rounded text-foreground outline outline-1 outline-border bg-background/10 outline-border/10\"\n                      >7</span\n                    >\n                  </a>\n                </li>\n              </ul>\n            </div>\n          </li>\n          <li class=\"pt-2 mt-2 border-t border-border\">\n            <button\n              class=\"w-full h-9 px-3 rounded-md flex items-center justify-between text-sm text-muted-foreground hover:bg-background/5\"\n              @click=\"sections.recent = !sections.recent\"\n              :aria-expanded=\"sections.recent\"\n            >\n              <span class=\"flex items-center gap-2\">\n                <FileDots class=\"size-4\" />\n                <span>Recent</span>\n              </span>\n              <span class=\"text-muted-foreground\">\n                <ChevronDown x-show=\"sections.recent\" class=\"size-4\" />\n                <ChevronRight x-show=\"!sections.recent\" class=\"size-4\" />\n              </span>\n            </button>\n            <div x-show=\"sections.recent\" x-collapse>\n              <ul class=\"mt-1 pl-2 space-y-1\">\n                <template x-for=\"item in recent\" :key=\"item.title\">\n                  <li>\n                    <a\n                      href=\"#_\"\n                      class=\"group flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n                    >\n                      <span class=\"flex items-center gap-2\"\n                        ><FileDots class=\"size-4\" />\n                        <span x-text=\"item.title\"></span></span\n                      >\n                      <span\n                        class=\"text-[0.70rem] text-muted-foreground\"\n                        x-text=\"item.time\"></span>\n                    </a>\n                  </li>\n                </template>\n              </ul>\n            </div>\n          </li>\n          <li>\n            <button\n              class=\"w-full h-9 px-3 rounded-md flex items-center justify-between text-sm text-muted-foreground hover:bg-background/5\"\n              @click=\"sections.team = !sections.team\"\n              :aria-expanded=\"sections.team\"\n            >\n              <span class=\"flex items-center gap-2\">\n                <UsersGroup class=\"size-4\" />\n                <span>Team</span>\n                <span\n                  x-show=\"notifications > 0\"\n                  class=\"text-[0.70rem] px-1.5 py-0.5 rounded bg-destructive text-foreground\"\n                  x-text=\"notifications\"></span>\n              </span>\n              <span class=\"text-muted-foreground\">\n                <ChevronDown x-show=\"sections.team\" class=\"size-4\" />\n                <ChevronRight x-show=\"!sections.team\" class=\"size-4\" />\n              </span>\n            </button>\n            <div x-show=\"sections.team\" x-collapse>\n              <ul class=\"mt-1 pl-2 space-y-1\">\n                <li>\n                  <a\n                    href=\"#_\"\n                    class=\"group flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n                  >\n                    <span class=\"flex items-center gap-2\"\n                      ><UsersGroup class=\"size-4\" /> Members</span\n                    >\n                    <span\n                      class=\"text-[0.70rem] px-1.5 py-0.5 rounded text-foreground outline outline-1 outline-border bg-background/10 outline-border/10\"\n                      >12</span\n                    >\n                  </a>\n                </li>\n                <li>\n                  <a\n                    href=\"#_\"\n                    class=\"group flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n                  >\n                    <span class=\"flex items-center gap-2\"\n                      ><Settings class=\"size-4\" /> Roles</span\n                    >\n                  </a>\n                </li>\n                <li>\n                  <a\n                    href=\"#_\"\n                    class=\"group flex items-center justify-between h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n                  >\n                    <span class=\"flex items-center gap-2\"\n                      ><CircleInfo class=\"size-4\" /> Permissions</span\n                    >\n                  </a>\n                </li>\n              </ul>\n            </div>\n          </li>\n          <li>\n            <a\n              href=\"#_\"\n              class=\"flex items-center gap-2 h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n            >\n              <Report class=\"size-4\" />\n              <span>Insights</span>\n            </a>\n          </li>\n          <li>\n            <a\n              href=\"#_\"\n              class=\"flex items-center gap-2 h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n            >\n              <Grid class=\"size-4\" />\n              <span>Integrations</span>\n            </a>\n          </li>\n          <li>\n            <a\n              href=\"#_\"\n              class=\"flex items-center gap-2 h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n            >\n              <Clipboard class=\"size-4\" />\n              <span>API</span>\n            </a>\n          </li>\n          <li>\n            <a\n              href=\"#_\"\n              class=\"flex items-center gap-2 h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n            >\n              <Lifebuoy class=\"size-4\" />\n              <span>Help Center</span>\n              <span\n                class=\"ml-auto text-[0.70rem] px-1.5 py-0.5 rounded text-foreground outline outline-1 outline-border bg-background/10 outline-border/10\"\n                >Online</span\n              >\n            </a>\n          </li>\n          <li class=\"pt-2 mt-2 border-t border-border\">\n            <a\n              href=\"#_\"\n              class=\"flex items-center gap-2 h-9 px-3 rounded-md text-sm text-muted-foreground hover:bg-background/5\"\n            >\n              <ExternalLink class=\"size-4\" />\n              <span>Open site</span>\n              <ExternalLink class=\"size-3 ml-auto opacity-60\" />\n            </a>\n          </li>\n        </ul>\n      </nav>\n      <!-- Sticky footer (status + account); stays pinned and dropdown overlays upward -->\n      <div class=\"sticky bottom-0 z-10 bg-background border-t border-border\">\n        <div class=\"p-3 lg:p-4 space-y-3\">\n          <div\n            class=\"rounded-xl outline outline-1 outline-border bg-background p-3\"\n          >\n            <p\n              class=\"text-xs font-medium text-foreground\"\n            >\n              System Status\n            </p>\n            <p class=\"mt-1 text-xs text-muted-foreground\">\n              All services operational. Last updated 5 min ago.\n            </p>\n            <div class=\"mt-2 flex items-center justify-between\">\n              <button\n                class=\"h-8 px-3 rounded-md text-foreground text-xs outline outline-1 outline-border bg-background/10 outline-border/10\"\n                >View dashboard</button\n              >\n              <div class=\"flex items-center gap-1\">\n                <div class=\"size-2 rounded-full bg-success\"></div>\n                <span class=\"text-xs text-muted-foreground\">Online</span>\n              </div>\n            </div>\n          </div>\n        </div>\n        <!-- Account / footer -->\n        <div class=\"px-3 pb-3 lg:px-4 lg:pb-4\">\n          <div x-data=\"{ open:false }\" class=\"relative\">\n            <button\n              class=\"w-full flex items-center justify-between gap-3 p-2 rounded-lg outline outline-1 outline-border hover:bg-background/5\"\n              @click=\"open=!open\"\n            >\n              <span class=\"flex items-center gap-3\">\n                <img\n                  src=\"https://i.pravatar.cc/40?img=12\"\n                  alt=\"Avatar\"\n                  class=\"size-8 rounded-full\"\n                />\n                <span class=\"text-left\">\n                  <span class=\"block text-sm font-medium text-foreground\"\n                    >Alex W.</span\n                  >\n                  <span class=\"block text-xs text-muted-foreground\"\n                    >alex@orbitkit.dev</span\n                  >\n                </span>\n              </span>\n              <ChevronDown class=\"size-4 text-muted-foreground\" />\n            </button>\n            <div\n              x-show=\"open\"\n              x-transition.opacity\n              @click.outside=\"open=false\"\n              class=\"absolute left-0 right-0 bottom-14 z-50 rounded-xl bg-background shadow-xl outline outline-1 outline-border overflow-hidden\"\n            >\n              <div class=\"p-2 text-sm\">\n                <a\n                  href=\"#_\"\n                  class=\"flex items-center justify-between h-9 px-2 rounded-md text-muted-foreground hover:bg-background/5\"\n                >\n                  <span class=\"flex items-center gap-2\"\n                    ><CircleInfo class=\"size-4\" /> View profile</span\n                  >\n                </a>\n                <a\n                  href=\"#_\"\n                  class=\"flex items-center justify-between h-9 px-2 rounded-md text-muted-foreground hover:bg-background/5\"\n                >\n                  <span class=\"flex items-center gap-2\"\n                    ><Settings class=\"size-4\" /> Account</span\n                  >\n                </a>\n                <a\n                  href=\"#_\"\n                  class=\"flex items-center justify-between h-9 px-2 rounded-md text-muted-foreground hover:bg-background/5\"\n                >\n                  <span class=\"flex items-center gap-2\"\n                    ><Lifebuoy class=\"size-4\" /> Docs</span\n                  >\n                </a>\n              </div>\n              <div class=\"border-t border-border p-2\">\n                <Button type=\"button\" variant=\"muted\" class=\"w-full\" size=\"xxs\"\n                  >Sign out</Button\n                >\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </aside>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
