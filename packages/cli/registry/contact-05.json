{
  "name": "contact-05",
  "type": "component",
  "description": "contact block 05",
  "category": "marketing",
  "section": "contact",
  "variant": 5,
  "aliases": [
    "contact",
    "contact 5",
    "contact 05"
  ],
  "files": [
    {
      "name": "05.astro",
      "path": "oxbow/marketing/contact/05.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport MapPin from \"@/components/fundations/icons/MapPin.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nconst services = [\n  { id: 1, name: \"UX Design\" },\n  { id: 2, name: \"Web Development\" },\n  { id: 3, name: \"SEO Optimization\" },\n  { id: 4, name: \"Content Writing\" },\n  { id: 5, name: \"Graphic Design\" },\n  { id: 6, name: \"Social Media Management\" },\n  { id: 7, name: \"App Development\" },\n  { id: 8, name: \"Digital Marketing\" },\n];\nconst options = [\n  { id: 1, name: \"Use our chat widget\", href: \"#\" },\n  { id: 2, name: \"Explore our knowledge base\", href: \"#\" },\n  { id: 3, name: \"Submit a support ticket\", href: \"#\" },\n];\nconst locations = [\n  {\n    title: \"Amsterdam\",\n    addressLines: [\"78 Canal Street\", \"1012 AB Amsterdam\", \"Netherlands\"],\n  },\n  {\n    title: \"Vienna\",\n    addressLines: [\"56 Schönbrunner Straße\", \"1120 Vienna\", \"Austria\"],\n  },\n  {\n    title: \"Stockholm\",\n    addressLines: [\"23 Gamla Stan\", \"111 29 Stockholm\", \"Sweden\"],\n  },\n  {\n    title: \"Zurich\",\n    addressLines: [\"12 Bahnhofstrasse\", \"8001 Zurich\", \"Switzerland\"],\n  },\n];\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-xl lg:text-balance\">\n      <Kicker>Let’s Talk</Kicker>\n      <Text\n        tag=\"h1\"\n        variant=\"displayMD\"\n        class=\"mt-12 font-semibold tracking-tight text-base-900 lg:text-balance\"\n      >\n        How can we help you today?\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-4 lg:text-balance text-base-500 \"\n      >\n        Reach out to our team for questions, project ideas, or support. We’re\n        here to collaborate and help you achieve your goals.\n      </Text>\n    </div>\n    <div class=\"mt-12 grid grid-cols-1 gap-x-32 gap-y-6 md:grid-cols-2\">\n      <form action=\"#\" method=\"POST\">\n        <div class=\"grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2\">\n          <div>\n            <label\n              for=\"first-name\"\n              class=\"text-sm font-medium text-base-500 \"\n            >\n              First name\n            </label>\n            <div class=\"1\">\n              <input\n                type=\"text\"\n                name=\"first-name\"\n                id=\"first-name\"\n                autocomplete=\"given-name\"\n                required\n                aria-required=\"true\"\n                aria-describedby=\"first-name-error\"\n                placeholder=\"Your first name\"\n                class=\"block w-full h-10 px-4 py-2 text-sm bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              />\n              <span id=\"first-name-error\" class=\"hidden text-sm text-destructive\">\n                Please enter your first name.\n              </span>\n            </div>\n          </div>\n          <div>\n            <label\n              for=\"last-name\"\n              class=\"text-sm font-medium text-base-500 \"\n            >\n              Last name\n            </label>\n            <div class=\"1\">\n              <input\n                type=\"text\"\n                name=\"last-name\"\n                id=\"last-name\"\n                autocomplete=\"family-name\"\n                required\n                aria-required=\"true\"\n                aria-describedby=\"last-name-error\"\n                placeholder=\"Your last name\"\n                class=\"block w-full h-10 px-4 py-2 text-sm bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              />\n              <span id=\"last-name-error\" class=\"hidden text-sm text-destructive\">\n                Please enter your last name.\n              </span>\n            </div>\n          </div>\n          <div class=\"sm:col-span-2\">\n            <label\n              for=\"compant\"\n              class=\"text-sm font-medium text-base-500 \"\n            >\n              Company name\n            </label>\n            <div class=\"1\">\n              <input\n                type=\"text\"\n                name=\"company\"\n                id=\"company\"\n                autocomplete=\"organization\"\n                aria-describedby=\"company-error\"\n                placeholder=\"Your company\"\n                class=\"block w-full h-10 px-4 py-2 text-sm bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              />\n              <span id=\"company-error\" class=\"hidden text-sm text-destructive\">\n                Please enter your company name.\n              </span>\n            </div>\n          </div>\n          <div class=\"sm:col-span-2\">\n            <label\n              for=\"phone-number\"\n              class=\"text-sm font-medium text-base-500 \"\n            >\n              Phone number\n            </label>\n            <div class=\"relative 1\">\n              <div class=\"absolute inset-y-0 left-0 flex items-center\">\n                <label for=\"country\" class=\"sr-only\">Country</label>\n                <select\n                  id=\"country\"\n                  name=\"country\"\n                  aria-label=\"Country code\"\n                  class=\"h-full py-0 pl-4 bg-transparent border-0 rounded-md pr-9 text-base-400 focus:ring-2 focus:ring-inset focus:ring-base-600 sm:text-sm\"\n                >\n                  <option value=\"IT\">Italy</option>\n                  <option value=\"ES\">Spain</option>\n                  <option value=\"JP\">Japan</option>\n                </select>\n              </div>\n              <input\n                type=\"tel\"\n                name=\"phone-number\"\n                id=\"phone-number\"\n                autocomplete=\"tel\"\n                aria-describedby=\"phone-number-description\"\n                placeholder=\"123-456-7890\"\n                class=\"block w-full h-10 px-4 py-2 pl-24 text-sm bg-white border border-transparent rounded-lg shadow appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              />\n              <p id=\"phone-number-description\" class=\"sr-only\">\n                Enter your phone number including the country code.\n              </p>\n            </div>\n          </div>\n          <div class=\"sm:col-span-2\">\n            <label\n              for=\"email\"\n              class=\"text-sm font-medium text-base-500 \"\n            >\n              Email\n            </label>\n            <div class=\"1\">\n              <input\n                type=\"email\"\n                name=\"email\"\n                id=\"email\"\n                autocomplete=\"email\"\n                required\n                aria-required=\"true\"\n                aria-describedby=\"email-error\"\n                placeholder=\"Your email\"\n                class=\"block w-full h-10 px-4 py-2 text-sm bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              />\n              <span id=\"email-error\" class=\"hidden text-sm text-destructive\">\n                Please enter a valid email address.\n              </span>\n            </div>\n          </div>\n          <div class=\"sm:col-span-2\">\n            <label\n              for=\"message\"\n              class=\"text-sm font-medium text-base-500 \"\n            >\n              Message\n            </label>\n            <div class=\"1\">\n              <textarea\n                name=\"message\"\n                id=\"message\"\n                rows=\"5\"\n                aria-describedby=\"message-error\"\n                placeholder=\"Your message\"\n                class=\"block w-full px-4 py-2 text-sm bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              ></textarea>\n              <span id=\"message-error\" class=\"hidden text-sm text-destructive\">\n                Please enter your message.\n              </span>\n            </div>\n          </div>\n        </div>\n        <div class=\"flex items-center mt-4 col-span-full\">\n          <input\n            id=\"agreement\"\n            name=\"agreement\"\n            type=\"checkbox\"\n            class=\"rounded shadow size-4 border-base-300 text-base-600 focus:ring-base-600 \"\n          />\n          <label\n            for=\"agreement\"\n            class=\"block ml-3 text-sm text-base-500 \"\n          >\n            You agree to our\n            <a\n              href=\"#_\"\n              class=\"ont-medium text-base-900 hover:text-base-600 \"\n            >\n              Terms of service\n            </a>\n            and\n            <a\n              href=\"#_\"\n              class=\"ont-medium text-base-900 hover:text-base-600 \"\n            >\n              Privacy Policy\n            </a>\n          </label>\n        </div>\n        <Button class=\"w-full mt-8\" variant=\"default\" size=\"base\">\n          Submit\n        </Button>\n        <div class=\"mt-8\">\n          <Text\n            tag=\"h3\"\n            variant=\"textLG\"\n            class=\"font-medium text-base-900 \"\n          >\n            Services\n          </Text>\n          <div class=\"mt-8 grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-2\">\n            <!-- Astro template syntax for services checkboxes -->\n            {\n              services.map((service) => (\n                <div class=\"flex items-start gap-3\">\n                  <input\n                    id={\"service-\" + service.id}\n                    name={\"service-\" + service.id}\n                    type=\"checkbox\"\n                    class=\"bg-white rounded shadow size-4 border-base-300 text-base-600 focus:ring-base-600 \"\n                  />\n                  <label\n                    for={\"service-\" + service.id}\n                    class=\"block text-sm font-medium text-base-500 \"\n                  >\n                    {service.name}\n                  </label>\n                </div>\n              ))\n            }\n          </div>\n        </div>\n      </form>\n      <div class=\"flex flex-col divide-y divide-base-200 \">\n        <div class=\"py-4\">\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"font-semibold text-base-900 \"\n          >\n            Get in touch\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Reach out to our experts for advice, collaboration, or support.\n            We’ll respond promptly and guide you every step of the way.\n          </Text>\n          <ul class=\"pt-4 mt-4 border-t border-base-200 \">\n            {\n              options.map((option) => (\n                <li>\n                  <a\n                    href=\"#_\"\n                    class=\"text-sm font-medium text-base-900 hover:text-base-600 \"\n                  >\n                    {option.name}\n                  </a>\n                </li>\n              ))\n            }\n          </ul>\n        </div>\n        <div class=\"py-4\">\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"font-medium text-base-900 \"\n          >\n            Call us\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Our phone lines are open around the clock. Call anytime and our team\n            will be happy to assist you.\n          </Text>\n          <div class=\"mt-6\">\n            <a\n              href=\"#_\"\n              class=\"text-sm font-medium text-base-900 hover:text-base-600 \"\n            >\n              <span class=\"sr-only\">Phone number</span>\n              +44 20 7946 1234\n            </a>\n          </div>\n        </div>\n        <div class=\"py-4\">\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"font-medium text-base-900 \"\n          >\n            Our offices\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Visit us at one of our international locations. We’re present in\n            Amsterdam, Vienna, Stockholm, and Zurich—stop by and say hello!\n          </Text>\n          <ul\n            class=\"mt-6 text-base font-medium list-none divide-y text-base-500 divide-base-200 \"\n          >\n            {\n              locations.map((location) => (\n                <div class=\"py-4 grid grid-cols-1 sm:grid-cols-2  lg:grid-cols-3\">\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textBase\"\n                    class=\"font-medium text-base-900 \"\n                  >\n                    {location.title}\n                  </Text>\n                  <address class=\"flex mt-2 not-italic lg:mt-0 gap-2 lg:col-span-2  sm:text-balance\">\n                    <MapPin\n                      class=\"text-base-600 \"\n                      size=\"sm\"\n                    />\n                    <div class=\"flex flex-col  gap-2\">\n                      {location.addressLines.map((line, idx) => (\n                        <Text\n                          tag=\"p\"\n                          variant=\"textSM\"\n                          class=\"text-sm font-medium text-base-500 \"\n                        >\n                          {line}\n                          {idx < location.addressLines.length - 1 ? \", \" : \"\"}\n                        </Text>\n                      ))}\n                    </div>\n                  </address>\n                </div>\n              ))\n            }\n          </ul>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
