{
  "name": "sign-in-03",
  "type": "component",
  "description": "Split screen sign in with testimonial",
  "category": "application",
  "section": "sign-in",
  "variant": 3,
  "aliases": [
    "sign in",
    "sign in 3",
    "sign in 03"
  ],
  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/application/sign-in/03.astro",
      "content": "---\nexport const description = \"Split screen sign in with testimonial\";\n\n// Assets\nimport { Image } from \"astro:assets\";\nimport A1 from \"@/images/avatars/avatar1.jpeg\";\nimport Placeholder from \"@/images/gradients/1.jpeg\";\n// Fundations\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Checkbox from \"@/components/fundations/inputs/Checkbox.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n// Icons\nimport GoogleColor from \"@/components/fundations/icons/GoogleColor.astro\";\n---\n\n<div class=\"flex h-screen bg-white \">\n  <div\n    class=\"flex items-center justify-center w-full  lg:w-1/2\"\n  >\n    <div\n      class=\"w-full max-w-md p-8 py-24 lg:py-32 \"\n    >\n      <div>\n        <a href=\"#_\">\n          <span class=\"sr-only\">Back to home</span>\n          <Logo class=\"h-12 text-base-900 \" aria-hidden=\"true\" /></a\n        >\n        <Text\n          tag=\"h1\"\n          variant=\"displayMD\"\n          class=\"mt-12 font-semibold tracking-tight text-base-900 \"\n        >\n          Sign in\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 text-base-500 text-balance\"\n        >\n          Welcome back. You know the drill, email, password, maybe a tear or\n          two.\n        </Text>\n      </div>\n      <form class=\"mt-10 space-y-4\">\n        <TextInput\n          id=\"email\"\n          name=\"email\"\n          label=\"Email Address\"\n          type=\"email\"\n          variant=\"default\"\n          size=\"base\"\n          placeholder=\"you@example.com\"\n        />\n        <TextInput\n          id=\"password\"\n          name=\"password\"\n          label=\"Password\"\n          type=\"password\"\n          passwordToggle={true}\n          size=\"base\"\n          placeholder=\"••••••••\"\n          required\n        />\n        <Checkbox\n          id=\"login-remember\"\n          name=\"login-remember\"\n          label=\"Remember me for 30 days\"\n          variant=\"default\"\n          size=\"base\"\n        />\n        <Button fullWidth variant=\"default\" size=\"base\">\n          Sign in with email\n        </Button>\n        <Button\n          variant=\"outline\"\n          size=\"base\"\n          gap=\"sm\"\n          class=\"relative flex items-center w-full\"\n        >\n          <GoogleColor slot=\"left-icon\" class=\"size-4\" />\n          Sign in with Google\n          <!-- Green dot indicator -->\n          <span\n            class=\"absolute w-2 h-2 bg-success/88 rounded-full right-3 top-1/2 -translate-y-1/2\"\n          ></span>\n        </Button>\n      </form>\n      <Text tag=\"p\" variant=\"textXS\" class=\"mt-4 font-medium text-base-500\">\n        Dont' have an account?\n        <a href=\"#_\" class=\"font-medium text-primary/88 hover:text-base-500\">\n          Sign up\n        </a>\n      </Text>\n    </div>\n  </div>\n  <div class=\"relative hidden lg:block lg:w-1/2\">\n    <Image\n      width={1200}\n      height={1200}\n      src={Placeholder}\n      alt=\"#_\"\n      aria-hidden=\"true\"\n      class=\"object-cover object-left w-full h-full bg-base-50 grayscale\"\n    />\n\n    <div\n      class=\"absolute p-8 shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl bottom-20 left-10 right-10\"\n    >\n      <div class=\"relative flex flex-col gap-2\">\n        <Text tag=\"h3\" variant=\"textBase\" class=\"font-medium text-base-900 \">\n          \"I’ve seen enough UI kits to last a lifetime. Oxbow’s the first one\n          that didn’t make me roll my eyes.\"\n        </Text>\n        <div class=\"flex items-center mt-2 gap-4\">\n          <Image\n            src={A1}\n            alt=\"#_\"\n            width={1000}\n            height={1000}\n            aria-hidden=\"true\"\n            class=\"object-cover object-top rounded-full size-10\"\n          />\n          <div>\n            <Text\n              tag=\"p\"\n              variant=\"textBase\"\n              class=\"font-semibold text-base-900 \"\n            >\n              Johan Snällström\n            </Text>\n            <Text tag=\"p\" variant=\"textXS\" class=\"text-base-500\">\n              Software Engineer\n            </Text>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
