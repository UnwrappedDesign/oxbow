    {
      "name": "06.astro",
      "path": "oxbow/application/tabs/06.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"bg-base-600\",\n  \"text-base-600\",\n  \"ring-1\",\n  \"ring-base-200\",\n  \"bg-base-50\",\n];\n---\n\n<div\n  class=\"flex flex-col justify-center p-12 mx-auto bg-white \"\n>\n  <!-- Accessible Tabs • Badges + subtle cards -->\n  <div\n    x-data=\"{\n      keys: ['overview','projects','packages'],\n      selected: 'overview',\n      focus: 0,\n      init(){ this.focus = 0 },\n      select(id){ this.selected = id; this.focus = this.keys.indexOf(id) },\n      onKeydown(e){\n        const last = this.keys.length - 1\n        let i = this.focus\n        if (e.key==='ArrowRight' || e.key==='ArrowDown') i = i===last?0:i+1\n        else if (e.key==='ArrowLeft' || e.key==='ArrowUp') i = i===0?last:i-1\n        else if (e.key==='Home') i = 0\n        else if (e.key==='End') i = last\n        else return\n        e.preventDefault(); const id = this.keys[i]; this.focus=i; this.$nextTick(()=>this.$refs['tab-'+id]?.focus())\n      }\n    }\"\n    class=\"max-w-2xl mx-auto\"\n  >\n    <div role=\"tablist\" aria-orientation=\"horizontal\" class=\"flex gap-2\">\n      <template x-for=\"(id, idx) in keys\" :key=\"id\">\n        <button\n          class=\"inline-flex items-center px-3 text-sm font-medium gap-2 h-9 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-base-500/50\"\n          :id=\"'tab-'+id\"\n          role=\"tab\"\n          :aria-selected=\"selected===id\"\n          :tabindex=\"focus===idx?0:-1\"\n          :aria-controls=\"'panel-'+id\"\n          x-ref=\"tab-[[id]]\"\n          @click=\"select(id)\"\n          @keydown=\"onKeydown($event)\"\n          :class=\"selected===id ? 'bg-white text-base-600 ring-1 ring-base-200 ' : 'bg-base-50 text-base-600 hover:text-base-900 '\"\n        >\n          <span\n            x-text=\"id==='overview' ? 'Overview' : id==='projects' ? 'Projects' : 'Packages'\"\n          ></span>\n          <span\n            x-show=\"id==='packages'\"\n            class=\"ml-1 inline-flex items-center px-1.5 h-5 text-[0.70rem] rounded-full bg-base-600 text-white\"\n            >New</span\n          >\n          <span\n            x-show=\"id==='projects'\"\n            class=\"ml-1 inline-flex items-center px-1.5 h-5 text-[0.70rem] rounded-full bg-base-50 text-base-600 border border-base-200 \"\n            >3</span\n          >\n        </button>\n      </template>\n    </div>\n    <div class=\"pt-4 text-sm text-base-500 \">\n      <section\n        x-show=\"selected==='overview'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-overview'\"\n        aria-labelledby=\"tab-overview\"\n      >\n        <p>Overview content — announcements and latest changes.</p>\n      </section>\n      <section\n        x-show=\"selected==='projects'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-projects'\"\n        aria-labelledby=\"tab-projects\"\n      >\n        <p>Projects content — ownership, contributors, and reports.</p>\n      </section>\n      <section\n        x-show=\"selected==='packages'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-packages'\"\n        aria-labelledby=\"tab-packages\"\n      >\n        <p>Packages content — release notes, channels, and approvals.</p>\n      </section>\n    </div>\n  </div>\n</div>\n"
    }
  ],
