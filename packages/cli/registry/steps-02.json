    {
      "name": "02.astro",
      "path": "oxbow/marketing/steps/02.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst history = [\n  {\n    title: \"Create your account\",\n    copy: `Sign up in seconds with your email and password to get started.`,\n  },\n  {\n    title: \"Verify your identity\",\n    copy: `Secure your account by confirming your details with a quick ID upload.`,\n  },\n  {\n    title: \"Connect your bank\",\n    copy: `Link your bank in a few clicks to manage all your finances seamlessly.`,\n  },\n  {\n    title: \"Explore features\",\n    copy: `Dive into our tools and insights to optimize your financial journey.`,\n  },\n];\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-xl mx-auto\">\n      <Text\n        tag=\"h2\"\n        variant=\"displayMD\"\n        class=\"font-semibold tracking-tight text-base-900 text-balance\"\n      >\n        Get set up in four simple steps\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-2 font-medium text-base-500 \"\n      >\n        Complete these quick steps to launch your account and start managing\n        your finances in no time.\n      </Text>\n    </div>\n    <div class=\"relative max-w-xl mx-auto mt-12\">\n      <div\n        data-orientation=\"vertical\"\n        class=\"shrink-0 data-[orientation=horizontal]:h-px data-[orientation=horizontal]:w-full data-[orientation=vertical]:h-full data-[orientation=vertical]:w-px bg-base-200 absolute left-2 top-0\"\n      >\n      </div>\n      <div class=\"relative max-w-xl mx-auto space-y-4\">\n        {\n          history.map((item, index) => (\n            <div class=\"relative pl-8 \">\n              <div class=\"absolute top-0 flex items-center justify-center rounded-full bg-base-100 size-8 -left-2 size-4\">\n                <span class=\"text-sm font-medium text-base-900 \">\n                  {index + 1}\n                </span>\n              </div>\n              <div class=\"p-4 ml-8 shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\">\n                <Text\n                  tag=\"h3\"\n                  variant=\"textBase\"\n                  class=\"font-semibold tracking-tight  text-base-900 \"\n                >\n                  {item.title}\n                </Text>\n                <Text\n                  tag=\"p\"\n                  variant=\"textSM\"\n                  class=\"text-base-500 lg:text-balance\"\n                >\n                  {item.copy}\n                </Text>\n              </div>\n            </div>\n          ))\n        }\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
