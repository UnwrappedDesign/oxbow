{
  "name": "product-details-04",
  "type": "component",
  "description": "product-details block 04",
  "category": "ecommerce",
  "section": "product-details",
  "variant": 4,
  "aliases": [
    "product details",
    "product details 4",
    "product details 04",
    "product detail",
    "product detail 4",
    "product detail 04"
  ],
  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/ecommerce/product-details/04.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"bg-white\",\n  \"text-base-500\",\n  \"border-b-2\",\n  \"border-base-500\",\n  \"ring-2\",\n  \"ring-base-900\",\n  \"ring-offset-2\",\n  \"ring-base-700\",\n  \"bg-base-400\",\n  \"ring-base-300\",\n  \"bg-base-200\",\n  \"ring-primary/50\",\n  \"bg-primary/36\",\n  \"ring-destructive/50\",\n  \"bg-destructive/36\",\n  \"ring-destructive/50\",\n  \"bg-destructive/36\",\n  \"ring-warning/50\",\n  \"bg-warning/36\",\n  \"ring-warning/50\",\n  \"bg-warning/36\",\n  \"ring-primary/50\",\n  \"bg-primary/36\",\n  \"ring-info/50\",\n  \"bg-info/36\",\n  \"ring-success/50\",\n  \"bg-success/36\",\n  \"ring-info/50\",\n  \"bg-info/36\",\n];\n\nexport const description =\n  \"Details with image slider on a three column grid, color, size selector and info tabs with reviews\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n      <div class=\"flex flex-col order-last lg:order-none\">\n        <div class=\"flex items-center justify-between\">\n          <Text tag=\"h1\" variant=\"textLG\" class=\"font-medium \"\n            >Nike Air Force 1´07 Fresh</Text\n          >\n          <Text tag=\"p\" variant=\"textLG\" class=\"\">$190</Text>\n        </div>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 text-base-500 \"\n        >\n          Hitting the field in the late '60s, adidas airmaxS quickly became\n          soccer's \"it\" shoe.\n        </Text>\n        <!-- Tab section -->\n        <div\n          x-data=\"{ tab: 'tab1' }\"\n          class=\"mt-8 divide-y divide-base-200 border-y border-base-200 \"\n        >\n          <ul\n            class=\"flex text-sm border-b gap-4 text-base-500 border-base-200 \"\n          >\n            <li class=\"-mb-px\">\n              <a\n                @click.prevent=\"tab = 'tab1'\"\n                href=\"#_\"\n                class=\"inline-block py-2 font-medium border-b-2 text-base-500 border-base-500 \"\n                :class=\"{ ' text-base-500 border-b-2 border-base-500 ' : tab === 'tab1' }\"\n              >\n                Details</a\n              >\n            </li>\n            <li class=\"-mb-px\">\n              <a\n                @click.prevent=\"tab = 'tab2'\"\n                href=\"#_\"\n                class=\"inline-block py-2 font-medium\"\n                :class=\"{ ' text-base-500 border-b-2 border-base-500 ' : tab === 'tab2' }\"\n              >\n                Shipping</a\n              >\n            </li>\n            <li class=\"-mb-px\">\n              <a\n                @click.prevent=\"tab = 'tab3'\"\n                href=\"#_\"\n                class=\"inline-block py-2 font-medium\"\n                :class=\"{ ' text-base-500 border-b-2 border-base-500 ' : tab === 'tab3' }\"\n              >\n                Returns</a\n              >\n            </li>\n            <li class=\"-mb-px\">\n              <a\n                @click.prevent=\"tab = 'tab4'\"\n                href=\"#_\"\n                class=\"inline-block py-2 font-medium\"\n                :class=\"{ ' text-base-500 border-b-2 border-base-500 ' : tab === 'tab4' }\"\n              >\n                Reviews</a\n              >\n            </li>\n          </ul>\n          <div\n            class=\"py-4 pt-4 text-left text-base-500 content\"\n          >\n            <div x-show=\"tab==='tab1'\">\n              <section class=\"py-4\">\n                <Text tag=\"p\" variant=\"sm\">\n                  This product is crafted from high-quality materials designed\n                  for durability and comfort. It features modern design elements\n                  and is perfect for everyday use.\n                </Text>\n                <ul\n                  role=\"list\"\n                  class=\"pl-5 mt-4 text-sm list-disc space-y-1 text-base-600 marker:text-base-500 \"\n                >\n                  <li>Versatile lace configurations</li>\n                  <li>Breathable and spacious interior fit</li>\n                  <li>Durable leather overlays</li>\n                  <li>Cushioned insole for added comfort</li>\n                  <li>Reinforced eyelets for secure lacing</li>\n                  <li>Stitching built for durability</li>\n                  <li>Water-resistant materials</li>\n                </ul>\n\n                <Text tag=\"p\" variant=\"textSM\" class=\"mt-8\">\n                  <strong class=\"text-black \"\n                    >True to size</strong\n                  >.We recommend ordering your usual size.\n                </Text>\n              </section>\n            </div>\n            <div x-show=\"tab==='tab2'\" style=\"display: none;\">\n              <section class=\"py-4\">\n                <Text tag=\"p\" variant=\"sm\">\n                  We offer free standard shipping on all orders above $50.\n                  Express shipping options are available at checkout for an\n                  additional fee.\n                </Text>\n              </section>\n            </div>\n            <div x-show=\"tab==='tab3'\" style=\"display: none;\">\n              <section class=\"py-4\">\n                <Text tag=\"p\" variant=\"sm\">\n                  We accept returns within 30 days of purchase. Items must be in\n                  their original condition and packaging. Please visit our\n                  returns page for more details.\n                </Text>\n              </section>\n            </div>\n            <div x-show=\"tab==='tab4'\" style=\"display: none;\">\n              <section class=\"py-4\">\n                <div\n                  class=\"flex flex-col\"\n                  x-data=\"{ \n                  testimonials: [\n                    {\n                      name: 'Fernando Monte',\n                      date: '2025-12-01',\n                      datetime: '2025-12-01',\n                      img: '/avatars/1.jpg',\n                      text: 'The Nike Air Max 90 Black exceeded my expectations! Super comfortable and perfect for both running and casual wear.',\n                    },\n                    {\n                      name: 'Juan  Echanove',\n                      date: '2025-11-15',\n                      datetime: '2025-11-15',\n                      img: '/avatars/2.jpg',\n                      text: 'Stylish and lightweight. I wear them everywhere, but the fit was slightly snug at first. Broke in nicely after a few days.',\n                    },\n                  ] \n                }\"\n                >\n                  <template\n                    x-for=\"testimonial in testimonials\"\n                    :key=\"testimonial.datetime\"\n                  >\n                    <div class=\"flex py-4 gap-x-4\">\n                      <div class=\"flex-none\">\n                        <img\n                          :src=\"testimonial.img\"\n                          :alt=\"testimonial.name\"\n                          class=\"rounded-full size-10 bg-base-100\"\n                        />\n                      </div>\n                      <div>\n                        <Text\n                          tag=\"h3\"\n                          variant=\"textBase\"\n                          class=\"font-medium text-base-900 \"\n                          x-text=\"testimonial.name\"\n                        />\n                        <Text\n                          variant=\"textXS\"\n                          class=\"text-base-500 \"\n                        >\n                          <time\n                            :datetime=\"testimonial.datetime\"\n                            x-text=\"testimonial.date\"></time>\n                        </Text>\n                        <Text\n                          tag=\"p\"\n                          variant=\"textSM\"\n                          class=\"mt-1 text-base-500 \"\n                          x-text=\"testimonial.text\"\n                        />\n                      </div>\n                    </div>\n                  </template>\n                </div>\n                <div class=\"flex mt-8\">\n                  <Button size=\"sm\" variant=\"muted\"> Write a review </Button>\n                </div>\n              </section>\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- Product Image Gallery -->\n      <div\n        x-data=\"{ \n                activeImage: 0,\n                images: [\n                    '/store/shoes/airmax/1.png',\n                    '/store/shoes/airmax/2.png',\n                    '/store/shoes/airmax/3.png',\n                    '/store/shoes/airmax/4.png',\n                    '/store/shoes/airmax/5.png',\n                    '/store/shoes/airmax/6.png'\n                ]\n            }\"\n        class=\"flex flex-col order-first gap-2 lg:order-none\"\n      >\n        <!-- Main Image -->\n        <div class=\"overflow-hidden aspect-square bg-base-200 rounded-2xl\">\n          <img\n            :src=\"images[activeImage]\"\n            class=\"object-cover size-full aspect-square\"\n            alt=\"Product image\"\n          />\n        </div>\n        <!-- Thumbnails -->\n        <div class=\"w-full grid grid-cols-6 gap-2\">\n          <template x-for=\"(image, index) in images\" :key=\"index\">\n            <button\n              @click=\"activeImage = index\"\n              :class=\"{'ring-2 ring-base-900 ': activeImage === index}\"\n              class=\"overflow-hidden size-full bg-base-200 rounded-xl aspect-square\"\n            >\n              <img\n                :src=\"image\"\n                class=\"object-cover size-full aspect-square\"\n                alt=\"Product thumbnail\"\n              />\n            </button>\n          </template>\n        </div>\n      </div>\n      <!-- Product Details -->\n\n      <div>\n        <div class=\"flex flex-col mt-4 gap-4\">\n          <!-- Color Selector -->\n          <div x-data=\"{ activeColor: null }\">\n            <Text\n              tag=\"p\"\n              variant=\"textXS\"\n              class=\"uppercase text-base-500 \"\n            >\n              Color\n            </Text>\n            <fieldset\n              aria-label=\"Choose a color\"\n              class=\"mt-2\"\n              x-data=\"{ \n            colors: [\n              { name: ' Black', ring: 'ring-base-700', bg: 'bg-base-400' },\n    { name: ' Gray', ring: 'ring-base-300', bg: 'bg-base-200' },\n    { name: ' Purple', ring: 'ring-primary/50', bg: 'bg-primary/36' },\n    { name: ' Pink', ring: 'ring-destructive/50', bg: 'bg-destructive/36' },\n    { name: ' Red', ring: 'ring-destructive/50', bg: 'bg-destructive/36' },\n    { name: ' Orange', ring: 'ring-warning/50', bg: 'bg-warning/36' },\n    { name: ' Yellow', ring: 'ring-warning/50', bg: 'bg-warning/36' },\n    { name: ' Blue', ring: 'ring-primary/50', bg: 'bg-primary/36' },\n    { name: ' Cyan', ring: 'ring-info/50', bg: 'bg-info/36' },\n    { name: ' Green', ring: 'ring-success/50', bg: 'bg-success/36' },\n    { name: ' Teal', ring: 'ring-info/50', bg: 'bg-info/36' },\n            ],\n            activeColor: null \n          }\"\n            >\n              <div class=\"flex flex-wrap items-center gap-3\">\n                <template x-for=\"color in colors\" :key=\"color.name\">\n                  <label\n                    :aria-label=\"color.name\"\n                    class=\"relative -m-0.5 duration-300 flex cursor-pointer items-center justify-center rounded-full p-0.5 focus:outline-none\"\n                    :class=\"{ 'ring-2 ring-offset-2 ring-base-900': activeColor === color.name }\"\n                  >\n                    <input\n                      type=\"radio\"\n                      name=\"color-choice\"\n                      :value=\"color.name\"\n                      class=\"sr-only\"\n                      @click=\"activeColor = color.name\"\n                    />\n                    <span\n                      aria-hidden=\"true\"\n                      class=\"rounded-full size-6 ring-1\"\n                      :class=\"`${color.ring} ${color.bg}`\"></span>\n                  </label>\n                </template>\n              </div>\n            </fieldset>\n          </div>\n          <!-- Sizing -->\n          <div\n            x-data=\"{\n              sizeSystem: 'US',\n              activeSize: null,\n              sizes: {\n                  US: ['6', '7', '8', '9', '10', '11', '12', '13'],\n                  EU: ['39', '40', '41', '42', '43', '44', '45', '46']\n              }\n          }\"\n          >\n            <div class=\"flex items-center justify-between\">\n              <Text\n                tag=\"p\"\n                variant=\"textXS\"\n                class=\"uppercase text-base-500 \"\n              >\n                Shoe size\n              </Text>\n              <div>\n                <label for=\"size-system\" class=\"sr-only\">Size System</label>\n                <select\n                  id=\"size-system\"\n                  x-model=\"sizeSystem\"\n                  @change=\"activeSize = null\"\n                  class=\"block w-auto h-8 pl-2.5 pr-8 py-2 text-xs text-base-900 duration-300 bg-white border border-transparent rounded-lg appearance-none ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2\"\n                >\n                  <option value=\"US\">US</option>\n                  <option value=\"EU\">EU</option>\n                </select>\n              </div>\n            </div>\n            <div\n              class=\"mt-2 grid grid-cols-4 gap-2 divide-x divide-base-200 \"\n            >\n              <template x-for=\"size in sizes[sizeSystem]\" :key=\"size\">\n                <div>\n                  <input\n                    type=\"radio\"\n                    :id=\"'size-' + size\"\n                    :value=\"size\"\n                    name=\"size-choice\"\n                    x-model=\"activeSize\"\n                    class=\"sr-only peer\"\n                  />\n                  <label\n                    :for=\"'size-' + size\"\n                    x-text=\"size\"\n                    class=\"flex items-center justify-center px-3 py-2 text-sm font-medium bg-white cursor-pointer ring-1 ring-base-200 rounded-md duration-300 peer-checked:ring-2 peer-checked:ring-base-900 peer-checked:text-base-500 text-base-500 peer-checked:ring-offset-2\"\n                  ></label>\n                </div>\n              </template>\n            </div>\n          </div>\n        </div>\n        <!-- Action Buttons -->\n        <div class=\"flex flex-col mt-8 gap-2\">\n          <Button size=\"sm\" variant=\"default\" class=\"w-full\">Add to Cart</Button\n          >\n          <Button size=\"sm\" variant=\"muted\" class=\"w-full\">Buy Now</Button>\n        </div>\n        <!-- Free shipping notice -->\n        <Text tag=\"p\" variant=\"textSM\" class=\"mt-1 text-base-500\"\n          >Free shipping over $50 if you behave</Text\n        >\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
