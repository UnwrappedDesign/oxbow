{
  "name": "sign-up-02",
  "type": "component",
  "description": "Centered sign up block",
  "category": "application",
  "section": "sign-up",
  "variant": 2,
  "aliases": [
    "sign up",
    "sign up 2",
    "sign up 02"
  ],
  "files": [
    {
      "name": "02.astro",
      "path": "oxbow/application/sign-up/02.astro",
      "content": "---\nexport const description = \"Centered sign up block\";\n\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n// Icons\nimport AppleColor from \"@/components/fundations/icons/AppleColor.astro\";\nimport GoogleColor from \"@/components/fundations/icons/GoogleColor.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div\n      class=\"max-w-md p-8 mx-auto shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n    >\n      <div class=\"text-center lg:text-balance\">\n        <Text\n          tag=\"h1\"\n          variant=\"displaySM\"\n          class=\"font-semibold tracking-tight text-base-900 \"\n        >\n          Create your account\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-2 text-base-600 text-balance\"\n        >\n          Join the party. Set up your account the old-fashioned way—email,\n          password, done.\n        </Text>\n      </div>\n      <form class=\"mt-10 space-y-4\">\n        <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n          <Button\n            variant=\"outline\"\n            size=\"base\"\n            gap=\"sm\"\n            fullWidth\n            class=\"flex items-center\"\n          >\n            <GoogleColor slot=\"left-icon\" class=\"size-4\" />\n            Google\n          </Button>\n          <Button\n            variant=\"outline\"\n            size=\"base\"\n            gap=\"sm\"\n            fullWidth\n            class=\"flex items-center\"\n          >\n            <AppleColor slot=\"left-icon\" class=\"size-4\" />\n            Apple\n          </Button>\n        </div>\n        <div class=\"relative\">\n          <div class=\"absolute inset-0 flex items-center\" aria-hidden=\"true\">\n            <div class=\"w-full border-t border-base-200 \">\n            </div>\n          </div>\n          <div class=\"relative flex justify-center\">\n            <span\n              class=\"px-2 py-0.5 rounded text-sm bg-white text-base-500 \"\n              >Or sign up with email</span\n            >\n          </div>\n        </div>\n        <TextInput\n          id=\"name\"\n          name=\"name\"\n          label=\"Full Name\"\n          type=\"text\"\n          variant=\"default\"\n          size=\"base\"\n          placeholder=\"John Doe\"\n        />\n\n        <TextInput\n          id=\"email\"\n          name=\"email\"\n          label=\"Email Address\"\n          type=\"email\"\n          variant=\"default\"\n          size=\"base\"\n          placeholder=\"you@example.com\"\n        />\n        <TextInput\n          id=\"password\"\n          name=\"password\"\n          label=\"Password\"\n          type=\"password\"\n          passwordToggle={true}\n          size=\"base\"\n          placeholder=\"••••••••\"\n          required\n        />\n        <TextInput\n          id=\"confirm-password\"\n          name=\"confirmPassword\"\n          label=\"Confirm Password\"\n          type=\"password\"\n          passwordToggle={true}\n          size=\"base\"\n          placeholder=\"••••••••\"\n          required\n        />\n\n        <Text\n          tag=\"p\"\n          variant=\"textXS\"\n          class=\"font-medium text-base-500 \"\n        >\n          By creating an account, you agree to our\n          <a\n            href=\"#_\"\n            class=\"font-medium text-primary/88 hover:text-base-500 \"\n          >\n            Terms of service\n          </a>\n          and\n          <a href=\"#_\" class=\"font-medium text-primary/88 hover:text-base-500\">\n            Privacy Policy\n          </a>\n        </Text>\n        <Button fullWidth variant=\"accent\" size=\"base\"> Create account </Button>\n      </form>\n      <Text\n        tag=\"p\"\n        variant=\"textXS\"\n        class=\"mt-4 font-medium text-base-500 \"\n      >\n        Already have an account?\n        <a\n          href=\"#_\"\n          class=\"font-medium text-primary/88 hover:text-base-500 \"\n        >\n          Sign in\n        </a>\n      </Text>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
