      "name": "05.astro",
      "path": "oxbow/application/checkboxes/05.astro",
      "content": "---\nexport const description = \"Destructive Action Confirmation\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2\"\n>\n  <!-- copy:start -->\n  <div class=\"flex flex-col w-full max-w-md gap-2\" x-data=\"{ confirm: false }\">\n    <div class=\"flex items-start gap-3\">\n      <input\n        id=\"confirm-delete\"\n        name=\"confirm-delete\"\n        type=\"checkbox\"\n        x-model=\"confirm\"\n        class=\"text-foreground rounded shadow size-4 border-border focus:ring-border bg-background checked:bg-muted\"\n      />\n      <div>\n        <Text\n          for=\"confirm-delete\"\n          tag=\"label\"\n          class=\"block text-sm text-foreground\"\n        >\n          I understand this action cannot be undone\n        </Text>\n        <p class=\"text-xs text-muted-foreground\">\n          This will permanently delete the item.\n        </p>\n      </div>\n    </div>\n    <div class=\"flex gap-2\">\n      <button\n        type=\"button\"\n        :disabled=\"!confirm\"\n        class=\"px-3 py-1.5 text-sm rounded bg-destructive text-foreground disabled:opacity-50 disabled:cursor-not-allowed\"\n        @click=\"alert('Deleted')\"\n      >\n        Delete\n      </button>\n      <span class=\"self-center text-xs text-muted-foreground\">\n        <span x-text=\"confirm ? 'Ready to delete' : 'Please confirm'\"></span>\n      </span>\n    </div>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
