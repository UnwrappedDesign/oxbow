{
  "name": "cta-01",
  "type": "component",
  "description": "Centered CTA with logo, image and text",
  "category": "marketing",
  "section": "cta",
  "variant": 1,
  "aliases": [
    "cta",
    "cta 1",
    "cta 01"
  ],
  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/marketing/cta/01.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"Centered CTA with logo, image and text\";\n// Assets\nimport Logo from \"@/components/assets/Logo.astro\";\nimport { Image } from \"astro:assets\";\nimport DashboardLight from \"@/images/assets/dashboardLight.svg\";\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 pt-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-xl mx-auto text-center lg:text-balance\">\n      <div class=\"inline-block p-4 rounded-full bg-base-100 \">\n        <Logo class=\"h-12 mx-auto text-base-900 \" />\n      </div>\n      <Text\n        tag=\"h1\"\n        variant=\"displayMD\"\n        class=\"mt-12 font-semibold tracking-tight text-base-900 lg:text-balance\"\n      >\n        Bring your vision to life\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-4 text-base-500 lg:text-balance\"\n      >\n        Simplify teamwork, organize your process, and launch projects with\n        confidence. Collaboration made effortless.\n      </Text>\n    </div>\n    <div\n      class=\"relative mt-12 overflow-hidden border border-b-0 rounded-t-xl max-h-120 border-base-200 \"\n    >\n      <Image\n        width={1200}\n        height={1200}\n        loading=\"eager\"\n        decoding=\"async\"\n        alt=\"dashboard\"\n        src={DashboardLight}\n        class=\"relative object-cover h-full\"\n      />\n      <div\n        aria-hidden=\"true\"\n        class=\"absolute inset-0 z-0 pointer-events-none bg-gradient-to-t from-base-50 via-white/70 to-transparent\"\n      >\n      </div>\n      <div class=\"absolute z-10 bottom-12 left-1/2 transform -translate-x-1/2\">\n        <Button variant=\"default\" size=\"sm\">Get started</Button>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
