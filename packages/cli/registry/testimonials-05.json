      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport ChevronLeft from \"@/components/fundations/icons/ChevronLeft.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\nexport const excludeFromObfuscation = [\"opacity-50\"];\n---\n\n<section class=\"relative overflow-hidden bg-background\">\n  <div\n    class=\"relative items-center px-8 py-24 mx-auto md:px-12 lg:px-24 max-w-7xl\"\n  >\n    <div\n      class=\"flex flex-col-reverse w-full\"\n      x-data=\"{\n      skip: 1,\n      // advance to the next page; wrap to start when past the end\n      next() {\n        this.to((current, offset, slider) => {\n          const target = current + (offset * this.skip)\n          const maxScroll = slider.scrollWidth - slider.clientWidth\n          // small tolerance for fractional pixels\n          if (target > maxScroll - 1) return 0\n          return target\n        })\n      },\n      // go to previous page; wrap to last when before the start\n      prev() {\n        this.to((current, offset, slider) => {\n          const target = current - (offset * this.skip)\n          if (target < 0) return Math.max(0, slider.scrollWidth - slider.clientWidth)\n          return target\n        })\n      },\n      // helper that computes offset including grid gap and calls the strategy\n      to(strategy) {\n        const slider = this.$refs.slider\n        const current = slider.scrollLeft\n        const first = slider.firstElementChild\n        const gap = parseFloat(getComputedStyle(slider).columnGap) || 0\n        const offset = first.getBoundingClientRect().width + gap\n        const target = strategy(current, offset, slider)\n        slider.scrollTo({ left: target, behavior: 'smooth' })\n      },\n      focusableWhenVisible: {\n        'x-intersect:enter'() {\n          this.$el.removeAttribute('tabindex')\n        },\n        'x-intersect:leave'() {\n          this.$el.setAttribute('tabindex', '-1')\n        },\n      },\n    }\"\n    >\n      <div\n        class=\"flex flex-col-reverse w-full\"\n        aria-labelledby=\"carousel-label\"\n        role=\"region\"\n        tabindex=\"0\"\n        x-on:keydown.left=\"prev\"\n        x-on:keydown.right=\"next\"\n      >\n        <div class=\"flex flex-col-reverse items-start lg:flex-row\">\n          <div class=\"max-w-xs\">\n            <Text\n              tag=\"h2\"\n              variant=\"displaySM\"\n              class=\"font-semibold tracking-tight text-foreground text-balance\"\n            >\n              Stories from teams using Oxbow\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textBase\"\n              class=\"mt-4 font-medium text-muted-foreground\"\n            >\n              Real-world examples of how product teams accelerate delivery with\n              our UI toolkit.\n            </Text>\n            <div class=\"inline-flex items-center order-last mt-4 space-x-2\">\n              <IconButton\n                x-on:click=\"prev\"\n                tabindex=\"0\"\n                variant=\"muted\"\n                size=\"sm\"\n              >\n                <ChevronLeft size=\"base\" slot=\"icon\" />\n                <span class=\"sr-only\">Skip to previous slide page</span>\n              </IconButton>\n              <IconButton\n                x-on:click=\"next\"\n                tabindex=\"0\"\n                variant=\"muted\"\n                size=\"sm\"\n              >\n                <ChevronRight size=\"base\" slot=\"icon\" />\n                <span class=\"sr-only\">Skip to next slide page</span>\n              </IconButton>\n            </div>\n          </div>\n          <div class=\"w-full snap-x lg:-mr-[90rem] lg:ml-32 mt-12 lg:mt-0 py-2\">\n            <ul\n              class=\"relative w-screen p-2 overflow-x-scroll gap-3 grid grid-flow-col auto-cols-max scrollbar-hide snap-mandatory\"\n              role=\"listbox\"\n              aria-labelledby=\"carousel-content-label\"\n              tabindex=\"0\"\n              x-ref=\"slider\"\n            >\n              <li\n                role=\"option\"\n                aria-selected=\"false\"\n                class=\"h-full p-8 shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl snap-start w-72\"\n              >\n                <figure class=\"flex flex-col-reverse justify-between h-full\">\n                  <figcaption class=\"relative flex items-center mt-12 gap-3\">\n                    <img\n                      alt=\"#_\"\n                      src=\"/avatars/1.jpg\"\n                      class=\"object-cover rounded-full size-12\"\n                    />\n                    <div>\n                      <Text\n                        tag=\"h3\"\n                        variant=\"textBase\"\n                        class=\"font-medium text-foreground\"\n                      >\n                        Mike Andreuzza\n                      </Text>\n                      <Text\n                        tag=\"p\"\n                        variant=\"textXS\"\n                        class=\"font-medium text-muted-foreground\"\n                      >\n                        Creator\n                      </Text>\n                    </div>\n                  </figcaption>\n                  <div>\n                    <Text\n                      tag=\"blockquote\"\n                      variant=\"textBase\"\n                      class=\"font-semibold text-foreground\"\n                    >\n                      Implementing Semplice's blockchain technology has been a\n                      game-changer for our supply chain management.\n                    </Text>\n                  </div>\n                </figure>\n              </li>\n              <li\n                role=\"option\"\n                aria-selected=\"false\"\n                class=\"h-full p-8 shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl snap-start w-72\"\n              >\n                <figure class=\"flex flex-col-reverse justify-between h-full\">\n                  <figcaption class=\"relative flex items-center gap-3\">\n                    <img\n                      alt=\"#_\"\n                      src=\"/avatars/2.jpg\"\n                      class=\"object-cover rounded-full size-12\"\n                    />\n                    <div>\n                      <Text\n                        tag=\"h3\"\n                        variant=\"textBase\"\n                        class=\"font-medium text-foreground\"\n                      >\n                        Gege Piazza\n                      </Text>\n                      <Text\n                        tag=\"p\"\n                        variant=\"textXS\"\n                        class=\"font-medium text-muted-foreground\"\n                      >\n                        Developer\n                      </Text>\n                    </div>\n                  </figcaption>\n                  <div>\n                    <Text\n                      tag=\"blockquote\"\n                      variant=\"textBase\"\n                      class=\"font-semibold text-foreground\"\n                    >\n                      Implementing Semplice's blockchain technology has been a\n                      game-changer for our supply chain management.\n                    </Text>\n                  </div>\n                </figure>\n              </li>\n              <li\n                role=\"option\"\n                aria-selected=\"false\"\n                class=\"h-full p-8 shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl snap-start w-72\"\n              >\n                <figure class=\"flex flex-col-reverse justify-between h-full\">\n                  <figcaption class=\"relative flex items-center mt-12 gap-3\">\n                    <img\n                      alt=\"#_\"\n                      src=\"/avatars/3.jpg\"\n                      class=\"object-cover rounded-full size-12\"\n                    />\n                    <div>\n                      <Text\n                        tag=\"h3\"\n                        variant=\"textBase\"\n                        class=\"font-medium text-foreground\"\n                      >\n                        Jenson Button\n                      </Text>\n                      <Text\n                        tag=\"p\"\n                        variant=\"textXS\"\n                        class=\"font-medium text-muted-foreground\"\n                      >\n                        Founder\n                      </Text>\n                    </div>\n                  </figcaption>\n                  <div>\n                    <Text\n                      tag=\"blockquote\"\n                      variant=\"textBase\"\n                      class=\"font-semibold text-foreground\"\n                    >\n                      We were initially hesitant about integrating blockchain\n                      technology into our existing systems.\n                    </Text>\n                  </div>\n                </figure>\n              </li>\n              <li\n                role=\"option\"\n                aria-selected=\"false\"\n                class=\"h-full p-8 shadow bg-muted snap-start w-72\"\n              >\n                <figure class=\"flex flex-col-reverse justify-between h-full\">\n                  <figcaption class=\"relative flex items-center gap-3\">\n                    <img\n                      alt=\"#_\"\n                      src=\"/avatars/4.jpg\"\n                      class=\"object-cover mx-auto rounded-full size-12\"\n                    />\n                    <div>\n                      <Text\n                        tag=\"h3\"\n                        variant=\"textBase\"\n                        class=\"font-medium text-foreground\"\n                      >\n                        Johanna Manoy\n                      </Text>\n                      <Text\n                        tag=\"p\"\n                        variant=\"textXS\"\n                        class=\"font-medium text-muted-foreground\"\n                      >\n                        Designer\n                      </Text>\n                    </div>\n                  </figcaption>\n                  <div>\n                    <Text tag=\"p\" variant=\"textBase\">\n                      Being in the financial industry, we were always looking\n                      for ways to enhance our transactions' security and\n                      efficiency.\n                    </Text>\n                  </div>\n                </figure>\n              </li>\n              <li\n                role=\"option\"\n                aria-selected=\"false\"\n                class=\"h-full p-8 shadow bg-muted snap-start w-72\"\n              >\n                <figure class=\"flex flex-col-reverse justify-between h-full\">\n                  <figcaption class=\"relative flex items-center gap-3\">\n                    <img\n                      alt=\"#_\"\n                      src=\"/avatars/5.jpg\"\n                      class=\"object-cover rounded-full size-12\"\n                    />\n                    <div>\n                      <Text\n                        tag=\"h3\"\n                        variant=\"textBase\"\n                        class=\"font-medium text-foreground\"\n                      >\n                        Sandra Piazza\n                      </Text>\n                      <Text\n                        tag=\"p\"\n                        variant=\"textXS\"\n                        class=\"font-medium text-muted-foreground\"\n                      >\n                        Creator\n                      </Text>\n                    </div>\n                  </figcaption>\n                  <div>\n                    <Text tag=\"p\" variant=\"textBase\">\n                      Implementing Semplice's blockchain technology has been a\n                      game-changer for our supply chain management.\n                    </Text>\n                  </div>\n                </figure>\n              </li>\n              <li\n                role=\"option\"\n                aria-selected=\"false\"\n                class=\"h-full p-8 shadow bg-muted snap-start w-72\"\n              >\n                <figure class=\"flex flex-col-reverse justify-between h-full\">\n                  <figcaption class=\"relative flex items-center gap-3\">\n                    <img\n                      alt=\"#_\"\n                      src=\"/avatars/6.jpg\"\n                      class=\"object-cover mx-auto rounded-full size-12\"\n                    />\n                    <div>\n                      <Text\n                        tag=\"h3\"\n                        variant=\"textBase\"\n                        class=\"font-medium text-foreground\"\n                      >\n                        Yokiro Mariro\n                      </Text>\n                      <Text\n                        tag=\"p\"\n                        variant=\"textXS\"\n                        class=\"font-medium text-muted-foreground\"\n                      >\n                        Nutcracker\n                      </Text>\n                    </div>\n                  </figcaption>\n                  <div>\n                    <Text tag=\"p\" variant=\"textBase\">\n                      We were initially hesitant about integrating blockchain\n                      technology into our existing systems.\n                    </Text>\n                  </div>\n                </figure>\n              </li>\n              <li\n                role=\"option\"\n                aria-selected=\"false\"\n                class=\"h-full p-8 shadow bg-muted snap-start w-72\"\n              >\n                <figure class=\"flex flex-col-reverse justify-between h-full\">\n                  <figcaption class=\"relative flex items-center gap-3\">\n                    <img\n                      alt=\"#_\"\n                      src=\"/avatars/11.png\"\n                      class=\"object-cover mx-auto rounded-full size-12\"\n                    />\n                    <div>\n                      <Text\n                        tag=\"h3\"\n                        variant=\"textBase\"\n                        class=\"font-medium text-foreground\"\n                      >\n                        Valentina Miu\n                      </Text>\n                      <Text\n                        tag=\"p\"\n                        variant=\"textXS\"\n                        class=\"font-medium text-muted-foreground\"\n                      >\n                        Writter\n                      </Text>\n                    </div>\n                  </figcaption>\n                  <div>\n                    <Text tag=\"p\" variant=\"textBase\">\n                      Being in the financial industry, we were always looking\n                      for ways to enhance our transactions' security and\n                      efficiency.\n                    </Text>\n                  </div>\n                </figure>\n              </li>\n              <li\n                role=\"option\"\n                aria-selected=\"false\"\n                class=\"h-full p-8 shadow bg-muted snap-start w-72\"\n              >\n                <figure class=\"flex flex-col-reverse justify-between h-full\">\n                  <figcaption class=\"relative flex items-center gap-3\">\n                    <img\n                      alt=\"#_\"\n                      src=\"/avatars/8.avif\"\n                      class=\"object-cover mx-auto rounded-full size-12\"\n                    />\n                    <div>\n                      <h3\n                        class=\"text-lg font-medium tracking-tight text-foreground\"\n                      >\n                        Gege Piazza\n                      </h3>\n                      <p class=\"mt-2 text-sm text-muted-foreground\">\n                        Creator of Pizza Piazza\n                      </p>\n                    </div>\n                  </figcaption>\n                  <div>\n                    <Text tag=\"p\" variant=\"textBase\">\n                      Implementing Semplice's blockchain technology has been a\n                      game-changer for our supply chain management.\n                    </Text>\n                  </div>\n                </figure>\n              </li>\n              <li\n                role=\"option\"\n                aria-selected=\"false\"\n                class=\"h-full p-8 shadow bg-muted snap-start w-72\"\n              >\n                <figure class=\"flex flex-col-reverse justify-between h-full\">\n                  <figcaption class=\"relative flex items-center mt-12 gap-3\">\n                    <img\n                      alt=\"#_\"\n                      src=\"/avatars/11.jpg\"\n                      class=\"object-cover mx-auto rounded-full size-12\"\n                    />\n                    <div>\n                      <h3\n                        class=\"text-lg font-medium tracking-tight text-foreground\"\n                      >\n                        Jenson Button\n                      </h3>\n                      <p class=\"mt-2 text-sm text-muted-foreground\">\n                        Founder of Benji and Tom\n                      </p>\n                    </div>\n                  </figcaption>\n                  <div>\n                    <Text tag=\"p\" variant=\"textBase\">\n                      We were initially hesitant about integrating blockchain\n                      technology into our existing systems.\n                    </Text>\n                  </div>\n                </figure>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
