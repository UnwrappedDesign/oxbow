  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/marketing/gallery/03.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport { Image } from \"astro:assets\";\nimport g1 from \"@/images/gallery/1.png\";\nimport g2 from \"@/images/gallery/2.png\";\nimport g3 from \"@/images/gallery/3.png\";\nimport g4 from \"@/images/gallery/4.png\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n      <Image\n        width={500}\n        height={500}\n        src={g1}\n        alt=\"#_\"\n        class=\"object-cover object-top size-full aspect-4/2\"\n      />\n      <Image\n        width={500}\n        height={500}\n        src={g2}\n        alt=\"#_\"\n        class=\"object-cover object-top size-full aspect-4/2\"\n      />\n\n      <div class=\"order-first py-12 lg:order-none\">\n        <Text\n          variant=\"displayMD\"\n          tag=\"h2\"\n          class=\"font-semibold tracking-tight text-foreground sm:text-balance\"\n        >\n          Explore our visual showcase\n        </Text>\n        <Text\n          variant=\"textSM\"\n          tag=\"p\"\n          class=\"mt-2 font-medium text-muted-foreground sm:text-balance\"\n        >\n          A curated collection of images capturing the essence of our brand and\n          the stories we tell.\n        </Text>\n      </div>\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        <Image\n          width={500}\n          height={500}\n          src={g3}\n          alt=\"#_\"\n          class=\"object-cover object-top size-full aspect-4/2\"\n        />\n        <Image\n          width={500}\n          height={500}\n          src={g4}\n          alt=\"#_\"\n          class=\"object-cover object-top size-full aspect-4/2\"\n        />\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
