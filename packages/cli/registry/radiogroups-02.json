      "name": "02.astro",
      "path": "oxbow/application/radiogroups/02.astro",
      "content": "---\nexport const description = \"Radio Button Group with Descriptions\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div class=\"flex justify-center p-16 mx-auto bg-white \">\n  <!-- copy:start -->\n  <div class=\"flex flex-col gap-2\" x-data=\"{ selected: 'option1' }\">\n    <div class=\"flex items-start gap-3\">\n      <input\n        id=\"radio-option1\"\n        name=\"radio-group\"\n        type=\"radio\"\n        value=\"option1\"\n        x-model=\"selected\"\n        class=\"text-primary bg-white rounded-full shadow size-4 border-base-300 focus:ring-primary \"\n      />\n      <div>\n        <Text\n          for=\"radio-option1\"\n          tag=\"label\"\n          class=\"block text-sm font-medium text-base-500 \"\n        >\n          Option 1\n        </Text>\n        <p class=\"text-sm text-base-400 \">\n          This is the description for option 1.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"flex items-start gap-3\">\n      <input\n        id=\"radio-option2\"\n        name=\"radio-group\"\n        type=\"radio\"\n        value=\"option2\"\n        x-model=\"selected\"\n        class=\"text-primary bg-white rounded-full shadow size-4 border-base-300 focus:ring-primary \"\n      />\n      <div>\n        <Text\n          for=\"radio-option2\"\n          tag=\"label\"\n          class=\"block text-sm font-medium text-base-500 \"\n        >\n          Option 2\n        </Text>\n        <p class=\"text-sm text-base-400 \">\n          This is the description for option 2.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"mt-2 text-sm text-base-500 \">\n      Selected: <span x-text=\"selected\"></span>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
