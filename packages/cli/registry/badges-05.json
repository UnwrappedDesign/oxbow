      "content": "---\nimport Badge from \"@/components/fundations/badges/Badge.astro\";\nimport Notification from \"@/components/fundations/badges/Notification.astro\";\n---\n\n<section\n  class=\"flex flex-col items-center justify-center h-full p-20 bg-background gap-12\"\n>\n  <!-- copy:start -->\n  <div class=\"flex flex-wrap justify-center gap-4\">\n    <!-- XS Size -->\n    <Badge variant=\"default\" size=\"xs\">\n      Default\n      <Notification\n        slot=\"notification\"\n        variant=\"default\"\n        position=\"xs\"\n        size=\"xs\"\n      >\n        1\n      </Notification>\n    </Badge>\n    <Badge variant=\"accent\" size=\"xs\">\n      Accent\n      <Notification\n        slot=\"notification\"\n        variant=\"accent\"\n        position=\"xs\"\n        size=\"xs\"\n      >\n        1\n      </Notification>\n    </Badge>\n    \n    <Badge variant=\"muted\" size=\"xs\">\n      Muted\n      <Notification slot=\"notification\" variant=\"muted\" position=\"xs\" size=\"xs\">\n        1\n      </Notification>\n    </Badge>\n    <Badge variant=\"info\" size=\"xs\">\n      info\n      <Notification slot=\"notification\" variant=\"info\" position=\"xs\" size=\"xs\">\n        1\n      </Notification>\n    </Badge>\n    <Badge variant=\"success\" size=\"xs\">\n      Success\n      <Notification\n        slot=\"notification\"\n        variant=\"success\"\n        position=\"xs\"\n        size=\"xs\"\n      >\n        1\n      </Notification>\n    </Badge>\n    <Badge variant=\"warning\" size=\"xs\">\n      Warning\n      <Notification\n        slot=\"notification\"\n        variant=\"warning\"\n        position=\"xs\"\n        size=\"xs\"\n      >\n        1\n      </Notification>\n    </Badge>\n    <Badge variant=\"danger\" size=\"xs\">\n      Danger\n      <Notification\n        slot=\"notification\"\n        variant=\"danger\"\n        position=\"xs\"\n        size=\"xs\"\n      >\n        1\n      </Notification>\n    </Badge>\n  </div>\n  <div class=\"flex flex-wrap justify-center gap-6\">\n    <!-- SM Size -->\n    <Badge variant=\"default\" size=\"sm\">\n      Default\n      <Notification\n        slot=\"notification\"\n        variant=\"default\"\n        position=\"sm\"\n        size=\"sm\"\n      >\n        1\n      </Notification>\n    </Badge>\n    <Badge variant=\"accent\" size=\"sm\">\n      Accent\n      <Notification\n        slot=\"notification\"\n        variant=\"accent\"\n        position=\"xsms\"\n        size=\"sm\"\n      >\n        1\n      </Notification>\n    </Badge>\n   \n    <Badge variant=\"muted\" size=\"xs\">\n      Muted\n      <Notification slot=\"notification\" variant=\"muted\" position=\"sm\" size=\"sm\">\n        1\n      </Notification>\n    </Badge>\n    <Badge variant=\"info\" size=\"xs\">\n      Info\n      <Notification slot=\"notification\" variant=\"info\" position=\"sm\" size=\"sm\">\n        1\n      </Notification>\n    </Badge>\n    <Badge variant=\"success\" size=\"xs\">\n      success\n      <Notification\n        slot=\"notification\"\n        variant=\"success\"\n        position=\"sm\"\n        size=\"sm\"\n      >\n        1\n      </Notification>\n    </Badge>\n    <Badge variant=\"warning\" size=\"xs\">\n      Warning\n      <Notification\n        slot=\"notification\"\n        variant=\"warning\"\n        position=\"sm\"\n        size=\"sm\"\n      >\n        1\n      </Notification>\n    </Badge>\n    <Badge variant=\"danger\" size=\"xs\">\n      Danger\n      <Notification\n        slot=\"notification\"\n        variant=\"danger\"\n        position=\"sm\"\n        size=\"sm\"\n      >\n        1\n      </Notification>\n    </Badge>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
