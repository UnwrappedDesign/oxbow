      "path": "oxbow/application/tables/02.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"bg-base-50\",\n  \"border-base-200\",\n  \"text-base-700\",\n  \"tabular-nums\",\n];\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport X from \"@/components/fundations/icons/X.astro\";\nimport Mail from \"@/components/fundations/icons/Mail.astro\";\nimport GithubBrand from \"@/components/fundations/icons/GithubBrand.astro\";\nconst rows = [\n  {\n    name: \"Jhonny Begood\",\n    providers: [\"mail\", \"github\"],\n    created: \"21 Aug 2024\",\n    signed: \"24 Sept 2024\",\n    userId: \"7fc61d7c-9060-464f-97df-37ba721e11f7\",\n    status: \"Active\",\n  },\n  {\n    name: \"Alice Smith\",\n    providers: [\"mail\"],\n    created: \"19 June 2024\",\n    signed: \"21 Aug 2024\",\n    userId: \"16839a81-6f63-4aa2-859f-69dd924fefdd\",\n    status: \"Inactive\",\n  },\n  {\n    name: \"Bob Johnson\",\n    providers: [\"github\"],\n    created: \"02 May 2024\",\n    signed: \"02 May 2024\",\n    userId: \"d4b03e34-4574-4641-a7aa-e57d04059e38\",\n    status: \"Pending\",\n  },\n  {\n    name: \"Clara Oswald\",\n    providers: [\"mail\", \"github\"],\n    created: \"12 March 2024\",\n    signed: \"16 July 2024\",\n    userId: \"9e402944-9e5f-4b39-9163-3b1664211cbe\",\n    status: \"Active\",\n  },\n];\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-white \">\n  <!-- copy:start -->\n  <div class=\"mx-auto flow-root max-w-7xl\">\n    <div class=\"overflow-x-auto\">\n      <div class=\"flex justify-center\">\n        <table class=\"min-w-[900px] text-sm\">\n          <thead class=\"bg-base-100 \">\n            <tr>\n              <th\n                class=\"px-3 py-2 font-medium text-left text-base-900 \"\n                >Name</th\n              >\n              <th\n                class=\"px-3 py-2 font-medium text-left text-base-900 \"\n                >Providers</th\n              >\n              <th\n                class=\"px-3 py-2 font-medium text-left text-base-900 \"\n                >Created</th\n              >\n              <th\n                class=\"px-3 py-2 font-medium text-left text-base-900 \"\n                >Signed</th\n              >\n              <th\n                class=\"px-3 py-2 font-medium text-left text-base-900 \"\n                >User ID</th\n              >\n              <th\n                class=\"px-3 py-2 font-medium text-left text-base-900 \"\n                >Status</th\n              >\n              <th\n                class=\"relative py-2 pl-3 pr-4 font-medium text-right text-base-900 \"\n                >Edit</th\n              >\n            </tr>\n          </thead>\n          <tbody>\n            {\n              rows.map((r) => (\n                <tr>\n                  <td class=\"px-3 py-2 font-medium text-base-700 \">\n                    {r.name}\n                  </td>\n                  <td class=\"px-3 py-2 text-base-500 \">\n                    <div class=\"flex items-center gap-2\">\n                      {r.providers.includes(\"mail\") && (\n                        <Mail class=\"text-base-400\" size=\"sm\" slot=\"icon\" />\n                      )}\n                      {r.providers.includes(\"github\") && (\n                        <GithubBrand\n                          class=\"text-base-400\"\n                          size=\"sm\"\n                          slot=\"icon\"\n                        />\n                      )}\n                    </div>\n                  </td>\n                  <td class=\"px-3 py-2 text-base-500 \">\n                    {r.created}\n                  </td>\n                  <td class=\"px-3 py-2 text-base-500 \">\n                    {r.signed}\n                  </td>\n                  <td class=\"px-3 py-2 font-mono text-base-900 \">\n                    <span class=\"flex items-center gap-2\">{r.userId}</span>\n                  </td>\n                  <td class=\"px-3 py-2 text-base-600 \">\n                    <span\n                      class={\n                        r.status === \"Active\"\n                          ? \"text-success \"\n                          : r.status === \"Inactive\"\n                            ? \"text-destructive \"\n                            : r.status === \"Pending\"\n                              ? \"text-warning \"\n                              : \"\"\n                      }\n                    >\n                      {r.status}\n                    </span>\n                  </td>\n                  <td class=\"py-2 \">\n                    <div class=\"flex items-center gap-2\">\n                      <Button\n                        size=\"sm\"\n                        type=\"submit\"\n                        variant=\"link\"\n                        class=\"ml-auto\"\n                      >\n                        Edit<span class=\"sr-only\">Edit</span>\n                      </Button>\n                    </div>\n                  </td>\n                </tr>\n              ))\n            }\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
