{
  "name": "textarea-15",
  "type": "component",
  "description": "Textarea with Emoji Picker",
  "category": "application",
  "section": "textarea",
  "variant": 15,
  "aliases": [
    "textarea",
    "textarea 15"
  ],
  "files": [
    {
      "name": "15.astro",
      "path": "oxbow/application/textarea/15.astro",
      "content": "---\nexport const description = \"Textarea with Emoji Picker\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-white \">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div\n      class=\"w-full space-y-2\"\n      x-data=\"{ text: '', emojis: ['💪', '🤣', '🔥', '👍', '🚀'] }\"\n    >\n      <div>\n        <Text\n          for=\"emoji-picker-textarea\"\n          tag=\"label\"\n          variant=\"textSM\"\n          class=\"font-medium text-base-500 \"\n        >\n          Emoji picker\n        </Text>\n        <textarea\n          id=\"emoji-picker-textarea\"\n          x-model=\"text\"\n          rows=\"4\"\n          placeholder=\"Type your message\"\n          class=\"block w-full px-4 py-2 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n        ></textarea>\n      </div>\n      <div class=\"flex items-center mt-2 gap-1\">\n        <template x-for=\"emoji in emojis\" :key=\"emoji\">\n          <IconButton\n            type=\"button\"\n            variant=\"outline\"\n            size=\"xs\"\n            @click=\"text += emoji\"\n            x-text=\"emoji\"\n          />\n        </template>\n      </div>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
