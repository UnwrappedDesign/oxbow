      "name": "12.astro",
      "path": "oxbow/marketing/gallery/12.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport { Image } from \"astro:assets\";\nimport g1 from \"@/images/gallery/1.png\";\nimport g2 from \"@/images/gallery/2.png\";\nimport g3 from \"@/images/gallery/3.png\";\nimport g4 from \"@/images/gallery/4.png\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n      <div class=\"flex flex-col gap-4\">\n        <Image\n          width={800}\n          height={800}\n          src={g1}\n          alt=\"#_\"\n          class=\"object-cover object-top size-full max-h-64\"\n        />\n        <Image\n          width={800}\n          height={800}\n          src={g2}\n          alt=\"#_\"\n          class=\"object-cover object-top size-full aspect-square\"\n        />\n      </div>\n      <div class=\"flex flex-col gap-4\">\n        <Image\n          width={800}\n          height={800}\n          src={g3}\n          alt=\"#_\"\n          class=\"object-cover object-top size-full aspect-square\"\n        />\n        <Image\n          width={800}\n          height={800}\n          src={g4}\n          alt=\"#_\"\n          class=\"object-cover object-top size-full max-h-64\"\n        />\n      </div>\n    </div>\n    <div class=\"items-end mt-12 grid grid-cols-1 gap-12 lg:grid-cols-3\">\n      <div class=\"lg:col-span-2\">\n        <Text\n          variant=\"displayMD\"\n          tag=\"h2\"\n          class=\"font-semibold tracking-tight text-base-900 sm:text-balance\"\n        >\n          Explore our visual showcase\n        </Text>\n        <Text\n          variant=\"textSM\"\n          tag=\"p\"\n          class=\"mt-2 font-medium text-base-500 sm:text-balance\"\n        >\n          A curated collection of images capturing the essence of our brand and\n          the stories we tell.\n        </Text>\n      </div>\n      <Button variant=\"default\" size=\"sm\" class=\"mt-8 w-fit lg:ml-auto\">\n        See gallery\n      </Button>\n    </div>\n  </div>\n</section>\n"
    }
  ],
