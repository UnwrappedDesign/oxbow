eHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n\n    <Badge variant=\"muted\" gap=\"xs\" size=\"sm\" slot=\"right-icon\">\n      Muted\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge variant=\"text\" gap=\"xs\" size=\"sm\" slot=\"right-icon\">\n      Text\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge variant=\"info\" gap=\"xs\" size=\"sm\" slot=\"right-icon\">\n      Info\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge variant=\"success\" gap=\"xs\" size=\"sm\" slot=\"right-icon\">\n      Success\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge variant=\"warning\" gap=\"xs\" size=\"sm\" slot=\"right-icon\">\n      Warning\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge variant=\"danger\" gap=\"xs\" size=\"sm\" slot=\"right-icon\">\n      Danger\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n  </div>\n  <!-- copy:end -->\n</section>\n"
