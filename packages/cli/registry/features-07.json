      "path": "oxbow/marketing/features/07.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\n\nconst listItems = [\n  \"Real-time collaboration\",\n  \"Automated workflows\",\n  \"Enhanced security\",\n  \"Seamless integrations\",\n  \"Centralized control\",\n  \"Intuitive monitoring\",\n  \"Data-driven insights\",\n  \"Scalable architecture\",\n];\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <ol\n      role=\"list\"\n      class=\"list-none grid lg:items-center grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-12 lg:grid-cols-3\"\n    >\n      <li>\n        <div class=\"max-w-xl lg:text-balance\">\n          <Text\n            tag=\"h2\"\n            variant=\"displaySM\"\n            class=\"font-semibold tracking-tight text-base-900 text-balance\"\n          >\n            Easy collaboration for finance workflows\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-500 \"\n          >\n            Accelerate project delivery with unified staging and testing\n            environments.<br /><br />Our platform provides powerful tools to\n            automate tasks, enforce security, and simplify complex workflows.\n          </Text>\n        </div>\n      </li>\n      <li class=\"order-last lg:order-none col-span-full lg:col-span-1\">\n        <img\n          class=\"shadow rounded-2xl size-full\"\n          src=\"/widgets/activity.svg\"\n          alt=\"#_\"\n        />\n      </li>\n      <li>\n        <ul\n          class=\"text-base font-medium list-none space-y-1 text-base-900 \"\n          role=\"list\"\n        >\n          {\n            listItems.map((item, index) => (\n              <li>\n                <div class=\"relative flex flex-row items-start gap-2\">\n                  <CircleCheck\n                    class=\"text-base-600 \"\n                    size=\"sm\"\n                  />\n                  <Text tag=\"span\" variant=\"textSM\">\n                    {item}\n                  </Text>\n                </div>\n              </li>\n            ))\n          }\n        </ul>\n      </li>\n    </ol>\n  </div>\n</section>\n"
    }
  ],
