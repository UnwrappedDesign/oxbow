      "content": "---\nexport const description = \"Empty playlist\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n---\n\n<div\n  class=\"flex items-center justify-center p-8 py-24 bg-white \"\n>\n  <!-- copy:start -->\n  <div class=\"text-center\">\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"24\"\n      height=\"24\"\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      stroke-width=\"2\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n      class=\"mx-auto icon icon-tabler icons-tabler-outline icon-tabler-music-x size-6 text-base-600\"\n      ><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path><path\n        d=\"M3 17a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\"></path><path d=\"M9 17v-13h10v9\"\n      ></path><path d=\"M9 8h10\"></path><path d=\"M22 22l-5 -5\"></path><path\n        d=\"M17 22l5 -5\"></path></svg\n    >\n    <Text\n      tag=\"h3\"\n      variant=\"textBase\"\n      class=\"mt-8 font-medium text-base-900 \"\n    >\n      Your playlist is empty\n    </Text>\n    <Text\n      tag=\"p\"\n      variant=\"textSM\"\n      class=\"mx-auto mt-2 font-medium text-base-500 text-balance\"\n    >\n      Start adding some tracks to create your perfect mix!\n    </Text>\n\n    <div class=\"flex flex-col max-w-sm mx-auto mt-8 gap-2\">\n      <TextInput\n        id=\"search-left\"\n        name=\"search-left\"\n       \n        type=\"search\"\n        iconPosition=\"left\"\n        variant=\"default\"\n        size=\"base\"\n        placeholder=\"Search with left icon\"\n      />\n      <Button class=\"w-auto\" size=\"base\" variant=\"default\">\n        Browse popular tracks\n      </Button>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
