      "content": "---\n\nexport const description = \"Action footer\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Lock from \"@/components/fundations/icons/Lock.astro\";\n---\n\n<section class=\"flex items-center justify-center bg-background p-18\">\n  <!-- copy:start -->\n  <div class=\"flex w-full max-w-xl items-center justify-between rounded-xl border border-border bg-background p-4 shadow-sm\">\n    <div class=\"flex flex-col gap-0.5 text-sm\">\n      <span class=\"font-medium text-foreground\">Lock sprint</span>\n      <span class=\"text-muted-foreground\">Freeze scope until next planning session.</span>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <Button variant=\"ghost\" size=\"sm\" class=\"gap-2 transition-none\">\n        Cancel\n      </Button>\n      <Button variant=\"accent\" size=\"sm\" class=\"gap-2 transition-none\">\n        <Lock slot=\"left-icon\" size=\"sm\" />\n        Confirm\n      </Button>\n    </div>\n  </div>\n  <!-- copy:end -->\n</section>\n"
