      "name": "03.astro",
      "path": "oxbow/application/navbars/03.astro",
      "content": "---\nexport const freeComponent = true;\nexport const excludeFromObfuscation = [\"flex\", \"hidden\"];\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport Burger from \"@/components/fundations/icons/Burger.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\nimport ChevronDown from \"@/components/fundations/icons/ChevronDown.astro\";\nimport FlyoutLinkBox from \"@/components/fundations/wrappers/FlyoutLinkBox.astro\";\nimport Refresh from \"@/components/fundations/icons/Refresh.astro\";\nimport FileDots from \"@/components/fundations/icons/FileDots.astro\";\nimport Edit from \"@/components/fundations/icons/Edit.astro\";\nimport Brain from \"@/components/fundations/icons/Brain.astro\";\nimport Subtask from \"@/components/fundations/icons/Subtask.astro\";\n---\n\n<div class=\"bg-background pb-100\">\n  <!-- copy:start -->\n  <header\n    class=\"w-full bg-background border-b border-border\"\n  >\n    <div\n      x-data=\"{ open:false, prod:false, res:false }\"\n      class=\"px-6 mx-auto max-w-screen-xl md:px-10 lg:px-16\"\n    >\n      <div class=\"flex items-center justify-between h-16 gap-3\">\n        <a href=\"#_\" class=\"inline-flex items-center gap-2\"\n          ><Logo class=\"text-foreground h-7\" /><span class=\"sr-only\"\n            >Home</span\n          ></a\n        >\n        <IconButton\n          class=\"md:hidden\"\n          @click=\"open=!open\"\n          :aria-expanded=\"open\"\n          aria-controls=\"nav-03m\"\n          variant=\"outline\"\n          size=\"xs\"\n        >\n          <Burger size=\"xs\" slot=\"icon\" />\n        </IconButton>\n        <!-- Desktop navigation (always hidden on mobile) -->\n        <nav\n          id=\"nav-03\"\n          aria-label=\"Primary\"\n          class=\"items-center hidden md:flex gap-1\"\n        >\n          <div x-data=\"{open:false}\" class=\"relative\">\n            <Button\n              size=\"xs\"\n              variant=\"ghost\"\n              @click=\"open=!open\"\n              @keydown.escape.window=\"open=false\"\n              :aria-expanded=\"open\"\n              class=\"flex items-center justify-between gap-2\"\n              >Products\n              <ChevronDown\n                size=\"sm\"\n                slot=\"right-icon\"\n                :class=\"open ? '-rotate-180' : ''\"\n                class=\"duration-300 ease-out transform\"\n              />\n            </Button>\n            <div\n              x-show=\"open\"\n              x-transition\n              @click.outside=\"open=false\"\n              class=\"absolute left-0 z-30 flex flex-col p-4 mt-2 bg-background shadow-lg top-full w-80 rounded-xl outline outline-border/10 gap-4\"\n            >\n              <FlyoutLinkBox\n                href=\"#_\"\n                icon={Refresh}\n                title=\"Sync across devices\"\n                description=\"Enable syncing across devices\"\n              />\n              <FlyoutLinkBox\n                href=\"#_\"\n                icon={FileDots}\n                title=\"Create custom documents\"\n                description=\"Stlye your documents with ease\"\n              />\n            </div>\n          </div>\n          <div x-data=\"{open:false}\" class=\"relative\">\n            <Button\n              size=\"xs\"\n              variant=\"ghost\"\n              @click=\"open=!open\"\n              @keydown.escape.window=\"open=false\"\n              :aria-expanded=\"open\"\n              class=\"flex items-center justify-between gap-2\"\n              >Resources\n              <ChevronDown\n                size=\"sm\"\n                slot=\"right-icon\"\n                :class=\"open ? '-rotate-180' : ''\"\n                class=\"duration-300 ease-out transform\"\n              />\n            </Button>\n            <div\n              x-show=\"open\"\n              x-transition\n              @click.outside=\"open=false\"\n              class=\"absolute left-0 z-30 flex flex-col p-4 mt-2 bg-background shadow-lg top-full w-80 rounded-xl outline outline-border/10 gap-4\"\n            >\n              <FlyoutLinkBox\n                href=\"#_\"\n                icon={Edit}\n                title=\" Edit your files\"\n                description=\"Endless possibilities\"\n              />\n              <FlyoutLinkBox\n                href=\"#_\"\n                icon={Brain}\n                title=\"Organize files\"\n                description=\"Keep them all in one place\"\n              />\n              <FlyoutLinkBox\n                href=\"#_\"\n                icon={Subtask}\n                title=\" Manage tasks and projects\"\n                description=\"  Make simple tasks a breeze\"\n              />\n            </div>\n          </div>\n          <a\n            href=\"#_\"\n            class=\"px-2 py-2 text-sm font-medium text-muted-foreground hover:text-foreground\"\n            >Pricing</a\n          >\n          <span aria-hidden class=\"w-px h-4 mx-2 bg-muted\"\n          ></span>\n          <Button variant=\"muted\" size=\"xs\">Sign in</Button>\n          <Button variant=\"default\" size=\"xs\">Sign up</Button>\n        </nav>\n      </div>\n      <!-- Mobile menu -->\n      <div\n        id=\"nav-03m\"\n        x-cloak\n        x-show=\"open\"\n        class=\"pb-4 grid grid-cols-1 gap-2 md:hidden\"\n      >\n        <details>\n          <summary\n            class=\"items-start justify-between w-full text-sm font-medium text-left select-none grid grid-cols-4 text-foreground hover:text-muted-foreground focus:text-muted-foreground gap-4focus:text-muted-foreground\"\n            ><span class=\"col-span-3\">Products</span>\n            <Plus\n              class=\"ml-auto duration-300 ease-out transform group-open:-rotate-45 group-open:text-foreground text-muted-foreground\"\n              size=\"sm\"\n            />\n          </summary>\n          <div\n            class=\"py-2 pt-2 text-sm text-muted-foreground space-y-2\"\n          >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-muted-foreground\"\n              >Sync Across devices</Text\n            >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-muted-foreground\"\n              >Create custom documents</Text\n            >\n          </div>\n        </details>\n        <details>\n          <summary\n            class=\"items-start justify-between w-full text-sm font-medium text-left select-none grid grid-cols-4 text-foreground hover:text-muted-foreground focus:text-muted-foreground gap-4focus:text-muted-foreground\"\n            ><span class=\"col-span-3\">Resources</span>\n            <Plus\n              class=\"ml-auto duration-300 ease-out transform group-open:-rotate-45 group-open:text-foreground text-muted-foreground\"\n              size=\"sm\"\n            /></summary\n          >\n          <div\n            class=\"py-2 pt-2 text-sm text-muted-foreground space-y-2\"\n          >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-muted-foreground\"\n              >Edit your files</Text\n            >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-muted-foreground\"\n              >Organize files</Text\n            >\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"font-medium text-muted-foreground\"\n              >Manage tasks and projects</Text\n            >\n          </div>\n        </details>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground hover:text-foreground\"\n          >Pricing</Text\n        >\n        <div class=\"flex items-center mt-8 gap-2\">\n          <Button variant=\"muted\" size=\"xs\">Sign in</Button>\n          <Button variant=\"default\" size=\"xs\">Sign up</Button>\n        </div>\n      </div>\n    </div>\n  </header>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
