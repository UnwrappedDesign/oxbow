      "name": "09.astro",
      "path": "oxbow/marketing/pricing/09.astro",
      "content": "---\nexport const description =\n  \"Pricing section with three cards and feature comparison table \";\n\nexport const excludeFromObfuscation = [\n  \"w-1/2\",\n  \"translate-x-0\",\n  \"translate-x-full\",\n  \"text-muted-foreground\",\n  \"focus:text-foreground\",\n  \"hover:text-foreground\",\n];\n\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Wrapper from \"@/components/fundations/containers/Wrapper.astro\";\n// Icons\n// Icons (import all used ones)\nimport Eye from \"@/components/fundations/icons/Eye.astro\";\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\nimport Lock from \"@/components/fundations/icons/Lock.astro\";\nimport Bulb from \"@/components/fundations/icons/Bulb.astro\";\nimport Tool from \"@/components/fundations/icons/Tool.astro\";\nimport Apps from \"@/components/fundations/icons/Apps.astro\";\nimport Check from \"@/components/fundations/icons/Check.astro\";\nimport Tools from \"@/components/fundations/icons/Tools.astro\";\nimport Brain from \"@/components/fundations/icons/Brain.astro\";\nimport Clock from \"@/components/fundations/icons/Clock.astro\";\nimport Shield from \"@/components/fundations/icons/Shield.astro\";\nimport ApiApp from \"@/components/fundations/icons/ApiApp.astro\";\nimport Report from \"@/components/fundations/icons/Report.astro\";\nimport UserPlus from \"@/components/fundations/icons/UserPlus.astro\";\nimport Lifebuoy from \"@/components/fundations/icons/Lifebuoy.astro\";\nimport Database from \"@/components/fundations/icons/Database.astro\";\nimport UsersGroup from \"@/components/fundations/icons/UsersGroup.astro\";\nimport InfoCircle from \"@/components/fundations/icons/InfoCircle.astro\";\nimport CreditCard from \"@/components/fundations/icons/CreditCard.astro\";\nimport ArrowIteration from \"@/components/fundations/icons/ArrowIteration.astro\";\nimport SettingsExclamation from \"@/components/fundations/icons/SettingsExclamation.astro\";\nimport AdjustmentsHorizontal from \"@/components/fundations/icons/AdjustmentsHorizontal.astro\";\nconst pricingOptions = [\n  {\n    id: \"core\",\n    cardClass: \"bg-background outline outline-border shadow rounded-xl p-8\",\n    primaryTextColor: \"text-foreground\",\n    secondaryTextColor: \"text-muted-foreground\",\n    featuresBorderColor: \"border-border border-border\",\n    title: \"Core\",\n    monthly: \"$29.00\",\n    annual: \"$19.00\",\n    description: \"For solo builders and side project warriors\",\n    button: {\n      text: \"Get Started\",\n      variant: \"muted\",\n    },\n    features: [\n      { icon: UserPlus, text: \"Unlimited members\" },\n      { icon: UsersGroup, text: \"1 Teams\" },\n      { icon: SettingsExclamation, text: \"50 issues\" },\n      { icon: ApiApp, text: \"Slack, GitHub, and API access\" },\n      { icon: Tools, text: \"Basic reporting tools\" },\n      { icon: Lifebuoy, text: \"Community support\" },\n      { icon: AdjustmentsHorizontal, text: \"Basic customization options\" },\n    ],\n  },\n  {\n    id: \"momentum\",\n    cardClass: \"bg-background outline outline-border shadow rounded-xl\",\n    primaryTextColor: \"text-foreground\",\n    secondaryTextColor: \"text-muted-foreground\",\n    featuresBorderColor: \"border-border/30 border-border/20\",\n    title: \"Momentum\",\n    monthly: \"$49.00\",\n    annual: \"$39.00\",\n    description: \"Perfect for growing teams that need more power.\",\n    button: {\n      text: \"Get Started\",\n      variant: \"default\",\n    },\n    features: [\n      { icon: Plus, text: \"All Core plan features\" },\n      { icon: UserPlus, text: \"Unlimited teams\" },\n      { icon: Lock, text: \"Private teams and guest\" },\n      { icon: Bulb, text: \"Insights\" },\n      { icon: ArrowIteration, text: \"Integrations\" },\n      { icon: Report, text: \"Advanced reporting and analytics\" },\n      { icon: Shield, text: \"Custom branding options\" },\n      { icon: Tool, text: \"Collaboration tools\" },\n      { icon: Apps, text: \"Mobile app access\" },\n      { icon: Database, text: \"File storage\" },\n    ],\n  },\n  {\n    id: \"velocity\",\n    cardClass: \"bg-background outline outline-border shadow rounded-xl p-8\",\n    primaryTextColor: \"text-foreground\",\n    secondaryTextColor: \"text-muted-foreground\",\n    featuresBorderColor: \"border-border border-border\",\n    title: \"Velocity\",\n    monthly: \"$99.00\",\n    annual: \"$79.00\",\n    description: \"Designed for fast-moving teams and startups.\",\n    button: {\n      text: \"Upgrade Now\",\n      variant: \"muted\",\n    },\n    features: [\n      { icon: Plus, text: \"All Momentum plan features\" },\n      { icon: Brain, text: \"Priority infrastructure resources\" },\n      { icon: Clock, text: \"SSO and enterprise auth\" },\n      { icon: Database, text: \"Advanced security and permissions\" },\n      { icon: InfoCircle, text: \"Real-time performance dashboards\" },\n      { icon: CreditCard, text: \"24/7 premium support\" },\n      { icon: Eye, text: \"Launch planning and onboarding\" },\n    ],\n  },\n];\n---\n\n<section x-data=\"{ duration: 'monthly' }\" class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-md mx-auto text-center\">\n      <Text\n        tag=\"h1\"\n        variant=\"displayMD\"\n        class=\"font-semibold tracking-tight text-foreground text-balance\"\n      >\n        Give your team tools that don't suck\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-2 font-medium text-muted-foreground text-balance\"\n      >\n        Start with what you need, skip what you don't. Scale up when\n        spreadsheets stop cutting it.\n      </Text>\n      <!-- Pricing Toggle -->\n      <div\n        aria-labelledby=\"pricing-toggle\"\n        class=\"relative z-0 inline-flex justify-center w-full p-1 mx-auto mt-8 overflow-hidden bg-background shadow ring-1 ring-border ring-offset-2 gap-4 lg:mx-0 rounded-md max-w-52 ring-offset-background\"\n      >\n        <div\n          class=\"absolute inset-0 bg-muted rounded-md ring-1 ring-border/60 shadow-sm transition-transform duration-200 ease-in-out\"\n          :class=\"duration === 'monthly' ? 'w-1/2 translate-x-0' : 'w-1/2 translate-x-full'\"\n        >\n        </div>\n        <button\n          class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n          :class=\"duration === 'monthly' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground focus:text-foreground'\"\n          @click=\"duration = 'monthly'\"\n          type=\"button\"\n          :aria-pressed=\"duration === 'monthly'\"\n        >\n          Monthly\n        </button>\n        <button\n          class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n          :class=\"duration === 'annual' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground focus:text-foreground'\"\n          @click=\"duration = 'annual'\"\n          type=\"button\"\n          :aria-pressed=\"duration === 'annual'\"\n        >\n          Annual\n        </button>\n      </div>\n    </div>\n\n    <!-- Pricing Cards -->\n    <div class=\"mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n      {\n        pricingOptions.map((tier) => (\n          <div\n            class={`flex flex-col p-8  outline  rounded-xl shadow  ${tier.cardClass}`}\n          >\n            <div class=\"flex flex-col\">\n              <Text\n                tag=\"h3\"\n                variant=\"textBase\"\n                class={` font-medium ${tier.primaryTextColor}`}\n              >\n                {tier.title}\n              </Text>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class={`mt-2 ${tier.secondaryTextColor}`}\n              >\n                {tier.description}\n              </Text>\n              <Text\n                variant=\"displaySM\"\n                class={`font-medium flex items-baseline tracking-tighter mt-4 ${tier.primaryTextColor}`}\n              >\n                <span\n                  data-monthly={tier.monthly}\n                  data-annual={tier.annual}\n                  x-text=\"$el.dataset[duration]\"\n                />\n                <span\n                  class={`text-sm font-normal  tracking-normal ${tier.secondaryTextColor}`}\n                >\n                  <span x-show=\"duration === 'monthly'\">/month</span>\n                  <span x-show=\"duration === 'annual'\" style=\"display: none;\">\n                    /annually\n                  </span>\n                </span>\n              </Text>\n              <div class=\"w-full mt-4\">\n                <Button class=\"w-full\" variant={tier.button.variant} size=\"sm\">\n                  {tier.button.text}\n                </Button>\n              </div>\n            </div>\n\n            <div class={`mt-8 pt-8 border-t ${tier.featuresBorderColor}  `}>\n              <Text\n                tag=\"p\"\n                variant=\"textXS\"\n                class={`font-medium uppercase ${tier.secondaryTextColor}`}\n              >\n                {tier.title === \"Momentum\"\n                  ? \"Everything in Core plus:\"\n                  : \"Core plan includes:\"}\n              </Text>\n              <ul\n                class={`flex flex-col mt-4 text-sm  gap-y-3 ${tier.primaryTextColor}`}\n                role=\"list\"\n              >\n                {tier.features.map((feature, index) => (\n                  <li class=\"flex items-center gap-2\">\n                    <feature.icon size=\"sm\" />\n                    <span>{feature.text}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n        ))\n      }\n    </div>\n    <div class=\"hidden mt-12 lg:block\">\n      <div class=\"pb-4 mt-20 border-b border-border\">\n        <Text tag=\"p\" variant=\"textXL\" class=\"font-medium text-foreground\">\n          Price comparison\n        </Text>\n        <p class=\"text-2xl font-semibold tracking-tight text-foreground\"></p>\n      </div>\n      <!---- Use only from xl: -->\n      <div>\n        <table class=\"w-full mx-auto text-center bg-transparent\">\n          <thead>\n            <tr class=\"align-top border-b border-border\">\n              <th\n                class=\"w-1/4 py-4 text-sm font-medium text-left leading-6 text-foreground\"\n                >Usage\n              </th>\n              <th\n                class=\"w-1/4 py-4 text-sm font-medium leading-6 text-foreground\"\n              >\n                Core\n              </th>\n              <th\n                class=\"w-1/4 py-4 text-sm font-medium leading-6 text-foreground\"\n              >\n                Momentum\n              </th>\n              <th\n                class=\"w-1/4 py-4 text-sm font-medium leading-6 text-foreground\"\n              >\n                Velocity\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th class=\"py-3 text-sm font-medium text-left text-foreground\">\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />\n                  Analytics\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >3</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n                >10</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Unlimited</td\n              >\n            </tr>\n            <tr>\n              <th\n                class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n              >\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />Accounts\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >5</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n                >10</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Unlimited</td\n              >\n            </tr>\n            <tr>\n              <th\n                class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n              >\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />Integrations\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >2</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n              >\n                YES\n              </td>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Unlimited</td\n              >\n            </tr>\n            <tr>\n              <th\n                class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n              >\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />Programs\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n              >\n                NO\n              </td>\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n                >1</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Unlimited</td\n              >\n            </tr>\n            <tr>\n              <th\n                class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n              >\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />Deployments\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n              >\n                NO\n              </td>\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n              >\n                YES\n              </td>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Unlimited</td\n              >\n            </tr>\n            <tr>\n              <th\n                class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n              >\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />Advanced Checkpoints\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n              >\n                NO\n              </td>\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n              >\n                YES\n              </td>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Unlimited</td\n              >\n            </tr>\n            <tr>\n              <th\n                class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n              >\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />Reporting tools\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n              >\n                NO\n              </td>\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n              >\n                YES\n              </td>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Unlimited</td\n              >\n            </tr>\n            <tr>\n              <th\n                class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n                ><div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />Support\n                </div></th\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Discord community</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n                >Live chat</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Unlimited</td\n              >\n            </tr>\n\n            <tr class=\"overflow-hidden\">\n              <th\n                scope=\"colgroup\"\n                colspan=\"4\"\n                class=\"py-4 text-sm font-medium text-left leading-6 text-foreground border-y border-border\"\n              >\n                Features\n              </th>\n            </tr>\n\n            <tr>\n              <th class=\"py-3 text-sm font-medium text-left text-foreground\">\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />\n                  Service agreement\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >No</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n                >No</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >YES</td\n              >\n            </tr>\n            <tr>\n              <th\n                class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n              >\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />Dedicted Manager\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >No</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n                >Yes</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Yes</td\n              >\n            </tr>\n            <tr>\n              <th\n                class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n              >\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />Onboarding sessions\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >No</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n              >\n                No\n              </td>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border\"\n                >Yes</td\n              >\n            </tr>\n            <tr>\n              <th\n                class=\"py-3 text-sm font-medium text-left border-t text-foreground border-border\"\n              >\n                <div class=\"flex items-center gap-2\">\n                  <Check size=\"sm\" />Dedicated support channel\n                </div>\n              </th>\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border rounded-bl-3xl\"\n              >\n                No\n              </td>\n              <td\n                class=\"px-2 text-xs font-medium text-center border-t bg-muted text-foreground border-border border-border\"\n                >No</td\n              >\n              <td\n                class=\"px-2 text-xs font-medium text-center bg-background border-t text-foreground border-border rounded-br-3xl\"\n                >Yes</td\n              >\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
