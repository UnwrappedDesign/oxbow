  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/application/emptyStates/03.astro",
      "content": "---\nexport const description = \"No data state\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nconst features = [\n  {\n    title: \"Track Progress\",\n    description: \"Monitor team activity and project milestones in real-time\",\n  },\n  {\n    title: \"Generate Reports\",\n    description: \"Get insights with automated weekly and monthly reports\",\n  },\n];\n---\n\n<div class=\"flex items-center justify-center p-8 py-24 bg-background\">\n  <!-- copy:start -->\n  <div class=\"max-w-xl mx-auto text-center\">\n    <div class=\"h-full p-8 pb-0 overflow-hidden bg-background rounded-2xl\">\n      <img\n        src=\"/widgets/activity2.svg\"\n        class=\"object-center w-full -mb-12 bg-background shadow rounded-t-2xl\"\n        alt=\"\"\n      />\n    </div>\n\n    <div>\n      <div class=\"max-w-lg mx-auto mt-4\">\n        <Text tag=\"h3\" variant=\"textBase\" class=\"font-medium text-foreground\">\n          Your activity feed is empty\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"mt-2 font-medium text-muted-foreground text-balance\"\n        >\n          Start tracking your team's progress. Your activity data will appear\n          here once you begin collaborating.\n        </Text>\n\n        <div class=\"flex flex-col justify-center mt-4 sm:flex-row gap-3\">\n          <Button class=\"\" size=\"xs\" variant=\"default\">\n            Set Up Dashboard\n          </Button>\n          <Button class=\"\" size=\"xs\" variant=\"muted\"> View Tutorial </Button>\n        </div>\n      </div>\n      <div class=\"mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        {\n          features.map((feature, index) => (\n            <div>\n              <Text\n                tag=\"h3\"\n                variant=\"textBase\"\n                class=\"font-medium text-foreground\"\n              >\n                {feature.title}\n              </Text>\n              <Text tag=\"p\" variant=\"textSM\" class=\"mt-1 text-muted-foreground\">\n                {feature.description}\n              </Text>\n            </div>\n          ))\n        }\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
