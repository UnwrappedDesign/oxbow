      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"items-end grid grid-cols-1 md:grid-cols-3 gap-6\">\n      <div\n        class=\"flex flex-col-reverse justify-between gap-x-16 gap-y-8 sm:w-3/4 sm:max-w-md sm:flex-row-reverse sm:items-end lg:w-72 lg:max-w-none lg:flex-none lg:flex-col lg:items-start\"\n      >\n        <div>\n          <Kicker> By the Numbers </Kicker>\n          <Text\n            tag=\"h2\"\n            variant=\"displaySM\"\n            class=\"mt-4 font-semibold tracking-tight text-foreground lg:text-balance\"\n          >\n            Transform your Finances with Proven Results\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-muted-foreground\"\n          >\n            Our track record speaks volumes—millions of users, minimal fees, and\n            impressive returns.\n          </Text>\n        </div>\n      </div>\n      <div\n        class=\"flex flex-col justify-between shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl lg:gap-28\"\n      >\n        <div class=\"order-last w-full p-8 border-t border-border\">\n          <Text\n            tag=\"p\"\n            variant=\"display2XL\"\n            class=\"font-mono font-medium text-foreground\"\n          >\n            90%\n          </Text>\n        </div>\n        <div class=\"p-8 sm:shrink lg:flex-none\">\n          <Text tag=\"h3\" variant=\"textBase\" class=\"font-medium text-foreground\">\n            Massive Earnings\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Reap the benefits with substantial returns.\n          </Text>\n        </div>\n      </div>\n      <div\n        class=\"flex flex-col justify-between shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl lg:gap-44\"\n      >\n        <div class=\"order-last w-full p-8 border-t border-border\">\n          <Text\n            tag=\"p\"\n            variant=\"display2XL\"\n            class=\"font-mono font-medium text-foreground\"\n          >\n            8%\n          </Text>\n        </div>\n        <div class=\"p-8 sm:shrink lg:flex-none\">\n          <Text tag=\"h3\" variant=\"textBase\" class=\"font-medium text-foreground\">\n            Super low fee\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Enjoy significant savings with our extremely low fee structure.\n          </Text>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
