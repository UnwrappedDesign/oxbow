      "path": "oxbow/marketing/features/17.astro",
      "content": "---\nexport const excludeFromObfuscation = [\"bg-white\", \"shadow\"];\n\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Filters from \"@/components/fundations/icons/Filters.astro\";\nimport WaveSquare from \"@/components/fundations/icons/WaveSquare.astro\";\nimport ArrowIteration from \"@/components/fundations/icons/ArrowIteration.astro\";\nimport Cursor from \"@/components/fundations/icons/Cursor.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <!-- Show Tab 1 as default  -->\n    <div\n      x-data=\"{ tab: 'tab1' }\"\n      class=\"items-center grid grid-cols-1 gap-6 lg:grid-cols-2\"\n    >\n      <ul class=\"list-none grid sm:grid-cols-2 lg:grid-cols-1 gap-4\">\n        <!-- Tab 1 -->\n        <li class=\"p-1 bg-base-50 rounded-xl\">\n          <button\n            @click.prevent=\"tab = 'tab1'\"\n            class=\"items-start h-full p-4 text-left bg-white rounded-lg shadow lg:p-8 transition \"\n            :class=\"{ 'bg-white shadow ' : tab === 'tab1' }\"\n          >\n            <div>\n              <div class=\"flex items-center gap-4\">\n                <Filters class=\"text-base-600 \" size=\"base\" />\n                <dt>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textBase\"\n                    class=\"font-semibold text-base-900 \"\n                  >\n                    Innovative Design\n                  </Text>\n                </dt>\n              </div>\n              <dd>\n                <Text\n                  tag=\"p\"\n                  variant=\"textSM\"\n                  class=\"mt-2 font-medium text-base-500 \"\n                >\n                  Our cutting-edge design offers a fresh, modern look that\n                  transforms your project into a standout experience.\n                </Text>\n              </dd>\n            </div>\n          </button>\n        </li>\n        <!-- Tab 2 -->\n        <li class=\"p-1 bg-base-50 rounded-xl\">\n          <button\n            @click.prevent=\"tab = 'tab2'\"\n            class=\"items-start h-full p-4 text-left bg-white rounded-lg shadow lg:p-8 transition \"\n            :class=\"{ 'bg-white shadow ' : tab === 'tab2' }\"\n          >\n            <div>\n              <div class=\"flex items-center gap-4\">\n                <WaveSquare\n                  class=\"text-base-600 \"\n                  size=\"base\"\n                />\n                <dt>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textBase\"\n                    class=\"font-semibold text-base-900 \"\n                  >\n                    Powerful Functionality\n                  </Text>\n                </dt>\n              </div>\n              <dd>\n                <Text\n                  tag=\"p\"\n                  variant=\"textSM\"\n                  class=\"mt-2 font-medium text-base-500 \"\n                >\n                  Equipped with advanced features and tools, our solution\n                  effortlessly manages complex tasks and workflows.\n                </Text>\n              </dd>\n            </div>\n          </button>\n        </li>\n        <!-- Tab 3 -->\n        <li class=\"p-1 bg-base-50 rounded-xl\">\n          <button\n            @click.prevent=\"tab = 'tab3'\"\n            class=\"items-start h-full p-4 text-left bg-white rounded-lg shadow lg:p-8 transition \"\n            :class=\"{ 'bg-white shadow ' : tab === 'tab3' }\"\n          >\n            <div>\n              <div class=\"flex items-center gap-4\">\n                <ArrowIteration\n                  class=\"text-base-600 \"\n                  size=\"base\"\n                />\n                <dt>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textBase\"\n                    class=\"font-semibold text-base-900 \"\n                  >\n                    Revolutionizing communication\n                  </Text>\n                </dt>\n              </div>\n              <dd>\n                <Text\n                  tag=\"p\"\n                  variant=\"textSM\"\n                  class=\"mt-2 font-medium text-base-500 \"\n                >\n                  Unlocking innovative solutions that enhance connectivity and\n                  streamline interactions.\n                </Text>\n              </dd>\n            </div>\n          </button>\n        </li>\n        <!-- Tab 4 -->\n        <li class=\"p-1 bg-base-50 rounded-xl\">\n          <button\n            @click.prevent=\"tab = 'tab4'\"\n            class=\"items-start h-full p-4 text-left bg-white rounded-lg shadow lg:p-8 transition \"\n            :class=\"{ 'bg-white shadow ' : tab === 'tab4' }\"\n          >\n            <div>\n              <div class=\"flex items-center gap-4\">\n                <WaveSquare\n                  class=\"text-base-600 \"\n                  size=\"base\"\n                />\n                <dt>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textBase\"\n                    class=\"font-semibold text-base-900 \"\n                  >\n                    Easy Integration\n                  </Text>\n                </dt>\n              </div>\n              <dd>\n                <Text\n                  tag=\"p\"\n                  variant=\"textSM\"\n                  class=\"mt-2 font-medium text-base-500 \"\n                >\n                  Integrating with existing systems is smooth and hassle-free,\n                  thanks to our incredible flexible approach.\n                </Text>\n              </dd>\n            </div>\n          </button>\n        </li>\n        <!-- Tab 5 -->\n        <li class=\"p-1 bg-base-50 rounded-xl\">\n          <button\n            @click.prevent=\"tab = 'tab5'\"\n            class=\"items-start h-full p-4 text-left bg-white rounded-lg shadow lg:p-8 transition \"\n            :class=\"{ 'bg-white shadow ' : tab === 'tab5' }\"\n          >\n            <div>\n              <div class=\"flex items-center gap-4\">\n                <Cursor class=\"text-base-600 \" size=\"base\" />\n                <dt>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textBase\"\n                    class=\"font-semibold text-base-900 \"\n                  >\n                    Advanced Analytics\n                  </Text>\n                </dt>\n              </div>\n              <dd>\n                <Text\n                  tag=\"p\"\n                  variant=\"textSM\"\n                  class=\"mt-2 font-medium text-base-500 \"\n                >\n                  Gain deep insights into your data with our comprehensive\n                  analytics tools, helping you make informed decisions.\n                </Text>\n              </dd>\n            </div>\n          </button>\n        </li>\n      </ul>\n      <div class=\"p-8 text-left content\">\n        <!-- Tab 1 content -->\n        <div x-show=\"tab==='tab1'\">\n          <div class=\"block w-full mt-12\">\n            <img\n              alt=\"#_\"\n              class=\"relative object-cover w-full h-full rounded-2xl drop-shadow-2xl\"\n              src=\"/images/phone1.png\"\n            />\n          </div>\n        </div>\n        <!-- Tab 2 content. You can add a transition on this div to make it smoother -->\n        <div x-show=\"tab==='tab2'\" style=\"display: none;\">\n          <div class=\"block w-full mt-12\">\n            <img\n              alt=\"#_\"\n              class=\"relative object-cover w-full h-full rounded-2xl drop-shadow-2xl\"\n              src=\"/images/phone2.png\"\n            />\n          </div>\n        </div>\n        <!-- Tab 3 content. You can add a transition on this div to make it smoother -->\n        <div x-show=\"tab==='tab3'\" style=\"display: none;\">\n          <div class=\"block w-full mt-12\">\n            <img\n              alt=\"#_\"\n              class=\"relative object-cover w-full h-full rounded-2xl drop-shadow-2xl\"\n              src=\"/images/phone3.png\"\n            />\n          </div>\n        </div>\n        <!-- Tab 4 content. You can add a transition on this div to make it smoother -->\n        <div x-show=\"tab==='tab4'\" style=\"display: none;\">\n          <div class=\"block w-full mt-12\">\n            <img\n              alt=\"#_\"\n              class=\"relative object-cover w-full h-full rounded-2xl drop-shadow-2xl\"\n              src=\"/images/phone4.png\"\n            />\n          </div>\n        </div>\n        <!-- Tab 5 content. You can add a transition on this div to make it smoother -->\n        <div x-show=\"tab==='tab5'\" style=\"display: none;\">\n          <div class=\"block w-full mt-12\">\n            <img\n              alt=\"#_\"\n              class=\"relative object-cover w-full h-full rounded-2xl drop-shadow-2xl\"\n              src=\"/images/phone5.png\"\n            />\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
