{
  "name": "sign-in-05",
  "type": "component",
  "description": "Split screen login with quote",
  "category": "application",
  "section": "sign-in",
  "variant": 5,
  "aliases": [
    "sign in",
    "sign in 5",
    "sign in 05"
  ],
  "files": [
    {
      "name": "05.astro",
      "path": "oxbow/application/sign-in/05.astro",
      "content": "---\nexport const description = \"Split screen login with quote\";\n// Assets\nimport { Image } from \"astro:assets\";\nimport Placeholder from \"@/images/gradients/2.jpeg\";\n// Fundations\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Checkbox from \"@/components/fundations/inputs/Checkbox.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n// Icons\nimport AppleColor from \"@/components/fundations/icons/AppleColor.astro\";\nimport GoogleColor from \"@/components/fundations/icons/GoogleColor.astro\";\n---\n\n<div class=\"flex h-screen bg-white \">\n  <div\n    class=\"flex items-center justify-center w-full  lg:w-1/3\"\n  >\n    <div\n      class=\"w-full max-w-md p-8 py-24 lg:py-32\"\n    >\n      <div>\n        <a href=\"#_\">\n          <span class=\"sr-only\">Back to home</span>\n          <Logo class=\"h-12 text-base-900 \" aria-hidden=\"true\" /></a\n        >\n        <Text\n          tag=\"h1\"\n          variant=\"displayMD\"\n          class=\"mt-12 font-semibold tracking-tight text-base-900 \"\n        >\n          Sign in to Oxbow\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 text-base-500 text-balance\"\n        >\n          Welcome back. Enter your email and password like you haven’t forgotten\n          them for the 12th time this week.\n        </Text>\n      </div>\n      <form class=\"mt-10 space-y-4\">\n        <TextInput\n          id=\"email\"\n          name=\"email\"\n          label=\"Email Address\"\n          type=\"email\"\n          variant=\"default\"\n          size=\"base\"\n          placeholder=\"you@example.com\"\n        />\n        <TextInput\n          id=\"password\"\n          name=\"password\"\n          label=\"Password\"\n          type=\"password\"\n          passwordToggle={true}\n          size=\"base\"\n          placeholder=\"••••••••\"\n          required\n        />\n        <Checkbox\n          id=\"login-remember\"\n          name=\"login-remember\"\n          label=\"Remember me for 30 days\"\n          variant=\"default\"\n          size=\"base\"\n        />\n        <Button fullWidth variant=\"default\" size=\"base\">\n          Sign in with email\n        </Button>\n        <div class=\"relative\">\n          <div class=\"absolute inset-0 flex items-center\" aria-hidden=\"true\">\n            <div class=\"w-full border-t border-base-200 \">\n            </div>\n          </div>\n          <div class=\"relative flex justify-start\">\n            <span\n              class=\"pr-2 text-sm bg-white text-base-500 \"\n              >Or sign in with</span\n            >\n          </div>\n        </div>\n        <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n          <Button\n            variant=\"outline\"\n            size=\"base\"\n            gap=\"sm\"\n            fullWidth\n            class=\"flex items-center\"\n          >\n            <GoogleColor slot=\"left-icon\" class=\"size-4\" />\n            Google\n          </Button>\n          <Button\n            variant=\"outline\"\n            size=\"base\"\n            gap=\"sm\"\n            fullWidth\n            class=\"flex items-center\"\n          >\n            <AppleColor slot=\"left-icon\" class=\"size-4\" />\n            Apple\n          </Button>\n        </div>\n      </form>\n      <Text tag=\"p\" variant=\"textXS\" class=\"mt-4 font-medium text-base-500\">\n        Dont' have an account?\n        <a href=\"#_\" class=\"font-medium text-primary/88 hover:text-base-500\">\n          Sign up\n        </a>\n      </Text>\n    </div>\n  </div>\n  <div class=\"relative hidden overflow-hidden lg:block lg:w-2/3\">\n    <Image\n      width={1200}\n      height={1200}\n      src={Placeholder}\n      alt=\"Background\"\n      aria-hidden=\"true\"\n      class=\"object-cover object-center w-full h-full bg-base-50\"\n    />\n    <div\n      aria-hidden=\"true\"\n      class=\"absolute inset-0 pointer-events-none bg-base-800/80\"\n    >\n    </div>\n    <div class=\"absolute inset-0 flex flex-col items-start justify-end p-8\">\n      <div class=\"max-w-md\">\n        <Text\n          tag=\"p\"\n          variant=\"displaySM\"\n          class=\"font-semibold text-white text-shadow text-balance\"\n        >\n          Say goodbye to financial stress with yet another UI promising to fix\n          your life.\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 text-base-200 text-shadow text-balance\"\n        >\n          Because \"quickest and simplest\" totally worked last time, right?\n        </Text>\n      </div>\n    </div>\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
