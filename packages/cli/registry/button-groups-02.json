      "content": "---\n\nexport const description = \"Segmented filter\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<section class=\"flex items-center justify-center bg-white p-18 \">\n  <!-- copy:start -->\n  <div\n    class=\"inline-flex overflow-hidden rounded-lg ring-1 ring-inset ring-base-200 shadow-sm \"\n    role=\"radiogroup\"\n    aria-label=\"Billing cadence\"\n  >\n    <Button\n      variant=\"accent\"\n      size=\"sm\"\n      type=\"button\"\n      noRounded\n      class=\"transition-none\"\n      aria-checked=\"true\"\n      role=\"radio\"\n    >\n      Monthly\n    </Button>\n    <Button\n      variant=\"muted\"\n      size=\"sm\"\n      type=\"button\"\n      noRounded\n      class=\"transition-none\"\n      aria-checked=\"false\"\n      role=\"radio\"\n    >\n      Quarterly\n    </Button>\n    <Button\n      variant=\"muted\"\n      size=\"sm\"\n      type=\"button\"\n      noRounded\n      class=\"transition-none\"\n      aria-checked=\"false\"\n      role=\"radio\"\n    >\n      Yearly\n    </Button>\n  </div>\n  <!-- copy:end -->\n</section>\n"
