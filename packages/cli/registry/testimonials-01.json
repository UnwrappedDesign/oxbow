  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/marketing/testimonials/01.astro",
      "content": "---\nexport const freeComponent = true;\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst data = [\n  {\n    name: \"Fernando Monte\",\n    title: \"Creator of Oxbow UI.com\",\n    testimonial:\n      \"Oxbow helped us ship a secure, polished payments UI in weeks — their components saved us months of work.\",\n    imgSrc: \"/avatars/1.jpg\",\n  },\n  {\n    name: \"Juan Echanove\",\n    title: \"Founder of Pay Oneeer\",\n    testimonial:\n      \"The library is thoughtfully designed and easy to integrate. We saw immediate improvements in reliability and conversion.\",\n    imgSrc: \"/avatars/2.jpg\",\n  },\n];\n---\n\n<section class=\"bg-white \">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <ul role=\"list\" class=\"grid md:grid-cols-2 gap-8\">\n      {\n        data.map((member) => (\n          <>\n            <li>\n              <figure class=\"flex flex-col \">\n                <figcaption>\n                  <div class=\"flex items-center gap-4\">\n                    <img\n                      class=\"object-cover rounded-full size-10\"\n                      src={member.imgSrc}\n                      alt=\"#_\"\n                    />\n                    <div>\n                      <Text\n                        tag=\"h3\"\n                        variant=\"textBase\"\n                        class=\"font-semibold text-base-900 \"\n                      >\n                        {member.name}\n                      </Text>\n                      <Text\n                        tag=\"p\"\n                        variant=\"textSM\"\n                        class=\"font-medium text-base-600 \"\n                      >\n                        {member.title}\n                      </Text>\n                    </div>\n                  </div>\n                </figcaption>\n                <Text\n                  tag=\"blockquote\"\n                  variant=\"textLG\"\n                  class=\"mt-4 font-medium text-base-900 lg:text-balance\"\n                >\n                  {member.testimonial}\n                </Text>\n              </figure>\n            </li>\n          </>\n        ))\n      }\n    </ul>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
