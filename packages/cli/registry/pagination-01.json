{
  "name": "pagination-01",
  "type": "component",
  "description": "pagination block 01",
  "category": "application",
  "section": "pagination",
  "variant": 1,
  "aliases": [
    "pagination",
    "pagination 1",
    "pagination 01"
  ],
  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/application/pagination/01.astro",
      "content": "---\nexport const freeComponent = true;\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport ChevronLeft from \"@/components/fundations/icons/ChevronLeft.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\n---\n<div class=\"flex justify-center p-16 mx-auto bg-background\">\n  <!-- copy:start -->\n  <nav class=\"relative z-0\" aria-label=\"Pagination\">\n    <ol role=\"list\" class=\"inline-flex items-center gap-1.5\">\n      <!-- Previous -->\n      <li>\n        <Button\n          disabled\n          aria-label=\"Go to previous page\"\n          variant=\"muted\"\n          size=\"xs\"\n          iconOnly\n        >\n          <ChevronLeft slot=\"left-icon\" size=\"xs\" />\n          <span class=\"sr-only\">Previous</span>\n        </Button>\n      </li>\n      <!-- Page numbers -->\n      <li>\n        <Button\n          variant=\"text\"\n          size=\"xs\"\n          aria-current=\"page\"\n          aria-label=\"Page 1, current page\"\n        >\n          1\n        </Button>\n      </li>\n      <li>\n        <Button variant=\"text\" size=\"xs\" aria-label=\"Go to page 2\">\n          2\n        </Button>\n      </li>\n      <!-- Ellipsis -->\n      <li aria-hidden=\"true\" class=\"px-1 text-muted-foreground\">\n        …\n      </li>\n      <li>\n        <Button variant=\"text\" size=\"xs\" aria-label=\"Go to page 9\">\n          9\n        </Button>\n      </li>\n      <li>\n        <Button variant=\"text\" size=\"xs\" aria-label=\"Go to page 10\">\n          10\n        </Button>\n      </li>\n      <!-- Next -->\n      <li>\n        <Button aria-label=\"Go to next page\" variant=\"accent\" size=\"xs\" iconOnly>\n          <ChevronRight slot=\"left-icon\" size=\"xs\" />\n          <span class=\"sr-only\">Next</span>\n        </Button>\n      </li>\n    </ol>\n  </nav>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
