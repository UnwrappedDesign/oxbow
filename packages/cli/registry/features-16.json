      "name": "16.astro",
      "path": "oxbow/marketing/features/16.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\nconst listItems = [\n  \"Real-time analytics\",\n  \"Actionable insights\",\n  \"Proactive security\",\n  \"Unified integrations\",\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20 lg:text-balance\">\n    <div class=\"flex flex-col gap-24\">\n      <div class=\"items-center grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-24\">\n        <div>\n          <Text\n            tag=\"h2\"\n            variant=\"displayMD\"\n            class=\"font-semibold tracking-tight text-foreground text-balance\"\n          >\n            Unlock the power of data-driven insights\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Analyze key metrics instantly to guide strategic decisions and stay\n            ahead of the curve.\n          </Text>\n          <ul\n            class=\"mt-8 text-base font-medium text-foreground grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-2\"\n          >\n            {\n              listItems.map((item, index) => (\n                <li>\n                  <div class=\"relative flex flex-row items-center gap-2\">\n                    <CircleCheck\n                      class=\"text-foreground\"\n                      size=\"sm\"\n                      slot=\"icon\"\n                    />\n                    <Text tag=\"span\" variant=\"textSM\">\n                      {item}\n                    </Text>\n                  </div>\n                </li>\n              ))\n            }\n          </ul>\n        </div>\n        <div\n          class=\"p-6 pb-0 overflow-hidden md:order-first bg-background rounded-2xl\"\n        >\n          <img\n            alt=\"#_\"\n            class=\"shadow rounded-t-2xl size-full\"\n            src=\"/widgets/analytics.svg\"\n          />\n        </div>\n      </div>\n      <div\n        class=\"items-center grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-24 md:flex-row-reverse\"\n      >\n        <div>\n          <Text\n            tag=\"h2\"\n            variant=\"displayMD\"\n            class=\"font-semibold tracking-tight text-foreground text-balance\"\n          >\n            Automate and scale your workflows\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Streamline tasks with automated processes and robust integration\n            support.\n          </Text>\n          <ul\n            class=\"mt-8 text-base font-medium text-foreground grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-2\"\n          >\n            {\n              listItems.map((item) => (\n                <li>\n                  <div class=\"relative flex flex-row items-center gap-2\">\n                    <CircleCheck\n                      class=\"text-foreground\"\n                      size=\"sm\"\n                      slot=\"icon\"\n                    />\n                    <Text tag=\"span\" variant=\"textSM\">\n                      {item}\n                    </Text>\n                  </div>\n                </li>\n              ))\n            }\n          </ul>\n        </div>\n        <div\n          class=\"p-6 pb-0 overflow-hidden bg-muted/40 rounded-2xl\"\n        >\n          <img\n            alt=\"#_\"\n            class=\"shadow rounded-t-2xl size-full\"\n            src=\"/widgets/progressCircles.svg\"\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
