      "name": "01.astro",
      "path": "oxbow/application/checkboxes/01.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"Basic Checkbox with State Tracking\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2\"\n>\n  <!-- copy:start -->\n  <div class=\"flex items-center gap-2\" x-data=\"{ checked: false }\">\n    <input\n      id=\"basic-checkbox\"\n      name=\"basic-checkbox\"\n      type=\"checkbox\"\n      x-model=\"checked\"\n      class=\"text-foreground rounded shadow size-4 border-border focus:ring-border bg-background checked:bg-muted\"\n    />\n    <Text\n      for=\"basic-checkbox\"\n      tag=\"label\"\n      class=\"block text-sm text-muted-foreground\"\n    >\n      Basic checkbox (<span x-text=\"checked ? 'Checked' : 'Unchecked'\"></span>)\n    </Text>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
