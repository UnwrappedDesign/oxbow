      "path": "oxbow/application/breadcrumbs/03.astro",
      "content": "---\nexport const description = \"Breadcrumb with buttons\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\nimport Home from \"@/components/fundations/icons/Home.astro\";\n---\n<section\n  class=\"flex flex-wrap items-center justify-center h-full bg-white gap-2 p-18 \"\n>\n  <!-- copy:start -->\n  <nav aria-label=\"Breadcrumb\">\n    <ol role=\"list\" class=\"flex items-center space-x-2\">\n      <li>\n        <Button\n          variant=\"outline\"\n          gap=\"xs\"\n          size=\"xs\"\n          class=\"\"\n          href=\"#_\"\n        >\n          <Home size=\"sm\" slot=\"left-icon\" aria-hidden=\"true\" />\n          Home\n          <ChevronRight size=\"base\" slot=\"right-icon\" aria-hidden=\"true\" />\n        </Button>\n      </li>\n      <li>\n        <Button\n          variant=\"outline\"\n          gap=\"xs\"\n          size=\"xs\"\n          class=\"\"\n          href=\"#_\"\n        >\n          Work\n          <ChevronRight size=\"base\" slot=\"right-icon\" aria-hidden=\"true\" />\n        </Button>\n      </li>\n      <li>\n        <Button\n          variant=\"default\"\n          gap=\"xs\"\n          size=\"xs\"\n          aria-current=\"page\"\n        >\n          Details\n        </Button>\n      </li>\n    </ol>\n  </nav>\n  <!-- copy:end -->\n</section>\n"
    }
