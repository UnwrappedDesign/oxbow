    {
      "name": "06.astro",
      "path": "oxbow/marketing/stats/06.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst stats = [\n  {\n    label: \"Working Individuals\",\n    description: \"We reached over 30 million users and are growing fast.\",\n    value: \"30%\",\n  },\n  {\n    label: \"Super low fee\",\n    description:\n      \"Enjoy significant savings with our extremely low fee structure.\",\n    value: \"40%\",\n  },\n  {\n    label: \"Great Commitment\",\n    description: \" We’re dedicated to delivering outstanding service and valu.\",\n    value: \"50%\",\n  },\n  {\n    label: \"Massive Earnings\",\n    description: \"Reap the benefits with substantial returns \",\n    value: \"100%\",\n  },\n];\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"items-center grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-24\">\n      <div class=\"order-last grid gap-x-6 gap-y-12 sm:grid-cols-2\">\n        {\n          stats.map((stat) => (\n            <div>\n              <div class=\"flex flex-col items-baseline gap-4\">\n                <Text\n                  tag=\"h3\"\n                  variant=\"displayXL\"\n                  class=\"font-mono text-primary \"\n                >\n                  {stat.value}\n                </Text>\n                <Text\n                  tag=\"h3\"\n                  variant=\"textBase\"\n                  class=\"font-semibold  text-base-900 \"\n                >\n                  {stat.label}\n                </Text>\n              </div>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-base-500 \"\n              >\n                {stat.description}\n              </Text>\n            </div>\n          ))\n        }\n      </div>\n      <div class=\"order-first block w-full\">\n        <img\n          alt=\"#_\"\n          class=\"drop-shadow size-full aspect-square rounded-2xl\"\n          src=\"/pose/3.png\"\n        />\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
