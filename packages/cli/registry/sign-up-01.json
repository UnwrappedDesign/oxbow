{
  "name": "sign-up-01",
  "type": "component",
  "description": "simple Sign up block",
  "category": "application",
  "section": "sign-up",
  "variant": 1,
  "aliases": [
    "sign up",
    "sign up 1",
    "sign up 01"
  ],
  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/application/sign-up/01.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"simple Sign up block \";\n\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-md p-8 mx-auto bg-background rounded-xl\">\n      <div class=\"text-center\">\n        <Text\n          tag=\"h1\"\n          variant=\"displaySM\"\n          class=\"font-semibold tracking-tight text-foreground\"\n        >\n          Sign up, no nonsense\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-2 text-muted-foreground text-balance\"\n        >\n          Just your email and a password. That’s it. You’re in.\n        </Text>\n      </div>\n      <form class=\"mt-10 space-y-4\">\n        <TextInput\n          id=\"email\"\n          name=\"email\"\n          label=\"Email Address\"\n          type=\"email\"\n          variant=\"default\"\n          size=\"base\"\n          placeholder=\"you@example.com\"\n        />\n        <TextInput\n          id=\"password\"\n          name=\"password\"\n          label=\"Password\"\n          type=\"password\"\n          passwordToggle={true}\n          size=\"base\"\n          placeholder=\"••••••••\"\n          required\n        />\n        <Text\n          tag=\"p\"\n          variant=\"textXS\"\n          class=\"font-medium text-muted-foreground\"\n        >\n          By creating an account, you agree to our\n          <a\n            href=\"#_\"\n            class=\"font-medium text-foreground hover:text-muted-foreground\"\n          >\n            Terms of service\n          </a>\n          and\n          <a href=\"#_\" class=\"font-medium text-foreground hover:text-muted-foreground\">\n            Privacy Policy\n          </a>\n        </Text>\n        <Button fullWidth variant=\"default\" size=\"base\">\n          Create account\n        </Button>\n      </form>\n      <Text\n        tag=\"p\"\n        variant=\"textXS\"\n        class=\"mt-4 font-medium text-muted-foreground\"\n      >\n        Already have an account?\n        <a\n          href=\"#_\"\n          class=\"font-medium text-foreground hover:text-muted-foreground\"\n        >\n          Sign in\n        </a>\n      </Text>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
