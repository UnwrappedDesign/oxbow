      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-2xl lg:text-balance\">\n      <Text\n        tag=\"h2\"\n        variant=\"displayMD\"\n        class=\"font-semibold tracking-tight text-foreground lg:text-balance\"\n      >\n        Empower your finances with our unmatched value\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-2 font-medium text-muted-foreground\"\n      >\n        Experience low fees, unwavering commitment, and massive earnings with a\n        service trusted by over 60 million users.\n      </Text>\n    </div>\n    <div class=\"flex flex-wrap items-center mt-8 gap-2 lg:ml-auto\">\n      <Button variant=\"default\" size=\"sm\"> Get started </Button>\n      <Button variant=\"muted\" size=\"sm\"> Learn more </Button>\n    </div>\n    <div class=\"items-end grid grid-cols-1 md:grid-cols-3 gap-6\">\n      <div\n        class=\"flex flex-col justify-between shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl lg:gap-12\"\n      >\n        <div class=\"order-last w-full p-8 border-t border-border\">\n          <Text\n            tag=\"p\"\n            variant=\"display2XL\"\n            class=\"font-mono font-medium text-foreground\"\n          >\n            30%\n          </Text>\n        </div>\n        <div class=\"p-8 sm:shrink lg:flex-none\">\n          <Text tag=\"h3\" variant=\"textBase\" class=\"font-medium text-foreground\">\n            Working Individuals\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            We’re dedicated to delivering outstanding service and value.\n          </Text>\n        </div>\n      </div>\n      <div\n        class=\"flex flex-col justify-between shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl lg:gap-28\"\n      >\n        <div class=\"order-last w-full p-8 border-t border-border\">\n          <Text\n            tag=\"p\"\n            variant=\"display2XL\"\n            class=\"font-mono font-medium text-foreground\"\n          >\n            90%\n          </Text>\n        </div>\n        <div class=\"p-8 sm:shrink lg:flex-none\">\n          <Text tag=\"h3\" variant=\"textBase\" class=\"font-medium text-foreground\">\n            Massive Earnings\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Reap the benefits with substantial returns.\n          </Text>\n        </div>\n      </div>\n      <div\n        class=\"flex flex-col justify-between shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl lg:gap-44\"\n      >\n        <div class=\"order-last w-full p-8 border-t border-border\">\n          <Text\n            tag=\"p\"\n            variant=\"display2XL\"\n            class=\"font-mono font-medium text-foreground\"\n          >\n            8%\n          </Text>\n        </div>\n        <div class=\"p-8 sm:shrink lg:flex-none\">\n          <Text tag=\"h3\" variant=\"textBase\" class=\"font-medium text-foreground\">\n            Super low fee\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Enjoy significant savings with our extremely low fee structure.\n          </Text>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
