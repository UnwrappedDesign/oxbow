  "files": [
    {
      "name": "05.astro",
      "path": "oxbow/marketing/stats/05.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nconst stats = [\n  {\n    label: \"Working Individuals\",\n    description: \"We reached over 30 million users and are growing fast.\",\n    value: \"30%\",\n  },\n  {\n    label: \"Super low fee\",\n    description:\n      \"Enjoy significant savings with our extremely low fee structure.\",\n    value: \"40%\",\n  },\n  {\n    label: \"Great Commitment\",\n    description: \" We’re dedicated to delivering outstanding service and valu.\",\n    value: \"50%\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-2xl\">\n      <Kicker> By the Numbers </Kicker>\n      <Text\n        tag=\"h2\"\n        variant=\"displaySM\"\n        class=\"mt-4 font-semibold tracking-tight text-foreground lg:text-balance\"\n      >\n        Transform your finances with proven results\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-4 font-medium text-muted-foreground lg:text-balance\"\n      >\n        Our track record speaks volumes—millions of users, minimal fees, and\n        impressive returns.\n      </Text>\n    </div>\n    <div\n      class=\"mt-12 grid grid-cols-1 gap-x-2 gap-y-6 sm:grid-cols-2 lg:divide-x divide-border border-border lg:border-x md:grid-cols-3\"\n    >\n      {\n        stats.map((stat) => (\n          <div class=\"flex flex-col pl-8 pr-4\">\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"flex items-center font-semibold text-foreground gap-2\"\n            >\n              <span class=\"font-semibold text-foreground\">\n                {stat.value}\n              </span>\n              {stat.label}\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textBase\"\n              class=\"mt-4 font-medium text-muted-foreground\"\n            >\n              {stat.description}\n            </Text>\n          </div>\n        ))\n      }\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
