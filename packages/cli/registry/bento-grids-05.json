    {
      "name": "05.astro",
      "path": "oxbow/marketing/bento-grids/05.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\n\nconst data = [\n  { src: \"/integrations/1.svg\", alt: \"integration 1\" },\n  { src: \"/integrations/2.svg\", alt: \"integration 2\" },\n  { src: \"/integrations/3.svg\", alt: \"integration 3\" },\n  { src: \"/integrations/4.svg\", alt: \"integration 4\" },\n  { src: \"/integrations/5.svg\", alt: \"integration 5\" },\n  { src: \"/integrations/6.svg\", alt: \"integration 6\" },\n  { src: \"/integrations/7.svg\", alt: \"integration 7\" },\n  { src: \"/integrations/8.svg\", alt: \"integration 8\" },\n  { src: \"/integrations/9.svg\", alt: \"integration 9\" },\n  { src: \"/integrations/10.svg\", alt: \"integration 10\" },\n  { src: \"/integrations/11.svg\", alt: \"integration 11\" },\n  { src: \"/integrations/12.svg\", alt: \"integration 12\" },\n  { src: \"/integrations/13.svg\", alt: \"integration 13\" },\n  { src: \"/integrations/14.svg\", alt: \"integration 14\" },\n  { src: \"/integrations/15.svg\", alt: \"integration 15\" },\n  { src: \"/integrations/16.svg\", alt: \"integration 16\" },\n  { src: \"/integrations/17.svg\", alt: \"integration 17\" },\n  { src: \"/integrations/18.svg\", alt: \"integration 18\" },\n  { src: \"/integrations/19.svg\", alt: \"integration 19\" },\n  { src: \"/integrations/20.svg\", alt: \"integration 20\" },\n];\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"h-full grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4\">\n      <div\n        class=\"relative flex flex-col items-center justify-center p-8 overflow-hidden text-center shadow lg:py-20 bg-linear-180 outline outline-primary/24 from-primary/16 to-primary/24 rounded-xl md:col-span-2\"\n      >\n        <div class=\"relative items-center text-balance\">\n          <Text\n            tag=\"h3\"\n            variant=\"displayMD\"\n            class=\"font-semibold text-base-900 \"\n          >\n            Build, launch, and grow together\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-2 font-medium text-base-600 \"\n          >\n            Collaborate in real time, streamline your workflow, and accelerate\n            your team's success with our unified platform.\n          </Text>\n          <div\n            class=\"flex flex-wrap items-center justify-center mx-auto mt-8 gap-2\"\n          >\n            <Button variant=\"accent\" size=\"sm\"> Get started </Button>\n            <Button variant=\"muted\" size=\"sm\"> Learn more </Button>\n          </div>\n        </div>\n      </div>\n      <div\n        class=\"flex flex-col justify-between h-full shadow lg:col-span-1 bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n      >\n        <div class=\"w-full p-8\">\n          <Text\n            tag=\"span\"\n            variant=\"textBase\"\n            class=\"font-medium text-base-900 \"\n          >\n            Analytics\n          </Text>\n        </div>\n        <div class=\"p-8 border-t border-base-200 \">\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"font-medium text-base-900 \"\n          >\n            Insights at a glance\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-base-500 \"\n          >\n            Visualize your data instantly and make informed decisions with\n            clear, actionable reports.\n          </Text>\n        </div>\n      </div>\n      <div\n        class=\"relative flex flex-col justify-between h-full overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Scheduling </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Smart scheduling\n          </Text>\n          <Text tag=\"p\" variant=\"textSM\" class=\"mt-2 font-medium text-base-500\">\n            Automate your calendar and let our platform handle reminders, so you\n            can focus on what matters most.\n          </Text>\n        </div>\n        <div class=\"ml-8 -bottom-2 -right-8\">\n          <img\n            class=\"w-full h-full shadow rounded-tl-xl\"\n            src=\"/widgets/performance.svg\"\n            alt=\"\"\n          />\n        </div>\n      </div>\n      <div\n        class=\"relative flex flex-col justify-between h-full overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Workflows </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Custom workflows\n          </Text>\n          <Text tag=\"p\" variant=\"textSM\" class=\"mt-2 font-medium text-base-500\">\n            Design processes that fit your needs and adapt as your business\n            grows, all in one place.\n          </Text>\n        </div>\n        <div class=\"ml-8 -bottom-2 -right-8\">\n          <img\n            class=\"w-full h-full shadow rounded-tl-xl\"\n            src=\"/widgets/hits.svg\"\n            alt=\"\"\n          />\n        </div>\n      </div>\n      <div\n        class=\"relative flex flex-col justify-between h-full overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n      >\n        <div class=\"relative p-8\">\n          <Kicker> Automation </Kicker>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-base-900 \"\n          >\n            Seamless automation\n          </Text>\n          <Text tag=\"p\" variant=\"textSM\" class=\"mt-2 font-medium text-base-500\">\n            Let repetitive tasks run in the background while you focus on\n            creative and strategic work.\n          </Text>\n        </div>\n        <div class=\"ml-8 -bottom-2 -right-8\">\n          <img\n            class=\"w-full h-full shadow rounded-tl-xl\"\n            src=\"/widgets/traffic.svg\"\n            alt=\"\"\n          />\n        </div>\n      </div>\n      <div\n        class=\"flex flex-col items-center justify-center p-8 overflow-hidden text-center shadow bg-linear-180 outline outline-primary/24 from-primary/16 to-primary/24 rounded-xl md:col-span-2 lg:p-12\"\n      >\n        <div class=\"flex flex-col w-full max-w-6xl gap-8\">\n          {/* max-w-6xl to control the maximum width */}\n          {/* First row */}\n          <div class=\"flex items-center justify-center gap-12\">\n            {/* Changed justify-between to justify-center and added gap */}\n            {\n              data\n                .slice(0, 6)\n                .map((item) => (\n                  <img\n                    class=\"w-auto h-12 bg-white shadow lg:h-32 rounded-2xl\"\n                    alt={item.alt}\n                    src={item.src}\n                  />\n                ))\n            }\n          </div>\n          {/* Second row */}\n          <div class=\"flex items-center justify-center gap-12\">\n            {/* Added gap */}\n            {\n              data\n                .slice(6, 12)\n                .map((item) => (\n                  <img\n                    class=\"w-auto h-12 bg-white shadow lg:h-32 rounded-2xl\"\n                    alt={item.alt}\n                    src={item.src}\n                  />\n                ))\n            }\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
