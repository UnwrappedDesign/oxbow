  "files": [
    {
      "name": "06.astro",
      "path": "oxbow/application/toggles/06.astro",
      "content": "---\nexport const description = \"Toggle with Text Indicators\";\nexport const excludeFromObfuscation = [\n  \"w-1/2\",\n  \"translate-x-0\",\n  \"translate-x-full\",\n  \"text-foreground\",\n  \"text-muted-foreground\",\n  \"hover:text-foreground\",\n];\n---\n\n<div class=\"flex flex-col justify-center mx-auto bg-background p-14\">\n  <!-- copy:start -->\n\n  <div\n    class=\"flex flex-col items-center justify-center\"\n    x-data=\"{duration: 'monthly'}\"\n  >\n    <div\n      aria-labelledby=\"pricing-toggle\"\n      class=\"relative z-0 inline-flex justify-center w-full p-1 mx-auto mt-8 overflow-hidden bg-background shadow ring-1 ring-border ring-offset-2 ring-offset-background gap-4 lg:mx-0 rounded-md max-w-52\"\n    >\n      <!-- Sliding background -->\n      <div\n        class=\"absolute inset-0 bg-muted rounded-md transition-transform duration-200 ease-in-out\"\n        :class=\"duration === 'monthly' ? 'w-1/2 translate-x-0' : 'w-1/2 translate-x-full'\"\n      >\n      </div>\n\n      <!-- Monthly Pricing Button -->\n      <button\n        id=\"monthly-pricing-button\"\n        class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n        :class=\"duration === 'monthly' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'\"\n        @click=\"duration = 'monthly'\"\n        type=\"button\"\n        :aria-pressed=\"duration === 'monthly'\"\n      >\n        Monthly\n      </button>\n\n      <!-- Annual Pricing Button -->\n      <button\n        id=\"annual-pricing-button\"\n        class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n        :class=\"duration === 'annual' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground'\"\n        @click=\"duration = 'annual'\"\n        type=\"button\"\n        :aria-pressed=\"duration === 'annual'\"\n      >\n        Annual\n      </button>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
