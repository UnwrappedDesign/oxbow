  ],
  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/ecommerce/product-lists/01.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description =\n  \"Simple cards with description and price below image\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst products = [\n  {\n    image: \"/store/shoes/airforceblack/3.jpg\",\n    title: \"Nike Air Force 1´07 Fresh\",\n    price: \"$280.00\",\n    link: \"#_\",\n  },\n  {\n    image: \"/store/shoes/airforcewhite/2.png\",\n    title: \"Nike Air Force 1 LE\",\n    price: \"$140.00\",\n    link: \"#_\",\n  },\n  {\n    image: \"/store/shoes/airmax/3.png\",\n    title: \"Nike Air Max 90\",\n    price: \"120.00\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <div class=\"relative grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n      {\n        products.map((article) => (\n          <div class=\"relative flex flex-col justify-between gap-2\">\n            <div class=\"relative aspect-[4/3]\">\n              <img\n                src={article.image}\n                alt=\"#_\"\n                class=\"absolute inset-0 object-cover size-full rounded-2xl bg-muted\"\n              />\n            </div>\n            <div>\n              <div class=\"flex items-center justify-between w-full\">\n                <Text\n                  tag=\"h3\"\n                  variant=\"textSM\"\n                  class=\"font-medium text-foreground\"\n                >\n                  {article.title}\n                  <a href=\"#_\">\n                    <span class=\"absolute inset-0\" />\n                  </a>\n                </Text>\n                <Text\n                  tag=\"h3\"\n                  variant=\"textSM\"\n                  class=\"text-muted-foreground\"\n                >\n                  {article.price}\n                </Text>\n              </div>\n            </div>\n          </div>\n        ))\n      }\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
