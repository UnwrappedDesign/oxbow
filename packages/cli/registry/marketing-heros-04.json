  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/marketing/marketing-heros/04.astro",
      "content": "---\nexport const description = \"Simple with center text and image\";\nimport { Image } from \"astro:assets\";\nimport DashboardLight from \"@/images/assets/dashboardLight.svg\";\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nimport Wrapper from \"@/components/fundations/containers/Wrapper.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<div class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-xl mx-auto text-center lg:text-balance\">\n      <Kicker\n        showLink={true}\n        href=\"#_\"\n        linkText=\"See how it works\"\n        class=\"text-primary/88 \"\n      >\n        A better way to build together\n      </Kicker>\n      <Text\n        tag=\"h2\"\n        variant=\"displayMD\"\n        class=\"mt-12 font-semibold tracking-tight text-base-900 lg:text-balance\"\n      >\n        Teamwork that feels effortless\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textSM\"\n        class=\"mt-4 text-base-500 lg:text-balance\"\n      >\n        Launch projects, share ideas, and keep everyone in sync—without the\n        hassle. Oxbow makes collaboration simple and enjoyable.\n      </Text>\n\n      <div\n        class=\"flex flex-wrap items-center justify-center mx-auto mt-8 gap-2\"\n      >\n        <Button variant=\"accent\" size=\"sm\">Start for free</Button>\n        <Button variant=\"muted\" size=\"sm\">See features</Button>\n      </div>\n    </div>\n\n    <div\n      class=\"relative mt-12 overflow-hidden rounded-lg shadow outline outline-base-200\"\n    >\n      <Image\n        width={1200}\n        height={1200}\n        loading=\"eager\"\n        decoding=\"async\"\n        alt=\"dashboard\"\n        src={DashboardLight}\n        class=\"object-cover h-full\"\n      />\n    </div>\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
