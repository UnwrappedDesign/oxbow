  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/marketing/blog-entries/04.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nimport b1 from \"@/images/placeholders/b1.png\";\nimport b2 from \"@/images/placeholders/b2.png\";\nimport b3 from \"@/images/placeholders/b3.png\";\nimport b4 from \"@/images/placeholders/b4.png\";\nimport { Image } from \"astro:assets\";\nconst articles = [\n  {\n    image: b1,\n    title: \"How we run design reviews\",\n    description:\n      \"Our approach to design reviews: what works, what doesn’t, and how we keep feedback constructive.\",\n    author: \"Maya Patel\",\n    authorImage: \"/avatars/12.jpg\",\n    date: \"Wed Jan 31\",\n    link: \"#_\",\n  },\n  {\n    image: b2,\n    title: \"Lessons from our first product launch\",\n    description:\n      \"A candid look at what went right, what went wrong, and what we’ll do differently next time.\",\n    author: \"Lucas Moreau\",\n    authorImage: \"/avatars/11.jpg\",\n    date: \"Mon Feb 19\",\n    link: \"#_\",\n  },\n  {\n    image: b3,\n    title: \"Why we value asynchronous work\",\n    description:\n      \"How async communication helps our team stay focused, flexible, and productive across time zones.\",\n    author: \"Olivia Chen\",\n    authorImage: \"/avatars/9.jpg\",\n    date: \"Fri Mar 15\",\n    link: \"#_\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"items-center grid grid-cols-1 lg:grid-cols-3 gap-8\">\n      <div class=\"flex flex-col justify-center h-full lg:order-last\">\n        <div>\n          <Text\n            tag=\"h1\"\n            variant=\"displayMD\"\n            class=\"font-semibold tracking-tight text-foreground\"\n          >\n            How we work, ship, and grow\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Honest reflections and practical tips from our journey building\n            Oxbow as a distributed team.\n          </Text>\n          <Button variant=\"muted\" size=\"sm\" class=\"flex mt-8 w-fit\">\n            Read article\n          </Button>\n        </div>\n      </div>\n\n      <Image\n        width={570}\n        height={480}\n        src={b4}\n        alt=\"#_\"\n        class=\"object-cover object-center w-full rounded-xl aspect-5/3 lg:col-span-2\"\n      />\n    </div>\n    <div class=\"mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n      {\n        articles.map((article) => (\n          <article class=\"relative group\">\n            <div class=\"flex flex-col h-full\">\n              <a href=\"#_\" class=\"absolute inset-0 z-10\">\n                <span class=\"sr-only\">, {article.title}</span>\n              </a>\n              <Image\n                width={570}\n                height={480}\n                class=\"object-cover object-center w-full rounded-xl aspect-5/3 bg-background\"\n                src={article.image}\n                alt=\"#_\"\n              />\n              <div class=\"flex flex-col justify-between h-full mt-2\">\n                <div>\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textBase\"\n                    class=\"font-semibold group-hover:underline text-foreground duration-200\"\n                  >\n                    {article.title}\n                  </Text>\n                  <Text\n                    tag=\"p\"\n                    variant=\"textSM\"\n                    class=\"font-medium text-muted-foreground\"\n                  >\n                    {article.description}\n                  </Text>\n                </div>\n                <div class=\"relative flex items-center mt-4 gap-x-4\">\n                  <img\n                    src={article.authorImage}\n                    alt=\"#_\"\n                    class=\"object-cover rounded-full size-8 bg-background\"\n                  />\n                  <div>\n                    <Text\n                      tag=\"h3\"\n                      variant=\"textSM\"\n                      class=\"font-medium text-foreground\"\n                    >\n                      {article.author}\n                    </Text>\n                    <Kicker>\n                      <time datetime={article.date}>{article.date}</time>\n                    </Kicker>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </article>\n        ))\n      }\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
