      "path": "oxbow/application/toggles/01.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"Basic Toggle\";\n---\n\n<div\n  class=\"flex flex-col justify-center mx-auto bg-white p-14 \"\n>\n  <!-- copy:start -->\n  <div\n    class=\"flex flex-col items-center justify-center gap-2\"\n    x-data=\"{ enabled: false }\"\n  >\n    <label class=\"relative inline-flex items-center cursor-pointer\">\n      <input type=\"checkbox\" x-model=\"enabled\" class=\"sr-only peer\" />\n      <div\n        class=\"h-6 rounded-full w-11 bg-base-300 peer peer-checked:bg-primary\"\n      >\n      </div>\n      <div\n        class=\"w-5 h-5 bg-white rounded-full shadow absolute left-1 top-0.5 transition-transform peer-checked:translate-x-5\"\n      >\n      </div>\n    </label>\n    <span\n      class=\"text-sm font-medium text-base-500 \"\n      x-text=\"enabled ? 'Enabled' : 'Disabled'\"></span>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
