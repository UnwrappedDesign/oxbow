  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/marketing/gallery/04.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport { Image } from \"astro:assets\";\nimport g1 from \"@/images/gallery/1.png\";\nimport g2 from \"@/images/gallery/2.png\";\nimport g3 from \"@/images/gallery/3.png\";\nimport g4 from \"@/images/gallery/4.png\";\n---\n\n<div class=\"relative bg-white \">\n  <div class=\"lg:absolute lg:inset-0 lg:right-2/5\">\n    <div class=\"h-full grid grid-cols-1 lg:grid-cols-6 gap-4\">\n      <Image\n        width={500}\n        height={500}\n        class=\"object-cover object-top w-full h-64 bg-base-50 sm:h-80 lg:h-full lg:col-span-3\"\n        src={g1}\n        alt=\"#_\"\n      />\n      <div class=\"flex flex-col gap-4 lg:col-span-2\">\n        <Image\n          width={500}\n          height={500}\n          src={g2}\n          alt=\"#_\"\n          class=\"hidden object-cover size-full lg:block\"\n        />\n        <Image\n          width={500}\n          height={500}\n          src={g3}\n          alt=\"#_\"\n          class=\"hidden object-cover size-full lg:block\"\n        />\n        <Image\n          width={500}\n          height={500}\n          src={g4}\n          alt=\"#_\"\n          class=\"hidden object-cover size-full lg:block\"\n        />\n      </div>\n    </div>\n  </div>\n  <div\n    class=\"py-16 pb-24 sm:py-24 lg:mx-auto lg:grid lg:max-w-7xl lg:grid-cols-2 lg:py-96\"\n  >\n    <div class=\"px-8 lg:col-start-2 lg:pl-24\">\n      <div class=\"max-w-xl mx-auto lg:mx-0 lg:max-w-lg\">\n        <Text\n          variant=\"displayMD\"\n          tag=\"h2\"\n          class=\"font-semibold tracking-tight text-base-900 sm:text-balance\"\n        >\n          Moments in Motion\n        </Text>\n\n        <Text\n          variant=\"textSM\"\n          tag=\"p\"\n          class=\"mt-2 font-medium text-base-500 sm:text-balance\"\n        >\n          A small gallery of candid moments and quiet details — street scenes,\n          portraits, and found textures captured with an eye for light and\n          atmosphere.\n        </Text>\n\n        <Text\n          variant=\"textSM\"\n          tag=\"p\"\n          class=\"mt-4 text-base-600 \"\n        >\n          Highlights:\n        </Text>\n\n        <ul\n          class=\"mt-2 ml-4 list-disc text-base-600 space-y-1\"\n        >\n          <li>Raw street photography and candid moments</li>\n          <li>Portrait studies and fleeting expressions</li>\n          <li>Color, texture, and light-focused compositions</li>\n        </ul>\n\n        <Text\n          variant=\"textSM\"\n          tag=\"p\"\n          class=\"mt-4 italic text-base-500 \"\n        >\n          Pro tip: hover to reveal details, or open any image for a closer look.\n        </Text>\n\n        <Button variant=\"default\" size=\"sm\" class=\"mt-8\"> See gallery </Button>\n      </div>\n    </div>\n  </div>\n</div>\n"
    }
  ],
