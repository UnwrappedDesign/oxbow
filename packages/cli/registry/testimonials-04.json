  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/marketing/testimonials/04.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\n\nexport const excludeFromObfuscation = [\n  \"size-12\",\n  \"opacity-25\",\n  \"opacity-100\",\n  \"text-foreground\",\n];\n---\n\n<section class=\"bg-background\" x-data=\"{ testimonialActive: 1 }\">\n  <div class=\"px-8 py-24 mx-auto md:px-12 lg:px-24 max-w-7xl\">\n    <div class=\"relative flex flex-col h-full text-center\">\n      <div class=\"max-w-sm mx-auto\">\n        <div x-show.immediate=\"testimonialActive === 1\">\n          <div x-show.transition=\"testimonialActive == 1\">\n            <Text\n              tag=\"blockquote\"\n              variant=\"textXL\"\n              class=\"font-semibold text-foreground lg:text-balance\"\n            >\n              Working with Oxbow reduced our time-to-market and improved payment\n              reliability.\n            </Text>\n          </div>\n        </div>\n        <div x-show.immediate=\"testimonialActive === 2\" style=\"display: none;\">\n          <div x-show.transition=\"testimonialActive == 2\">\n            <Text\n              tag=\"blockquote\"\n              variant=\"textXL\"\n              class=\"font-semibold text-foreground lg:text-balance\"\n            >\n              The library’s design and docs saved our engineers hours every\n              sprint.\n            </Text>\n          </div>\n        </div>\n        <div x-show.immediate=\"testimonialActive === 3\" style=\"display: none;\">\n          <div x-show.transition=\"testimonialActive == 3\">\n            <Text\n              tag=\"blockquote\"\n              variant=\"textXL\"\n              class=\"font-semibold text-foreground lg:text-balance\"\n            >\n              We shipped polished pages faster thanks to sensible defaults and\n              examples.\n            </Text>\n          </div>\n        </div>\n      </div>\n      <div class=\"flex flex-col pt-8 lg:items-center gap-4\">\n        <div class=\"flex flex-row items-center justify-center\">\n          <button\n            @click.prevent=\"testimonialActive = 1\"\n            class=\"inline-block mx-2 font-bold text-center text-foreground rounded-full opacity-100 shadow-xs focus:outline-none focus:ring-2 ring-2 ring-border ring-offset-background\"\n            :class=\"{'size-12 opacity-25 ': testimonialActive != 1, 'opacity-100 text-foreground': == 1 }\"\n          >\n            <img\n              class=\"inline-block object-cover rounded-full size-12\"\n              src=\"/avatars/1.jpg\"\n              alt=\"#\"\n            />\n          </button>\n          <button\n            @click.prevent=\"testimonialActive = 2\"\n            class=\"inline-block mx-2 font-bold text-center rounded-full opacity-25 shadow-xs focus:outline-none focus:ring-2 ring-2 ring-border ring-offset-background size-12\"\n            :class=\"{'size-12 opacity-25 ': testimonialActive != 2, 'opacity-100 == 2 }\"\n          >\n            <img\n              class=\"inline-block object-cover rounded-full size-12\"\n              src=\"/avatars/2.jpg\"\n              alt=\"@dqmonn on twitter\"\n            />\n          </button>\n          <button\n            @click.prevent=\"testimonialActive = 3\"\n            class=\"inline-block mx-2 font-bold text-center rounded-full opacity-25 shadow-xs focus:outline-none focus:ring-2 ring-2 ring-border ring-offset-background size-12\"\n            :class=\"{'size-12 opacity-25 ': testimonialActive != 3, 'opacity-100 text-foreground': == 3 }\"\n          >\n            <img\n              class=\"inline-block object-cover rounded-full size-12\"\n              src=\"/avatars/3.jpg\"\n              alt=\"#_\"\n            />\n          </button>\n        </div>\n        <div>\n          <div x-show=\"testimonialActive == 1\">\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-foreground\"\n            >\n              Michael Andreuzza\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textXS\"\n              class=\"font-medium text-muted-foreground\"\n            >\n              Founder\n            </Text>\n          </div>\n          <div x-show=\"testimonialActive == 2\" style=\"display: none;\">\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-foreground\"\n            >\n              Jonny Mnemonic\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textXS\"\n              class=\"font-medium text-muted-foreground\"\n            >\n              Designer\n            </Text>\n          </div>\n          <div x-show=\"testimonialActive == 3\" style=\"display: none;\">\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-foreground\"\n            >\n              Anna Svenblad\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textXS\"\n              class=\"font-medium text-muted-foreground\"\n            >\n              Writer\n            </Text>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
