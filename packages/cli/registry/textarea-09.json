  "files": [
    {
      "name": "09.astro",
      "path": "oxbow/application/textarea/09.astro",
      "content": "---\nexport const description = \"Textarea with character limit countdown\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-background\">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"w-full space-y-1\" x-data=\"{ text: '', maxLength: 100 }\">\n      <Text\n        for=\"countdown-textarea\"\n        tag=\"label\"\n        variant=\"textSM\"\n        class=\"font-medium text-muted-foreground\"\n      >\n        Character countdown\n      </Text>\n      <textarea\n        id=\"countdown-textarea\"\n        x-model=\"text\"\n        :maxlength=\"maxLength\"\n        rows=\"4\"\n        placeholder=\"Type your message\"\n        class=\"block w-full px-4 py-2 text-sm text-foreground bg-background border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n      ></textarea>\n      <div class=\"mt-2 text-sm text-muted-foreground\">\n        <span x-text=\"maxLength - text.length\"></span> characters remaining\n      </div>\n    </div>\n    <!-- copy:end -->\n </div>\n</div>\n"
    }
  ],
