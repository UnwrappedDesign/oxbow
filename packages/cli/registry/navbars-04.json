      "path": "oxbow/application/navbars/04.astro",
      "content": "---\nexport const freeComponent = true;\nexport const excludeFromObfuscation = [\"flex\", \"hidden\"];\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport Burger from \"@/components/fundations/icons/Burger.astro\";\nimport Logo from \"@/components/assets/Logo.astro\";\n---\n\n<!-- copy:start -->\n<header\n  class=\"w-full bg-background border-b border-border\"\n>\n  <div\n    x-data=\"{ open:false }\"\n    class=\"px-6 mx-auto max-w-screen-xl md:px-10 lg:px-16\"\n  >\n    <div class=\"flex items-center justify-between h-16 md:grid md:grid-cols-3\">\n      <div class=\"items-center hidden md:flex gap-4\">\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground hover:text-foreground\"\n          >Products</Text\n        >\n\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground hover:text-foreground\"\n          >Solutions</Text\n        >\n      </div>\n      <div class=\"flex items-center justify-center\">\n        <a href=\"#_\" class=\"inline-flex items-center gap-2\"\n          ><Logo class=\"text-foreground h-7\" /><span class=\"sr-only\"\n            >Home</span\n          ></a\n        >\n      </div>\n      <div class=\"flex items-center justify-end gap-3\">\n        <div class=\"items-center hidden md:flex gap-3\">\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textSM\"\n            class=\"font-medium text-muted-foreground hover:text-foreground\"\n            >Pricing</Text\n          >\n\n          <Text\n            tag=\"a\"\n            href=\"#_\"\n            variant=\"textSM\"\n            class=\"font-medium text-muted-foreground hover:text-foreground\"\n            >Docs</Text\n          >\n          <Button variant=\"default\" size=\"xs\">Get started</Button>\n        </div>\n        <IconButton\n          class=\"md:hidden\"\n          @click=\"open=!open\"\n          :aria-expanded=\"open\"\n          aria-controls=\"nav-04m\"\n          variant=\"muted\"\n          size=\"xs\"\n        >\n          <Burger size=\"xs\" slot=\"icon\" />\n        </IconButton>\n      </div>\n    </div>\n    <div\n      id=\"nav-04m\"\n      x-cloak\n      x-show=\"open\"\n      class=\"pb-4 md:hidden grid grid-cols-1 gap-2\"\n    >\n      <Button variant=\"muted\" size=\"xs\">Products</Button>\n      <Button variant=\"muted\" size=\"xs\">Solutions</Button>\n      <Button variant=\"muted\" size=\"xs\">Pricing</Button>\n      <Button variant=\"muted\" size=\"xs\">Docs</Button>\n      <Button variant=\"default\" size=\"xs\">Get started</Button>\n    </div>\n  </div>\n</header>\n<!-- copy:end -->\n"
    }
