  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/marketing/features/03.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\n// Updated feature sections\nconst data = [\n  {\n    category: \"Intuitive UI\",\n    text: \"Navigate a clean, modern interface that streamlines every interaction.\",\n    items: [\"User-focused design\", \"Accessible navigation\"],\n  },\n  {\n    category: \"Robust Features\",\n    text: \"Leverage powerful tools designed for peak performance and scalability.\",\n    items: [\"Efficient processes\", \"Advanced analytics\"],\n  },\n  {\n    category: \"Seamless Integration\",\n    text: \"Connect effortlessly with your existing workflows and systems.\",\n    items: [\"API connectivity\", \"Modular architecture\"],\n  },\n];\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"items-center grid grid-cols-1 lg:grid-cols-3 gap-12\">\n      <div class=\"lg:order-last\">\n        <Text\n          tag=\"h2\"\n          variant=\"displayMD\"\n          class=\"font-semibold tracking-tight text-base-900 text-balance\"\n        >\n          Transform your workflow\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 font-medium text-base-500 \"\n        >\n          Empower your team with intuitive, high-performance tools.\n        </Text>\n        <div class=\"flex flex-wrap items-center mx-auto mt-8 gap-2\">\n          <Button variant=\"default\" size=\"sm\">Get started now</Button>\n          <Button variant=\"muted\" size=\"sm\">Discover more</Button>\n        </div>\n      </div>\n      <div class=\"lg:col-span-2\">\n        <div class=\"relative h-full\">\n          <img\n            class=\"object-cover h-full shadow rounded-2xl\"\n            src=\"/images/dashboardLight.svg\"\n            alt=\"#_\"\n          />\n        </div>\n      </div>\n    </div>\n    <div\n      class=\"mt-12 gap-x-2 gap-y-14 lg:gap-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\"\n    >\n      {\n        data.map((section) => (\n          <div>\n            <div>\n              <Text\n                variant=\"textBase\"\n                tag=\"h3\"\n                class=\"font-semibold  text-base-900 \"\n              >\n                {section.category}\n              </Text>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-base-500 \"\n              >\n                {section.text}\n              </Text>\n            </div>\n            <ul\n              role=\"list\"\n              class=\"mt-6 text-base font-medium space-y-1 text-base-900 \"\n            >\n              {section.items.map((item) => (\n                <li>\n                  <div class=\"flex items-center  gap-4\">\n                    <CircleCheck\n                      class=\"text-primary \"\n                      size=\"sm\"\n                      slot=\"icon\"\n                    />\n                    <Text tag=\"span\" variant=\"textSM\">\n                      {item}\n                    </Text>\n                  </div>\n                </li>\n              ))}\n            </ul>\n          </div>\n        ))\n      }\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
