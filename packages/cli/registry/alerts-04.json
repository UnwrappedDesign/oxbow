      "path": "oxbow/application/alerts/04.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport AlertTriangle from \"@/components/fundations/icons/AlertTriangle.astro\";\n---\n\n<div class=\"flex items-center justify-center p-8 bg-background\">\n  <!-- copy:start -->\n  <div\n    role=\"alert\"\n    class=\"relative w-full p-8 border border-destructive/20 rounded-xl bg-destructive/20 border-destructive\"\n  >\n    <div class=\"flex flex-col sm:flex-row gap-2\">\n      <div class=\"flex-shrink-0\">\n        <AlertTriangle size=\"base\" slot=\"icon\" class=\"text-destructive\" />\n      </div>\n      <div>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"font-medium text-foreground\"\n        >\n          Warning! rose, time for a giggle Break!!\n        </Text>\n\n        <ul role=\"list\">\n          <li class=\"list-disc space-y-1\">\n            <Text tag=\"p\" variant=\"textSM\" class=\"font-medium text-destructive\">\n              Your password must be at least 8 characters, because even\n              passwords need a little length to protect their secrets.\n            </Text>\n          </li>\n          <li class=\"list-disc space-y-1\">\n            <Text tag=\"p\" variant=\"textSM\" class=\"font-medium text-destructive\">\n              Your password must include at least one pro wrestling finishing\n              move, so you can 'pin' down your security like a champ\n            </Text>\n          </li>\n        </ul>\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
