      "content": "---\nexport const description = \"Address input group\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n---\n\n<section class=\"justify-center h-full bg-background gap-2 p-14\">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"grid grid-cols-2\">\n      <TextInput\n        id=\"city\"\n        name=\"city\"\n        label=\"City\"\n        placeholder=\"San Francisco\"\n        noRoundedRight\n        isGrouped\n      />\n      <TextInput\n        id=\"zip\"\n        name=\"zip\"\n        label=\"ZIP Code\"\n        placeholder=\"94110\"\n        noRoundedLeft\n        isGrouped\n      />\n    </div>\n    <!-- copy:end -->\n  </div>\n</section>\n"
    }
