{
  "name": "textarea-13",
  "type": "component",
  "description": "Textarea with Auto-Save",
  "category": "application",
  "section": "textarea",
  "variant": 13,
  "aliases": [
    "textarea",
    "textarea 13"
  ],
  "files": [
    {
      "name": "13.astro",
      "path": "oxbow/application/textarea/13.astro",
      "content": "---\nexport const description = \"Textarea with Auto-Save\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-white \">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div\n      class=\"w-full space-y-1\"\n      x-data=\"{ text: '', saved: false }\"\n      x-init=\"\n        let timeout;\n        $watch('text', () => {\n          clearTimeout(timeout);\n          saved = false;\n          timeout = setTimeout(() => saved = true, 2000);\n        });\n      \"\n    >\n      <Text\n        for=\"autosave-textarea\"\n        tag=\"label\"\n        variant=\"textSM\"\n        class=\"font-medium text-base-500 \"\n      >\n        Auto-save textarea\n      </Text>\n      <textarea\n        id=\"autosave-textarea\"\n        x-model=\"text\"\n        rows=\"4\"\n        placeholder=\"Type your message\"\n        class=\"block w-full px-4 py-2 text-sm text-primary/88 bg-white border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n      ></textarea>\n      <div\n        class=\"mt-2 text-sm text-base-500 \"\n        x-text=\"saved ? 'Saved!' : 'Saving...'\"\n      >\n      </div>\n    </div>\n    <!-- copy:end -->\n </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
