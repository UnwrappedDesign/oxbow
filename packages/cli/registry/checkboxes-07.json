      "path": "oxbow/application/checkboxes/07.astro",
      "content": "---\nexport const description = \"Dependent Checkbox (Prerequisite)\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full p-24 bg-background gap-2\"\n>\n  <!-- copy:start -->\n  <div\n    class=\"flex flex-col w-full max-w-md gap-2\"\n    x-data=\"{ agreed: false, marketing: false }\"\n  >\n    <div class=\"flex items-start gap-3\">\n      <input\n        id=\"dep-agree\"\n        name=\"dep-agree\"\n        type=\"checkbox\"\n        x-model=\"agreed\"\n        class=\"text-foreground rounded shadow size-4 border-border focus:ring-border bg-background checked:bg-muted\"\n      />\n      <Text\n        for=\"dep-agree\"\n        tag=\"label\"\n        class=\"block text-sm text-muted-foreground\"\n      >\n        I agree to data processing\n      </Text>\n    </div>\n    <div class=\"flex items-start pl-6 gap-3\">\n      <input\n        id=\"dep-marketing\"\n        name=\"dep-marketing\"\n        type=\"checkbox\"\n        x-model=\"marketing\"\n        :disabled=\"!agreed\"\n        class=\"text-foreground rounded shadow size-4 border-border focus:ring-border disabled:opacity-50 disabled:cursor-not-allowed bg-background checked:bg-muted\"\n      />\n      <div>\n        <Text\n          for=\"dep-marketing\"\n          tag=\"label\"\n          class=\"block text-sm text-muted-foreground\"\n        >\n          Receive marketing emails <span\n            class=\"text-muted-foreground\">(Optional)</span\n          >\n        </Text>\n        <p class=\"text-xs text-muted-foreground\">\n          Requires consent above.\n        </p>\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
