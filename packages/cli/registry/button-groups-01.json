  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/application/button-groups/01.astro",
      "content": "---\n\nexport const description = \"Counter group (− value +)\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Minus from \"@/components/fundations/icons/Minus.astro\";\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\n---\n\n<section class=\"flex items-center justify-center bg-background p-18\">\n  <!-- copy:start -->\n  <div\n    class=\"inline-flex items-stretch overflow-hidden rounded-md border border-border bg-background text-sm shadow-sm\"\n    x-data=\"{ n: 235 }\"\n    role=\"group\"\n    aria-label=\"Adjust quantity\"\n  >\n    <Button\n      variant=\"muted\"\n      size=\"sm\"\n      iconOnly\n      type=\"button\"\n      noRounded\n      class=\"border-r border-border text-muted-foreground transition-none\"\n      @click=\"n = Math.max(0, n - 1)\"\n      aria-label=\"Decrease\"\n    >\n      <Minus slot=\"left-icon\" size=\"sm\" />\n    </Button>\n    <span class=\"flex items-center px-5 font-semibold text-foreground\" x-text=\"n\"></span>\n    <Button\n      variant=\"accent\"\n      size=\"sm\"\n      iconOnly\n      type=\"button\"\n      noRounded\n      class=\"border-l border-border transition-none\"\n      @click=\"n = n + 1\"\n      aria-label=\"Increase\"\n    >\n      <Plus slot=\"left-icon\" size=\"sm\" />\n    </Button>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
