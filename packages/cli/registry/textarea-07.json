      "name": "07.astro",
      "path": "oxbow/application/textarea/07.astro",
      "content": "---\nexport const description = \"Expandable textarea\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div\n  class=\"flex flex-col justify-center p-10 mx-auto bg-background\"\n>\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"w-full space-y-1\" x-data=\"{ text: '', rows: 2 }\">\n      <Text\n        for=\"expandable-textarea\"\n        tag=\"label\"\n        variant=\"textSM\"\n        class=\"font-medium text-muted-foreground\"\n      >\n        Expandable textarea\n      </Text>\n      <textarea\n        id=\"expandable-textarea\"\n        x-model=\"text\"\n        :rows=\"rows\"\n        placeholder=\"Type more to expand\"\n        class=\"block w-full px-4 py-2 text-sm text-foreground bg-background border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n        @input=\"rows = Math.min(10, Math.floor((text.length / 20) + 2))\"\n      ></textarea>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
  ],
