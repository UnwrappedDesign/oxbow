  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/application/checkboxes/03.astro",
      "content": "---\nexport const description = \"Required Consent with Validation\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full p-24 bg-white gap-2 \"\n>\n  <!-- copy:start -->\n  <form\n    x-data=\"{ accepted: false, submitted: false }\"\n    @submit.prevent=\"submitted = true; if (!accepted) return;\"\n    class=\"flex flex-col w-full max-w-md gap-2\"\n  >\n    <div class=\"flex items-start gap-3\">\n      <input\n        id=\"consent-required\"\n        name=\"consent-required\"\n        type=\"checkbox\"\n        x-model=\"accepted\"\n        :aria-invalid=\"submitted && !accepted\"\n        aria-describedby=\"consent-required-error\"\n        class=\"text-primary rounded shadow size-4 border-base-300 focus:ring-primary \"\n      />\n      <div>\n        <Text\n          for=\"consent-required\"\n          tag=\"label\"\n          class=\"block text-sm text-base-600 \"\n        >\n          I agree to the Terms and Privacy Policy\n        </Text>\n        <p\n          id=\"consent-required-error\"\n          x-show=\"submitted && !accepted\"\n          class=\"mt-1 text-xs text-destructive \"\n          role=\"alert\"\n        >\n          You must accept to continue.\n        </p>\n      </div>\n    </div>\n    <div class=\"flex gap-2\">\n      <button\n        type=\"submit\"\n        :disabled=\"!accepted\"\n        class=\"px-3 py-1.5 text-sm rounded bg-primary text-white disabled:opacity-50 disabled:cursor-not-allowed\"\n      >\n        Continue\n      </button>\n      <span class=\"self-center text-xs text-base-500 \">\n        Status: <span x-text=\"accepted ? 'Ready' : 'Needs consent'\"></span>\n      </span>\n    </div>\n  </form>\n  <!-- copy:end -->\n</section>\n"
    }
  ],
