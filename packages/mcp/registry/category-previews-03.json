{
  "name": "category-previews-03",
  "type": "component",
  "description": "Simple cards with description and link below image",
  "category": "ecommerce",
  "section": "category-previews",
  "variant": 3,
  "aliases": [
    "category previews",
    "category previews 3",
    "category previews 03",
    "category preview",
    "category preview 3",
    "category preview 03"
  ],
  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/ecommerce/category-previews/03.astro",
      "content": "---\nexport const description = \"Simple cards with description and link below image\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst products = [\n  {\n    image: \"/store/shoes/airmax/1.png\",\n    title: \"Trainers\",\n  },\n  {\n    image: \"/store/jackets/1.png\",\n    title: \"Hoodies\",\n    link: \"#_\",\n  },\n  {\n    image: \"/store/backpacks/1.jpeg\",\n    title: \"Backpacks\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <div class=\"relative grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n      {\n        products.map((article) => (\n          <div>\n            <div class=\"relative\">\n              <div class=\"relative aspect-[8/10] w-full overflow-hidden rounded-lg\">\n                <img\n                  src={article.image}\n                  alt=\"#_\"\n                  class=\"object-cover size-full\"\n                />\n              </div>\n              <div class=\"relative mt-2\">\n                <div class=\"flex items-center justify-between w-full\">\n                  <Text\n                    tag=\"h3\"\n                    variant=\"textSM\"\n                    class=\"font-medium text-foreground\"\n                  >\n                    {article.title}\n                  </Text>\n                </div>\n                <div\n                  class=\"flex items-center gap-1\"\n                >\n                  <Text\n                    href=\"#_\"\n                    tag=\"a\"\n                    variant=\"textSM\"\n                    class=\"text-muted-foreground\"\n                  >\n                    Shop now\n                  </Text>\n                </div>\n              </div>\n            </div>\n          </div>\n        ))\n      }\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
