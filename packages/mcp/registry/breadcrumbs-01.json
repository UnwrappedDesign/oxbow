      "path": "oxbow/application/breadcrumbs/01.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"Basic  breadcrumbs\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Home from \"@/components/fundations/icons/Home.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full bg-white gap-2 p-18 \"\n>\n  <!-- copy:start -->\n  <nav aria-label=\"Breadcrumb\">\n    <ol role=\"list\" class=\"flex items-center space-x-2\">\n      <li>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXS\"\n          class=\"flex items-center font-medium gap-2 text-base-500 hover:text-primary \"\n          aria-label=\"Home\"\n        >\n          <Home size=\"sm\" aria-hidden=\"true\" />\n          <span class=\"sr-only\">Home</span>\n        </Text>\n      </li>\n      <li>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXS\"\n          class=\"flex items-center font-medium gap-2 text-base-500 hover:text-primary \"\n        >\n          Home\n          <ChevronRight size=\"base\" aria-hidden=\"true\" />\n        </Text>\n      </li>\n      <li>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXS\"\n          class=\"flex items-center font-medium gap-2 text-base-500 hover:text-primary \"\n        >\n          Work\n          <ChevronRight size=\"base\" aria-hidden=\"true\" />\n        </Text>\n      </li>\n      <li>\n        <Text\n          tag=\"span\"\n          variant=\"textXS\"\n          aria-current=\"page\"\n          class=\"flex items-center font-medium gap-2 text-base-900 \"\n        >\n          Details\n        </Text>\n      </li>\n    </ol>\n  </nav>\n  <!-- copy:end -->\n</section>\n"
    }
