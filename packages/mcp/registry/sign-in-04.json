{
  "name": "sign-in-04",
  "type": "component",
  "description": "Split screen sign in with customers.",
  "category": "application",
  "section": "sign-in",
  "variant": 4,
  "aliases": [
    "sign in",
    "sign in 4",
    "sign in 04"
  ],
  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/application/sign-in/04.astro",
      "content": "---\nexport const description = \"Split screen sign in with customers.\";\n\n// Assets\nimport { Image } from \"astro:assets\";\nimport Placeholder from \"@/images/gradients/1.jpeg\";\nimport One from \"@/images/brandsLight/1.svg\";\nimport Two from \"@/images/brandsLight/2.svg\";\nimport Three from \"@/images/brandsLight/3.svg\";\nimport Four from \"@/images/brandsLight/4.svg\";\n// Fundations\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Checkbox from \"@/components/fundations/inputs/Checkbox.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n// Icons\nimport GoogleColor from \"@/components/fundations/icons/GoogleColor.astro\";\nconst logos = [\n  {\n    src: One,\n    width: 158,\n    height: 48,\n  },\n  {\n    src: Two,\n    width: 158,\n    height: 48,\n  },\n  {\n    src: Three,\n    width: 158,\n    height: 48,\n  },\n  {\n    src: Four,\n    width: 158,\n    height: 48,\n  },\n];\n---\n\n<div class=\"flex h-screen bg-white  \">\n  <div\n    class=\"flex items-center justify-center w-full  lg:w-2/3\"\n  >\n    <div\n      class=\"w-full max-w-md p-8 py-24 lg:py-32 \"\n    >\n      <div>\n        <Text\n          tag=\"h1\"\n          variant=\"displayMD\"\n          class=\"font-medium tracking-tight text-base-900 \"\n        >\n          Sign in\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 text-base-500 text-balance\"\n        >\n          Welcome back. Enter your email and password like you haven’t forgotten\n          them for the 12th time this week.\n        </Text>\n      </div>\n      <form class=\"mt-10 space-y-4\">\n        <TextInput\n          id=\"email\"\n          name=\"email\"\n          label=\"Email Address\"\n          type=\"email\"\n          variant=\"default\"\n          size=\"base\"\n          placeholder=\"you@example.com\"\n        />\n        <TextInput\n          id=\"password\"\n          name=\"password\"\n          label=\"Password\"\n          type=\"password\"\n          passwordToggle={true}\n          size=\"base\"\n          placeholder=\"••••••••\"\n          required\n        />\n        <Checkbox\n          id=\"login-remember\"\n          name=\"login-remember\"\n          label=\"Remember me for 30 days\"\n          variant=\"default\"\n          size=\"base\"\n        />\n        <Button fullWidth variant=\"default\" size=\"base\">\n          Sign in with email\n        </Button>\n        <Button\n          variant=\"outline\"\n          size=\"base\"\n          gap=\"sm\"\n          class=\"flex items-center w-full\"\n        >\n          <GoogleColor slot=\"left-icon\" class=\"size-4\" />\n          Sign in with Google\n        </Button>\n      </form>\n      <Text tag=\"p\" variant=\"textXS\" class=\"mt-4 font-medium text-base-500\">\n        Dont' have an account?\n        <a href=\"#_\" class=\"font-medium text-primary/88 hover:text-base-500\">\n          Sign up\n        </a>\n      </Text>\n    </div>\n  </div>\n  <div class=\"relative hidden overflow-hidden lg:block lg:w-1/3 lg:order-first\">\n    <Image\n      width={1200}\n      height={1200}\n      src={Placeholder}\n      alt=\"Background\"\n      aria-hidden=\"true\"\n      class=\"object-cover object-center w-full h-full bg-base-50 grayscale\"\n    />\n    <div\n      aria-hidden=\"true\"\n      class=\"absolute inset-0 pointer-events-none bg-base-800/80\"\n    >\n    </div>\n    <div class=\"absolute inset-0 flex flex-col items-start justify-between p-8\">\n      <div>\n        <a href=\"#_\">\n          <span class=\"sr-only\">Back to home</span>\n          <Logo class=\"h-12 mx-auto text-white md:mx-0\" aria-hidden=\"true\" /></a\n        >\n        <Text\n          tag=\"p\"\n          variant=\"textXL\"\n          class=\"mt-12 font-medium text-white text-shadow-sm\"\n        >\n          Ready when you are. <br /> Let’s get you logged in.\n        </Text>\n      </div>\n      <div class=\"flex items-center justify-center w-full gap-8\">\n        {\n          logos.map((logo) => (\n            <Image\n              class=\"max-h-3 \"\n              src={logo.src}\n              alt=\"#_\"\n              width={logo.width}\n              height={logo.height}\n            />\n          ))\n        }\n      </div>\n    </div>\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
