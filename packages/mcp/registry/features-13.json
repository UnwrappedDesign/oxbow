      "path": "oxbow/marketing/features/13.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\n\nexport const excludeFromObfuscation = [\"bg-background\", \"shadow\"];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div\n      x-data=\"{ tab: 'tab1' }\"\n      class=\"relative items-center grid grid-cols-1 gap-4 lg:grid-cols-3\"\n    >\n      <ul class=\"list-none grid md:grid-cols-2 gap-4 lg:col-span-2\">\n        <!-- Tab 1 -->\n        <li class=\"p-1 bg-background rounded-xl\">\n          <button\n            @click.prevent=\"tab = 'tab1'\"\n            class=\"items-start h-full p-4 text-left bg-background rounded-lg shadow lg:p-8 transition shadow-muted/15\"\n            :class=\"{ 'bg-background shadow ' : tab === 'tab1' }\"\n          >\n            <div>\n              <div class=\"flex items-center gap-2\">\n                <CircleCheck\n                  class=\"text-muted-foreground\"\n                  size=\"sm\"\n                  slot=\"icon\"\n                />\n                <Text\n                  tag=\"h3\"\n                  variant=\"textBase\"\n                  class=\"font-semibold text-foreground\"\n                >\n                  Innovative Design\n                </Text>\n              </div>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-muted-foreground\"\n              >\n                Our cutting-edge design offers a fresh, modern look that\n                transforms your project into a standout experience.\n              </Text>\n            </div>\n          </button>\n        </li>\n        <!-- Tab 2 -->\n        <li class=\"p-1 bg-background rounded-xl\">\n          <button\n            @click.prevent=\"tab = 'tab2'\"\n            class=\"items-start h-full p-4 text-left bg-background rounded-lg shadow lg:p-8 transition shadow-muted/15\"\n            :class=\"{ 'bg-background shadow ' : tab === 'tab2' }\"\n          >\n            <div>\n              <div class=\"flex items-center gap-2\">\n                <CircleCheck\n                  class=\"text-muted-foreground\"\n                  size=\"sm\"\n                  slot=\"icon\"\n                />\n                <Text\n                  tag=\"h3\"\n                  variant=\"textBase\"\n                  class=\"font-semibold text-foreground\"\n                >\n                  Powerful Functionality\n                </Text>\n              </div>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-muted-foreground\"\n              >\n                Equipped with advanced features and tools, our solution\n                effortlessly manages complex tasks and workflows.\n              </Text>\n            </div>\n          </button>\n        </li>\n        <!-- Tab 3 -->\n        <li class=\"p-1 bg-background rounded-xl\">\n          <button\n            @click.prevent=\"tab = 'tab3'\"\n            class=\"items-start h-full p-4 text-left bg-background rounded-lg shadow lg:p-8 transition shadow-muted/15\"\n            :class=\"{ 'bg-background shadow ' : tab === 'tab3' }\"\n          >\n            <div>\n              <div class=\"flex items-center gap-2\">\n                <CircleCheck\n                  class=\"text-muted-foreground\"\n                  size=\"sm\"\n                  slot=\"icon\"\n                />\n                <Text\n                  tag=\"h3\"\n                  variant=\"textBase\"\n                  class=\"font-semibold text-foreground\"\n                >\n                  Po Easy Integration\n                </Text>\n              </div>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-muted-foreground\"\n              >\n                Integrating with existing systems is smooth and hassle-free,\n                thanks to our incredible flexible approach.\n              </Text>\n            </div>\n          </button>\n        </li>\n        <!-- Tab 4 -->\n        <li class=\"p-1 bg-background rounded-xl\">\n          <button\n            @click.prevent=\"tab = 'tab4'\"\n            class=\"items-start h-full p-4 text-left bg-background rounded-lg shadow lg:p-8 transition shadow-muted/15\"\n            :class=\"{ 'bg-background shadow' : tab === 'tab4' }\"\n          >\n            <div>\n              <div class=\"flex items-center gap-2\">\n                <CircleCheck\n                  class=\"text-muted-foreground\"\n                  size=\"sm\"\n                  slot=\"icon\"\n                />\n                <Text\n                  tag=\"h3\"\n                  variant=\"textBase\"\n                  class=\"font-semibold text-foreground\"\n                >\n                  Great Communication\n                </Text>\n              </div>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-muted-foreground\"\n              >\n                Integrating with existing systems is smooth and hassle-free,\n                thanks to our incredible flexible approach.\n              </Text>\n            </div>\n          </button>\n        </li>\n      </ul>\n      <div class=\"text-left content size-full\">\n        <!-- Tab 1 content -->\n        <div class=\"size-full\" x-show=\"tab==='tab1'\">\n          <div\n            class=\"block w-full h-full p-8 pb-0 aspect-square lg:mt-0 bg-background rounded-3xl\"\n          >\n            <img\n              alt=\"#_\"\n              class=\"object-cover object-top size-full\"\n              src=\"/images/phone4.png\"\n            />\n          </div>\n        </div>\n        <!-- Tab 2 content -->\n        <div class=\"size-full\" x-show=\"tab==='tab2'\" style=\"display: none;\">\n          <div\n            class=\"block w-full h-full p-8 pb-0 aspect-square lg:mt-0 bg-background rounded-3xl\"\n          >\n            <img\n              alt=\"#_\"\n              class=\"object-cover object-top size-full\"\n              src=\"/images/phone2.png\"\n            />\n          </div>\n        </div>\n        <!-- Tab 3 content -->\n        <div class=\"size-full\" x-show=\"tab==='tab3'\" style=\"display: none;\">\n          <div\n            class=\"block w-full h-full p-8 pb-0 aspect-square lg:mt-0 bg-background rounded-3xl\"\n          >\n            <img\n              alt=\"#_\"\n              class=\"object-cover object-top size-full\"\n              src=\"/images/phone3.png\"\n            />\n          </div>\n        </div>\n        <!-- Tab 4 content -->\n        <div class=\"size-full\" x-show=\"tab==='tab4'\" style=\"display: none;\">\n          <div\n            class=\"block w-full h-full p-8 pb-0 aspect-square lg:mt-0 bg-background rounded-3xl\"\n          >\n            <img\n              alt=\"#_\"\n              class=\"object-cover object-top size-full\"\n              src=\"/images/phone5.png\"\n            />\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
