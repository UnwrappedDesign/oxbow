      "name": "06.astro",
      "path": "oxbow/application/breadcrumbs/06.astro",
      "content": "---\nexport const description = \"Breadcrumb With Select Crumb\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Select from \"@/components/fundations/inputs/Select.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\n---\n\n<section\n  class=\"flex items-center justify-center bg-white p-18 \"\n>\n  <!-- copy:start -->\n  <nav\n    aria-label=\"Breadcrumb\"\n    x-data=\"{ section:'Guides' }\"\n    class=\"max-w-xl mx-auto\"\n  >\n    <ol\n      class=\"flex items-center text-sm gap-1 text-base-600 \"\n    >\n      <li>\n        <Text variant=\"textSM\" tag=\"a\" href=\"#_\" class=\"hover:text-primary\"\n          >Home</Text\n        >\n      </li>\n      <ChevronRight size=\"base\" class=\"text-base-400\" />\n      <li>\n        <Text variant=\"textSM\" tag=\"a\" href=\"#_\" class=\"hover:text-primary\"\n          >Docs</Text\n        >\n      </li>\n      <ChevronRight size=\"base\" class=\"text-base-400\" />\n      <li class=\"w-40\">\n        <Select\n          id=\"crumb-select\"\n          name=\"crumb-select\"\n          size=\"xs\"\n          xModel=\"section\"\n        >\n          <option>API</option>\n          <option selected>Guides</option>\n          <option>Tutorials</option>\n        </Select>\n      </li>\n    </ol>\n  </nav>\n  <!-- copy:end -->\n</section>\n"
    }
