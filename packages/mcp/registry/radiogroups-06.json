      "path": "oxbow/application/radiogroups/06.astro",
      "content": "---\nexport const description = \"Radio Button Group with Tool Selection\";\n---\n\n<div class=\"flex justify-center p-16 mx-auto bg-white \">\n  <!-- copy:start -->\n  <div class=\"grid grid-cols-2 gap-2\" x-data=\"{ selectedTool: 'pen' }\">\n    <div\n      class=\"flex items-center p-4 border rounded-lg gap-3 border-base-200 \"\n    >\n      <input\n        id=\"radio-pen\"\n        name=\"tool-selection\"\n        type=\"radio\"\n        value=\"pen\"\n        x-model=\"selectedTool\"\n        class=\"text-primary bg-white border rounded-full shadow size-4 border-base-300 focus:ring-primary/88 \"\n      />\n      <label for=\"radio-pen\" class=\"block text-sm font-medium text-base-500\">\n        Pen\n      </label>\n    </div>\n    <div\n      class=\"flex items-center p-4 border rounded-lg gap-3 border-base-200 \"\n    >\n      <input\n        id=\"radio-marker\"\n        name=\"tool-selection\"\n        type=\"radio\"\n        value=\"marker\"\n        x-model=\"selectedTool\"\n        class=\"text-primary bg-white border rounded-full shadow size-4 border-base-300 focus:ring-primary/88 \"\n      />\n      <label for=\"radio-marker\" class=\"block text-sm font-medium text-base-500\">\n        Marker\n      </label>\n    </div>\n    <div\n      class=\"flex items-center p-4 border rounded-lg gap-3 border-base-200 \"\n    >\n      <input\n        id=\"radio-highlighter\"\n        name=\"tool-selection\"\n        type=\"radio\"\n        value=\"highlighter\"\n        x-model=\"selectedTool\"\n        class=\"text-primary bg-white border rounded-full shadow size-4 border-base-300 focus:ring-primary/88 \"\n      />\n      <label\n        for=\"radio-highlighter\"\n        class=\"block text-sm font-medium text-base-500\"\n      >\n        Highlighter\n      </label>\n    </div>\n    <div\n      class=\"flex items-center p-4 border rounded-lg gap-3 border-base-200 \"\n    >\n      <input\n        id=\"radio-eraser\"\n        name=\"tool-selection\"\n        type=\"radio\"\n        value=\"eraser\"\n        x-model=\"selectedTool\"\n        class=\"text-primary bg-white border rounded-full shadow size-4 border-base-300 focus:ring-primary/88 \"\n      />\n      <label for=\"radio-eraser\" class=\"block text-sm font-medium text-base-500\">\n        Eraser\n      </label>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
