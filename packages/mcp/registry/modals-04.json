  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/application/modals/04.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"opacity-0\",\n  \"opacity-100\",\n  \"translate-y-4\",\n  \"sm:translate-y-0\",\n  \"sm:scale-95\",\n];\nimport LibraryPhoto from \"@/components/fundations/icons/LibraryPhoto.astro\";\nimport MapPin from \"@/components/fundations/icons/MapPin.astro\";\nimport CircleInfo from \"@/components/fundations/icons/CircleInfo.astro\";\nimport X from \"@/components/fundations/icons/X.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\n---\n\n<div\n  class=\"p-8 pb-250 pt-20 bg-white flex items-center justify-center\"\n>\n  <!-- Copy:start -->\n  <!--\n// Make sure to change  \"open: false\",  to  open: true. On the z-data=\"{}\".\n-->\n  <div\n    class=\"w-full max-w-3xl\"\n    x-data=\"{\n      open:true,\n      drag:false,\n      submitting:false,\n      form:{\n        name:'',\n        website:'',\n        logo:'',\n        slug:'',\n        industry:'SaaS',\n        size:'1–10',\n        hq:'',\n        tags:[],\n        tagInput:'',\n        description:'',\n      },\n      show(){ this.reset(); this.open = true; this.$nextTick(()=> this.$refs.name?.focus()); },\n      reset(){ this.form={ name:'', website:'', logo:'', slug:'', industry:'SaaS', size:'1–10', hq:'', tags:[], tagInput:'', description:'' }; this.drag=false; this.submitting=false; },\n      close(){ if(this.submitting) return; this.open=false; },\n      urlOk(v){ try { const u=new URL(v.startsWith('http')?v:`https://${v}`); return !!u.host; } catch { return false; } },\n      slugOk(v){ return /^[a-z0-9]([a-z0-9-]{1,28})[a-z0-9]$/.test(v||''); },\n      valid(){ return this.form.name && this.urlOk(this.form.website) && this.slugOk(this.form.slug) && this.form.description.trim().length>0; },\n      addTag(){ const v=(this.form.tagInput||'').trim().toLowerCase(); if(!v) return; if(this.form.tags.length>=10) return; if(!this.form.tags.includes(v)) this.form.tags.push(v); this.form.tagInput=''; },\n      rmTag(i){ this.form.tags.splice(i,1); },\n      pick(e){ const f=e.target?.files?.[0]; if(f) this.readLogo(f); },\n      drop(e){ e.preventDefault(); const f=e.dataTransfer?.files?.[0]; if(f) this.readLogo(f); this.drag=false; },\n      readLogo(file){ try{ this.form.logo=URL.createObjectURL(file);}catch{} },\n      submit(){ if(!this.valid()) return; this.submitting=true; setTimeout(()=>{ window.dispatchEvent(new CustomEvent('org:create',{ detail:{ ...this.form } })); this.submitting=false; this.open=false; },700); }\n    }\"\n  >\n    <Button\n      variant=\"default\"\n      size=\"sm\"\n      type=\"button\"\n      class=\"mx-auto\"\n      @click=\"show()\">Add organization</Button\n    >\n    <!-- Backdrop -->\n    <div\n      x-show=\"open\"\n      x-transition.opacity\n      class=\"fixed inset-0 z-40 bg-black/40 \"\n      aria-hidden=\"true\"\n      @click=\"close()\"\n    >\n    </div>\n    <!-- Dialog -->\n    <div\n      x-show=\"open\"\n      x-transition:enter=\"transition ease-out duration-200\"\n      x-transition:enter-start=\"opacity-0\"\n      x-transition:enter-end=\"opacity-100\"\n      x-transition:leave=\"transition ease-in duration-150\"\n      x-transition:leave-start=\"opacity-100\"\n      x-transition:leave-end=\"opacity-0\"\n      class=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"org-title\"\n      @keydown.escape.window.prevent=\"close()\"\n    >\n      <div\n        x-show=\"open\"\n        @click.outside=\"close()\"\n        x-transition:enter=\"transition ease-out duration-200\"\n        x-transition:enter-start=\"translate-y-4 sm:translate-y-0 sm:scale-95\"\n        x-transition:enter-end=\"translate-y-0 sm:scale-100\"\n        x-transition:leave=\"transition ease-in duration-150\"\n        x-transition:leave-start=\"opacity-100\"\n        x-transition:leave-end=\"opacity-0\"\n        class=\"w-full sm:max-w-3xl rounded-2xl bg-white shadow-xl outline outline-1 outline-black/5 \"\n      >\n        <!-- Header -->\n        <div\n          class=\"flex items-center justify-between px-6 py-4 border-b border-base-100 \"\n        >\n          <div class=\"flex items-start gap-2\">\n            <div\n              class=\"size-9 rounded-lg grid place-items-center bg-base-100 text-base-700 \"\n            >\n              <CircleInfo size=\"sm\" />\n            </div>\n            <div>\n              <Text\n                tag=\"h2\"\n                variant=\"textSM\"\n                id=\"org-title\"\n                class=\"font-semibold text-base-900 \"\n              >\n                Create an organization\n              </Text>\n              <Text\n                tag=\"p\"\n                variant=\"textXS\"\n                class=\"text-base-600 \"\n              >\n                Set a name, logo, and public profile. Takes under 5 minutes.\n              </Text>\n            </div>\n          </div>\n          <IconButton\n            variant=\"text\"\n            size=\"xxs\"\n            aria-label=\"Close\"\n            @click=\"close()\"><X size=\"sm\" /></IconButton\n          >\n        </div>\n        <!-- Content -->\n        <div class=\"px-6 py-5 space-y-5\">\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <!-- Company name -->\n            <div>\n              <label\n                class=\"block text-xs font-medium text-base-700 \"\n                >Organization name*</label\n              >\n              <input\n                x-ref=\"name\"\n                x-model=\"form.name\"\n                type=\"text\"\n                placeholder=\"e.g. Northwind\"\n                class=\"mt-1 block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              />\n            </div>\n            <!-- Website -->\n            <div>\n              <label\n                class=\"block text-xs font-medium text-base-700 \"\n                >Website URL*</label\n              >\n              <input\n                x-model=\"form.website\"\n                type=\"text\"\n                placeholder=\"www.example.com\"\n                class=\"mt-1 block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              />\n            </div>\n            <!-- Logo dropzone spans two cols -->\n            <div class=\"md:col-span-2\">\n              <label class=\"sr-only\">Logo*</label>\n              <div class=\"mt-1 grid grid-cols-[96px_1fr] gap-3 items-start\">\n                <div\n                  class=\"size-24 rounded-xl overflow-hidden ring-1 ring-base-200 bg-base-100 grid place-items-center\"\n                >\n                  <img\n                    x-show=\"form.logo\"\n                    :src=\"form.logo\"\n                    alt=\"Logo\"\n                    class=\"size-full object-cover\"\n                  />\n                  <div x-show=\"!form.logo\" class=\"text-base-400\">\n                    <LibraryPhoto size=\"base\" />\n                  </div>\n                </div>\n                <div>\n                  <label class=\"sr-only\">Profile image</label>\n                  <div\n                    @dragover.prevent\n                    @dragenter.prevent=\"drag=true\"\n                    @dragleave.prevent=\"drag=false\"\n                    @drop=\"drop($event)\"\n                    :class=\"drag ? 'ring-2 ring-primary/88 bg-primary/6 ' : 'ring-1 ring-base-200 '\"\n                    class=\"rounded-xl p-4 bg-white text-center\"\n                  >\n                    <LibraryPhoto\n                      size=\"sm\"\n                      class=\"text-base-500 mx-auto mb-1\"\n                    />\n                    <label\n                      class=\"text-xs\n                      text-primary\n                      cursor-pointer font-medium\"\n                    >\n                      <input\n                        type=\"file\"\n                        class=\"sr-only\"\n                        accept=\"image/*\"\n                        @change=\"pick($event)\"\n                      />Click to upload\n                    </label>\n                    <span class=\"text-xs text-base-500 font-medium\">\n                      or drag & drop</span\n                    >\n                    <div class=\"mt-1 text-[0.70rem] text-base-500 font-medium\">\n                      SVG, PNG, JPG, GIF (max 800×400px)\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <!-- Slug -->\n            <div>\n              <label\n                class=\"block text-xs font-medium text-base-700 \"\n                >Public URL*</label\n              >\n              <div\n                class=\"mt-1 grid grid-cols-[minmax(120px,180px)_1fr] items-center\"\n              >\n                <div\n                  class=\"block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg rounded-r-none appearance-none bg-base-50 text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n                >\n                  example.com/org/\n                </div>\n                <input\n                  x-model=\"form.slug\"\n                  type=\"text\"\n                  placeholder=\"acme\"\n                  class=\"block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg rounded-l-none appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n                />\n              </div>\n              <p\n                class=\"mt-1 text-[0.70rem]\"\n                :class=\"slugOk(form.slug)?'text-success ':'text-destructive '\"\n                x-text=\"slugOk(form.slug) ? 'Looks good' : 'Use 3–30 lowercase letters or dashes' \"\n              >\n              </p>\n            </div>\n            <!-- Industry -->\n            <div>\n              <label\n                class=\"block text-xs font-medium text-base-700 \"\n                >Industry</label\n              >\n              <select\n                x-model=\"form.industry\"\n                class=\"mt-1 block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              >\n                <option>SaaS</option>\n                <option>E‑commerce</option>\n                <option>Marketplace</option>\n                <option>Agency/Services</option>\n                <option>Open Source</option>\n              </select>\n            </div>\n            <!-- Size -->\n            <div>\n              <label\n                class=\"block text-xs font-medium text-base-700 \"\n                >Team size</label\n              >\n              <select\n                x-model=\"form.size\"\n                class=\"mt-1 block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              >\n                <option>1–10</option>\n                <option>11–50</option>\n                <option>51–200</option>\n                <option>200+</option>\n              </select>\n            </div>\n            <!-- HQ -->\n            <div class=\"md:col-span-2\">\n              <label\n                class=\"block text-xs font-medium text-base-700 \"\n                >Headquarters</label\n              >\n              <div class=\"mt-1 flex items-center gap-2\">\n                <div class=\"text-base-500 \">\n                  <MapPin size=\"sm\" />\n                </div>\n                <input\n                  x-model=\"form.hq\"\n                  type=\"text\"\n                  placeholder=\"City, Country\"\n                  class=\"flex-1 mt-1 block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n                />\n              </div>\n            </div>\n            <!-- Tags -->\n            <div class=\"md:col-span-2\">\n              <label\n                class=\"block text-xs font-medium text-base-700 \"\n                >Keywords (1–10)</label\n              >\n              <div class=\"mt-1 flex items-end gap-2\">\n                <input\n                  x-model=\"form.tagInput\"\n                  @keydown.enter.prevent=\"addTag()\"\n                  type=\"text\"\n                  placeholder=\"e.g. b2b, saas, marketplace\"\n                  class=\"flex-1 mt-1 block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n                />\n                <Button\n                  variant=\"outline\"\n                  size=\"base\"\n                  type=\"button\"\n                  :disabled=\"!form.tagInput\"\n                  @click=\"addTag()\">Add</Button\n                >\n              </div>\n              <div class=\"mt-2 flex flex-wrap gap-2\">\n                <template x-for=\"(t,i) in form.tags\" :key=\"t\">\n                  <span\n                    class=\"inline-flex items-center gap-1 text-xs px-2 py-1 rounded-full bg-base-100 text-base-700 \"\n                  >\n                    <span x-text=\"t\"></span>\n                    <button\n                      type=\"button\"\n                      class=\"text-base-500 hover:text-base-700 \"\n                      @click=\"rmTag(i)\">×</button\n                    >\n                  </span>\n                </template>\n              </div>\n            </div>\n            <!-- Description -->\n            <div class=\"md:col-span-2\">\n              <label\n                class=\"block text-xs font-medium text-base-700 \"\n                >About the organization*</label\n              >\n              <textarea\n                x-model=\"form.description\"\n                rows=\"4\"\n                placeholder=\"What do you build? Who do you help?\"\n                class=\"mt-1 block w-full px-4 py-2 text-xs bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              ></textarea>\n            </div>\n          </div>\n        </div>\n        <!-- Footer -->\n        <div\n          class=\"px-6 py-4 border-t border-base-100 flex items-center gap-3\"\n        >\n          <label\n            class=\"inline-flex items-center gap-2 text-sm text-base-500 text-xs\"\n          >\n            <input\n              type=\"checkbox\"\n              class=\"rounded border-base-300 text-primary focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 shadow size-4\"\n              x-model=\"form.dontShow\"\n            />\n            Don’t show again\n          </label>\n          <div class=\"ml-auto flex items-center gap-2\">\n            <Button\n              variant=\"outline\"\n              size=\"xxs\"\n              type=\"button\"\n              @click=\"close()\"\n              :disabled=\"submitting\">Cancel</Button\n            >\n            <Button\n              variant=\"accent\"\n              size=\"xxs\"\n              type=\"button\"\n              @click=\"submit()\"\n              :disabled=\"!valid() || submitting\">Create organization</Button\n            >\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <!-- Copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
