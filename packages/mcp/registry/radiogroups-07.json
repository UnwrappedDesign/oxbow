      "name": "07.astro",
      "path": "oxbow/application/radiogroups/07.astro",
      "content": "---\nexport const description = \"Radio Button Group for Payment Methods\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div class=\"flex justify-center p-16 mx-auto bg-white \">\n  <!-- copy:start -->\n  <div class=\"w-full max-w-sm mx-auto\">\n    <div\n      class=\"flex flex-col w-full gap-2\"\n      x-data=\"{ paymentMethod: 'credit-card' }\"\n    >\n      <div\n        class=\"flex items-center p-4 border rounded-lg gap-3 border-base-200 \"\n      >\n        <input\n          id=\"radio-credit-card\"\n          name=\"payment-method\"\n          type=\"radio\"\n          value=\"credit-card\"\n          x-model=\"paymentMethod\"\n          class=\"text-primary bg-white rounded-full shadow size-4 border-base-300 focus:ring-primary \"\n        />\n        <label\n          for=\"radio-credit-card\"\n          class=\"block text-sm font-medium text-base-500\"\n        >\n          Credit Card\n        </label>\n      </div>\n      <div\n        class=\"flex items-center p-4 border rounded-lg gap-3 border-base-200 \"\n      >\n        <input\n          id=\"radio-debit-card\"\n          name=\"payment-method\"\n          type=\"radio\"\n          value=\"debit-card\"\n          x-model=\"paymentMethod\"\n          class=\"text-primary bg-white rounded-full shadow size-4 border-base-300 focus:ring-primary \"\n        />\n        <label\n          for=\"radio-debit-card\"\n          class=\"block text-sm font-medium text-base-500\"\n        >\n          Debit Card\n        </label>\n      </div>\n      <div\n        class=\"flex items-center p-4 border rounded-lg gap-3 border-base-200 \"\n      >\n        <input\n          id=\"radio-wallet\"\n          name=\"payment-method\"\n          type=\"radio\"\n          value=\"wallet\"\n          x-model=\"paymentMethod\"\n          class=\"text-primary bg-white rounded-full shadow size-4 border-base-300 focus:ring-primary \"\n        />\n        <label\n          for=\"radio-wallet\"\n          class=\"block text-sm font-medium text-base-500\"\n        >\n          Wallet\n        </label>\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
