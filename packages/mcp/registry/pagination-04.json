  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/application/pagination/04.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport ChevronLeft from \"@/components/fundations/icons/ChevronLeft.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\n---\n\n<section>\n  <div class=\"flex justify-center p-16 mx-auto bg-white \">\n    <!-- copy:start -->\n    <nav\n      class=\"flex items-center justify-center w-full px-4 sm:px-0 gap-4\"\n      aria-label=\"Pagination\"\n    >\n      <!-- Mobile Previous -->\n      <Button\n        gap=\"xs\"\n        size=\"xs\"\n        variant=\"outline\"\n        class=\"md:hidden\"\n        aria-label=\"Go to previous page\"\n      >\n        <ChevronLeft size=\"sm\" slot=\"icon\" slot=\"left-icon\" />\n        Previous\n      </Button>\n\n      <!-- Desktop Pagination -->\n      <div class=\"hidden md:-mt-px md:flex\">\n        <a\n          href=\"#_\"\n          class=\"inline-flex items-center px-4 pb-4 text-sm font-medium border-b-2 border-transparent text-base-500 hover:border-base-300 hover:text-base-600 \"\n          aria-label=\"Go to page 1\"\n        >\n          1\n        </a>\n        <a\n          href=\"#_\"\n          class=\"inline-flex items-center px-4 pb-4 text-sm font-medium border-b-2 border-base-600 text-base-600 \"\n          aria-current=\"page\"\n          aria-label=\"Page 2, current page\"\n        >\n          2\n        </a>\n        <a\n          href=\"#_\"\n          class=\"inline-flex items-center px-4 pb-4 text-sm font-medium border-b-2 border-transparent text-base-500 hover:border-base-300 hover:text-base-600 \"\n          aria-label=\"Go to page 3\"\n        >\n          3\n        </a>\n        <span\n          class=\"inline-flex items-center px-4 pb-4 text-sm font-medium border-b-2 border-transparent text-base-500 \"\n          aria-hidden=\"true\"\n        >\n          ...\n        </span>\n        <a\n          href=\"#_\"\n          class=\"inline-flex items-center px-4 pb-4 text-sm font-medium border-b-2 border-transparent text-base-500 hover:border-base-300 hover:text-base-600 \"\n          aria-label=\"Go to page 8\"\n        >\n          8\n        </a>\n        <a\n          href=\"#_\"\n          class=\"inline-flex items-center px-4 pb-4 text-sm font-medium border-b-2 border-transparent text-base-500 hover:border-base-300 hover:text-base-600 \"\n          aria-label=\"Go to page 9\"\n        >\n          9\n        </a>\n        <a\n          href=\"#_\"\n          class=\"inline-flex items-center px-4 pb-4 text-sm font-medium border-b-2 border-transparent text-base-500 hover:border-base-300 hover:text-base-500 \"\n          aria-label=\"Go to page 10\"\n        >\n          10\n        </a>\n      </div>\n\n      <!-- Mobile Next -->\n      <Button\n        gap=\"xs\"\n        size=\"xs\"\n        variant=\"outline\"\n        class=\"md:hidden\"\n        aria-label=\"Go to next page\"\n      >\n        Next\n        <ChevronRight size=\"sm\" slot=\"icon\" slot=\"right-icon\" />\n      </Button>\n    </nav>\n    <!-- copy:end -->\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
