      "path": "oxbow/application/emptyStates/04.astro",
      "content": "---\nexport const description = \"Project creation empty state\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\n---\n\n<div class=\"flex items-center justify-center p-8 py-24 bg-background\">\n  <!-- copy:start -->\n  <div class=\"flex flex-col items-center justify-center text-center\">\n    <div class=\"relative mb-6 size-24\">\n      <div class=\"absolute inset-0 rounded-full bg-background opacity-10\"></div>\n      <div class=\"absolute border-2 rounded-lg inset-4 border-border rotate-6\">\n      </div>\n      <div\n        class=\"absolute bottom-0 right-0 flex items-center justify-center w-8 h-8 bg-background rounded-full\"\n      >\n        <span class=\"text-xl text-foreground\">+</span>\n      </div>\n    </div>\n    <Text tag=\"h3\" variant=\"textBase\" class=\"font-medium text-foreground\">\n      Project Files\n    </Text>\n    <Text\n      tag=\"p\"\n      variant=\"textSM\"\n      class=\"w-2/3 mt-2 font-medium text-muted-foreground text-balance\"\n    >\n      Begin your journey by creating a new workspace for your team's projects\n      and files.\n    </Text>\n\n    <Button class=\"mx-auto mt-8\" gap=\"xs\" size=\"sm\" variant=\"default\">\n      <Plus size=\"sm\" slot=\"icon\" slot=\"left-icon\" />\n      Create projects\n    </Button>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
