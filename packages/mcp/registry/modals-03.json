  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/application/modals/03.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"opacity-0\",\n  \"opacity-100\",\n  \"translate-y-4\",\n  \"sm:translate-y-0\",\n  \"sm:scale-95\",\n];\nimport LibraryPhoto from \"@/components/fundations/icons/LibraryPhoto.astro\";\nimport X from \"@/components/fundations/icons/X.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport IconButton from \"@/components/fundations/buttons/IconButton.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div\n  class=\"p-8 pt-12 pb-170 bg-white flex items-center justify-center\"\n>\n  <!-- Copy:start -->\n  <!--\n// Make sure to change  \"open: false\",  to  open: true. On the z-data=\"{}\".\n-->\n  <div\n    class=\"w-full max-w-xl mx-auto\"\n    x-data=\"{\n      open:true,\n      submitting:false,\n      form:{\n        avatar:'',\n        handle:'',\n        intro:'',\n        agree:false,\n        dontShow:false,\n      },\n      show(){ this.reset(); this.open=true; this.$nextTick(()=> this.$refs.handle?.focus()); },\n      reset(){ this.form={ avatar:'', handle:'@', intro:'', agree:false, dontShow:false }; this.submitting=false; this.drag=false; },\n      close(){ if(this.submitting) return; this.open=false; },\n      drop(e){ e.preventDefault(); const f=e.dataTransfer?.files?.[0]; if(!f) return; this.readAvatar(f); this.drag=false; },\n      pick(e){ const f=e.target?.files?.[0]; if(!f) return; this.readAvatar(f); },\n      readAvatar(file){ try { const url = URL.createObjectURL(file); this.form.avatar=url; } catch {} },\n      submit(){\n        if(!this.form.agree) return;\n        this.submitting=true;\n        setTimeout(()=>{\n          window.dispatchEvent(new CustomEvent('profile:completed', { detail:{ ...this.form } }));\n          this.submitting=false; this.open=false;\n        }, 900);\n      }\n    }\"\n  >\n    <Button\n      variant=\"default\"\n      size=\"sm\"\n      type=\"button\"\n      class=\"mx-auto\"\n      @click=\"show()\">Finish profile</Button\n    >\n    <!-- Backdrop -->\n    <div\n      x-show=\"open\"\n      x-transition.opacity\n      class=\"fixed inset-0 z-40 bg-black/40 \"\n      aria-hidden=\"true\"\n      @click=\"close()\"\n    >\n    </div>\n    <!-- Dialog -->\n    <div\n      x-show=\"open\"\n      x-transition:enter=\"transition ease-out duration-200\"\n      x-transition:enter-start=\"opacity-0\"\n      x-transition:enter-end=\"opacity-100\"\n      x-transition:leave=\"transition ease-in duration-150\"\n      x-transition:leave-start=\"opacity-100\"\n      x-transition:leave-end=\"opacity-0\"\n      class=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"profile-title\"\n      @keydown.escape.window.prevent=\"close()\"\n    >\n      <div\n        x-show=\"open\"\n        @click.outside=\"close()\"\n        x-transition:enter=\"transition ease-out duration-200\"\n        x-transition:enter-start=\"translate-y-4 sm:translate-y-0 sm:scale-95\"\n        x-transition:enter-end=\"translate-y-0 sm:scale-100\"\n        x-transition:leave=\"transition ease-in duration-150\"\n        x-transition:leave-start=\"opacity-100\"\n        x-transition:leave-end=\"opacity-0\"\n        class=\"w-full sm:max-w-xl rounded-2xl bg-white shadow-xl outline outline-1 outline-black/5 \"\n      >\n        <!-- Header -->\n        <div\n          class=\"flex items-center justify-between px-5 py-4 border-b border-base-100 \"\n        >\n          <div>\n            <Text\n              tag=\"h2\"\n              variant=\"sm\"\n              id=\"profile-title\"\n              class=\"text-sm font-semibold text-base-900 \"\n            >\n              Finish setting up your profile\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textXS\"\n              class=\"text-base-600 \"\n            >\n              Add an avatar, choose a handle, and a short bio.\n            </Text>\n          </div>\n          <IconButton\n            variant=\"text\"\n            size=\"xxs\"\n            aria-label=\"Close\"\n            @click=\"close()\"><X size=\"sm\" /></IconButton\n          >\n        </div>\n        <!-- Content -->\n        <div class=\"p-5 space-y-4\">\n          <div\n            class=\"grid grid-cols-1 sm:grid-cols-[96px_1fr] gap-4 items-center\"\n          >\n            <!-- Avatar -->\n            <div class=\"flex flex-col items-center gap-2\">\n              <div\n                class=\"size-24 rounded-xl overflow-hidden ring-1 ring-base-200 bg-base-100 grid place-items-center\"\n              >\n                <template x-if=\"!form.avatar\">\n                  <div class=\"text-base-400\"><LibraryPhoto size=\"base\" /></div>\n                </template>\n                <img\n                  x-show=\"form.avatar\"\n                  :src=\"form.avatar\"\n                  alt=\"Avatar\"\n                  class=\"size-full object-cover\"\n                />\n              </div>\n              <label\n                class=\"text-[0.70rem] text-base-600 text-center\"\n                >Square images look best</label\n              >\n            </div>\n            <!-- Dropzone -->\n            <div>\n              <label\n                class=\"block text-[0.70rem] font-medium text-base-700 \"\n                >Profile image</label\n              >\n              <div\n                @dragover.prevent\n                @dragenter.prevent=\"drag=true\"\n                @dragleave.prevent=\"drag=false\"\n                @drop=\"drop($event)\"\n                :class=\"drag ? 'outline-2 outline-primary/88 bg-primary/6 ' : 'outline-1 outline-primary/88'\"\n                class=\"mt-1 rounded-xl p-4 bg-white flex items-center justify-center text-center h-[120px] outline outline-1 outline-base-200 \"\n              >\n                <div>\n                  <LibraryPhoto\n                    size=\"sm\"\n                    class=\"text-base-500 mx-auto mb-1\"\n                  />\n                  <label\n                    class=\"text-xs\n                    text-primary\n                    cursor-pointer font-medium\"\n                  >\n                    <input\n                      type=\"file\"\n                      class=\"sr-only\"\n                      accept=\"image/*\"\n                      @change=\"pick($event)\"\n                    />\n                    Click to upload\n                  </label>\n                  <span class=\"text-xs text-base-500 font-medium\">\n                    or drag & drop</span\n                  >\n                  <div class=\"mt-1 text-[0.70rem] text-base-500 font-medium\">\n                    PNG, JPG, GIF (max 800×400px)\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <!-- Handle -->\n          <div>\n            <label\n              class=\"block text-xs font-medium text-base-700 \"\n              >Handle</label\n            >\n            <div class=\"mt-1 grid grid-cols-[minmax(120px,180px)_1fr]\">\n              <div\n                class=\"block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg rounded-r-none appearance-none bg-base-50 text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              >\n                example.com/\n              </div>\n              <input\n                x-ref=\"handle\"\n                x-model=\"form.handle\"\n                type=\"text\"\n                placeholder=\"@username\"\n                class=\"block w-full h-10 px-4 py-2 text-xs bg-white border border-transparent rounded-lg rounded-l-none appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n              />\n            </div>\n          </div>\n          <!-- Intro -->\n          <div>\n            <label\n              class=\"block text-xs font-medium text-base-700 \"\n              >Short bio</label\n            >\n            <textarea\n              x-model=\"form.intro\"\n              rows=\"4\"\n              placeholder=\"Tell people what you work on…\"\n              class=\"mt-1 block w-full px-4 py-2 text-xs bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n            ></textarea>\n          </div>\n          <!-- Agreement -->\n          <label\n            class=\"inline-flex items-center gap-2 text-xs text-base-500 \"\n          >\n            <input\n              type=\"checkbox\"\n              class=\"rounded border-base-300 text-primary focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 shadow size-4\"\n              x-model=\"form.agree\"\n            />\n            I agree to the <a href=\"#\" class=\"underline\">terms</a> and <a\n              href=\"#\"\n              class=\"underline\">privacy policy</a\n            >.\n          </label>\n        </div>\n        <!-- Footer -->\n        <div\n          class=\"px-5 py-4 border-t border-base-100 flex items-center gap-3\"\n        >\n          <label\n            class=\"inline-flex items-center gap-2 text-sm text-base-500 text-xs\"\n          >\n            <input\n              type=\"checkbox\"\n              class=\"rounded border-base-300 text-primary focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 shadow size-4\"\n              x-model=\"form.dontShow\"\n            />\n            Don’t show again\n          </label>\n          <div class=\"ml-auto flex items-center gap-2\">\n            <Button\n              variant=\"outline\"\n              size=\"xxs\"\n              type=\"button\"\n              @click=\"close()\"\n              :disabled=\"submitting\">Cancel</Button\n            >\n            <Button\n              variant=\"accent\"\n              size=\"xxs\"\n              type=\"button\"\n              @click=\"submit()\"\n              :disabled=\"!form.agree || submitting\">Save profile</Button\n            >\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <!-- Copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
