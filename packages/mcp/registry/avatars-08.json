      "path": "oxbow/application/avatars/08.astro",
      "content": "---\nexport const description = \"Avatar Group (Dynamic +N)\";\n---\n\n<section class=\"flex items-center justify-center bg-background p-14\">\n  <!-- copy:start -->\n  <div x-data=\"{ people: ['/avatars/1.jpg','/avatars/2.jpg','/avatars/3.jpg','/avatars/4.jpg','/avatars/5.jpg','/avatars/6.jpg'], max: 5 }\" class=\"flex items-center -space-x-2\">\n    <template x-for=\"(src, i) in people.slice(0, max)\" :key=\"src\">\n      <img :src=\"src\" alt=\"\" class=\"inline-block object-cover rounded-full size-10 ring-2 ring-border\" />\n    </template>\n    <template x-if=\"people.length > max\">\n      <span class=\"inline-flex items-center justify-center rounded-full size-10 bg-muted text-muted-foreground ring-2 ring-border\" x-text=\"'+' + (people.length - max)\"></span>\n    </template>\n  </div>\n  <!-- copy:end -->\n</section>\n\n"
    }
