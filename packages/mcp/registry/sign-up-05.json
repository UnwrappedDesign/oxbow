{
  "name": "sign-up-05",
  "type": "component",
  "description": "Split screen signup with quote",
  "category": "application",
  "section": "sign-up",
  "variant": 5,
  "aliases": [
    "sign up",
    "sign up 5",
    "sign up 05"
  ],
  "files": [
    {
      "name": "05.astro",
      "path": "oxbow/application/sign-up/05.astro",
      "content": "---\nexport const description = \"Split screen signup with quote\";\n\n// Assets\nimport { Image } from \"astro:assets\";\nimport Placeholder from \"@/images/gradients/4.jpeg\";\n\n// Fundations\nimport Logo from \"@/components/assets/Logo.astro\";\n\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n// Icons\nimport AppleColor from \"@/components/fundations/icons/AppleColor.astro\";\nimport GoogleColor from \"@/components/fundations/icons/GoogleColor.astro\";\n---\n\n<div class=\"relative flex h-screen\">\n  <Image\n    width={1200}\n    height={1200}\n    src={Placeholder}\n    alt=\"Background\"\n    aria-hidden=\"true\"\n    class=\"absolute inset-0 object-cover object-center w-full h-full grayscale\"\n  />\n  <div\n    aria-hidden=\"true\"\n    class=\"absolute inset-0 pointer-events-none bg-background/80\"\n  >\n  </div>\n  <div class=\"flex w-full ml-auto lg:p-4 lg:w-1/2\">\n    <div\n      class=\"relative flex items-center justify-center w-full p-8 ml-auto bg-background rounded-lg\"\n    >\n      <div class=\"w-full max-w-md py-24 lg:py-32\">\n        <div>\n          <Text\n            tag=\"h1\"\n            variant=\"displaySM\"\n            class=\"font-semibold tracking-tight text-foreground\"\n          >\n            Create your account\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-2 text-muted-foreground text-balance\"\n          >\n            Join the party. Set up your account the old-fashioned way—email,\n            password, done.\n          </Text>\n        </div>\n        <form class=\"mt-10 space-y-4\">\n          <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n            <Button\n              variant=\"outline\"\n              size=\"base\"\n              gap=\"sm\"\n              fullWidth\n              class=\"flex items-center\"\n            >\n              <GoogleColor slot=\"left-icon\" class=\"size-4\" />\n              Google\n            </Button>\n            <Button\n              variant=\"outline\"\n              size=\"base\"\n              gap=\"sm\"\n              fullWidth\n              class=\"flex items-center\"\n            >\n              <AppleColor slot=\"left-icon\" class=\"size-4\" />\n              Apple\n            </Button>\n          </div>\n          <div class=\"relative\">\n            <div class=\"absolute inset-0 flex items-center\" aria-hidden=\"true\">\n              <div class=\"w-full border-t border-border\">\n              </div>\n            </div>\n            <div class=\"relative flex justify-center\">\n              <span\n                class=\"px-2 text-sm bg-background text-muted-foreground\"\n                >Or sign in with</span\n              >\n            </div>\n          </div>\n          <TextInput\n            id=\"email\"\n            name=\"email\"\n            label=\"Email Address\"\n            type=\"email\"\n            variant=\"default\"\n            size=\"base\"\n            placeholder=\"you@example.com\"\n          />\n          <TextInput\n            id=\"password\"\n            name=\"password\"\n            label=\"Password\"\n            type=\"password\"\n            passwordToggle={true}\n            size=\"base\"\n            placeholder=\"••••••••\"\n            required\n          />\n          <TextInput\n            id=\"confirm-password\"\n            name=\"confirmPassword\"\n            label=\"Confirm Password\"\n            type=\"password\"\n            passwordToggle={true}\n            size=\"base\"\n            placeholder=\"••••••••\"\n            required\n          />\n          <Text\n            tag=\"p\"\n            variant=\"textXS\"\n            class=\"font-medium text-muted-foreground\"\n          >\n            By creating an account, you agree to our\n            <a\n              href=\"#_\"\n              class=\"font-medium text-foreground hover:text-muted-foreground\"\n            >\n              Terms of service\n            </a>\n            and\n            <a href=\"#_\" class=\"font-medium text-foreground hover:text-muted-foreground\">\n              Privacy Policy\n            </a>\n          </Text>\n          <Button fullWidth variant=\"default\" size=\"base\">\n            Create account\n          </Button>\n        </form>\n        <Text\n          tag=\"p\"\n          variant=\"textXS\"\n          class=\"mt-4 font-medium text-muted-foreground\"\n        >\n          Already have an account?\n          <a\n            href=\"#_\"\n            class=\"font-medium text-foreground hover:text-muted-foreground\"\n          >\n            Sign in\n          </a>\n        </Text>\n      </div>\n    </div>\n  </div>\n  <div\n    class=\"relative hidden mr-auto overflow-hidden lg:block lg:w-1/2 lg:order-first\"\n  >\n    <div class=\"absolute inset-0 flex flex-col items-start justify-between p-4\">\n      <a href=\"#_\">\n        <span class=\"sr-only\">Back to home</span>\n        <Logo class=\"h-12 mx-auto text-foreground md:mx-0\" aria-hidden=\"true\" /></a\n      >\n      <div class=\"mt-12 max-lg\">\n        <Text\n          tag=\"h1\"\n          variant=\"displaySM\"\n          class=\"font-semibold text-shadow-sm lg:text-balance\"\n        >\n          Go ahead, start your \"journey.\"\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textMD\"\n          class=\"mt-2 text-shadow-sm lg:text-balance\"\n        >\n          Join the internet’s favorite club of freelancers and business owners—\n          because what could possibly go wrong?\n        </Text>\n      </div>\n    </div>\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
