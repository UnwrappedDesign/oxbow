  "files": [
    {
      "name": "05.astro",
      "path": "oxbow/marketing/logo-clouds/05.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst logos = [\n  {\n    src: \"/brands/1.svg\",\n  },\n  {\n    src: \"/brands/2.svg\",\n  },\n  {\n    src: \"/brands/9.svg\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div\n      class=\"items-center py-12 bg-background grid grid-cols-1 lg:grid-cols-4 border-y md:grid-cols-2 border-border lg:gap-24\"\n    >\n      <div class=\"col-span-full lg:col-span-1 lg:max-w-none lg:mr-auto\">\n        <Text\n          tag=\"h2\"\n          variant=\"textBase\"\n          class=\"mt-4 font-semibold text-muted-foreground\"\n        >\n          Some of the mazing companies\n        </Text>\n      </div>\n      <div class=\"items-center mt-12 lg:mt-0 md:col-span-3\">\n        <div class=\"flex flex-wrap justify-between gap-6\">\n          {\n            logos.map((logo) => (\n              <img\n                class=\"mx-auto max-h-12\"\n                src={logo.src}\n                alt=\"#_\"\n              />\n            ))\n          }\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
