      "name": "01.astro",
      "path": "oxbow/application/avatars/01.astro",
      "content": "---\nexport const freeComponent = true;\n---\n\n<div class=\"flex items-center justify-center bg-background p-14\">\n  <!-- copy:start -->\n  <div x-data=\"{ error:false, showInitials:false }\" class=\"relative\">\n    <template x-if=\"!error\">\n      <img\n        class=\"inline-block object-cover rounded-full size-16 ring-2 ring-border\"\n        src=\"/avatars/1.jpg\"\n        alt=\"User avatar\"\n        @error=\"error=true\"\n      />\n    </template>\n    <template x-if=\"error\">\n      <div\n        class=\"inline-flex items-center justify-center rounded-full size-16 bg-muted ring-2 ring-border\"\n      >\n        <span\n          x-show=\"showInitials\"\n          class=\"text-foreground\"\n          aria-label=\"Avatar initials\">MA</span\n        >\n        <button\n          x-show=\"!showInitials\"\n          @click=\"showInitials = true\"\n          class=\"px-2 py-1 text-xs border rounded bg-background text-foreground border-border\"\n          type=\"button\"\n        >\n          Show initials\n        </button>\n      </div>\n    </template>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
