  "files": [
    {
      "name": "06.astro",
      "path": "oxbow/marketing/contact/06.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport MapPin from \"@/components/fundations/icons/MapPin.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nimport Phone from \"@/components/fundations/icons/Phone.astro\";\nimport Mail from \"@/components/fundations/icons/Mail.astro\";\nconst contactInfo = [\n  {\n    title: \"Collaborate\",\n    email: {\n      address: \"example@oxbowui.com\",\n      mailto: \"mailto:example@oxbowui.com\",\n    },\n    phone: \"+44 20 7946 1234\",\n  },\n  {\n    title: \"Press\",\n    email: {\n      address: \"example@oxbowui.com\",\n      mailto: \"mailto:example@oxbowui.com\",\n    },\n    phone: \"+33 1 42 68 90 12\",\n  },\n  {\n    title: \"Join our team\",\n    email: {\n      address: \"example@oxbowui.com\",\n      mailto: \"mailto:example@oxbowui.com\",\n    },\n    phone: \"+49 30 98765432\",\n  },\n  {\n    title: \"Say hello\",\n    email: {\n      address: \"example@oxbowui.com\",\n      mailto: \"mailto:example@oxbowui.com\",\n    },\n    phone: \"+34 91 654 3210\",\n  },\n];\nconst locations = [\n  {\n    title: \"Amsterdam\",\n    addressLines: [\"78 Canal Street\", \"1012 AB Amsterdam\", \"Netherlands\"],\n  },\n  {\n    title: \"Vienna\",\n    addressLines: [\"56 Schönbrunner Straße\", \"1120 Vienna\", \"Austria\"],\n  },\n  {\n    title: \"Stockholm\",\n    addressLines: [\"23 Gamla Stan\", \"111 29 Stockholm\", \"Sweden\"],\n  },\n  {\n    title: \"Zurich\",\n    addressLines: [\"12 Bahnhofstrasse\", \"8001 Zurich\", \"Switzerland\"],\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-12\">\n      <div>\n        <Text\n          tag=\"h1\"\n          variant=\"displayMD\"\n          class=\"font-semibold tracking-tight text-foreground lg:text-balance\"\n        >\n          Let’s connect and collaborate\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 lg:text-balance text-muted-foreground\"\n        >\n          Have a question, want to partner, or just want to say hi?\n          <br />\n          <br />\n          Our team is here to support your ideas and help you move forward. Reach\n          out and let’s make something amazing happen.\n        </Text>\n      </div>\n      <div class=\"space-y-12 lg:col-span-2\">\n        <div>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"font-semibold text-foreground\"\n          >\n            Contact us\n          </Text>\n          <div\n            class=\"flex flex-col mt-4 divide-y divide-border border-y border-border\"\n          >\n            {\n              contactInfo.map((contact) => (\n                <div class=\"py-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2\">\n                  <Text\n                    tag=\"h2\"\n                    variant=\"textSM\"\n                    class=\"font-medium text-foreground lg:text-balance\"\n                  >\n                    {contact.title}\n                  </Text>\n                  <dl class=\"text-sm gap-2 text-muted-foreground lg:col-span-2 grid grid-cols-1 lg:grid-cols-2\">\n                    <div>\n                      <dt class=\"sr-only\">Email</dt>\n                      <dd>\n                        <a\n                          href=\"#_\"\n                          class=\"flex items-center text-sm font-medium text-foreground hover:text-foreground\"\n                        >\n                          <Mail size=\"sm\" />\n                          {contact.email.address}\n                        </a>\n                      </dd>\n                    </div>\n                    <div>\n                      <dt class=\"sr-only\">Phone number</dt>\n                      <dd>\n                        <a\n                          href=\"#_\"\n                          class=\"flex items-center text-sm font-medium text-foreground hover:text-foreground\"\n                        >\n                          <Phone size=\"sm\" />\n                          {contact.phone}\n                        </a>\n                      </dd>\n                    </div>\n                  </dl>\n                </div>\n              ))\n            }\n          </div>\n        </div>\n        <div>\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"font-semibold text-foreground\"\n          >\n            Our offices\n          </Text>\n          <div\n            class=\"mt-4 border-y divide-y border-border divide-border\"\n          >\n            {\n              locations.map((location) => (\n                <div class=\"py-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2\">\n                  <Text\n                    tag=\"h2\"\n                    variant=\"textSM\"\n                    class=\"font-medium text-foreground lg:text-balance\"\n                  >\n                    {location.title}\n                  </Text>\n                  <address class=\"flex mt-2 text-sm not-italic gap-2 lg:col-span-2 text-muted-foreground sm:text-balance\">\n                    <MapPin\n                      class=\"text-foreground\"\n                      size=\"sm\"\n                    />\n                    <div class=\"flex flex-col lg:flex-row gap-2\">\n                      {location.addressLines.map((line, idx) => (\n                        <Text tag=\"p\" variant=\"small\">\n                          {line}\n                          {idx < location.addressLines.length - 1 ? \", \" : \"\"}\n                        </Text>\n                      ))}\n                    </div>\n                  </address>\n                </div>\n              ))\n            }\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
