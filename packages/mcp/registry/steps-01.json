  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/marketing/steps/01.astro",
      "content": "---\nexport const freeComponent = true;\n\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst steps = [\n  {\n    title: \"Select Your Account\",\n    description: \"Pick a checking, savings, or both to match your needs.\",\n  },\n  {\n    title: \"Prepare Your Documents\",\n    description: \"Have your ID, proof of address, and SSN ready.\",\n  },\n  {\n    title: \"Submit Your Application\",\n    description: \"Fill out and submit your application accurately.\",\n  },\n];\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <dl\n      class=\"grid grid-cols-1 gap-x-4 gap-y-12 lg:grid-cols-3 lg:divide-x lg:border-x border-base-200 divide-base-200 \"\n    >\n      {\n        steps.map((step, index) => (\n          <div class=\"lg:px-8\">\n            <dt class=\"flex items-center  gap-3\">\n              <Text\n                tag=\"h3\"\n                variant=\"textBase\"\n                class=\"flex items-center font-medium  text-base-900 gap-2\"\n              >\n                <span class=\"text-primary \">\n                  {index + 1}.\n                </span>\n                {step.title}\n              </Text>\n            </dt>\n            <dd class=\"mt-2\">\n              <Text\n                tag=\"p\"\n                variant=\"textBase\"\n                class=\"font-medium text-base-500 \"\n              >\n                {step.description}\n              </Text>\n            </dd>\n          </div>\n        ))\n      }\n    </dl>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
