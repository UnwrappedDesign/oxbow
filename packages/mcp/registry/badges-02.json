\"sm\" />\n      Accent\n    </Badge>\n\n    <Badge variant=\"muted\" gap=\"xs\" size=\"sm\" slot=\"left-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Muted\n    </Badge>\n    <Badge variant=\"text\" gap=\"xs\" size=\"sm\" slot=\"left-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Text\n    </Badge>\n    <Badge variant=\"info\" gap=\"xs\" size=\"sm\" slot=\"left-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Info\n    </Badge>\n    <Badge variant=\"success\" gap=\"xs\" size=\"sm\" slot=\"left-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Success\n    </Badge>\n    <Badge variant=\"warning\" gap=\"xs\" size=\"sm\" slot=\"left-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Warning\n    </Badge>\n    <Badge variant=\"danger\" gap=\"xs\" size=\"sm\" slot=\"left-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Danger\n    </Badge>\n  </div>\n  <!-- copy:end -->\n</section>\n"
