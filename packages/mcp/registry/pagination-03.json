    {
      "name": "03.astro",
      "path": "oxbow/application/pagination/03.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<section>\n  <div class=\"flex justify-center p-16 mx-auto bg-background\">\n    <!-- copy:start -->\n    <nav aria-label=\"Pagination\">\n      <span class=\"inline-flex isolate\">\n        <Button\n          variant=\"muted\"\n          size=\"sm\"\n          noRoundedRight\n          disabled\n          aria-label=\"Go to previous page\"\n        >\n          Previous\n        </Button>\n\n        <Button\n          variant=\"muted\"\n          size=\"sm\"\n          noRoundedLeft\n          noRoundedRight\n          aria-current=\"page\"\n          aria-label=\"Page 1, current page\"\n        >\n          1\n        </Button>\n\n        <Button\n          variant=\"muted\"\n          size=\"sm\"\n          noRoundedLeft\n          noRoundedRight\n          disabled\n          aria-hidden=\"true\"\n          role=\"presentation\"\n         \n        >\n          ...\n        </Button>\n\n        <Button\n          variant=\"muted\"\n          size=\"sm\"\n          noRoundedLeft\n          noRoundedRight\n          aria-label=\"Go to page 10\"\n        >\n          10\n        </Button>\n\n        <Button\n          variant=\"muted\"\n          size=\"sm\"\n          noRoundedLeft\n          aria-label=\"Go to next page\"\n        >\n          Next\n        </Button>\n      </span>\n    </nav>\n    <!-- copy:end -->\n  </div>\n</section>\n"
    }
  ],
