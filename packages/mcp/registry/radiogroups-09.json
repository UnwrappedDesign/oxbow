      "name": "09.astro",
      "path": "oxbow/application/radiogroups/09.astro",
      "content": "---\nexport const description = \"Radio Group for Plan Selection\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Badge from \"@/components/fundations/badges/Badge.astro\";\n---\n\n<div class=\"flex justify-center p-16 mx-auto bg-white \">\n  <!-- copy:start -->\n  <div class=\"flex flex-col gap-8\" x-data=\"{ selectedPlan: 'basic' }\">\n    <div class=\"flex items-start gap-3\">\n      <input\n        id=\"radio-basic\"\n        name=\"plan\"\n        type=\"radio\"\n        value=\"basic\"\n        x-model=\"selectedPlan\"\n        class=\"text-primary bg-white rounded-full shadow size-4 border-base-300 focus:ring-primary \"\n      />\n      <div>\n        <label\n          for=\"radio-basic\"\n          class=\"block text-sm font-medium text-base-500\"\n        >\n          Basic\n        </label>\n        <p class=\"text-sm text-base-400\">$10/month for basic features.</p>\n      </div>\n    </div>\n    <div class=\"flex items-start gap-3\">\n      <input\n        id=\"radio-pro\"\n        name=\"plan\"\n        type=\"radio\"\n        value=\"pro\"\n        x-model=\"selectedPlan\"\n        class=\"text-primary bg-white rounded-full shadow size-4 border-base-300 focus:ring-primary \"\n      />\n      <div>\n        <label for=\"radio-pro\" class=\"block text-sm font-medium text-base-500\">\n          Pro\n          <Badge variant=\"default\" size=\"xs\" class=\"ml-2\"> Popular </Badge>\n        </label>\n        <p class=\"text-sm text-base-400\">$30/month for advanced features.</p>\n      </div>\n    </div>\n    <div class=\"flex items-start gap-3\">\n      <input\n        id=\"radio-enterprise\"\n        name=\"plan\"\n        type=\"radio\"\n        value=\"enterprise\"\n        x-model=\"selectedPlan\"\n        class=\"text-primary bg-white rounded-full shadow size-4 border-base-300 focus:ring-primary \"\n      />\n      <div>\n        <label\n          for=\"radio-enterprise\"\n          class=\"block text-sm font-medium text-base-500\"\n        >\n          Enterprise\n        </label>\n        <p class=\"text-sm text-base-400\">Custom pricing for enterprises.</p>\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
  ],
