      "path": "oxbow/application/button-groups/03.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"Stacked action list\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Settings from \"@/components/fundations/icons/Settings.astro\";\nimport UsersGroup from \"@/components/fundations/icons/UsersGroup.astro\";\nimport Report from \"@/components/fundations/icons/Report.astro\";\n---\n\n<section class=\"flex items-center justify-center bg-white p-18 \">\n  <!-- copy:start -->\n  <div class=\"flex w-72 flex-col overflow-hidden rounded-lg border border-base-200 bg-white text-sm shadow-sm \">\n    <Button\n      variant=\"muted\"\n      size=\"sm\"\n      fullWidth\n      noRoundedBottom\n      class=\"justify-start gap-3 transition-none\"\n    >\n      <Settings slot=\"left-icon\" size=\"sm\" />\n      Workspace settings\n    </Button>\n    <Button\n      variant=\"muted\"\n      size=\"sm\"\n      fullWidth\n      noRounded\n      class=\"justify-start gap-3 transition-none\"\n    >\n      <UsersGroup slot=\"left-icon\" size=\"sm\" />\n      Team access\n    </Button>\n    <Button\n      variant=\"danger\"\n      size=\"sm\"\n      fullWidth\n      noRoundedTop\n      class=\"justify-start gap-3 transition-none\"\n    >\n      <Report slot=\"left-icon\" size=\"sm\" />\n      Report an issue\n    </Button>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
