      "content": "---\nexport const description = \"Radio Button Group for Mood Rating\";\n---\n\n<div class=\"flex justify-center p-16 mx-auto bg-background\">\n  <!-- copy:start -->\n  <div class=\"flex flex-col gap-2\" x-data=\"{ mood: '' }\">\n    <div class=\"flex items-center gap-2\">\n      <label class=\"flex items-center\">\n        <input\n          type=\"radio\"\n          name=\"mood\"\n          value=\"happy\"\n          x-model=\"mood\"\n          class=\"hidden\"\n        />\n        <span class=\"text-2xl cursor-pointer text-foreground\">😊</span>\n      </label>\n      <label class=\"flex items-center\">\n        <input\n          type=\"radio\"\n          name=\"mood\"\n          value=\"neutral\"\n          x-model=\"mood\"\n          class=\"hidden\"\n        />\n        <span class=\"text-2xl cursor-pointer text-foreground\">😐</span>\n      </label>\n      <label class=\"flex items-center\">\n        <input\n          type=\"radio\"\n          name=\"mood\"\n          value=\"sad\"\n          x-model=\"mood\"\n          class=\"hidden\"\n        />\n        <span class=\"text-2xl cursor-pointer text-foreground\">😢</span>\n      </label>\n    </div>\n    <p class=\"mt-2 text-sm text-muted-foreground\">\n      Selected mood: <span x-text=\"mood\"></span>\n    </p>\n  </div>\n  <!-- copy:end -->\n</div>\n"
