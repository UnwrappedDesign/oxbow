  "files": [
    {
      "name": "11.astro",
      "path": "oxbow/application/textarea/11.astro",
      "content": "---\nexport const description = \"Spell check toggle\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-background\">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"w-full space-y-1\" x-data=\"{ text: '', spellCheck: true }\">\n      <Text\n        for=\"spellcheck-textarea\"\n        tag=\"label\"\n        variant=\"textSM\"\n        class=\"font-medium text-muted-foreground\"\n      >\n        Spellcheck textarea\n      </Text>\n      <textarea\n        id=\"spellcheck-textarea\"\n        x-model=\"text\"\n        rows=\"4\"\n        placeholder=\"Type your message\"\n        class=\"block w-full px-4 py-2 text-sm text-foreground bg-background border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n        :spellcheck=\"spellCheck\"\n      ></textarea>\n      <label\n        class=\"flex items-center mt-2 text-sm gap-3 text-muted-foreground\"\n      >\n        <input\n          type=\"checkbox\"\n          class=\"text-foreground rounded shadow size-4 border-border focus:ring-border\"\n          x-model=\"spellCheck\"\n        />\n        Enable spellcheck\n      </label>\n    </div>\n    <!-- copy:end -->\n</div>\n</div>\n"
    }
  ],
