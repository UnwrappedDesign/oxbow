      "path": "oxbow/application/alerts/08.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleInfo from \"@/components/fundations/icons/CircleInfo.astro\";\n---\n\n<div class=\"flex items-center justify-center p-8 bg-background\">\n  <!-- copy:start -->\n  <div\n    class=\"relative w-full p-8 text-muted-foreground rounded-xl bg-background\"\n  >\n    <div class=\"flex gap-2\">\n      <div class=\"flex-shrink-0\">\n        <CircleInfo size=\"base\" slot=\"icon\" />\n      </div>\n      <div>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"font-medium text-foreground\"\n        >\n          Neutral alert!\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground\"\n        >\n          A new feature is available. You will be notified when it is ready.\n        </Text>\n        <div class=\"flex items-center mt-4 gap-2\">\n          <Button variant=\"accent\" size=\"xs\"> View Updates </Button>\n          <Button variant=\"outline\" size=\"xs\"> Remind me later </Button>\n        </div>\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
