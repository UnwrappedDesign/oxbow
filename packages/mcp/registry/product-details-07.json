{
  "name": "product-details-07",
  "type": "component",
  "description": "product-details block 07",
  "category": "ecommerce",
  "section": "product-details",
  "variant": 7,
  "aliases": [
    "product details",
    "product details 7",
    "product details 07",
    "product detail",
    "product detail 7",
    "product detail 07"
  ],
  "files": [
    {
      "name": "07.astro",
      "path": "oxbow/ecommerce/product-details/07.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"bg-background\",\n  \"bg-muted\",\n  \"ring-2\",\n  \"ring-offset-2\",\n  \"ring-border\",\n  \"ring-border\",\n  \"bg-muted\",\n  \"ring-border\",\n  \"bg-muted\",\n  \"ring-border/30\",\n  \"bg-muted\",\n  \"ring-border/30\",\n  \"bg-muted/20\",\n  \"ring-destructive/30\",\n  \"bg-destructive/20\",\n  \"ring-border/30\",\n  \"bg-muted/20\",\n  \"ring-warning/30\",\n  \"bg-warning\",\n  \"ring-border/30\",\n  \"bg-muted/20\",\n  \"ring-info/30\",\n  \"bg-info\",\n  \"ring-success/30\",\n  \"bg-success\",\n  \"ring-success/30\",\n  \"bg-success/20\",\n  \"text-foreground\",\n  \"bg-background\",\n  \"border-b-2\",\n  \"border-border\",\n];\n\nexport const description =\n  \"Details with image slider with arrow and step navigation, color, size selector and info tabs with reviews\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <div class=\"grid grid-cols-1 gap-8 lg:grid-cols-2\">\n      <div\n        x-data=\"{ activeSlide: 0, slides: ['/store/shoes/airmax/1.png', '/store/shoes/airmax/2.png', '/store/shoes/airmax/3.png', '/store/shoes/airmax/4.png'] }\"\n        role=\"region\"\n        aria-label=\"Image Slider\"\n        class=\"relative flex flex-col gap-4\"\n      >\n        <!-- Slider container -->\n        <div class=\"relative w-full aspect-square\">\n          <!-- Template for each slide image -->\n          <template x-for=\"(slide, index) in slides\" :key=\"index\">\n            <div\n              x-show=\"activeSlide === index\"\n              x-transition:enter=\"transition ease-out duration-500\"\n              x-transition:enter-start=\"opacity-0 transform scale-95\"\n              x-transition:enter-end=\"opacity-100 transform scale-100\"\n              x-transition:leave=\"transition ease-in duration-500\"\n              x-transition:leave-start=\"opacity-100 transform scale-100\"\n              x-transition:leave-end=\"opacity-0 transform scale-95\"\n              class=\"absolute inset-0 aspect-square\"\n              :aria-hidden=\"activeSlide !== index\"\n            >\n              <!-- Slide image -->\n              <img\n                :src=\"slide\"\n                alt=\"#\"\n                class=\"object-cover size-full rounded-2xl\"\n              />\n            </div>\n          </template>\n        </div>\n\n        <!-- Buttons and Pagination -->\n        <div class=\"flex items-center justify-between gap-4\">\n          <div class=\"flex items-center gap-4\">\n            <!-- Previous slide button -->\n            <button\n              @click=\"activeSlide = activeSlide === 0 ? slides.length - 1 : activeSlide - 1\"\n              class=\"flex items-center justify-center bg-background border rounded-full transform border-border text-foreground size-10 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-border\"\n              aria-label=\"Previous Slide\"\n            >\n              &larr;\n            </button>\n            <!-- Next slide button -->\n            <button\n              @click=\"activeSlide = activeSlide === slides.length - 1 ? 0 : activeSlide + 1\"\n              class=\"flex items-center justify-center bg-background border rounded-full transform border-border text-foreground size-10 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-border\"\n              aria-label=\"Next Slide\"\n            >\n              &rarr;\n            </button>\n          </div>\n          <!-- Pagination indicators -->\n          <div class=\"flex transform space-x-2\">\n            <template x-for=\"(slide, index) in slides\" :key=\"index\">\n              <button\n                @click=\"activeSlide = index\"\n                :class=\"{'bg-background': activeSlide === index, 'bg-muted': activeSlide !== index}\"\n                class=\"rounded-full size-3 focus:outline-none\"\n                :aria-label=\"'Slide ' + (index + 1)\"\n                :aria-current=\"activeSlide === index ? 'true' : 'false'\"\n              ></button>\n            </template>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"flex flex-col\">\n        <Text tag=\"h1\" variant=\"textXL\" class=\"font-medium text-foreground\"\n          >Nike Air Force 1´07 Fresh</Text\n        >\n        <Text tag=\"p\" variant=\"textLG\" class=\"mt-1 text-foreground\"\n          >$152 <del class=\"opacity-70\">$190</del>\n          <span class=\"text-success\">20% Off</span></Text\n        >\n        <Text tag=\"p\" variant=\"textSM\" class=\"mt-2 text-muted-foreground\">\n          Men's shoes\n        </Text>\n        <Text tag=\"p\" variant=\"textSM\" class=\"mt-8 text-muted-foreground\">\n          Hitting the field in the late '60s, adidas airforcewhiteS quickly\n          became soccer's \"it\" shoe.\n        </Text>\n        <div class=\"mt-4 grid cols-1 md:grid-cols-2 gap-4\">\n          <!-- Color Selector -->\n          <div x-data=\"{ activeColor: null }\">\n            <Text\n              tag=\"p\"\n              variant=\"textXS\"\n              class=\"uppercase text-muted-foreground\"\n            >\n              Color\n            </Text>\n            <fieldset\n              aria-label=\"Choose a color\"\n              class=\"mt-2\"\n              x-data=\"{ \n              colors: [\n                { name: ' Black', ring: 'ring-border', bg: 'bg-muted' },\n                { name: ' Gray', ring: 'ring-border', bg: 'bg-muted' },\n                { name: ' Purple', ring: 'ring-border/30', bg: 'bg-muted' },\n                { name: ' Pink', ring: 'ring-border/30', bg: 'bg-muted/20' },\n                { name: ' Red', ring: 'ring-destructive/30', bg: 'bg-destructive/20' },\n                { name: ' Orange', ring: 'ring-border/30', bg: 'bg-muted/20' },\n                { name: ' Yellow', ring: 'ring-warning/30', bg: 'bg-warning' },\n                { name: ' Blue', ring: 'ring-info/30', bg: 'bg-info' },\n                { name: ' Cyan', ring: 'ring-info/30', bg: 'bg-info' },\n                { name: ' Green', ring: 'ring-success/30', bg: 'bg-success' },\n                { name: ' Teal', ring: 'ring-success/30', bg: 'bg-success/20' },\n              ],\n              activeColor: ' Black' \n            }\"\n            >\n              <div class=\"flex flex-wrap items-center gap-3\">\n                <template x-for=\"color in colors\" :key=\"color.name\">\n                  <label\n                    :aria-label=\"color.name\"\n                    class=\"relative -m-0.5 duration-300 flex cursor-pointer items-center justify-center rounded-full p-0.5 focus:outline-none\"\n                    :class=\"{ 'ring-2 ring-offset-2 ring-border': activeColor === color.name }\"\n                  >\n                    <input\n                      type=\"radio\"\n                      name=\"color-choice\"\n                      :value=\"color.name\"\n                      class=\"sr-only\"\n                      @click=\"activeColor = color.name\"\n                    />\n                    <span\n                      aria-hidden=\"true\"\n                      class=\"rounded-full size-6 ring-1\"\n                      :class=\"`${color.ring} ${color.bg}`\"></span>\n                  </label>\n                </template>\n              </div>\n            </fieldset>\n          </div>\n          <!-- Sizing -->\n          <div\n            x-data=\"{\n              sizeSystem: 'US',\n              activeSize: null,\n              sizes: {\n                  US: ['6', '7', '8', '9', '10', '11', '12', '13'],\n                  EU: ['39', '40', '41', '42', '43', '44', '45', '46']\n              }\n          }\"\n          >\n            <div class=\"flex items-center justify-between\">\n              <Text\n                tag=\"p\"\n                variant=\"textXS\"\n                class=\"uppercase text-muted-foreground\"\n              >\n                Shoe size\n              </Text>\n              <div>\n                <label for=\"size-system\" class=\"sr-only\">Size System</label>\n                <select\n                  id=\"size-system\"\n                  x-model=\"sizeSystem\"\n                  @change=\"activeSize = null\"\n                  class=\"block w-auto h-8 pl-2.5 pr-8 py-2 text-xs text-foreground duration-300 bg-background border border-transparent rounded-lg appearance-none ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2\"\n                >\n                  <option value=\"US\">US</option>\n                  <option value=\"EU\">EU</option>\n                </select>\n              </div>\n            </div>\n            <div class=\"mt-2 grid grid-cols-4 gap-2 divide-x divide-border\">\n              <template x-for=\"size in sizes[sizeSystem]\" :key=\"size\">\n                <div>\n                  <input\n                    type=\"radio\"\n                    :id=\"'size-' + size\"\n                    :value=\"size\"\n                    name=\"size-choice\"\n                    x-model=\"activeSize\"\n                    class=\"sr-only peer\"\n                  />\n                  <label\n                    :for=\"'size-'+ size\" x-text=\"size\" class=\"flex items-center justify-center px-3 py-2 text-sm font-medium bg-background cursor-pointer ring-1 ring-border rounded-md duration-300 peer-checked:ring-2 peer-checked:ring-border peer-checked:text-foreground text-foreground peer-checked:ring-offset-2\" ></label> </div> </template> </div> </div> </div> <!-- Action Buttons --> <div class=\"flex flex-row mt-8 gap-2\"> <Button size=\"sm\" variant=\"default\" class=\"w-full\">Add to Cart</Button > <Button size=\"sm\" variant=\"muted\" class=\"w-full\">Buy Now</Button> </div> <!-- Free shipping notice --> <Text tag=\"p\" variant=\"textSM\" class=\"mt-1 text-muted-foreground\" >Shop now. Pay in 30 days with Klarna. <a href=\"#_\" class=\"underline text-foreground\">Learn more</a ></Text > <!-- Tab section --> <div x-data=\"{ tab:'tab1' }\"\n          class=\"mt-8 border-b divide-y divide-border border-border\"\n        >\n          <ul\n            class=\"flex text-sm border-b gap-4 text-muted-foreground border-border\"\n          >\n            <li class=\"-mb-px\">\n              <a\n                @click.prevent=\"tab = 'tab1'\"\n                href=\"#_\"\n                class=\"inline-block py-2 font-medium border-b-2 text-muted-foreground border-border\"\n                :class=\"{ ' text-muted-foreground border-b-2 border-border' : tab === 'tab1' }\"\n              >\n                Details</a\n              >\n            </li>\n            <li class=\"-mb-px\">\n              <a\n                @click.prevent=\"tab = 'tab2'\"\n                href=\"#_\"\n                class=\"inline-block py-2 font-medium\"\n                :class=\"{ ' text-muted-foreground border-b-2 border-border' : tab === 'tab2' }\"\n              >\n                Shipping</a\n              >\n            </li>\n            <li class=\"-mb-px\">\n              <a\n                @click.prevent=\"tab = 'tab3'\"\n                href=\"#_\"\n                class=\"inline-block py-2 font-medium\"\n                :class=\"{ ' text-muted-foreground border-b-2 border-border' : tab === 'tab3' }\"\n              >\n                Returns</a\n              >\n            </li>\n            <li class=\"-mb-px\">\n              <a\n                @click.prevent=\"tab = 'tab4'\"\n                href=\"#_\"\n                class=\"inline-block py-2 font-medium\"\n                :class=\"{ ' text-muted-foreground border-b-2 border-border' : tab === 'tab4'}\" > Reviews</a > </li> </ul> <div class=\"py-4 pt-4 text-left text-foreground content\" > <div x-show=\"tab==='tab1'\">\n              <section class=\"py-4\">\n                <Text tag=\"p\" variant=\"sm\">\n                  This product is crafted from high-quality materials designed\n                  for durability and comfort. It features modern design elements\n                  and is perfect for everyday use.\n                </Text>\n                <ul\n                  role=\"list\"\n                  class=\"pl-5 mt-4 text-sm list-disc space-y-1 text-muted-foreground marker:text-foreground\"\n                >\n                  <li>Versatile lace configurations</li>\n                  <li>Breathable and spacious interior fit</li>\n                  <li>Durable leather overlays</li>\n                  <li>Cushioned insole for added comfort</li>\n                  <li>Reinforced eyelets for secure lacing</li>\n                  <li>Stitching built for durability</li>\n                  <li>Water-resistant materials</li>\n                </ul>\n\n                <Text tag=\"p\" variant=\"textSM\" class=\"mt-8\">\n                  <strong class=\"text-foreground\">True to size</strong>.We\n                  recommend ordering your usual size.\n                </Text>\n              </section>\n            </div>\n            <div x-show=\"tab==='tab2'\" style=\"display: none;\">\n              <section class=\"py-4\">\n                <Text tag=\"p\" variant=\"sm\">\n                  We offer free standard shipping on all orders above $50.\n                  Express shipping options are available at checkout for an\n                  additional fee.\n                </Text>\n              </section>\n            </div>\n            <div x-show=\"tab==='tab3'\" style=\"display: none;\">\n              <section class=\"py-4\">\n                <Text tag=\"p\" variant=\"sm\">\n                  We accept returns within 30 days of purchase. Items must be in\n                  their original condition and packaging. Please visit our\n                  returns page for more details.\n                </Text>\n              </section>\n            </div>\n            <div x-show=\"tab==='tab4'\" style=\"display: none;\">\n              <section class=\"py-4\">\n                <div\n                  class=\"flex flex-col\"\n                  x-data=\"{ \n                    testimonials: [\n                      {\n                        name: 'Fernando Monte',\n                        date: '2025-12-01',\n                        datetime: '2025-12-01',\n                        img: '/avatars/1.jpg',\n                        text: 'The Nike Air Max 90 Black exceeded my expectations! Super comfortable and perfect for both running and casual wear.',\n                      },\n                      {\n                        name: 'Juan  Echanove',\n                        date: '2025-11-15',\n                        datetime: '2025-11-15',\n                        img: '/avatars/2.jpg',\n                        text: 'Stylish and lightweight. I wear them everywhere, but the fit was slightly snug at first. Broke in nicely after a few days.',\n                      },\n                    ] \n                  }\"\n                >\n                  <template\n                    x-for=\"testimonial in testimonials\"\n                    :key=\"testimonial.datetime\"\n                  >\n                    <div class=\"flex py-4 gap-x-4\">\n                      <div class=\"flex-none\">\n                        <img\n                          :src=\"testimonial.img\"\n                          :alt=\"testimonial.name\"\n                          class=\"rounded-full size-10 bg-muted\"\n                        />\n                      </div>\n                      <div>\n                        <Text\n                          tag=\"h3\"\n                          variant=\"textBase\"\n                          class=\"font-medium text-foreground\"\n                          x-text=\"testimonial.name\"\n                        />\n                        <Text variant=\"textXS\" class=\"text-muted-foreground\">\n                          <time\n                            :datetime=\"testimonial.datetime\"\n                            x-text=\"testimonial.date\"></time>\n                        </Text>\n                        <Text\n                          tag=\"p\"\n                          variant=\"textSM\"\n                          class=\"mt-1 text-muted-foreground\"\n                          x-text=\"testimonial.text\"\n                        />\n                      </div>\n                    </div>\n                  </template>\n                </div>\n                <div class=\"flex mt-8\">\n                  <Button size=\"sm\" variant=\"muted\"> Write a review </Button>\n                </div>\n              </section>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
