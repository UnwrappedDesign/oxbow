  "files": [
    {
      "name": "06.astro",
      "path": "oxbow/application/select/06.astro",
      "content": "---\nexport const description = \"Conditional styling\";\n\nconst countryOptions = [\n  { label: \"United States\", value: \"us\" },\n  { label: \"Canada\", value: \"ca\" },\n  { label: \"United Kingdom\", value: \"uk\" },\n  { label: \"Australia\", value: \"au\" },\n  { label: \"Germany\", value: \"de\" },\n  { label: \"France\", value: \"fr\" },\n  { label: \"Japan\", value: \"jp\" },\n];\n---\n\n<div class=\"flex justify-center mx-auto bg-white p-18 \">\n  <div>\n    <!-- copy:start -->\n    <div\n      class=\"flex flex-col w-full max-w-sm\"\n      x-data=\"{ \n                 searchTerm: '',\n                 allOptions: [\n                   { label: 'United States', value: 'us' },\n                   { label: 'Canada', value: 'ca' },\n                   { label: 'United Kingdom', value: 'uk' },\n                   { label: 'Australia', value: 'au' },\n                   { label: 'Germany', value: 'de' },\n                   { label: 'France', value: 'fr' },\n                   { label: 'Japan', value: 'jp' }\n                 ],\n                 filteredOptions: [],\n                 selectedValue: '',\n                 filterOptions() {\n                   if (!this.searchTerm) {\n                     this.filteredOptions = [...this.allOptions];\n                   } else {\n                     const term = this.searchTerm.toLowerCase();\n                     this.filteredOptions = this.allOptions.filter(\n                       option => option.label.toLowerCase().includes(term)\n                     );\n                   }\n                   console.log('Filtered options:', this.filteredOptions);\n                 }\n               }\"\n      x-init=\"filteredOptions = [...allOptions]; console.log('Initial options:', filteredOptions)\"\n    >\n      <div class=\"mb-4\">\n        <label for=\"search\" class=\"block mb-1 text-sm font-medium text-base-500\"\n          >Search Countries</label\n        >\n        <input\n          type=\"text\"\n          id=\"search\"\n          x-model=\"searchTerm\"\n          @input=\"filterOptions()\"\n          class=\"block w-full h-10 px-4 py-2 text-sm bg-white border border-transparent text-base-500 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 rounded-md\"\n          placeholder=\"Type to search...\"\n        />\n      </div>\n\n      <div>\n        <label\n          for=\"filtered-select\"\n          class=\"block mb-1 text-sm font-medium text-base-500\"\n          >Filtered Countries</label\n        >\n        <select\n          id=\"filtered-select\"\n          name=\"filtered-select\"\n          x-model=\"selectedValue\"\n          class=\"block w-full h-10 px-4 py-2 text-sm bg-white border border-transparent text-base-500 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 rounded-md\"\n        >\n          <option value=\"\">Select a country</option>\n          <template x-for=\"option in filteredOptions\">\n            <option :value=\"option.value\" x-text=\"option.label\"></option>\n          </template>\n        </select>\n      </div>\n\n      <div class=\"mt-2\">\n        <p class=\"text-xs font-medium text-base-500\">\n          Selected country: <span\n            class=\"uppercase\"\n            x-text=\"selectedValue || 'None'\"></span>\n        </p>\n        <p class=\"text-xs font-medium text-base-500\" mt-1>\n          Showing <span x-text=\"filteredOptions.length\"></span> of <span\n            x-text=\"allOptions.length\"></span> countries\n        </p>\n        <!-- Debug output -->\n        <div class=\"mt-2 text-xs font-medium text-base-900\">\n          <p>Search term: <span x-text=\"searchTerm\"></span></p>\n          <div\n            x-show=\"filteredOptions.length === 0\"\n            class=\"hidden font-medium text-destructive/88\"\n            :class=\"{ 'hidden': filteredOptions.length !== 0 }\"\n          >\n            No matching options found\n          </div>\n        </div>\n      </div>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
