    {
      "name": "02.astro",
      "path": "oxbow/marketing/contact/02.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nimport CreditCard from \"@/components/fundations/icons/CreditCard.astro\";\nimport News from \"@/components/fundations/icons/News.astro\";\nimport Lifebuoy from \"@/components/fundations/icons/Lifebuoy.astro\";\nimport UserPlus from \"@/components/fundations/icons/UserPlus.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"max-w-xl mx-auto text-center lg:text-balance\">\n      <Kicker>Contact Us</Kicker>\n      <Text\n        tag=\"h1\"\n        variant=\"displayMD\"\n        class=\"mt-12 font-semibold tracking-tight text-base-900 lg:text-balance\"\n      >\n        We’re excited to connect with you!\n      </Text>\n      <Text\n        tag=\"p\"\n        variant=\"textBase\"\n        class=\"mt-4 lg:text-balance text-base-500 \"\n      >\n        Bringing together expertise and creativity. Meet the passionate team\n        committed to driving our mission forward.\n      </Text>\n    </div>\n    <div class=\"flex flex-col max-w-md mx-auto mt-12 gap-12\">\n      <div>\n        <div class=\"flex flex-col gap-2\">\n          <div class=\"flex items-center gap-2\">\n            <CreditCard class=\"text-primary/88 \" size=\"base\" />\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-base-900 \"\n            >\n              Sales\n            </Text>\n          </div>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-500 \"\n          >\n            Ready to grow your business? Our sales team is here to help you\n            discover the perfect solutions for your needs. Let’s unlock new\n            opportunities together.\n          </Text>\n        </div>\n        <Text\n          href=\"#_\"\n          class=\"flex items-center mt-4 text-sm font-medium gap-2 text-base-900 hover:text-primary \"\n        >\n          Connect with sales\n          <ChevronRight size=\"sm\" />\n        </Text>\n      </div>\n      <div>\n        <div class=\"flex flex-col gap-2\">\n          <div class=\"flex items-center gap-2\">\n            <Lifebuoy class=\"text-primary/88 \" size=\"base\" />\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-base-900 \"\n            >\n              Support\n            </Text>\n          </div>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-500 \"\n          >\n            Have a question or need assistance? Our support team is dedicated to\n            making your experience seamless and successful. Reach out and we’ll\n            be happy to help.\n          </Text>\n        </div>\n        <Text\n          href=\"#_\"\n          class=\"flex items-center mt-4 text-sm font-medium gap-2 text-base-900 hover:text-primary \"\n        >\n          Get support\n          <ChevronRight size=\"sm\" />\n        </Text>\n      </div>\n      <div>\n        <div class=\"flex flex-col gap-2\">\n          <div class=\"flex items-center gap-2\">\n            <News class=\"text-primary/88 \" size=\"base\" />\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-base-900 \"\n            >\n              Press\n            </Text>\n          </div>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-500 \"\n          >\n            Interested in our latest news or media resources? Connect with our\n            press team for stories, interviews, and more information about Oxbow\n            UI.\n          </Text>\n        </div>\n        <Text\n          href=\"#_\"\n          class=\"flex items-center mt-4 text-sm font-medium gap-2 text-base-900 hover:text-primary \"\n        >\n          Contact press\n          <ChevronRight size=\"sm\" />\n        </Text>\n      </div>\n      <div>\n        <div class=\"flex flex-col gap-2\">\n          <div class=\"flex items-center gap-2\">\n            <UserPlus class=\"text-primary/88 \" size=\"base\" />\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"font-medium text-base-900 \"\n            >\n              Partners\n            </Text>\n          </div>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"font-medium text-base-500 \"\n          >\n            Let’s build something amazing together. If you’re interested in\n            collaborating or forming a partnership, we’d love to hear your ideas\n            and explore new possibilities.\n          </Text>\n        </div>\n        <Text\n          href=\"#_\"\n          class=\"flex items-center mt-4 text-sm font-medium gap-2 text-base-900 hover:text-primary \"\n        >\n          Partner with us\n          <ChevronRight size=\"sm\" />\n        </Text>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
