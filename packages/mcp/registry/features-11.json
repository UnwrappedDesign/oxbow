      "path": "oxbow/marketing/features/11.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\nimport CircleX from \"@/components/fundations/icons/CircleX.astro\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"items-end pb-2 grid grid-cols-4\">\n      <div class=\"col-span-4 max-w-[460px] md:col-span-2\">\n        <Text\n          tag=\"h2\"\n          variant=\"displayMD\"\n          class=\"font-semibold tracking-tight text-foreground text-balance\"\n        >\n          Standing out\n        </Text>\n      </div>\n      <div\n        class=\"hidden text-base font-semibold text-center col-span-1 md:block text-foreground\"\n      >\n        Oxbow\n      </div>\n      <div\n        class=\"hidden text-base font-semibold text-center col-span-1 md:block text-foreground\"\n      >\n        Other processors\n      </div>\n    </div>\n    <div\n      class=\"border-y divide-y border-border divide-border lg:text-balance\"\n    >\n      <div class=\"items-start py-6 grid grid-flow-row-dense grid-cols-4 gap-4\">\n        <div class=\"order-1 col-span-3 md:col-span-2 lg:col-span-2\">\n          <Text\n            tag=\"h3\"\n            variant=\"textBase\"\n            class=\"font-semibold text-foreground\"\n          >\n            Comprehensive error reporting\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Access detailed failure codes and clear explanations instantly to\n            diagnose and resolve payment issues faster.\n          </Text>\n        </div>\n        <div class=\"order-2 justify-self-center lg:order-3\">\n          <CircleCheck class=\"text-muted-foreground\" size=\"base\" />\n        </div>\n        <div class=\"order-3 hidden md:block justify-self-center lg:order-4\">\n          <CircleX class=\"text-muted-foreground\" size=\"base\" />\n        </div>\n      </div>\n      <div class=\"items-start py-6 grid grid-flow-row-dense grid-cols-4 gap-4\">\n        <div class=\"order-1 col-span-3 md:col-span-2 lg:col-span-2\">\n          <Text\n            tag=\"h3\"\n            variant=\"textLG\"\n            class=\"font-semibold text-foreground\"\n          >\n            Unique transaction tracking\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textSM\"\n            class=\"mt-2 font-medium text-muted-foreground\"\n          >\n            Instantly obtain a unique RTP network reference to confirm and\n            monitor payment status in real-time.\n          </Text>\n        </div>\n        <div class=\"order-2 justify-self-center lg:order-3\">\n          <CircleCheck class=\"text-muted-foreground\" size=\"base\" />\n        </div>\n        <div class=\"order-3 hidden md:block justify-self-center lg:order-4\">\n          <CircleX class=\"text-muted-foreground\" size=\"base\" />\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
