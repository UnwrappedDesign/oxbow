{
  "name": "textarea-14",
  "type": "component",
  "description": "Textarea with Character Highlight",
  "category": "application",
  "section": "textarea",
  "variant": 14,
  "aliases": [
    "textarea",
    "textarea 14"
  ],
  "files": [
    {
      "name": "14.astro",
      "path": "oxbow/application/textarea/14.astro",
      "content": "---\nexport const excludeFromObfuscation = [\"ring-destructive\", \"focus:ring-destructive\"];\n\nexport const description = \"Textarea with Character Highlight\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-background\">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"w-full space-y-1\" x-data=\"{ text: '', threshold: 50 }\">\n      <Text\n        for=\"highlight-textarea\"\n        tag=\"label\"\n        variant=\"textSM\"\n        class=\"font-medium text-muted-foreground\"\n      >\n        Highlight excess characters\n      </Text>\n      <textarea\n        id=\"highlight-textarea\"\n        x-model=\"text\"\n        rows=\"4\"\n        placeholder=\"Type your message\"\n        class=\"block w-full px-4 py-2 text-sm text-foreground bg-background border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n        :class=\"{ 'ring-destructive focus:ring-destructive': text.length > threshold }\"\n      ></textarea>\n      <div class=\"mt-2 text-sm text-muted-foreground\">\n        Characters: <span x-text=\"text.length\"></span> (Limit: <span\n          x-text=\"threshold\"></span>)\n      </div>\n    </div>\n    <!-- copy:end -->\n</div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
