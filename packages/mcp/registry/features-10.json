      "path": "oxbow/marketing/features/10.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\nconst listOne = [\n  \"Real-time collaboration\",\n  \"Automated workflows\",\n  \"Robust security\",\n  \"Integrated APIs\",\n];\nconst listTwo = [\n  \"Centralized monitoring\",\n  \"Scalable infrastructure\",\n  \"Data-driven insights\",\n  \"Seamless deployment\",\n];\n---\n\n<section class=\"overflow-hidden bg-white \">\n  <div\n    class=\"relative flex flex-col items-center pt-24 pb-24 mx-auto md:flex-row lg:gap-8 max-w-7xl\"\n  >\n    <div class=\"px-8 md:px-12 lg:px-20 lg:pb-0\">\n      <div>\n        <Text\n          tag=\"h2\"\n          variant=\"displayMD\"\n          class=\"font-semibold tracking-tight text-base-900 text-balance\"\n        >\n          Unite your team with robust tools\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 font-medium text-base-500 \"\n        >\n          Simplify your workflow with integrated staging, monitoring, and\n          deployment features.\n        </Text>\n        <ul\n          role=\"list\"\n          class=\"flex-col hidden mt-12 font-medium lg:flex gap-1 ext-base text-base-900 \"\n        >\n          {\n            listTwo.map((item) => (\n              <li>\n                <div class=\"flex flex-row items-center  gap-2\">\n                  <CircleCheck\n                    class=\"text-base-600 \"\n                    size=\"base\"\n                  />\n                  <Text tag=\"span\" variant=\"textSM\">\n                    {item}\n                  </Text>\n                </div>\n              </li>\n            ))\n          }\n        </ul>\n      </div>\n    </div>\n    <div class=\"h-full p-8 ml-auto -mr-48 lg:p-0\">\n      <div class=\"lg:h-full\">\n        <img\n          alt=\"#\"\n          class=\"shadow rounded-3xl\"\n          src=\"/images/dashboardLight.svg\"\n        />\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
