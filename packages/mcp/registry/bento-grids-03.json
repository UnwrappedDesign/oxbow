      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"grid grid-cols-1 gap-2 lg:grid-cols-2\">\n      <div class=\"h-full grid grid-cols-1 gap-2\">\n        <img\n          src=\"/widgets/figmaComp.svg\"\n          alt=\"#_\"\n          class=\"object-cover shadow size-full rounded-2xl\"\n        />\n        <div class=\"h-full grid grid-cols-1 gap-2 sm:grid-cols-2\">\n          <div class=\"flex flex-col gap-2\">\n            <div class=\"grid grid-cols-1 gap-2 sm:grid-cols-2\">\n              <img\n                src=\"/widgets/spiral.svg\"\n                alt=\"#_\"\n                class=\"shadow size-full rounded-2xl\"\n              />\n              <img\n                src=\"/widgets/miniprogress.svg\"\n                alt=\"#_\"\n                class=\"shadow size-full rounded-2xl\"\n              />\n            </div>\n            <div\n              class=\"relative flex items-center justify-center h-full p-8 overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n            >\n              <div>\n                <Kicker> Creativity </Kicker>\n                <Text\n                  tag=\"h3\"\n                  variant=\"textBase\"\n                  class=\"mt-4 font-medium text-base-900 \"\n                >\n                  Unleash Creativity\n                </Text>\n                <Text\n                  tag=\"p\"\n                  variant=\"textSM\"\n                  class=\"mt-2 font-medium text-base-500 \"\n                >\n                  Empower your team to innovate with tools designed for\n                  limitless imagination and seamless collaboration.\n                </Text>\n              </div>\n            </div>\n          </div>\n          <div\n            class=\"flex flex-col justify-between h-full shadow lg:col-span-1 bg-linear-180 outline outline-primary/24 from-primary/16 to-primary/24 rounded-xl\"\n          >\n            <div class=\"w-full p-8\">\n              <Text\n                tag=\"span\"\n                variant=\"textBase\"\n                class=\"font-medium text-base-900 \"\n              >\n                24/7\n              </Text>\n            </div>\n            <div class=\"p-8 border-t border-base-200 \">\n              <Text\n                tag=\"h3\"\n                variant=\"textBase\"\n                class=\"font-medium text-base-900 \"\n              >\n                Always available\n              </Text>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-base-500 \"\n              >\n                Get support and access your resources any time, so your team can\n                keep moving forward without interruption.\n              </Text>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"flex flex-col gap-2\">\n        <div class=\"h-full grid grid-cols-1 gap-2 lg:grid-cols-2\">\n          <div\n            class=\"flex flex-col justify-between h-full shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n          >\n            <div class=\"flex items-center p-8\">\n              <Text\n                tag=\"span\"\n                variant=\"textBase\"\n                class=\"font-medium text-base-900 \"\n              >\n                24/7\n              </Text>\n            </div>\n            <div class=\"p-8 border-t border-base-200 \">\n              <Text\n                tag=\"h3\"\n                variant=\"textBase\"\n                class=\"font-medium text-base-900 \"\n              >\n                Support\n              </Text>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-base-500 \"\n              >\n                Our expert team is always available to help you overcome\n                challenges and reach your goals.\n              </Text>\n            </div>\n          </div>\n          <div class=\"flex flex-col gap-2\">\n            <div\n              class=\"relative flex items-center justify-center h-full p-8 overflow-hidden shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n            >\n              <div>\n                <Kicker> Privacy </Kicker>\n                <Text\n                  tag=\"h3\"\n                  variant=\"textBase\"\n                  class=\"mt-4 font-medium text-base-900 \"\n                >\n                  Security\n                </Text>\n                <Text\n                  tag=\"p\"\n                  variant=\"textSM\"\n                  class=\"mt-2 font-medium text-base-500 \"\n                >\n                  Protect your data with advanced encryption and robust privacy\n                  controls, ensuring peace of mind for your team.\n                </Text>\n              </div>\n            </div>\n            <img\n              src=\"/widgets/calendar.svg\"\n              alt=\"#_\"\n              class=\"shadow size-full rounded-2xl\"\n            />\n          </div>\n        </div>\n        <img\n          src=\"/widgets/figmaComp2.svg\"\n          alt=\"#_\"\n          class=\"shadow size-full rounded-2xl\"\n        />\n      </div>\n    </div>\n  </div>\n</section>\n"
