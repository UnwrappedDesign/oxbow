  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/marketing/stats/04.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst stats = [\n  {\n    label: \"Working Individuals\",\n    description: \"We reached over 30 million users and are growing fast.\",\n    value: \"30%\",\n  },\n  {\n    label: \"Super low fee\",\n    description:\n      \"Enjoy significant savings with our extremely low fee structure.\",\n    value: \"40%\",\n  },\n  {\n    label: \"Great Commitment\",\n    description: \" We’re dedicated to delivering outstanding service and valu.\",\n    value: \"50%\",\n  },\n  {\n    label: \"Massive Earnings\",\n    description: \"Reap the benefits with substantial returns \",\n    value: \"100%\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"grid grid-cols-1 gap-12 lg:grid-cols-3 lg:items-center\">\n      <div class=\"flex flex-col justify-between h-full gap-8\">\n        <div class=\"text-center lg:text-left\">\n          <Kicker> By the Numbers </Kicker>\n          <Text\n            tag=\"h2\"\n            variant=\"displaySM\"\n            class=\"mt-4 font-semibold tracking-tight text-foreground lg:text-balance\"\n          >\n            Transform your finances with proven results\n          </Text>\n          <Text\n            variant=\"textBase\"\n            class=\"mt-4 font-medium text-muted-foreground\"\n          >\n            Our track record speaks volumes—millions of users, minimal fees, and\n            impressive returns.\n          </Text>\n        </div>\n        <div\n          class=\"flex flex-wrap items-center justify-center lg:justify-start gap-2\"\n        >\n          <Button variant=\"accent\" size=\"sm\"> Get started </Button>\n          <Button variant=\"muted\" size=\"sm\"> Learn more </Button>\n        </div>\n      </div>\n      <div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:col-span-2\">\n        {\n          stats.map((stat) => (\n            <div class=\"flex flex-col p-8 shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl\">\n              <Text\n                tag=\"h3\"\n                variant=\"textBase\"\n                class=\"flex items-center font-semibold text-foreground gap-2\"\n              >\n                <span class=\"font-semibold text-foreground\">{stat.value}</span>\n                {stat.label}\n              </Text>\n              <Text\n                tag=\"p\"\n                variant=\"textBase\"\n                class=\"mt-2 font-medium text-muted-foreground\"\n              >\n                {stat.description}\n              </Text>\n            </div>\n          ))\n        }\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
