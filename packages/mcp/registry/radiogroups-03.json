      "content": "---\nexport const description = \"Radio Buttons with Icons\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div class=\"flex justify-center p-16 mx-auto bg-white \">\n  <!-- copy:start -->\n  <div class=\"flex flex-col gap-2\" x-data=\"{ selected: 'email' }\">\n    <div\n      class=\"flex items-center p-4 bg-white border rounded-lg gap-3 border-base-200 \"\n    >\n      <input\n        id=\"radio-email\"\n        name=\"radio-with-icons\"\n        type=\"radio\"\n        value=\"email\"\n        x-model=\"selected\"\n        class=\"text-primary bg-white rounded-full shadow size-4 border-base-300 focus:ring-primary \"\n      />\n      <div class=\"flex items-center gap-3\">\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"24\"\n          height=\"24\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          class=\"icon icon-tabler icons-tabler-outline icon-tabler-mail size-5 text-base-500 \"\n          ><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path><path\n            d=\"M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z\"\n          ></path><path d=\"M3 7l9 6l9 -6\"></path></svg\n        >\n        <Text\n          for=\"radio-email\"\n          tag=\"label\"\n          class=\"block text-sm font-medium text-base-500 \"\n        >\n          Email Notifications\n        </Text>\n      </div>\n    </div>\n\n    <div\n      class=\"flex items-center p-4 bg-white border rounded-lg gap-3 border-base-200 \"\n    >\n      <input\n        id=\"radio-sms\"\n        name=\"radio-with-icons\"\n        type=\"radio\"\n        value=\"sms\"\n        x-model=\"selected\"\n        class=\"text-primary bg-white rounded-full shadow size-4 border-base-300 focus:ring-primary \"\n      />\n      <div class=\"flex items-center gap-3\">\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"24\"\n          height=\"24\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          class=\"icon icon-tabler icons-tabler-outline icon-tabler-device-mobile-message size-5 text-base-500 \"\n          ><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path><path\n            d=\"M11 3h10v8h-3l-4 2v-2h-3z\"></path><path\n            d=\"M15 16v4a1 1 0 0 1 -1 1h-8a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1h2\"\n          ></path><path d=\"M10 18v.01\"></path></svg\n        >\n        <Text\n          for=\"radio-sms\"\n          tag=\"label\"\n          class=\"block text-sm font-medium text-base-500 \"\n        >\n          SMS Notifications\n        </Text>\n      </div>\n    </div>\n\n    <div class=\"mt-2 text-sm text-base-500 \">\n      Selected: <span x-text=\"selected\"></span>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
