      "path": "oxbow/application/emptyStates/05.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"text-base-500\",\n  \"border-b-2\",\n  \"border-base-500\",\n];\n\nexport const description = \"Contextual Empty States\";\n\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\n---\n\n<div class=\"flex items-center justify-center p-8 py-24 \">\n  <!-- copy:start -->\n  <div x-data=\"{ tab: 'tab1' }\">\n    <ul\n      class=\"flex items-center justify-center text-sm border-b gap-4 text-base-500 border-base-200 \"\n    >\n      <li class=\"-mb-px\">\n        <a\n          @click.prevent=\"tab = 'tab1'\"\n          href=\"#_\"\n          class=\"inline-block py-2 font-medium border-b-2 text-base-500 border-base-500 \"\n          :class=\"{ '  text-base-500 border-b-2 border-base-500' : tab === 'tab1' }\"\n        >\n          Marketing</a\n        >\n      </li>\n      <li class=\"-mb-px\">\n        <a\n          @click.prevent=\"tab = 'tab2'\"\n          href=\"#_\"\n          class=\"inline-block py-2 font-medium\"\n          :class=\"{ '  text-base-500 border-b-2 border-base-500' : tab === 'tab2' }\"\n        >\n          Application</a\n        >\n      </li>\n      <li class=\"-mb-px\">\n        <a\n          @click.prevent=\"tab = 'tab3'\"\n          href=\"#_\"\n          class=\"inline-block py-2 font-medium\"\n          :class=\"{ '  text-base-500 border-b-2 border-base-500' : tab === 'tab3' }\"\n        >\n          ECommerce</a\n        >\n      </li>\n    </ul>\n    <div class=\"max-w-xl p-8 mx-auto text-left content\">\n      <div x-show=\"tab==='tab1'\" class=\"text-base-500\">\n        <main>\n          <div class=\"flex flex-col items-center justify-center text-center\">\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              class=\"icon icon-tabler icons-tabler-outline icon-tabler-stack-front size-6 text-base-600 \"\n              ><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path><path\n                d=\"M12 4l-8 4l8 4l8 -4l-8 -4\"\n                fill=\"currentColor\"></path><path d=\"M8 14l-4 2l8 4l8 -4l-4 -2\"\n              ></path><path d=\"M8 10l-4 2l8 4l8 -4l-4 -2\"></path></svg\n            >\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"mt-8 font-medium text-base-900 \"\n            >\n              No Marketing Data\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"w-2/3 mt-2 font-medium text-base-500 text-balance\"\n            >\n              Start creating marketing campaigns to see your performance metrics\n              here.\n            </Text>\n\n            <Button class=\"mx-auto mt-8\" gap=\"xs\" size=\"sm\" variant=\"default\">\n              <Plus size=\"sm\" slot=\"icon\" slot=\"left-icon\" />\n              Create Campaign\n            </Button>\n          </div>\n        </main>\n      </div>\n      <div x-show=\"tab==='tab2'\" class=\"text-base-500\" style=\"display: none\">\n        <main>\n          <div class=\"flex flex-col items-center justify-center text-center\">\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              class=\"icon icon-tabler icons-tabler-outline icon-tabler-stack-front size-6 text-base-600 \"\n              ><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path><path\n                d=\"M12 4l-8 4l8 4l8 -4l-8 -4\"\n                fill=\"currentColor\"></path><path d=\"M8 14l-4 2l8 4l8 -4l-4 -2\"\n              ></path><path d=\"M8 10l-4 2l8 4l8 -4l-4 -2\"></path></svg\n            >\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"mt-8 font-medium text-base-900 \"\n            >\n              No Application Data\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"w-2/3 mt-4 font-medium text-base-500 text-balance\"\n            >\n              Build and integrate applications to view your usage statistics.\n            </Text>\n\n            <Button class=\"mx-auto mt-8\" gap=\"xs\" size=\"sm\" variant=\"default\">\n              <Plus size=\"sm\" slot=\"icon\" slot=\"left-icon\" />\n              Create Application\n            </Button>\n          </div>\n        </main>\n      </div>\n      <div x-show=\"tab==='tab3'\" class=\"text-base-500\" style=\"display: none\">\n        <main>\n          <div class=\"flex flex-col items-center justify-center text-center\">\n            <svg\n              xmlns=\"http://www.w3.org/2000/svg\"\n              width=\"24\"\n              height=\"24\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              class=\"icon icon-tabler icons-tabler-outline icon-tabler-stack-front size-6 text-base-600 \"\n              ><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path><path\n                d=\"M12 4l-8 4l8 4l8 -4l-8 -4\"\n                fill=\"currentColor\"></path><path d=\"M8 14l-4 2l8 4l8 -4l-4 -2\"\n              ></path><path d=\"M8 10l-4 2l8 4l8 -4l-4 -2\"></path></svg\n            >\n            <Text\n              tag=\"h3\"\n              variant=\"textBase\"\n              class=\"mt-8 font-medium text-base-900 \"\n            >\n              No ECommerce Data\n            </Text>\n            <Text\n              tag=\"p\"\n              variant=\"textSM\"\n              class=\"w-2/3 mt-4 font-medium text-base-500 text-balance\"\n            >\n              Start adding products to your store to track sales and inventory.\n            </Text>\n\n            <Button class=\"mx-auto mt-8\" gap=\"xs\" size=\"sm\" variant=\"default\">\n              <Plus size=\"sm\" slot=\"icon\" slot=\"left-icon\" />\n              Add Product\n            </Button>\n          </div>\n        </main>\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
