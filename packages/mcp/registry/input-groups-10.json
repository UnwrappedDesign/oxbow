  "files": [
    {
      "name": "10.astro",
      "path": "oxbow/application/input-groups/10.astro",
      "content": "---\nexport const description = \"Value input group\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n// Icons\nimport ChevronDown from \"@/components/fundations/icons/ChevronDown.astro\";\nimport ChevronUp from \"@/components/fundations/icons/ChevronUp.astro\";\n---\n\n<section class=\"justify-center h-full bg-background gap-2 p-15\">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"w-full space-y-1\" x-data=\"{ value: 50, min: 0, max: 100 }\">\n      <label class=\"text-sm font-medium text-muted-foreground\"> Value </label>\n      <div class=\"flex items-center\">\n        <Button\n          @click=\"value = Math.max(min, value - 1)\"\n          variant=\"outline\"\n          onlyIconSize=\"sm\"\n          noRoundedRight\n        >\n          <ChevronDown slot=\"left-icon\" size=\"sm\" />\n        </Button>\n        <TextInput\n          size=\"sm\"\n          isGrouped={true}\n          noRounded={true}\n          type=\"number\"\n          id=\"input-chevrons\"\n          name=\"input-chevrons\"\n          x-model=\"value\"\n          readonly\n        />\n        <Button\n          @click=\"value = Math.min(max, value + 1)\"\n          variant=\"outline\"\n          onlyIconSize=\"sm\"\n          no\n          noRoundedLeft\n        >\n          <ChevronUp slot=\"right-icon\" size=\"sm\" />\n        </Button>\n      </div>\n    </div>\n    <!-- copy:end -->\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
