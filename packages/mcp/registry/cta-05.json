{
  "name": "cta-05",
  "type": "component",
  "description": "Splited CTA with text-and image",
  "category": "marketing",
  "section": "cta",
  "variant": 5,
  "aliases": [
    "cta",
    "cta 5",
    "cta 05"
  ],
  "files": [
    {
      "name": "05.astro",
      "path": "oxbow/marketing/cta/05.astro",
      "content": "---\nexport const description = \"Splited CTA with text-and image\";\n// Assets\nimport Logo from \"@/components/assets/Logo.astro\";\nimport { Image } from \"astro:assets\";\nimport Activity from \"@/images/assets/activity.svg\";\nimport Avatar1 from \"@/images/avatars/1.jpg\";\n// Foundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Wrapper from \"@/components/fundations/containers/Wrapper.astro\";\nconst data = [\n  {\n    name: \"Tina Byte\",\n    title: \"Pixel Pusher at PushButton\",\n    testimonial:\n      \"I used to design dashboards that even I couldn’t navigate. Then I met Oxbow. Now I spend less time crying into my Tailwind sites and more time pretending I'm productive.\",\n    img: Avatar1,\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div\n      class=\"items-start max-w-md mx-auto grid grid-cols-1 lg:max-w-none md:grid-cols-2 lg:p-20 lg:bg-linear-180 lg:outline lg:outline-border lg:from-background lg:to-background lg:rounded-xl\"\n    >\n      <div class=\"lg:pr-24 md:pr-12\">\n        <Logo class=\"h-12 text-foreground\" />\n        <Text\n          tag=\"h1\"\n          variant=\"displaySM\"\n          class=\"mt-12 font-semibold tracking-tight text-foreground lg:text-balance\"\n        >\n          Finally, a tool that won’t make you question your career choices\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 font-medium text-muted-foreground\"\n        >\n          Say goodbye to clunky workflows, endless tabs, and the vague\n          existential dread of “collaboration.”\n        </Text>\n        <div class=\"flex flex-wrap items-center mt-8 gap-2\">\n          <Button variant=\"accent\" size=\"sm\">Push the button</Button>\n          <Button variant=\"muted\" size=\"sm\">Still skeptical?</Button>\n        </div>\n        <article role=\"list\" class=\"pt-6 mt-6 border-t border-border\">\n          {\n            data.map((member) => (\n              <div>\n                <figure class=\"flex flex-col h-full\">\n                  <Text\n                    tag=\"blockquote\"\n                    variant=\"textSM\"\n                    class=\"italic font-medium text-muted-foreground\"\n                  >\n                    \"{member.testimonial}\"\n                  </Text>\n                  <figcaption>\n                    <div class=\"flex items-center mt-8 gap-2\">\n                      <Image\n                        src={member.img}\n                        alt={`Avatar of ${member.name}`}\n                        width={member.img.width}\n                        height={member.img.height}\n                        class=\"inline-block rounded-full size-12\"\n                        loading=\"lazy\"\n                      />\n                      <div>\n                        <Text\n                          tag=\"p\"\n                          variant=\"textBase\"\n                          class=\"font-medium text-foreground\"\n                        >\n                          {member.name}\n                        </Text>\n                        <Text\n                          tag=\"p\"\n                          variant=\"textSM\"\n                          class=\"font-medium text-muted-foreground\"\n                        >\n                          {member.title}\n                        </Text>\n                      </div>\n                    </div>\n                  </figcaption>\n                </figure>\n              </div>\n            ))\n          }\n        </article>\n      </div>\n      <div class=\"z-10 h-full mt-12 lg:-mt-32\">\n        <Image\n          src={Activity}\n          width={600}\n          height={800}\n          alt=\"Product showcase\"\n          loading=\"eager\"\n          decoding=\"async\"\n          class=\"w-full shadow rounded-xl outline outline-border\"\n        />\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
