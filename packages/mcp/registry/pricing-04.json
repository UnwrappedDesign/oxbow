{
  "name": "pricing-04",
  "type": "component",
  "description": "Single usage based pricing card",
  "category": "marketing",
  "section": "pricing",
  "variant": 4,
  "aliases": [
    "pricing",
    "pricing 4",
    "pricing 04"
  ],
  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/marketing/pricing/04.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"w-1/2\",\n  \"translate-x-0\",\n  \"translate-x-full\",\n  \"text-muted-foreground\",\n  \"text-foreground\",\n  \"focus:text-foreground\",\n  \"hover:text-foreground\",\n];\n\nexport const description = \"Single usage based pricing card\";\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n// Icons\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\nimport Clock from \"@/components/fundations/icons/Clock.astro\";\nimport Refresh from \"@/components/fundations/icons/Refresh.astro\";\nimport Database from \"@/components/fundations/icons/Database.astro\";\nimport Lifebuoy from \"@/components/fundations/icons/Lifebuoy.astro\";\nimport Brain from \"@/components/fundations/icons/Brain.astro\";\nimport ArrowIteration from \"@/components/fundations/icons/ArrowIteration.astro\";\nimport Lock from \"@/components/fundations/icons/Lock.astro\";\nconst pricingTiers = [\n  { amount: \"5,000\", monthly: \"$29\", annual: \"$19\" },\n  { amount: \"7,500\", monthly: \"$39\", annual: \"$27\" },\n  { amount: \"10,000\", monthly: \"$49\", annual: \"$35\" },\n  { amount: \"12,500\", monthly: \"$59\", annual: \"$42\" },\n];\n---\n\n<section x-data=\"{ duration: 'monthly' }\" class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"items-end grid grid-cols-1 lg:grid-cols-2\">\n      <div>\n        <Text\n          tag=\"h1\"\n          variant=\"displaySM\"\n          class=\"font-semibold tracking-tight text-foreground lg:text-balance\"\n        >\n          Equip your business with world class software\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-2 font-medium text-muted-foreground lg:text-balance\"\n        >\n          Choose a plan that works the best for you and your team. Start small,\n          upgrade when you need to.\n        </Text>\n      </div>\n      <div\n        aria-labelledby=\"pricing-toggle\"\n        class=\"relative z-0 inline-flex justify-center w-full p-1 mx-auto mt-8 overflow-hidden bg-background shadow ring-1 ring-border ring-offset-2 gap-4 lg:mx-0 rounded-md max-w-52 ring-offset-background lg:ml-auto\"\n      >\n        <div\n          class=\"absolute inset-0 bg-muted rounded-md ring-1 ring-border/60 shadow-sm transition-transform duration-200 ease-in-out\"\n          :class=\"duration === 'monthly' ? 'w-1/2 translate-x-0' : 'w-1/2 translate-x-full'\"\n        >\n        </div>\n        <button\n          class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n          :class=\"duration === 'monthly' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground focus:text-foreground'\"\n          @click=\"duration = 'monthly'\"\n          type=\"button\"\n          :aria-pressed=\"duration === 'monthly'\"\n        >\n          Monthly\n        </button>\n        <button\n          class=\"relative z-10 flex items-center justify-center w-full h-6 px-2 text-xs font-medium focus:outline-none transition-colors duration-300\"\n          :class=\"duration === 'annual' ? 'text-foreground' : 'text-muted-foreground hover:text-foreground focus:text-foreground'\"\n          @click=\"duration = 'annual'\"\n          type=\"button\"\n          :aria-pressed=\"duration === 'annual'\"\n        >\n          Annual\n        </button>\n      </div>\n    </div>\n    <div class=\"flex flex-col mt-8 gap-2\">\n      <div\n        class=\"p-4 overflow-hidden shadow bg-background outline outline-border rounded-xl\"\n      >\n        <div class=\"grid md:grid-cols-12\">\n          <div class=\"p-4 md:col-span-7 sm:p-8\">\n            <div class=\"flex items-center gap-2\">\n              <Text\n                tag=\"h2\"\n                variant=\"textLG\"\n                class=\"font-medium text-foreground\"\n              >\n                AI Add-Ons —\n                <span class=\"font-normal text-muted-foreground\">\n                  Oxbow UI gives your AI tools the upgrade they didn't know they\n                  needed.\n                </span>\n              </Text>\n            </div>\n            <div class=\"mt-12 grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-4\">\n              <div class=\"flex items-center text-sm gap-2\">\n                <div class=\"text-muted-foreground\">\n                  <Clock size=\"sm\" />\n                </div>\n                <span class=\"text-muted-foreground\">\n                  <span class=\"font-medium text-foreground\">30 day</span> model retention\n                </span>\n              </div>\n\n              <div class=\"flex items-center text-sm gap-2\">\n                <div class=\"text-muted-foreground\">\n                  <Refresh size=\"base\" />\n                </div>\n                <span class=\"text-muted-foreground\">\n                  <span class=\"font-medium text-foreground\">5,000</span> AI calls/month\n                </span>\n              </div>\n\n              <div class=\"flex items-center text-sm gap-2\">\n                <div class=\"text-muted-foreground\">\n                  <Database size=\"base\" />\n                </div>\n                <span class=\"text-muted-foreground\"\n                  >Custom model rebuilding</span\n                >\n              </div>\n\n              <div class=\"flex items-center text-sm gap-2\">\n                <div class=\"text-muted-foreground\">\n                  <Lifebuoy size=\"base\" />\n                </div>\n                <span class=\"text-muted-foreground\"\n                  >Training validation included</span\n                >\n              </div>\n\n              <div class=\"flex items-center text-sm gap-2\">\n                <div class=\"text-muted-foreground\">\n                  <Brain size=\"base\" />\n                </div>\n                <span class=\"text-muted-foreground\"\n                  >Real-time inference feedback</span\n                >\n              </div>\n\n              <div class=\"flex items-center text-sm gap-2\">\n                <div class=\"text-muted-foreground\">\n                  <Lock size=\"base\" />\n                </div>\n                <span class=\"text-muted-foreground\"\n                  >One-click prompt tuning</span\n                >\n              </div>\n            </div>\n\n            <div class=\"flex mt-12 gap-2\">\n              <Button variant=\"default\" size=\"sm\"> Start Using AI </Button>\n              <Button variant=\"muted\" size=\"sm\"> Get a Demo </Button>\n            </div>\n          </div>\n          <div\n            class=\"flex flex-col justify-between h-full bg-background md:col-span-5 outline outline-border rounded-xl\"\n          >\n            <div class=\"p-4 grid grid-cols-2\">\n              <Text\n                tag=\"h3\"\n                variant=\"textBase\"\n                class=\"font-semibold text-foreground\">Monthly requests</Text\n              >\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"font-semibold text-right text-muted-foreground\"\n                >Pricing</Text\n              >\n            </div>\n            <div class=\"divide-y divide-border\">\n              {\n                pricingTiers.map((tier) => (\n                  <div class=\"p-4 grid grid-cols-2\">\n                    <div class=\"font-medium text-muted-foreground\">\n                      {tier.amount}\n                    </div>\n                    <div class=\"font-medium text-right text-foreground\">\n                      <Text\n                        tag=\"p\"\n                        variant=\"textBase\"\n                        class=\"font-medium text-foreground\"\n                      >\n                        <span\n                          data-monthly={tier.monthly}\n                          data-annual={tier.annual}\n                          x-text=\"$el.dataset[duration]\"\n                        />\n                        <span x-show=\"duration==='monthly'\">/m</span>\n                        <span\n                          x-show=\"duration==='annual'\"\n                          style=\"display: none\"\n                        >\n                          /m\n                        </span>\n                      </Text>\n                    </div>\n                  </div>\n                ))\n              }\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"p-4 shadow bg-background outline outline-border rounded-xl\">\n        <div\n          class=\"flex flex-col lg:flex-row gap-4 lg:justify-between lg:items-center\"\n        >\n          <div class=\"flex flex-col items-start sm:flex-row gap-2\">\n            <div\n              class=\"p-3 bg-background rounded-lg outline outline-border text-foreground\"\n            >\n              <Plus size=\"base\" />\n            </div>\n            <div>\n              <Text\n                tag=\"h2\"\n                variant=\"textLG\"\n                class=\"font-medium text-foreground\">Enterprise</Text\n              >\n              <Text tag=\"p\" variant=\"textSM\" class=\"text-muted-foreground\">\n                Built for teams that move fast, break stuff, and need more\n                firepower than your average startup plan allows.\n              </Text>\n            </div>\n          </div>\n\n          <Button variant=\"muted\" size=\"sm\"> Contact Us </Button>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
