      "content": "---\nexport const description = \"Checkbox with Border and Icon\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full p-24 bg-white gap-2 \"\n>\n  <!-- copy:start -->\n  <div\n    class=\"flex items-start p-4 bg-white border rounded-lg gap-3 border-base-200 \"\n  >\n    <div class=\"flex items-start gap-3\">\n      <input\n        id=\"marketing-checkbox\"\n        name=\"marketing-checkbox\"\n        type=\"checkbox\"\n        class=\"text-primary rounded shadow size-4 border-base-300 focus:ring-primary \"\n      />\n      <div>\n        <Text\n          for=\"marketing-checkbox\"\n          tag=\"label\"\n          class=\"block text-sm font-medium text-base-500 \"\n        >\n          Enable marketing emails <span class=\"text-base-400 \"\n            >(Optional)</span\n          >\n        </Text>\n        <p class=\"text-sm text-base-400 \">\n          By checking this box, you agree to receive occasional marketing emails\n          about updates, offers, and promotions.\n        </p>\n      </div>\n    </div>\n    <div class=\"ml-auto\">\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"24\"\n        height=\"24\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"text-primary/88 icon icon-tabler icons-tabler-outline icon-tabler-gift size-6\"\n        ><path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"></path><path\n          d=\"M3 8m0 1a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1z\"\n        ></path><path d=\"M12 8l0 13\"></path><path\n          d=\"M19 12v7a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-7\"></path><path\n          d=\"M7.5 8a2.5 2.5 0 0 1 0 -5a4.8 8 0 0 1 4.5 5a4.8 8 0 0 1 4.5 -5a2.5 2.5 0 0 1 0 5\"\n        ></path></svg\n      >\n    </div>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
