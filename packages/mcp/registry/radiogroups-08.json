      "name": "08.astro",
      "path": "oxbow/application/radiogroups/08.astro",
      "content": "---\nexport const description = \"Radio Group for Server Location\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Badge from \"@/components/fundations/badges/Badge.astro\";\n---\n\n<div class=\"flex justify-center mx-auto bg-background p-17\">\n  <!-- copy:start -->\n  <div class=\"flex gap-6\" x-data=\"{ location: 'usa' }\">\n    <div class=\"flex items-center gap-3\">\n      <input\n        id=\"radio-usa\"\n        name=\"server-location\"\n        type=\"radio\"\n        value=\"usa\"\n        x-model=\"location\"\n        class=\"text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border\"\n      />\n      <label for=\"radio-usa\" class=\"block text-sm text-muted-foreground\">USA</label>\n    </div>\n    <div class=\"flex items-center gap-3\">\n      <input\n        id=\"radio-europe\"\n        name=\"server-location\"\n        type=\"radio\"\n        value=\"europe\"\n        x-model=\"location\"\n        class=\"text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border\"\n      />\n      <label for=\"radio-europe\" class=\"block text-sm text-muted-foreground\"\n        >Europe</label\n      >\n    </div>\n    <div class=\"flex items-center gap-3\">\n      <input\n        id=\"radio-asia\"\n        name=\"server-location\"\n        type=\"radio\"\n        value=\"asia\"\n        x-model=\"location\"\n        class=\"text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border\"\n      />\n      <label for=\"radio-asia\" class=\"block text-sm text-muted-foreground\">Asia</label>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
