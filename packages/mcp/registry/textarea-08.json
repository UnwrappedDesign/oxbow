  "files": [
    {
      "name": "08.astro",
      "path": "oxbow/application/textarea/08.astro",
      "content": "---\nexport const description = \"Textarea with Clear Button\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-background\">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"w-full space-y-2\" x-data=\"{ text: '' }\">\n      <div>\n        <Text\n          for=\"clearable-textarea\"\n          tag=\"label\"\n          variant=\"textSM\"\n          class=\"font-medium text-muted-foreground\"\n        >\n          Clearable textarea\n        </Text>\n        <textarea\n          id=\"clearable-textarea\"\n          x-model=\"text\"\n          rows=\"4\"\n          placeholder=\"Type your message\"\n          class=\"block w-full px-4 py-2 text-sm text-foreground bg-background border border-transparent rounded-lg appearance-none duration-300 ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n        ></textarea>\n      </div>\n      <Button\n        @click=\"text = ''\"\n        type=\"button\"\n        @click=\"draft = text\"\n        variant=\"muted\"\n        size=\"sm\"\n        class=\"ml-auto\"\n      >\n        Clear\n      </Button>\n    </div>\n    <!-- copy:end -->\n  </div>\n</div>\n"
    }
  ],
