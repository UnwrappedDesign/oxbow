{
  "name": "marketing-heros-03",
  "type": "component",
  "description": "Split with image",
  "category": "marketing",
  "section": "marketing-heros",
  "variant": 3,
  "aliases": [
    "marketing heros",
    "marketing heros 3",
    "marketing heros 03",
    "hero",
    "hero 3",
    "hero 03",
    "heroes",
    "heroes 3",
    "heroes 03"
  ],
  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/marketing/marketing-heros/03.astro",
      "content": "---\nexport const description = \"Split with image\";\nimport { Image } from \"astro:assets\";\nimport DashboardLight from \"@/images/assets/dashboardLight.svg\";\nimport Avatar1 from \"@/images/avatars/1.jpg\";\nimport Avatar2 from \"@/images/avatars/2.jpg\";\nimport Avatar3 from \"@/images/avatars/3.jpg\";\nimport Avatar4 from \"@/images/avatars/4.jpg\";\nconst avatars = [\n  { src: Avatar1, alt: \"#_\" },\n  { src: Avatar2, alt: \"#_\" },\n  { src: Avatar3, alt: \"#_\" },\n  { src: Avatar4, alt: \"#_\" },\n];\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Kicker from \"@/components/fundations/typography/Kicker.astro\";\n---\n\n<section class=\"relative overflow-hidden bg-white \">\n  <div class=\"relative items-center p-8 mx-auto max-w-7xl lg:flex\">\n    <div\n      class=\"max-w-2xl mx-auto lg:mx-0 lg:max-w-xl lg:flex-shrink-0 lg:pl-28\"\n    >\n      <Text\n        tag=\"h1\"\n        variant=\"displayLG\"\n        class=\"font-semibold tracking-tight text-base-900 lg:text-balance\"\n      >\n        Tools that help you move faster\n      </Text>\n      <Text\n        class=\"mt-4 text-base-500 lg:text-balance\"\n        tag=\"p\"\n        variant=\"textBase\"\n      >\n        Integrate in minutes, not days. Oxbow adapts to your workflow and lets\n        you focus on what matters—shipping great products.\n      </Text>\n\n      <div class=\"flex flex-wrap items-center mx-auto mt-8 gap-2\">\n        <Button variant=\"accent\" size=\"sm\">Start building</Button>\n        <Button variant=\"muted\" size=\"sm\">See pricing</Button>\n      </div>\n      <div class=\"flex flex-wrap items-center mt-8 gap-2\">\n        <div class=\"flex -space-x-2\">\n          {\n            avatars.map((avatar) => (\n              <Image\n                width={200}\n                height={200}\n                src={avatar.src}\n                alt={avatar.alt}\n                class=\"inline-block object-cover object-center rounded-full size-8 outline-2 outline-white \"\n              />\n            ))\n          }\n        </div>\n        <div class=\"text-xs text-base-500 lg:items-center\">\n          <span class=\"block\">Trusted by teams</span>\n          <span class=\"block\">who value speed and simplicity</span>\n        </div>\n      </div>\n    </div>\n    <div\n      class=\"flex max-w-2xl mx-auto mt-16 sm:mt-24 lg:ml-10 lg:mr-0 lg:mt-0 lg:max-w-none lg:flex-none xl:ml-32\"\n    >\n      <div class=\"flex-none max-w-3xl sm:max-w-5xl lg:max-w-none\">\n        <div class=\"lg:-m-4\">\n          <Image\n            width={1200}\n            height={1200}\n            loading=\"eager\"\n            decoding=\"async\"\n            alt=\"dashboard\"\n            src={DashboardLight}\n            class=\"w-[76rem] shadow outline rounded-lg outline-base-200 \"\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
