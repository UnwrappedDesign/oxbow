  "files": [
    {
      "name": "08.astro",
      "path": "oxbow/marketing/features/08.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\nimport Filters from \"@/components/fundations/icons/Filters.astro\";\nimport WaveSquare from \"@/components/fundations/icons/WaveSquare.astro\";\nimport ArrowIteration from \"@/components/fundations/icons/ArrowIteration.astro\";\nconst listItems = [\n  \"Real-time analytics\",\n  \"Optimized workflows\",\n  \"Robust security\",\n  \"Unified integrations\",\n  \"Streamlined operations\",\n  \"Scalable solutions\",\n];\nconst data = [\n  {\n    icon: \"Filters\",\n    category: \"Interactive Filtering\",\n    text: \"Filter and customize data views on the fly for tailored insights.\",\n  },\n  {\n    icon: \"WaveSquare\",\n    category: \"Dynamic Layouts\",\n    text: \"Automatically adapt your interface to display content optimally on any device.\",\n  },\n  {\n    icon: \"ArrowIteration\",\n    category: \"Iterative Enhancements\",\n    text: \"Continuously refine your workflows with intelligent feedback loops.\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"items-end grid grid-cols-1 gap-12 lg:grid-cols-2\">\n      <Text\n        tag=\"h2\"\n        variant=\"displaySM\"\n        class=\"font-semibold tracking-tight text-foreground text-balance\"\n      >\n        Driving innovation in modern finance\n      </Text>\n      <ul\n        class=\"text-base font-medium grid grid-cols-1 gap-2 text-foreground sm:grid-cols-2 lg:grid-cols-2\"\n      >\n        {\n          listItems.map((item, index) => (\n            <li>\n              <div class=\"flex flex-row items-center gap-2\">\n                <CircleCheck\n                  class=\"text-muted-foreground\"\n                  size=\"sm\"\n                />\n                <Text tag=\"span\" variant=\"textSM\">\n                  {item}\n                </Text>\n              </div>\n            </li>\n          ))\n        }\n      </ul>\n    </div>\n    <div class=\"mt-6 grid grid-cols-1 gap-12 sm:grid-cols-2\">\n      <div\n        class=\"h-full p-8 pb-0 overflow-hidden bg-background rounded-2xl\"\n      >\n        <img\n          class=\"object-center w-full -mb-12 shadow rounded-t-2xl\"\n          src=\"/widgets/sliders.svg\"\n          alt=\"#_\"\n        />\n      </div>\n      <div\n        class=\"h-full p-8 pb-0 overflow-hidden bg-muted/40 rounded-2xl\"\n      >\n        <img\n          class=\"object-center w-full -mb-12 shadow rounded-t-2xl\"\n          src=\"/widgets/progressCircles.svg\"\n          alt=\"#_\"\n        />\n      </div>\n    </div>\n    <dl\n      class=\"mt-12 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-16\"\n    >\n      {\n        data.map((section) => (\n          <div>\n            <div class=\"flex items-center text-muted-foreground gap-3\">\n              {section.icon === \"Filters\" && (\n                <Filters class=\"text-muted-foreground\" size=\"base\" />\n              )}\n              {section.icon === \"WaveSquare\" && (\n                <WaveSquare\n                  class=\"text-muted-foreground\"\n                  size=\"base\"\n                />\n              )}\n              {section.icon === \"ArrowIteration\" && (\n                <ArrowIteration\n                  class=\"text-muted-foreground\"\n                  size=\"base\"\n                />\n              )}\n\n              <dt>\n                <Text\n                  tag=\"h3\"\n                  variant=\"textBase\"\n                  class=\"font-semibold text-foreground\"\n                >\n                  {section.category}\n                </Text>\n              </dt>\n            </div>\n            <dd>\n              <Text\n                tag=\"p\"\n                variant=\"textSM\"\n                class=\"mt-2 font-medium text-muted-foreground\"\n              >\n                {section.text}\n              </Text>\n            </dd>\n          </div>\n        ))\n      }\n    </dl>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
