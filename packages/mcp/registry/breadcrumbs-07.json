  "files": [
    {
      "name": "07.astro",
      "path": "oxbow/application/breadcrumbs/07.astro",
      "content": "---\nexport const description = \"Scrollable Breadcrumb (Overflow)\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport ChevronRight from \"@/components/fundations/icons/ChevronRight.astro\";\n---\n\n<section class=\"flex items-center justify-center bg-background p-18\">\n  <!-- copy:start -->\n  <nav aria-label=\"Breadcrumb\" class=\"max-w-2xl mx-auto\">\n    <div class=\"flex items-center gap-2\">\n      <Text\n        tag=\"a\"\n        href=\"#_\"\n        class=\"hidden text-sm text-muted-foreground hover:text-foreground md:block\"\n        >Home</Text\n      >\n      <ChevronRight\n        size=\"base\"\n        class=\"hidden text-muted-foreground md:block\"\n        aria-hidden=\"true\"\n      />\n      <div class=\"relative flex-1\">\n        <div\n          class=\"flex overflow-x-auto snap-x snap-mandatory gap-1 scrollbar-thin scrollbar-thumb-muted\"\n        >\n          {\n            Array.from({ length: 2 }).map((_, i) => (\n              <div class=\"flex items-center gap-1 snap-start shrink-0\">\n                <Text\n                  tag=\"a\"\n                  href=\"#_\"\n                  class=\"text-sm text-muted-foreground hover:text-foreground\"\n                >\n                  Section {i + 1}\n                </Text>\n                <ChevronRight\n                  size=\"base\"\n                  class=\"text-muted-foreground\"\n                  aria-hidden=\"true\"\n                />\n              </div>\n            ))\n          }\n          <span class=\"text-sm font-medium text-foreground\" aria-current=\"page\"\n            >Current</span\n          >\n        </div>\n      </div>\n    </div>\n  </nav>\n  <!-- copy:end -->\n</section>\n"
    }
  ],
  "dependencies": [],
