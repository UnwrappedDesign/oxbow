    {
      "name": "02.astro",
      "path": "oxbow/marketing/footers/02.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport XBrand from \"@/components/fundations/icons/XBrand.astro\";\nimport Logo from \"@/components/assets/Logo.astro\";\nimport LinkedinBrand from \"@/components/fundations/icons/LinkedinBrand.astro\";\nimport YoutubeBrand from \"@/components/fundations/icons/YoutubeBrand.astro\";\nimport GithubBrand from \"@/components/fundations/icons/GithubBrand.astro\";\nconst footerLinks = [\n  {\n    heading: \"Company \",\n    links: [\n      { href: \"#\", text: \"About\" },\n      { href: \"#\", text: \"Mission\" },\n      { href: \"#\", text: \"Leadership Team\" },\n      { href: \"#\", text: \"History\" },\n    ],\n  },\n  {\n    heading: \" Services\",\n    links: [\n      { href: \"#\", text: \"Marketing\" },\n      { href: \"#\", text: \"Analytics\" },\n      { href: \"#\", text: \"Commerce\" },\n      { href: \"#\", text: \"Insights\" },\n    ],\n  },\n  {\n    heading: \"Resources\",\n    links: [\n      { href: \"#\", text: \"Documentation\" },\n      { href: \"#\", text: \"Guides\" },\n      { href: \"#\", text: \"Webinars\" },\n      { href: \"#\", text: \"White Papers\" },\n    ],\n  },\n  {\n    heading: \"Support & Legal\",\n    links: [\n      { href: \"#\", text: \"Pricing\" },\n      { href: \"#\", text: \"API Status\" },\n      { href: \"#\", text: \"Live Chat\" },\n      { href: \"#\", text: \"Email Support\" },\n    ],\n  },\n];\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div\n      class=\"grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-x-8 gap-y-24\"\n    >\n      <Logo\n        class=\"h-12 text-base-900 col-span-full md:col-span-1\"\n      />\n\n      {\n        footerLinks.map((section, index) => (\n          <div class=\"space-y-4\">\n            <nav aria-labelledby={`footer-heading-${index}`}>\n              <Text\n                tag=\"h2\"\n                variant=\"textBase\"\n                id={`footer-heading-${index}`}\n                class=\"font-semibold text-base-900 \"\n              >\n                {section.heading}\n              </Text>\n              <ul class=\"mt-4\">\n                {section.links.map((link) => (\n                  <li>\n                    <a\n                      href=\"#_\"\n                      class=\"text-sm font-medium text-base-600 hover:text-primary \"\n                    >\n                      {link.text}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </nav>\n          </div>\n        ))\n      }\n    </div>\n    <div\n      class=\"flex flex-col justify-between pt-12 mt-12 border-t gap-8 sm:flex-row sm:items-center border-base-200 \"\n    >\n      <Text\n        tag=\"h2\"\n        variant=\"textSM\"\n        class=\"font-medium text-base-400 \"\n      >\n        Copyright © 2024 Oxbow UI. All rights reserved.\n      </Text>\n      <nav\n        aria-labelledby=\"social-icons-heading\"\n        role=\"navigation\"\n        class=\"flex items-center gap-4 text-base-500\"\n      >\n        <Text id=\"social-icons-heading\" class=\"sr-only\">\n          Follow us on social media\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"text-sm font-medium text-base-900 hover:text-primary \"\n        >\n          <XBrand size=\"sm\" />\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"font-medium hover:text-primary/88 text-base-500 \"\n        >\n          <LinkedinBrand size=\"sm\" />\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"font-medium hover:text-primary/88 text-base-500 \"\n        >\n          <GithubBrand size=\"sm\" />\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"font-medium hover:text-primary/88 text-base-500 \"\n        >\n          <YoutubeBrand size=\"sm\" />\n        </Text>\n      </nav>\n    </div>\n  </div>\n</section>\n"
    }
  ],
