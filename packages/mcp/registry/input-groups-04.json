      "name": "04.astro",
      "path": "oxbow/application/input-groups/04.astro",
      "content": "---\nexport const description = \"Search input group\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n---\n\n<section class=\"justify-center h-full bg-background gap-2 p-15\">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"flex w-full\">\n      <TextInput\n        id=\"search\"\n        name=\"search\"\n        type=\"search\"\n        placeholder=\"Search...\"\n        variant=\"default\"\n        size=\"sm\"\n        noRoundedRight\n        isGrouped\n        class=\"flex-1\"\n      />\n      <Button type=\"submit\" size=\"sm\" variant=\"outline\" noRoundedLeft={true}>\n        Search\n      </Button>\n    </div>\n    <!-- copy:end -->\n  </div>\n</section>\n"
    }
