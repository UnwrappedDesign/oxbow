    {
      "name": "09.astro",
      "path": "oxbow/application/tabs/09.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"bg-base-600\",\n  \"text-base-600\",\n  \"ring-1\",\n  \"ring-base-200\",\n  \"bg-base-50\",\n];\n---\n\n<div class=\"flex flex-col justify-center p-8 mx-auto bg-white \">\n  <!-- Accessible Tabs • Justified filled tabs -->\n  <div\n    x-data=\"{\n      keys: ['overview','projects','packages'],\n      selected: 'overview',\n      focus: 0,\n      init(){ this.focus = 0 },\n      select(id){ this.selected = id; this.focus = this.keys.indexOf(id) },\n      onKeydown(e){ const last=this.keys.length-1; let i=this.focus;\n        if(e.key==='ArrowRight'||e.key==='ArrowDown') i=i===last?0:i+1;\n        else if(e.key==='ArrowLeft'||e.key==='ArrowUp') i=i===0?last:i-1;\n        else if(e.key==='Home') i=0; else if(e.key==='End') i=last; else return;\n        e.preventDefault(); const id=this.keys[i]; this.focus=i; this.$nextTick(()=>this.$refs['tab-'+id]?.focus()); }\n    }\"\n    class=\"w-full max-w-3xl mx-auto\"\n  >\n    <div\n      role=\"tablist\"\n      aria-orientation=\"horizontal\"\n      class=\"grid grid-cols-3 gap-2\"\n    >\n      <template x-for=\"(id, idx) in keys\" :key=\"id\">\n        <button\n          class=\"h-10 px-3 text-sm font-medium rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-base-500/50\"\n          :id=\"'tab-'+id\"\n          role=\"tab\"\n          :aria-selected=\"selected===id\"\n          :tabindex=\"focus===idx?0:-1\"\n          :aria-controls=\"'panel-'+id\"\n          x-ref=\"tab-[[id]]\"\n          @click=\"select(id)\"\n          @keydown=\"onKeydown($event)\"\n          :class=\"selected===id ? 'bg-base-600 text-white ' : 'bg-base-50 text-base-700 hover:text-base-900 ring-1 ring-base-200 '\"\n        >\n          <span\n            x-text=\"id==='overview' ? 'Overview' : id==='projects' ? 'Projects' : 'Packages'\"\n          ></span>\n        </button>\n      </template>\n    </div>\n    <div class=\"pt-4 text-sm text-base-500 \">\n      <section\n        x-show=\"selected==='overview'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-overview'\"\n        aria-labelledby=\"tab-overview\"\n        class=\"p-4 border rounded-lg border-base-200 \"\n      >\n        <p>Overview content — full-width tab buttons with solid fill.</p>\n      </section>\n      <section\n        x-show=\"selected==='projects'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-projects'\"\n        aria-labelledby=\"tab-projects\"\n        class=\"p-4 border rounded-lg border-base-200 \"\n      >\n        <p>Projects content — team boards and workflows.</p>\n      </section>\n      <section\n        x-show=\"selected==='packages'\"\n        x-cloak\n        role=\"tabpanel\"\n        :id=\"'panel-packages'\"\n        aria-labelledby=\"tab-packages\"\n        class=\"p-4 border rounded-lg border-base-200 \"\n      >\n        <p>Packages content — publishing and releases.</p>\n      </section>\n    </div>\n  </div>\n</div>\n"
    }
  ],
