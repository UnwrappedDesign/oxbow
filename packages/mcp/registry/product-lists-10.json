{
  "name": "product-lists-10",
  "type": "component",
  "description": "Simple cards with color name and choices",
  "category": "ecommerce",
  "section": "product-lists",
  "variant": 10,
  "aliases": [
    "product lists",
    "product lists 10",
    "product list",
    "product list 10"
  ],
  "files": [
    {
      "name": "10.astro",
      "path": "oxbow/ecommerce/product-lists/10.astro",
      "content": "---\nexport const description = \"Simple cards with color name and choices\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nconst products = [\n  {\n    image: \"/store/jackets/1.png\",\n    title: \"Contrast Hooded Puch Pocket\",\n    price: \"$140.00\",\n    description: \"Charcoal +3\",\n    colors: [\"bg-[#454648]\"],\n    link: \"#_\",\n  },\n  {\n    image: \"/store/jackets/2.png\",\n    title: \"Nike Air Force 1 LE\",\n    price: \"$280.00\",\n    description: \"Gray +5\",\n    colors: [\"bg-[#c9c7c2]\"],\n    link: \"#_\",\n  },\n  {\n    image: \"/store/jackets/3.png\",\n    title: \"Nike Air Max 90\",\n    price: \"$120.00\",\n    description: \"Nero +2\",\n    colors: [\"bg-[#252525]\"],\n    link: \"#_\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <div class=\"relative grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n      {\n        products.map((article) => (\n          <div class=\"relative\">\n            <div class=\"relative aspect-[8/10] w-full overflow-hidden rounded-lg\">\n              <img\n                src={article.image}\n                alt=\"#_\"\n                class=\"object-cover size-full\"\n              />\n            </div>\n            <div class=\"mt-2\">\n              <div class=\"flex items-center justify-between w-full\">\n                <Text\n                  tag=\"h3\"\n                  variant=\"textSM\"\n                  class=\"font-medium text-foreground\"\n                >\n                  {article.title}\n                </Text>\n                <Text\n                  tag=\"p\"\n                  variant=\"textSM\"\n                  class=\"relative flex items-center text-muted-foreground gap-x-1\"\n                >\n                  {article.price}\n                </Text>\n              </div>\n              <div class=\"flex items-center gap-1\">\n                <ul role=\"list\" class=\"flex items-center gap-x-1\">\n                  {article.colors.map((color, index) => (\n                    <li\n                      class={`size-3 rounded-full border border-border/10 ${color}`}\n                    >\n                      <span class=\"sr-only\">{color}</span>\n                    </li>\n                  ))}\n                </ul>\n                <Text tag=\"p\" variant=\"textSM\" class=\"text-muted-foreground\">\n                  {article.description}\n                  <a href=\"#_\">\n                    <span class=\"absolute inset-0\" />\n                  </a>\n                </Text>\n              </div>\n            </div>\n          </div>\n        ))\n      }\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
