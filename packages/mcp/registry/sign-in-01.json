{
  "name": "sign-in-01",
  "type": "component",
  "description": "Sign in with magic link",
  "category": "application",
  "section": "sign-in",
  "variant": 1,
  "aliases": [
    "sign in",
    "sign in 1",
    "sign in 01"
  ],
  "files": [
    {
      "name": "01.astro",
      "path": "oxbow/application/sign-in/01.astro",
      "content": "---\nexport const freeComponent = true;\nexport const description = \"Sign in with magic link\";\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n---\n\n<section>\n  <div\n    class=\"relative px-8 py-32 mx-auto bg-background md:px-12 lg:px-24 max-w-7xl\"\n  >\n    <div\n      class=\"max-w-md p-8 mx-auto shadow bg-linear-180 outline outline-border from-muted to-background rounded-xl\"\n    >\n      <div class=\"text-center\">\n        <Text\n          tag=\"h1\"\n          variant=\"displayMD\"\n          class=\"font-medium tracking-tight text-foreground\"\n        >\n          Magic, but make it login\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 text-muted-foreground text-balance\"\n        >\n          Drop your email below. We'll zap a link to your inbox, no passwords,\n          no drama, just login magic.\n        </Text>\n      </div>\n      <form class=\"mt-10 space-y-4\">\n        <TextInput\n          id=\"email\"\n          name=\"email\"\n          label=\"Email Address\"\n          type=\"email\"\n          variant=\"default\"\n          size=\"base\"\n          placeholder=\"you@example.com\"\n        />\n        <Button fullWidth variant=\"accent\" size=\"base\">\n          Send magic link\n        </Button>\n      </form>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
