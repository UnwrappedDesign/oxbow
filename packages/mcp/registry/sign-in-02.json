{
  "name": "sign-in-02",
  "type": "component",
  "description": "Centered sign in block",
  "category": "application",
  "section": "sign-in",
  "variant": 2,
  "aliases": [
    "sign in",
    "sign in 2",
    "sign in 02"
  ],
  "files": [
    {
      "name": "02.astro",
      "path": "oxbow/application/sign-in/02.astro",
      "content": "---\nexport const description = \"Centered sign in block\";\n// Fundations\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Checkbox from \"@/components/fundations/inputs/Checkbox.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n// Icons\nimport GoogleColor from \"@/components/fundations/icons/GoogleColor.astro\";\n---\n\n<section class=\"bg-white \">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div\n      class=\"max-w-md p-8 mx-auto shadow bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl\"\n    >\n      <div class=\"text-center lg:text-balance\">\n        <Text\n          tag=\"h1\"\n          variant=\"displaySM\"\n          class=\"font-semibold tracking-tight text-base-900 \"\n        >\n          Sign in\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 text-base-500 text-balance\"\n        >\n          Welcome back! Fire up that password muscle memory, just like the good\n          old dial-up days.\n        </Text>\n      </div>\n      <form class=\"mt-10 space-y-4\">\n        <TextInput\n          id=\"email\"\n          name=\"email\"\n          label=\"Email Address\"\n          type=\"email\"\n          variant=\"default\"\n          size=\"base\"\n          placeholder=\"you@example.com\"\n        />\n        <TextInput\n          id=\"password\"\n          name=\"password\"\n          label=\"Password\"\n          type=\"password\"\n          passwordToggle={true}\n          size=\"base\"\n          placeholder=\"••••••••\"\n          required\n        />\n        <Checkbox\n          id=\"login-remember\"\n          name=\"login-remember\"\n          label=\"Remember me for 30 days\"\n          variant=\"default\"\n          size=\"base\"\n        />\n        <Button fullWidth variant=\"default\" size=\"base\">\n          Sign in with email\n        </Button>\n        <Button\n          variant=\"outline\"\n          size=\"base\"\n          gap=\"sm\"\n          class=\"flex items-center w-full\"\n        >\n          <GoogleColor slot=\"left-icon\" class=\"size-4\" />\n          Sign in with Google\n        </Button>\n      </form>\n      <Text\n        tag=\"p\"\n        variant=\"textXS\"\n        class=\"mt-4 font-medium text-base-500 \"\n      >\n        Dont' have an account?\n        <a\n          href=\"#_\"\n          class=\"font-medium text-primary/88 hover:text-base-500 \"\n        >\n          Sign up\n        </a>\n      </Text>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
