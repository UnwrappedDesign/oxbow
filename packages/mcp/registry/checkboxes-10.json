      "content": "---\nexport const description = \"Checkbox with Expansion\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full p-24 bg-white gap-2 \"\n>\n  <!-- copy:start -->\n  <div class=\"flex flex-col w-full gap-1\" x-data=\"{ expanded: false }\">\n    <div class=\"flex items-start gap-3\">\n      <input\n        id=\"terms-acceptance-checkbox\"\n        name=\"terms-acceptance-checkbox\"\n        type=\"checkbox\"\n        @change=\"expanded = !expanded\"\n        class=\"text-primary rounded shadow size-4 border-base-300 focus:ring-primary \"\n      />\n      <div>\n        <Text\n          for=\"terms-acceptance-checkbox\"\n          tag=\"label\"\n          class=\"block text-sm font-medium text-base-500 \"\n        >\n          Accept terms and conditions\n        </Text>\n        <Text tag=\"p\" variant=\"textSM\" class=\"text-base-400 \">\n          Please review and accept the terms and conditions to proceed.\n        </Text>\n      </div>\n    </div>\n    <div\n      x-show=\"expanded\"\n      class=\"mt-2 text-sm ml-7 text-base-400 \"\n    >\n      By checking this box, you confirm that you have read and agreed to the\n      terms and conditions of our service.\n    </div>\n  </div>\n  <!-- copy:end -->\n</section>\n"
    }
