    {
      "name": "05.astro",
      "path": "oxbow/marketing/footers/05.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\nimport Logo from \"@/components/assets/Logo.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport XBrand from \"@/components/fundations/icons/XBrand.astro\";\nimport LinkedinBrand from \"@/components/fundations/icons/LinkedinBrand.astro\";\nimport YoutubeBrand from \"@/components/fundations/icons/YoutubeBrand.astro\";\nimport GithubBrand from \"@/components/fundations/icons/GithubBrand.astro\";\nconst footerLinks = [\n  {\n    heading: \"Company \",\n    links: [\n      { href: \"#\", text: \"About\" },\n      { href: \"#\", text: \"Mission\" },\n      { href: \"#\", text: \"Leadership Team\" },\n      { href: \"#\", text: \"History\" },\n    ],\n  },\n  {\n    heading: \" Services\",\n    links: [\n      { href: \"#\", text: \"Marketing\" },\n      { href: \"#\", text: \"Analytics\" },\n      { href: \"#\", text: \"Commerce\" },\n      { href: \"#\", text: \"Insights\" },\n    ],\n  },\n  {\n    heading: \"Resources\",\n    links: [\n      { href: \"#\", text: \"Documentation\" },\n      { href: \"#\", text: \"Guides\" },\n      { href: \"#\", text: \"Webinars\" },\n      { href: \"#\", text: \"White Papers\" },\n    ],\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl lg:px-12\">\n    <div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-8\">\n      <div class=\"col-span-full md:col-span-3\">\n        <Logo class=\"h-12 text-foreground\" />\n        <div class=\"mt-8\">\n          <Text\n            tag=\"h2\"\n            variant=\"textBase\"\n            class=\"font-semibold text-foreground\"\n          >\n            Join our newsletter\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-1 font-medium text-muted-foreground lg:text-balance\"\n          >\n            Stay up to date with our latest news and updates.\n          </Text>\n          <form\n            class=\"flex flex-col w-full max-w-xs mt-4 md:flex-row lg:items-center gap-2\"\n          >\n            <TextInput\n              id=\"email\"\n              name=\"email\"\n              type=\"email\"\n              placeholder=\"you@probablyimportant.com\"\n              variant=\"default\"\n              label=\"Email address\"\n              size=\"sm\"\n              isGrouped\n            />\n            <Button type=\"submit\" size=\"sm\" variant=\"accent\" class=\"shrink-0\">\n              Join us!\n            </Button>\n          </form>\n        </div>\n      </div>\n      {\n        footerLinks.map((section, index) => (\n          <nav aria-labelledby={`footer-heading-${index}`}>\n            <Text\n              tag=\"h2\"\n              variant=\"textBase\"\n              id={`footer-heading-${index}`}\n              class=\"font-semibold text-foreground\"\n            >\n              {section.heading}\n            </Text>\n            <ul class=\"mt-4\">\n              {section.links.map((link) => (\n                <li>\n                  <a\n                    href=\"#_\"\n                    class=\"text-sm font-medium text-muted-foreground hover:text-foreground\"\n                  >\n                    {link.text}\n                  </a>\n                </li>\n              ))}\n            </ul>\n          </nav>\n        ))\n      }\n    </div>\n    <div\n      class=\"flex flex-col justify-between pt-12 mt-12 border-t gap-8 sm:flex-row sm:items-center border-border\"\n    >\n      <Text\n        tag=\"h2\"\n        variant=\"textSM\"\n        class=\"font-medium text-muted-foreground\"\n      >\n        © 2024 Oxbow UI. All rights reserved.\n      </Text>\n      <nav\n        aria-labelledby=\"social-icons-heading\"\n        role=\"navigation\"\n        class=\"flex items-center gap-4 text-muted-foreground\"\n      >\n        <Text id=\"social-icons-heading\" class=\"sr-only\">\n          Follow us on social media\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"text-sm font-medium text-foreground hover:text-foreground\"\n        >\n          <XBrand size=\"sm\" />\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"text-sm font-medium text-foreground hover:text-foreground\"\n        >\n          <LinkedinBrand size=\"sm\" />\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"text-sm font-medium text-foreground hover:text-foreground\"\n        >\n          <GithubBrand size=\"sm\" />\n        </Text>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textBase\"\n          class=\"text-sm font-medium text-foreground hover:text-foreground\"\n        >\n          <YoutubeBrand size=\"sm\" />\n        </Text>\n      </nav>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
