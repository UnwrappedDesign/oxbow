      "name": "05.astro",
      "path": "oxbow/marketing/gallery/05.astro",
      "content": "---\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport { Image } from \"astro:assets\";\nimport g1 from \"@/images/gallery/1.png\";\nimport g2 from \"@/images/gallery/2.png\";\nimport g3 from \"@/images/gallery/3.png\";\nimport g4 from \"@/images/gallery/4.png\";\nimport g5 from \"@/images/gallery/5.png\";\nimport g6 from \"@/images/gallery/6.png\";\nimport g7 from \"@/images/gallery/7.png\";\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div class=\"items-center grid grid-cols-1 gap-12 lg:grid-cols-6\">\n      <div class=\"lg:col-span-2\">\n        <Text\n          variant=\"displayMD\"\n          tag=\"h2\"\n          class=\"font-semibold tracking-tight text-foreground sm:text-balance\"\n        >\n          Lightbox\n        </Text>\n        <Text\n          variant=\"textSM\"\n          tag=\"p\"\n          class=\"mt-2 font-medium text-muted-foreground sm:text-balance\"\n        >\n          Browse selected screens and components showing Oxbow UI in action —\n          design examples, component usage, and real layouts to inspire your\n          next project.\n        </Text>\n\n        <Text\n          variant=\"textSM\"\n          tag=\"p\"\n          class=\"mt-4 text-muted-foreground\"\n        >\n          What you'll find:\n        </Text>\n\n        <ul\n          class=\"mt-2 ml-4 list-disc text-muted-foreground space-y-1\"\n        >\n          <li>High-fidelity screen mockups and layout examples</li>\n          <li>Reusable components in real contexts (forms, cards, headers)</li>\n          <li>Design patterns for responsive and accessible UI</li>\n        </ul>\n\n        <Text\n          variant=\"textSM\"\n          tag=\"p\"\n          class=\"mt-4 italic text-muted-foreground\"\n        >\n          Tip: Wait for autum for the full experience.\n        </Text>\n      </div>\n      <div\n        class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 lg:grid-cols-3 lg:col-span-4\"\n      >\n        <div class=\"flex flex-col gap-4 sm:col-span-2 lg:col-span-1\">\n          <Image\n            width={500}\n            height={500}\n            src={g1}\n            alt=\"#_\"\n            class=\"object-cover aspect-square lg:aspect-auto lg:h-120 size-full\"\n          />\n          <Image\n            width={500}\n            height={500}\n            src={g2}\n            alt=\"#_\"\n            class=\"object-cover aspect-square lg:aspect-auto lg:h-120 size-full\"\n          />\n        </div>\n        <div class=\"flex flex-col gap-4 sm:col-span-2 lg:col-span-1\">\n          <Image\n            width={500}\n            height={500}\n            src={g3}\n            alt=\"#_\"\n            class=\"object-cover aspect-square lg:aspect-auto aspect-2/4 size-full\"\n          />\n          <Image\n            width={500}\n            height={500}\n            src={g4}\n            alt=\"#_\"\n            class=\"object-cover aspect-square lg:aspect-auto aspect-2/4 size-full\"\n          />\n          <Image\n            width={500}\n            height={500}\n            src={g5}\n            alt=\"#_\"\n            class=\"object-cover aspect-square lg:aspect-auto aspect-2/4 size-full\"\n          />\n        </div>\n        <div class=\"flex flex-col gap-4 sm:col-span-2 lg:col-span-1\">\n          <Image\n            width={500}\n            height={500}\n            src={g6}\n            alt=\"#_\"\n            class=\"object-cover aspect-square lg:aspect-auto lg:h-120 size-full\"\n          />\n          <Image\n            width={500}\n            height={500}\n            src={g7}\n            alt=\"#_\"\n            class=\"object-cover aspect-square lg:aspect-auto lg:h-120 size-full\"\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
