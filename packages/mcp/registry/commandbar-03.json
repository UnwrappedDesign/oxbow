{
  "name": "commandbar-03",
  "type": "component",
  "description": "commandbar block 03",
  "category": "application",
  "section": "commandbar",
  "variant": 3,
  "aliases": [
    "commandbar",
    "commandbar 3",
    "commandbar 03"
  ],
  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/application/commandbar/03.astro",
      "content": "---\n// Keep dynamic classes readable after CSS obfuscation\nexport const excludeFromObfuscation = [\n  \"bg-base-50\",\n  \"bg-white/5\",\n  \"\",\n  \"text-accent-600\",\n  \"text-base-600\",\n];\nimport Search from \"@/components/fundations/icons/Search.astro\";\nimport XIcon from \"@/components/fundations/icons/X.astro\";\nimport Grid from \"@/components/fundations/icons/Grid.astro\";\nimport FileDots from \"@/components/fundations/icons/FileDots.astro\";\nimport Subtask from \"@/components/fundations/icons/Subtask.astro\";\nimport UsersGroup from \"@/components/fundations/icons/UsersGroup.astro\";\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\nimport Settings from \"@/components/fundations/icons/Settings.astro\";\nimport CircleInfo from \"@/components/fundations/icons/CircleInfo.astro\";\n---\n\n<div\n  class=\"flex items-center justify-center p-8 py-24 bg-white \"\n>\n  <!-- Copy:start -->\n  <!--\n  \n  - [x-cloak] hides uninitialized Alpine content until hydration to avoid flicker.\n \n<style>\n  :global([x-cloak]) {\n    display: none !important;\n  }\n  \n</style> \n\n-->\n  <div\n    class=\"w-full max-w-2xl overflow-hidden bg-white shadow-lg rounded-xl outline outline-base-200 \"\n    x-data=\"{\n      open: true,\n      query: '',\n      activeTab: 'all',\n      selected: 0,\n      // quick filter for priority\n      priority: 'all', // all | high | medium | low\n      tabs: [\n        { id:'all', label:'All', icon:'grid' },\n        { id:'open', label:'Open', icon:'task' },\n        { id:'mine', label:'Mine', icon:'users' },\n        { id:'mentions', label:'Mentions', icon:'info' },\n      ],\n      // Issue triage dataset\n      items: [\n        { id:'iss-101', type:'open', assignee:'me', mentions:false, priority:'high',  title:'Payment flow times out intermittently', subtitle:'#checkout · reported by support', badges:['Bug','High'], href:'#issue-101' },\n        { id:'iss-102', type:'open', assignee:'none', mentions:true,  priority:'medium',title:'Clarify empty state copy for Reports', subtitle:'#analytics', badges:['UX','Medium'], href:'#issue-102' },\n        { id:'iss-103', type:'open', assignee:'me', mentions:true,  priority:'low',   title:'Add filter: archived projects', subtitle:'#projects', badges:['Enhancement','Low'], href:'#issue-103' },\n        { id:'iss-104', type:'closed', assignee:'sara', mentions:false, priority:'high', title:'Fix double-submit on mobile', subtitle:'#auth', badges:['Bug','High'], href:'#issue-104' },\n        { id:'iss-105', type:'open', assignee:'dan', mentions:false, priority:'medium', title:'Refactor avatar uploader', subtitle:'#settings', badges:['Tech Debt','Medium'], href:'#issue-105' },\n      ],\n      // Triage actions (fire events instead of navigation)\n      actions: [\n        { id:'assign-me', text:'Assign to me', desc:'Take ownership of the selected issue', icon:'users', shortcuts:['A'] },\n        { id:'mark-high', text:'Mark as High Priority', desc:'Upgrade priority to High', icon:'settings', shortcuts:['H'] },\n        { id:'close-issue', text:'Close Issue', desc:'Resolve and archive', icon:'task', shortcuts:['C'] },\n        { id:'new-issue', text:'New Issue', desc:'Create issue from scratch', icon:'plus', shortcuts:['N'] },\n      ],\n      score(text, q){\n        q = (q||'').trim().toLowerCase();\n        if(!q) return 1;\n        text = (text||'').toLowerCase();\n        if(text === q) return 1000;\n        if(text.startsWith(q)) return 500;\n        // subsequence\n        let i=0,j=0; while(i<text.length && j<q.length){ if(text[i]===q[j]) j++; i++; }\n        return j===q.length ? 200 : (text.includes(q) ? 100 : -1);\n      },\n      filteredResults(){\n        const q = this.query;\n        const tab = this.activeTab;\n        return this.items\n          .filter(it => {\n            if (tab==='all') return true;\n            if (tab==='open') return it.type==='open';\n            if (tab==='mine') return it.assignee==='me';\n            if (tab==='mentions') return !!it.mentions;\n            return true;\n          })\n          .filter(it => this.priority==='all' ? true : it.priority===this.priority)\n          .map(o=>({o, s: Math.max(this.score(o.title,q), this.score(o.subtitle,q))}))\n          .filter(x=>x.s>=0)\n          .sort((a,b)=> b.s - a.s)\n          .map(x=>x.o);\n      },\n      filteredActions(){\n        const q = this.query;\n        return this.actions\n          .map(o=>({o, s: Math.max(this.score(o.text,q), this.score(o.desc,q))}))\n          .filter(x=>x.s>=0)\n          .sort((a,b)=> b.s - a.s)\n          .map(x=>x.o);\n      },\n      get selectable(){\n        const res = this.filteredResults();\n        const acts = this.filteredActions();\n        return [\n          ...res.map(r=>({key:`item:${r.id}`, kind:'item', data:r})),\n          ...acts.map(a=>({key:`action:${a.id}`, kind:'action', data:a})),\n        ];\n      },\n      isSelected(entry){\n        const sel = this.selectable[this.selected];\n        return sel && sel.key === entry.key;\n      },\n      openList(){ this.open = true; this.selected = 0; },\n      closeList(){ this.open = false; },\n      next(){ const n = this.selectable.length; if(!n) return; this.selected = (this.selected + 1) % n; },\n      prev(){ const n = this.selectable.length; if(!n) return; this.selected = (this.selected - 1 + n) % n; },\n      choose(){\n        const sel = this.selectable[this.selected];\n        if(!sel) return;\n        if(sel.kind==='action'){\n          window.dispatchEvent(new CustomEvent('triage:action', { detail:{ action: sel.data.id, query: this.query } }));\n          this.closeList();\n          return;\n        }\n        const href = sel.data.href; if(href){ window.location.hash = href; }\n        this.closeList();\n      },\n      onKey(e){\n        if((e.metaKey||e.ctrlKey) && !e.shiftKey && !e.altKey && e.key.toLowerCase()==='k'){ e.preventDefault(); this.openList(); this.$nextTick(()=> this.$refs.input?.focus()); return; }\n        if(e.key==='/'){ e.preventDefault(); this.openList(); this.$nextTick(()=> this.$refs.input?.focus()); return; }\n        if(e.key==='Escape'){ this.closeList(); return; }\n      }\n    }\"\n    @keydown.window=\"onKey($event)\"\n  >\n    <!-- Search + Tabs -->\n    <div class=\"p-2\">\n      <div class=\"relative\">\n        <Search\n          class=\"pointer-events-none absolute top-3.5 left-4 text-base-400\"\n          size=\"base\"\n          slot=\"icon\"\n        />\n        <input\n          x-ref=\"input\"\n          x-model=\"query\"\n          @focus=\"openList()\"\n          @keydown.arrow-down.prevent=\"next()\"\n          @keydown.arrow-up.prevent=\"prev()\"\n          @keydown.enter.prevent=\"choose()\"\n          @keydown.escape.prevent=\"closeList()\"\n          class=\"w-full h-12 pr-24 bg-transparent border-0 rounded-lg text-base-800 placeholder-base-400 pl-11 sm:text-sm ring-1 ring-base-200 focus:outline-none focus:ring-2 focus:ring-primary/70\"\n          placeholder=\"Find anything — docs, tickets, teammates\"\n          autocomplete=\"off\"\n          role=\"combobox\"\n          :aria-expanded=\"open\"\n          aria-controls=\"options\"\n          aria-autocomplete=\"list\"\n        />\n        <div\n          class=\"pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 hidden sm:flex gap-1 text-[0.70rem] text-base-500 \"\n        >\n          <kbd\n            class=\"px-1 border rounded bg-base-100 border-base-200 text-base-600\"\n            >⌘</kbd\n          >\n          <kbd\n            class=\"px-1 border rounded bg-base-100 border-base-200 text-base-600\"\n            >K</kbd\n          >\n        </div>\n        <button\n          type=\"button\"\n          x-show=\"query.length>0\"\n          @click=\"query=''; $nextTick(()=> $refs.input?.focus())\"\n          class=\"absolute right-[3.25rem] top-1/2 -translate-y-1/2 size-7 inline-flex items-center justify-center rounded-md text-base-500 hover:text-base-700 hover:bg-base-100 \"\n          aria-label=\"Clear search\"\n        >\n          <XIcon size=\"sm\" />\n        </button>\n      </div>\n      <!-- Tabs -->\n      <div class=\"px-2 mt-2\">\n        <div class=\"flex items-center gap-2 text-[12px]\">\n          <template x-for=\"t in tabs\" :key=\"t.id\">\n            <button\n              type=\"button\"\n              @click=\"activeTab=t.id; selected=0\"\n              :class=\"activeTab===t.id ? 'text-primary/70' : 'text-base-500 '\"\n              class=\"relative inline-flex items-center px-2 py-1 gap-2 rounded-md hover:bg-base-50 \"\n            >\n              <template x-if=\"t.icon==='grid'\"><Grid size=\"sm\" /></template>\n              <template x-if=\"t.icon==='file'\"><FileDots size=\"sm\" /></template>\n              <template x-if=\"t.icon==='task'\"><Subtask size=\"sm\" /></template>\n              <template x-if=\"t.icon==='users'\"\n                ><UsersGroup size=\"sm\" /></template\n              >\n              <template x-if=\"t.icon==='info'\"\n                ><CircleInfo size=\"sm\" /></template\n              >\n              <span x-text=\"t.label\"></span>\n              <span\n                x-show=\"activeTab===t.id\"\n                class=\"absolute -bottom-1 left-2 right-2 h-[2px] rounded bg-primary/70\"\n              ></span>\n            </button>\n          </template>\n        </div>\n        <!-- Quick priority filter -->\n        <div class=\"flex items-center gap-2 py-2 mt-4\">\n          <span class=\"text-[0.70rem] text-base-500 \"\n            >Priority:</span\n          >\n          <button\n            @click=\"priority='all'; selected=0\"\n            :class=\"priority==='all' ? 'bg-base-100 text-base-900 ' : 'text-base-600 '\"\n            class=\"h-6 px-2 rounded-md text-xs\">All</button\n          >\n          <button\n            @click=\"priority='high'; selected=0\"\n            :class=\"priority==='high' ? 'bg-destructive/24 text-destructive/88 ' : 'text-base-600 '\"\n            class=\"h-6 px-2 rounded-md text-xs\">High</button\n          >\n          <button\n            @click=\"priority='medium'; selected=0\"\n            :class=\"priority==='medium' ? 'bg-warning/24 text-warning/88 ' : 'text-base-600 '\"\n            class=\"h-6 px-2 rounded-md text-xs\">Medium</button\n          >\n          <button\n            @click=\"priority='low'; selected=0\"\n            :class=\"priority==='low' ? 'bg-success/24 text-success/88 ' : 'text-base-600 '\"\n            class=\"h-6 px-2 rounded-md text-xs\">Low</button\n          >\n        </div>\n      </div>\n    </div>\n\n    <!-- Results -->\n    <div class=\"py-1\">\n      <div\n        class=\"px-6 py-1 text-[0.70rem] font-medium text-base-500 \"\n      >\n        Recent\n      </div>\n      <ul class=\"divide-y divide-base-100 \">\n        <template x-for=\"r in filteredResults()\" :key=\"r.id\">\n          <li\n            :class=\"isSelected({key:'item:'+r.id}) ? 'bg-base-50 ' : ''\"\n            class=\"flex items-center justify-between px-6 py-3 cursor-pointer text-base-900 \"\n            @mouseenter=\"selected = selectable.findIndex(e=>e.key==='item:'+r.id)\"\n            @click=\"selected = selectable.findIndex(e=>e.key==='item:'+r.id); choose()\"\n          >\n            <div class=\"flex items-center gap-3\">\n              <div\n                class=\"bg-white rounded-lg size-8 grid place-items-center ring-1 ring-base-200 \"\n              >\n                <template x-if=\"true\"><Subtask size=\"sm\" /></template>\n              </div>\n              <div>\n                <div class=\"text-sm font-medium\" x-text=\"r.title\"></div>\n                <div\n                  class=\"text-xs text-base-500 \"\n                  x-text=\"r.subtitle\"\n                >\n                </div>\n              </div>\n            </div>\n            <div class=\"items-center hidden md:flex gap-1\">\n              <template x-for=\"b in r.badges\" :key=\"b\">\n                <span\n                  class=\"text-[0.70rem] px-2 py-0.5 rounded-full bg-base-100 text-base-700 \"\n                  x-text=\"b\"></span>\n              </template>\n            </div>\n          </li>\n        </template>\n        <li\n          x-show=\"filteredResults().length===0\"\n          class=\"px-6 py-6 text-sm italic text-center text-base-500 \"\n        >\n          No matches in this tab\n        </li>\n      </ul>\n    </div>\n\n    <!-- Actions -->\n    <div class=\"py-1\">\n      <div\n        class=\"px-6 py-1 text-[0.70rem] font-medium text-base-500 \"\n      >\n        Quick actions\n      </div>\n      <ul class=\"divide-y divide-base-100 \">\n        <template x-for=\"a in filteredActions()\" :key=\"a.id\">\n          <li\n            :class=\"isSelected({key:'action:'+a.id}) ? 'bg-base-50 ' : ''\"\n            class=\"flex items-center justify-between px-6 py-3 cursor-pointer text-base-900 \"\n            @mouseenter=\"selected = selectable.findIndex(e=>e.key==='action:'+a.id)\"\n            @click=\"selected = selectable.findIndex(e=>e.key==='action:'+a.id); choose()\"\n          >\n            <div class=\"flex items-center gap-3\">\n              <div\n                class=\"bg-white rounded-lg size-8 grid place-items-center ring-1 ring-base-200 \"\n              >\n                <template x-if=\"a.icon==='plus'\"><Plus size=\"sm\" /></template>\n                <template x-if=\"a.icon==='users'\"\n                  ><UsersGroup size=\"sm\" /></template\n                >\n                <template x-if=\"a.icon==='file'\"\n                  ><FileDots size=\"sm\" /></template\n                >\n                <template x-if=\"a.icon==='settings'\"\n                  ><Settings size=\"sm\" /></template\n                >\n              </div>\n              <div>\n                <div class=\"text-sm font-medium\" x-text=\"a.text\"></div>\n                <div\n                  class=\"text-xs text-base-500 \"\n                  x-text=\"a.desc\"\n                >\n                </div>\n              </div>\n            </div>\n            <div\n              class=\"hidden sm:flex items-center gap-1 text-[0.70rem] text-base-600\"\n            >\n              <template x-for=\"k in a.shortcuts\" :key=\"k\">\n                <kbd\n                  class=\"px-1 border rounded bg-base-100 border-base-200 text-base-600\"\n                  x-text=\"k\"></kbd>\n              </template>\n            </div>\n          </li>\n        </template>\n        <li\n          x-show=\"filteredActions().length===0\"\n          class=\"px-6 py-6 text-sm italic text-center text-base-500 \"\n        >\n          No actions found\n        </li>\n      </ul>\n    </div>\n\n    <!-- Footer help -->\n    <div\n      class=\"px-4 py-2 text-[0.70rem] text-base-500 flex items-center justify-between bg-base-50 \"\n    >\n      <div>\n        Hint: press <kbd\n          class=\"px-1 border rounded bg-base-100 border-base-200 text-base-600\"\n          >/</kbd\n        > to search\n      </div>\n      <div class=\"items-center hidden sm:flex gap-2\">\n        <span class=\"flex items-center gap-1\"\n          ><kbd\n            class=\"px-1 border rounded bg-base-100 border-base-200 text-base-600\"\n            >↑</kbd\n          ><kbd\n            class=\"px-1 border rounded bg-base-100 border-base-200 text-base-600\"\n            >↓</kbd\n          > to navigate</span\n        >\n        <span class=\"flex items-center gap-1\"\n          ><kbd\n            class=\"px-1 border rounded bg-base-100 border-base-200 text-base-600\"\n            >↵</kbd\n          > to open</span\n        >\n      </div>\n    </div>\n  </div>\n  <!-- Copy:end -->\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
