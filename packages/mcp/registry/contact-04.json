{
  "name": "contact-04",
  "type": "component",
  "description": "contact block 04",
  "category": "marketing",
  "section": "contact",
  "variant": 4,
  "aliases": [
    "contact",
    "contact 4",
    "contact 04"
  ],
  "files": [
    {
      "name": "04.astro",
      "path": "oxbow/marketing/contact/04.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nexport const excludeFromObfuscation = [\"ring-base-500\", \"ring-base-300\"];\nimport { Image } from \"astro:assets\";\nimport contact from \"@/images/placeholders/contact.png\";\n---\n\n<div class=\"relative p-8 bg-white \">\n  <div class=\"lg:absolute lg:inset-0 lg:left-1/2\">\n    <Image\n      width={1200}\n      height={1200}\n      src={contact}\n      alt=\"\"\n      class=\"object-cover w-full h-64 bg-base-50 sm:h-80 lg:absolute lg:h-full\"\n    />\n  </div>\n  <div\n    class=\"pt-16 pb-24 sm:pb-32 sm:pt-24 lg:mx-auto lg:grid lg:max-w-7xl lg:grid-cols-2 lg:pt-32\"\n  >\n    <div class=\"px-6 lg:px-8\">\n      <div class=\"max-w-xl mx-auto lg:mx-0 lg:max-w-lg\">\n        <div class=\"max-w-xl lg:text-balance\">\n          <Text\n            tag=\"h1\"\n            variant=\"displayMD\"\n            class=\"font-semibold tracking-tight text-base-900 lg:text-balance\"\n          >\n            Let’s start a conversation\n          </Text>\n          <Text\n            tag=\"p\"\n            variant=\"textBase\"\n            class=\"mt-4 lg:text-balance text-base-500 \"\n          >\n            Have a question, idea, or feedback? Our team is here to listen and\n            help you move forward. Reach out and let’s connect.\n          </Text>\n        </div>\n        <form action=\"#\" method=\"POST\" class=\"max-w-lg mx-auto mt-12\">\n          <div class=\"grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2\">\n            <div>\n              <label\n                for=\"first-name\"\n                class=\"text-sm font-medium text-base-500 \"\n              >\n                First name\n              </label>\n              <div class=\"mt-1\">\n                <input\n                  type=\"text\"\n                  name=\"first-name\"\n                  id=\"first-name\"\n                  autocomplete=\"given-name\"\n                  required\n                  aria-required=\"true\"\n                  aria-describedby=\"first-name-error\"\n                  placeholder=\"Your first name\"\n                  class=\"block w-full h-10 px-4 py-2 text-sm bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n                />\n                <span id=\"first-name-error\" class=\"hidden text-sm text-destructive\">\n                  Please enter your first name.\n                </span>\n              </div>\n            </div>\n            <div>\n              <label\n                for=\"last-name\"\n                class=\"text-sm font-medium text-base-500 \"\n              >\n                Last name\n              </label>\n              <div class=\"mt-1\">\n                <input\n                  type=\"text\"\n                  name=\"last-name\"\n                  id=\"last-name\"\n                  autocomplete=\"family-name\"\n                  required\n                  aria-required=\"true\"\n                  aria-describedby=\"last-name-error\"\n                  placeholder=\"Your last name\"\n                  class=\"block w-full h-10 px-4 py-2 text-sm bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n                />\n                <span id=\"last-name-error\" class=\"hidden text-sm text-destructive\">\n                  Please enter your last name.\n                </span>\n              </div>\n            </div>\n            <div class=\"sm:col-span-2\">\n              <label\n                for=\"compant\"\n                class=\"text-sm font-medium text-base-500 \"\n              >\n                Company name\n              </label>\n              <div class=\"mt-1\">\n                <input\n                  type=\"text\"\n                  name=\"company\"\n                  id=\"company\"\n                  autocomplete=\"organization\"\n                  aria-describedby=\"company-error\"\n                  placeholder=\"Your company\"\n                  class=\"block w-full h-10 px-4 py-2 text-sm bg-white border border-transparent rounded-lg appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n                />\n                <span id=\"company-error\" class=\"hidden text-sm text-destructive\">\n                  Please enter your company name.\n                </span>\n              </div>\n            </div>\n            <div class=\"sm:col-span-2\">\n              <label\n                for=\"phone-number\"\n                class=\"text-sm font-medium text-base-500 \"\n              >\n                Phone number\n              </label>\n              <div class=\"relative mt-1\">\n                <div class=\"absolute inset-y-0 left-0 flex items-center\">\n                  <label for=\"country\" class=\"sr-only\">Country</label>\n                  <select\n                    id=\"country\"\n                    name=\"country\"\n                    aria-label=\"Country code\"\n                    class=\"h-full py-0 pl-4 bg-transparent border-0 rounded-md pr-9 text-base-400 focus:ring-2 focus:ring-inset focus:ring-base-600 sm:text-sm\"\n                  >\n                    <option value=\"IT\">Italy</option>\n                    <option value=\"ES\">Spain</option>\n                    <option value=\"JP\">Japan</option>\n                  </select>\n                </div>\n                <input\n                  type=\"tel\"\n                  name=\"phone-number\"\n                  id=\"phone-number\"\n                  autocomplete=\"tel\"\n                  aria-describedby=\"phone-number-description\"\n                  placeholder=\"123-456-7890\"\n                  class=\"block w-full h-10 px-4 py-2 pl-24 text-sm bg-white border border-transparent rounded-lg shadow appearance-none text-base-700 duration-300 ring-1 ring-base-200 placeholder-base-400 focus:border-base-300 focus:bg-transparent focus:outline-none focus:ring-primary/88 focus:ring-offset-2 focus:ring-2 sm:text-sm\"\n                />\n                <p id=\"phone-number-description\" class=\"sr-only\">\n                  Enter your phone number including the country code.\n                </p>\n              </div>\n            </div>\n          </div>\n          <div\n            x-data=\"{\n    radioGroupSelectedValue: null,\n    radioGroupOptions: [\n      {\n        title: 'Freelancer',\n        description: 'Select this option if you are a freelancer.',\n        value: 'freelancer'\n      },\n      {\n        title: 'Company',\n        description: 'Select this option if you are working for a company.',\n        value: 'company'\n      },\n    ]\n  }\"\n            class=\"mt-6 grid grid-cols-1 md:grid-cols-2 gap-2\"\n            role=\"radiogroup\"\n            aria-labelledby=\"radio-group-label\"\n          >\n            <span id=\"radio-group-label\" class=\"sr-only\"\n              >Choose your work status</span\n            >\n            <template x-for=\"(option, index) in radioGroupOptions\" :key=\"index\">\n              <div>\n                <input\n                  type=\"radio\"\n                  :id=\"'radio-' + option.value\"\n                  name=\"radio-group\"\n                  :value=\"option.value\"\n                  x-model=\"radioGroupSelectedValue\"\n                  class=\"sr-only\"\n                  :aria-describedby=\"'description-' + option.value\"\n                />\n                <label\n                  :for=\"'radio-' + option.value\"\n                  class=\"block shadow cursor-pointer bg-linear-180 outline outline-base-100 from-base-50 to-base-100 rounded-xl transition-all duration-300 ease-in-out focus-within:ring-base-500\"\n                  :class=\"{ 'ring-base-500': radioGroupSelectedValue === option.value }\"\n                >\n                  <div\n                    class=\"flex flex-col justify-between h-full text-left rounded-lg\"\n                    tabindex=\"-1\"\n                  >\n                    <div class=\"flex items-center p-4 gap-3\">\n                      <div\n                        class=\"flex items-center justify-center bg-white rounded-full size-4 ring-1 \"\n                        :class=\"{ 'ring-base-500': radioGroupSelectedValue === option.value, 'ring-base-300 ': radioGroupSelectedValue !== option.value }\"\n                        aria-hidden=\"true\"\n                      >\n                        <svg\n                          xmlns=\"http://www.w3.org/2000/svg\"\n                          class=\"icon icon-tabler icon-tabler-circle-check-filled text-base-600 \"\n                          width=\"20\"\n                          height=\"20\"\n                          viewBox=\"0 0 24 24\"\n                          stroke-width=\"2\"\n                          stroke=\"currentColor\"\n                          fill=\"none\"\n                          stroke-linecap=\"round\"\n                          stroke-linejoin=\"round\"\n                          x-show=\"radioGroupSelectedValue === option.value\"\n                        >\n                          <path stroke=\"none\" d=\"M0 0h24v24H0z\" fill=\"none\"\n                          ></path>\n                          <path\n                            d=\"M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-1.293 5.953a1 1 0 0 0 -1.32 -.083l-.094 .083l-3.293 3.292l-1.293 -1.292l-.094 -.083a1 1 0 0 0 -1.403 1.403l.083 .094l2 2l.094 .083a1 1 0 0 0 1.226 0l.094 -.083l4 -4l.083 -.094a1 1 0 0 0 -.083 -1.32z\"\n                            stroke-width=\"0\"\n                            fill=\"currentColor\"></path>\n                        </svg>\n                      </div>\n                      <Text\n                        tag=\"span\"\n                        variant=\"textBase\"\n                        x-text=\"option.title\"\n                        class=\"font-medium text-base-900 \"\n                      />\n                    </div>\n                    <div\n                      class=\"p-4 border-t border-base-200 \"\n                    >\n                      <Text\n                        tag=\"span\"\n                        variant=\"textBase\"\n                        x-text=\"option.description\"\n                        :id=\"'description-' + option.value\"\n                        class=\"text-sm font-medium text-base-500 \"\n                      />\n                    </div>\n                  </div>\n                </label>\n              </div>\n            </template>\n          </div>\n          <Button class=\"w-full mt-8\" variant=\"default\" size=\"base\">\n            Submit\n          </Button>\n          <div class=\"flex items-center mt-4\">\n            <input\n              id=\"agreement\"\n              name=\"agreement\"\n              type=\"checkbox\"\n              class=\"rounded shadow size-4 border-base-300 text-base-600 focus:ring-base-600\"\n            />\n            <label\n              for=\"agreement\"\n              class=\"block ml-3 text-sm text-base-500 \"\n            >\n              You agree to our\n              <a\n                href=\"#_\"\n                class=\"ont-medium text-base-900 hover:text-primary \"\n              >\n                Terms of service\n              </a>\n              and\n              <a\n                href=\"#_\"\n                class=\"ont-medium text-base-900 hover:text-primary \"\n              >\n                Privacy Policy\n              </a>\n            </label>\n          </div>\n        </form>\n      </div>\n    </div>\n  </div>\n</div>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
