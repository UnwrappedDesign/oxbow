{
  "name": "product-details-03",
  "type": "component",
  "description": "product-details block 03",
  "category": "ecommerce",
  "section": "product-details",
  "variant": 3,
  "aliases": [
    "product details",
    "product details 3",
    "product details 03",
    "product detail",
    "product detail 3",
    "product detail 03"
  ],
  "files": [
    {
      "name": "03.astro",
      "path": "oxbow/ecommerce/product-details/03.astro",
      "content": "---\nexport const excludeFromObfuscation = [\n  \"ring-2\",\n  \"ring-border\",\n  \"ring-offset-2\",\n  \"ring-border\",\n  \"bg-muted\",\n  \"ring-border\",\n  \"bg-muted\",\n  \"ring-border/30\",\n  \"bg-muted\",\n  \"ring-border/30\",\n  \"bg-muted/20\",\n  \"ring-destructive/30\",\n  \"bg-destructive/20\",\n  \"ring-border/30\",\n  \"bg-muted/20\",\n  \"ring-warning/30\",\n  \"bg-warning\",\n  \"ring-border/30\",\n  \"bg-muted/20\",\n  \"ring-info/30\",\n  \"bg-info\",\n  \"ring-success/30\",\n  \"bg-success\",\n  \"ring-success/30\",\n  \"bg-success/20\",\n  \"text-foreground\",\n  \"group-open:-rotate-45\",\n];\n\nexport const description =\n  \"Details with image slider on a two column grid, color, size selector and accordion\";\n\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Plus from \"@/components/fundations/icons/Plus.astro\";\nconst productInfo = [\n  {\n    title: \"Details\",\n    description:\n      \"This product is crafted from high-quality materials designed for durability and comfort. It features modern design elements and is perfect for everyday use.\",\n  },\n  {\n    title: \"Shipping\",\n    description:\n      \"We offer free standard shipping on all orders above $50. Express shipping options are available at checkout for an additional fee.\",\n  },\n  {\n    title: \"Returns\",\n    description:\n      \"We accept returns within 30 days of purchase. Items must be in their original condition and packaging. Please visit our returns page for more details.\",\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"relative px-8 py-24 mx-auto md:px-12 lg:px-20 max-w-7xl\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n      <!-- Product Image Gallery -->\n      <div\n        x-data=\"{ \n                activeImage: 0,\n                images: [\n                    '/store/shoes/airforcewhite/1.png',\n                    '/store/shoes/airforcewhite/2.png',\n                    '/store/shoes/airforcewhite/3.png',\n                    '/store/shoes/airforcewhite/4.png',\n                    '/store/shoes/airforcewhite/5.png',\n                    '/store/shoes/airforcewhite/6.png'\n                ]\n            }\"\n        class=\"lg:sticky lg:top-24 lg:self-start lg:order-last\"\n      >\n        <div class=\"grid grid-cols-7 gap-2\">\n          <!-- Thumbnails -->\n          <div class=\"col-span-1 grid grid-cols-1 gap-2\">\n            <template x-for=\"(image, index) in images\" :key=\"index\">\n              <button\n                @click=\"activeImage = index\"\n                class=\"overflow-hidden aspect-square bg-background rounded-2xl\"\n              >\n                <img\n                  :src=\"image\"\n                  alt=\"Product thumbnail\"\n                  class=\"object-cover size-full aspect-square\"\n                />\n              </button>\n            </template>\n          </div>\n          <!-- Main Image -->\n          <div\n            class=\"overflow-hidden col-span-6 rounded-2xl bg-background\"\n          >\n            <img\n              :src=\"images[activeImage]\"\n              class=\"object-cover size-full aspect-square\"\n              alt=\"Product image\"\n            />\n          </div>\n        </div>\n      </div>\n      <!-- Product Details -->\n      <div class=\"flex flex-col\">\n        <div class=\"flex items-center justify-betwee text-foreground\">\n          <Text tag=\"h1\" variant=\"textLG\" class=\"font-medium\"\n            >Nike Air Force 1´07 Fresh</Text\n          >\n          <Text tag=\"p\" variant=\"textLG\">$190</Text>\n        </div>\n        <Text tag=\"p\" variant=\"textSM\" class=\"mt-4 text-muted-foreground\">\n          Hitting the field in the late '60s, adidas airforcewhiteS quickly\n          became soccer's \"it\" shoe.\n        </Text>\n        <div class=\"mt-4 grid cols-1 md:grid-cols-2 gap-4\">\n          <!-- Color Selector -->\n          <div x-data=\"{ activeColor: null }\">\n            <Text\n              tag=\"p\"\n              variant=\"textXS\"\n              class=\"uppercase text-muted-foreground\"\n            >\n              Color\n            </Text>\n            <fieldset\n              aria-label=\"Choose a color\"\n              class=\"mt-2\"\n              x-data=\"{ \n              colors: [\n                { name: ' Black', ring: 'ring-border', bg: 'bg-background' },\n                { name: ' Gray', ring: 'ring-border', bg: 'bg-muted' },\n                { name: ' Purple', ring: 'ring-border/30', bg: 'bg-muted' },\n                { name: ' Pink', ring: 'ring-border/30', bg: 'bg-muted/20' },\n                { name: ' Red', ring: 'ring-destructive/30', bg: 'bg-destructive/20' },\n                { name: ' Orange', ring: 'ring-border/30', bg: 'bg-muted/20' },\n                { name: ' Yellow', ring: 'ring-warning/30', bg: 'bg-warning' },\n                { name: ' Blue', ring: 'ring-info/30', bg: 'bg-info' },\n                { name: ' Cyan', ring: 'ring-info/30', bg: 'bg-info' },\n                { name: ' Green', ring: 'ring-success/30', bg: 'bg-success' },\n                { name: ' Teal', ring: 'ring-success/30', bg: 'bg-success/20' },\n              ],\n              activeColor: null \n            }\"\n            >\n              <div class=\"flex flex-wrap items-center gap-3\">\n                <template x-for=\"color in colors\" :key=\"color.name\">\n                  <label\n                    :aria-label=\"color.name\"\n                    class=\"relative -m-0.5 duration-300 flex cursor-pointer items-center justify-center rounded-full p-0.5 focus:outline-none\"\n                    :class=\"{ 'ring-2 ring-offset-2 ring-border': activeColor === color.name }\"\n                  >\n                    <input\n                      type=\"radio\"\n                      name=\"color-choice\"\n                      :value=\"color.name\"\n                      class=\"sr-only\"\n                      @click=\"activeColor = color.name\"\n                    />\n                    <span\n                      aria-hidden=\"true\"\n                      class=\"rounded-full size-6 ring-1\"\n                      :class=\"`${color.ring} ${color.bg}`\"></span>\n                  </label>\n                </template>\n              </div>\n            </fieldset>\n          </div>\n          <!-- Sizing -->\n          <div\n            x-data=\"{\n              sizeSystem: 'US',\n              activeSize: null,\n              sizes: {\n                  US: ['6', '7', '8', '9', '10', '11', '12', '13'],\n                  EU: ['39', '40', '41', '42', '43', '44', '45', '46']\n              }\n          }\"\n          >\n            <div class=\"flex items-center justify-between\">\n              <Text\n                tag=\"p\"\n                variant=\"textXS\"\n                class=\"uppercase text-muted-foreground\"\n              >\n                Shoe size\n              </Text>\n              <div>\n                <label for=\"size-system\" class=\"sr-only\">Size System</label>\n                <select\n                  id=\"size-system\"\n                  x-model=\"sizeSystem\"\n                  @change=\"activeSize = null\"\n                  class=\"block w-auto h-8 pl-2.5 pr-8 py-2 text-xs text-foreground duration-300 bg-background border border-transparent rounded-lg appearance-none ring-1 ring-border placeholder:text-muted-foreground focus:border-border focus:border-border focus:bg-transparent focus:outline-none focus:ring-border focus:ring-offset-2 focus:ring-2\"\n                >\n                  <option value=\"US\">US</option>\n                  <option value=\"EU\">EU</option>\n                </select>\n              </div>\n            </div>\n            <div class=\"mt-2 grid grid-cols-4 gap-2 divide-x divide-border\">\n              <template x-for=\"size in sizes[sizeSystem]\" :key=\"size\">\n                <div>\n                  <input\n                    type=\"radio\"\n                    :id=\"'size-' + size\"\n                    :value=\"size\"\n                    name=\"size-choice\"\n                    x-model=\"activeSize\"\n                    class=\"sr-only peer\"\n                  />\n                  <label\n                    :for=\"'size-' + size\"\n                    x-text=\"size\"\n                    class=\"flex items-center justify-center px-3 py-2 text-sm font-medium bg-background cursor-pointer ring-1 ring-border rounded-md duration-300 peer-checked:ring-2 peer-checked:ring-border peer-checked:text-foreground text-foreground peer-checked:ring-offset-2\"\n                  ></label>\n                </div>\n              </template>\n            </div>\n          </div>\n        </div>\n\n        <!-- Action Buttons -->\n        <div class=\"flex flex-row mt-8 gap-2\">\n          <Button size=\"sm\" variant=\"default\" class=\"w-full\">Add to Cart</Button\n          >\n          <Button size=\"sm\" variant=\"muted\" class=\"w-full\">Buy Now</Button>\n        </div>\n        <!-- Free shipping notice -->\n        <Text tag=\"p\" variant=\"textSM\" class=\"mt-1 text-muted-foreground\"\n          >Free shipping over $50 if you behave</Text\n        >\n        <!-- Accordion sections -->\n        <div class=\"mt-8 divide-y divide-border border-y border-border\">\n          {\n            productInfo.map((info) => (\n              <details class=\"cursor-pointer group\">\n                <Text\n                  tag=\"summary\"\n                  variant=\"textSM\"\n                  class=\"flex items-center justify-between w-full py-4 font-medium text-left select-none text-foreground hover:text-muted-foreground focus:text-muted-foreground\"\n                >\n                  {info.title}\n                  <Plus\n                    class=\"duration-300 ease-out transform group-open:-rotate-45\"\n                    size=\"sm\"\n                  />\n                </Text>\n                <div class=\"pb-4\">\n                  <Text tag=\"p\" variant=\"textSM\" class=\"text-muted-foreground\">\n                    {info.description}\n                  </Text>\n                </div>\n              </details>\n            ))\n          }\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
