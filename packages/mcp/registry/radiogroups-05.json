      "name": "05.astro",
      "path": "oxbow/application/radiogroups/05.astro",
      "content": "---\nexport const description = \"Radio Group with Toggle Details\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\n---\n\n<div class=\"flex justify-center mx-auto bg-background p-15\">\n  <!-- copy:start -->\n  <div\n    class=\"flex flex-col w-full max-w-2xl mx-auto lg:flex-row gap-12\"\n    x-data=\"{ selected: 'monthly' }\"\n  >\n    <div class=\"space-y-4\">\n      <div class=\"flex items-start gap-3\">\n        <input\n          id=\"radio-monthly\"\n          name=\"radio-toggle-group\"\n          type=\"radio\"\n          value=\"monthly\"\n          x-model=\"selected\"\n          class=\"text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border\"\n        />\n        <div>\n          <Text\n            for=\"radio-monthly\"\n            tag=\"label\"\n            class=\"block text-sm font-medium text-muted-foreground\"\n          >\n            Monthly Plan\n          </Text>\n          <p class=\"text-sm text-muted-foreground\">\n            Pay $10 per month.\n          </p>\n        </div>\n      </div>\n      <div class=\"flex items-start gap-3\">\n        <input\n          id=\"radio-yearly\"\n          name=\"radio-toggle-group\"\n          type=\"radio\"\n          value=\"yearly\"\n          x-model=\"selected\"\n          class=\"text-foreground bg-background rounded-full shadow size-4 border-border focus:ring-border\"\n        />\n        <div>\n          <Text\n            for=\"radio-yearly\"\n            tag=\"label\"\n            class=\"block text-sm font-medium text-muted-foreground\"\n          >\n            Yearly Plan\n          </Text>\n          <p class=\"text-sm text-muted-foreground\">\n            Pay $100 per year and save 20%.\n          </p>\n        </div>\n      </div>\n    </div>\n    <div class=\"text-sm text-muted-foreground\">\n      <div x-show=\"selected === 'monthly'\">\n        Monthly plan is flexible and easy to cancel anytime!\n      </div>\n      <div x-show=\"selected === 'yearly'\">\n        Yearly plan offers a better deal for long-term use!\n      </div>\n    </div>\n  </div>\n  <!-- copy:end -->\n</div>\n"
    }
