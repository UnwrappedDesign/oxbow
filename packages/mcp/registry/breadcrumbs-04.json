    {
      "name": "04.astro",
      "path": "oxbow/application/breadcrumbs/04.astro",
      "content": "---\nexport const description = \"Breadcrumb with outline\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport Home from \"@/components/fundations/icons/Home.astro\";\nimport Slash from \"@/components/fundations/icons/Slash.astro\";\n---\n\n<section\n  class=\"flex flex-wrap items-center justify-center h-full bg-background gap-2 p-18\"\n>\n  <!-- copy:start -->\n  <nav\n    aria-label=\"Breadcrumb\"\n    class=\"border inline-flex py-1.5 px-3.5 rounded-lg border-border bg-background\"\n  >\n    <ol role=\"list\" class=\"flex items-center space-x-2\">\n      <li>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXS\"\n          class=\"flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground\"\n        >\n          <Home size=\"sm\" aria-hidden=\"true\" />\n        </Text>\n      </li>\n      <li>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXS\"\n          class=\"flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground\"\n        >\n          <span>Home</span>\n          <Slash size=\"base\" aria-hidden=\"true\" />\n        </Text>\n      </li>\n      <li>\n        <Text\n          tag=\"a\"\n          href=\"#_\"\n          variant=\"textXS\"\n          class=\"flex items-center font-medium gap-2 text-muted-foreground hover:text-foreground\"\n        >\n          <span>Work</span>\n          <Slash size=\"base\" aria-hidden=\"true\" />\n        </Text>\n      </li>\n      <li>\n        <Text\n          tag=\"span\"\n          variant=\"textXS\"\n          aria-current=\"page\"\n          class=\"flex items-center font-medium gap-2 text-foreground\"\n        >\n          <span>Details</span>\n        </Text>\n      </li>\n    </ol>\n  </nav>\n  <!-- copy:end -->\n</section>\n"
    }
  ],
