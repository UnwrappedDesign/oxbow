  "files": [
    {
      "name": "06.astro",
      "path": "oxbow/marketing/features/06.astro",
      "content": "---\nimport Button from \"@/components/fundations/buttons/Button.astro\";\nimport Text from \"@/components/fundations/typography/Text.astro\";\nimport CircleCheck from \"@/components/fundations/icons/CircleCheck.astro\";\n\nexport const excludeFromObfuscation = [\"bg-background\", \"bg-muted\"];\n\nconst data = [\n  {\n    category: \"Innovative Design\",\n    text: \"Our cutting-edge design offers a fresh, modern look that transforms your project into a standout experience.\",\n    items: [\"Great communication\", \"Enhancing productivity\"],\n  },\n  {\n    category: \"Powerful Functionality\",\n    text: \"Equipped with advanced features and tools, our solution effortlessly manages complex tasks and workflows.\",\n    items: [\"Unlocking  solutions\", \"Enabling interoperability\"],\n  },\n  {\n    category: \"Seamless Collaboration\",\n    text: \"Our platform fosters teamwork and collaboration by providing the tools and features needed to work effectively.\",\n    items: [\"Real-time editing\", \"Shared workspaces\"],\n  },\n  {\n    category: \"Advanced Analytics\",\n    text: \"Gain deep insights into your data with our comprehensive analytics tools, helping you make informed decisions.\",\n    items: [\"Customizable dashboards\", \"Predictive analytics\"],\n  },\n];\n---\n\n<section class=\"bg-background\">\n  <div class=\"px-8 py-24 mx-auto max-w-7xl md:px-12 lg:px-20\">\n    <div\n      class=\"relative items-center p-8 list-none grid grid-cols-1 bg-muted/40 lg:grid-cols-2 gap-4 lg:gap-24 rounded-3xl lg:p-10 overflow-clip\"\n    >\n      <div class=\"pt-8 text-center lg:text-left\">\n        <Text\n          tag=\"p\"\n          variant=\"textSM\"\n          class=\"font-bold text-foreground uppercase\"\n        >\n          Tagline\n        </Text>\n        <Text\n          tag=\"h2\"\n          variant=\"displayMD\"\n          class=\"mt-4 font-semibold text-foreground lg:text-balance\"\n        >\n          Transforming the banking experience for a digital future\n        </Text>\n        <Text\n          tag=\"p\"\n          variant=\"textBase\"\n          class=\"mt-4 font-medium text-muted-foreground\"\n        >\n          The fastest method for working together on staging and temporary\n          environments.\n        </Text>\n        <div class=\"flex flex-wrap items-center mx-auto mt-8 gap-2\">\n          <Button variant=\"accent\" size=\"sm\"> Get started </Button>\n          <Button variant=\"outline\" size=\"sm\"> Learn more </Button>\n        </div>\n      </div>\n      <div class=\"items-center h-full mt-12 lg:mt-0\">\n        <img\n          alt=\"#\"\n          class=\"absolute w-full border shadow rounded-2xl border-border\"\n          src=\"/images/dashboardLight.svg\"\n        />\n      </div>\n    </div>\n    <div class=\"mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6\">\n      <div class=\"gap-6 grid grid-cols-1 sm:grid-cols-2 gap-y-12 lg:col-span-2\">\n        {\n          data.map((section) => (\n            <div>\n              <div>\n                <Text\n                  variant=\"textLG\"\n                  tag=\"h3\"\n                  class=\"font-medium text-foreground\"\n                >\n                  {section.category}\n                </Text>\n                <Text\n                  tag=\"p\"\n                  variant=\"textBase\"\n                  class=\"mt-4 font-medium text-muted-foreground\"\n                >\n                  {section.text}\n                </Text>\n              </div>\n              <ul\n                role=\"list\"\n                class=\"mt-6 text-base font-medium list-none space-y-1 text-foreground\"\n              >\n                {section.items.map((item) => (\n                  <li>\n                    <div class=\"flex items-center gap-4\">\n                      <CircleCheck\n                        class=\"text-foreground\"\n                        size=\"base\"\n                        slot=\"icon\"\n                      />\n                      <Text tag=\"span\" variant=\"textBase\">\n                        {item}\n                      </Text>\n                    </div>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))\n        }\n      </div>\n      <div class=\"block w-full lg:row-span-2\">\n        <div\n          x-data=\"{ activeSlide: 0, slides: ['/widgets/activity.svg', '/widgets/hits.svg', '/widgets/traffic.svg'] }\"\n          class=\"relative h-full\"\n          role=\"region\"\n          aria-label=\"Image Slider\"\n        >\n          <!-- Template for each slide image -->\n          <template x-for=\"(slide, index) in slides\" :key=\"index\">\n            <div\n              x-show=\"activeSlide === index\"\n              x-transition:enter=\"transition ease-out duration-500\"\n              x-transition:enter-start=\"opacity-0 transform scale-95\"\n              x-transition:enter-end=\"opacity-100 transform scale-100\"\n              x-transition:leave=\"transition ease-in duration-500\"\n              x-transition:leave-start=\"opacity-100 transform scale-100\"\n              x-transition:leave-end=\"opacity-0 transform scale-95\"\n              class=\"absolute inset-0 size-full\"\n              :aria-hidden=\"activeSlide !== index\"\n            >\n              <!-- Slide image -->\n              <img\n                :src=\"slide\"\n                alt=\"#\"\n                class=\"object-contain shadow size-full rounded-2xl\"\n              />\n            </div>\n          </template>\n          <!-- Previous slide button -->\n          <button\n            @click=\"activeSlide = activeSlide === 0 ? slides.length - 1 : activeSlide - 1\"\n            class=\"absolute flex items-center justify-center bg-background border rounded-full left-4 top-1/2 transform -translate-y-1/2 text-foreground size-10 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-border\"\n            aria-label=\"Previous Slide\"\n          >\n            &larr;\n          </button>\n          <!-- Next slide button -->\n          <button\n            @click=\"activeSlide = activeSlide === slides.length - 1 ? 0 : activeSlide + 1\"\n            class=\"absolute flex items-center justify-center bg-background border rounded-full right-4 top-1/2 transform -translate-y-1/2 text-foreground size-10 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-border\"\n            aria-label=\"Next Slide\"\n          >\n            &rarr;\n          </button>\n          <!-- Pagination indicators -->\n          <div\n            class=\"absolute flex bottom-4 left-1/2 transform -translate-x-1/2 space-x-2\"\n          >\n            <template x-for=\"(slide, index) in slides\" :key=\"index\">\n              <button\n                @click=\"activeSlide = index\"\n                :class=\"{'bg-background': activeSlide === index, 'bg-muted': activeSlide !== index}\"\n                class=\"w-3 h-3 rounded-full focus:outline-none\"\n                :aria-label=\"'Slide ' + (index + 1)\"\n                :aria-current=\"activeSlide === index ? 'true' : 'false'\"\n              ></button>\n            </template>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": []
}
