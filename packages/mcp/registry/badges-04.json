      "content": "---\nexport const description = \"Left and right badge \";\nimport Badge from \"@/components/fundations/badges/Badge.astro\";\nimport PlaceHolderIcon from \"@/components/fundations/icons/PlaceHolderIcon.astro\";\n---\n\n<section\n  class=\"flex flex-col items-center justify-center h-full p-20 bg-white gap-12 \"\n>\n  <!-- SM Size -->\n  <div class=\"flex flex-wrap justify-center gap-2\">\n    <!-- XS Size -->\n    <Badge\n      variant=\"default\"\n      gap=\"xs\"\n      size=\"xs\"\n      slot=\"left-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Default\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge\n      variant=\"accent\"\n      gap=\"xs\"\n      size=\"xs\"\n      slot=\"fet-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Accent\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n\n    <Badge variant=\"muted\" gap=\"xs\" size=\"xs\" slot=\"fet-icon\" slot=\"right-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Muted\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge variant=\"text\" gap=\"xs\" size=\"xs\" slot=\"fet-icon\" slot=\"right-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Text\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge variant=\"info\" gap=\"xs\" size=\"xs\" slot=\"fet-icon\" slot=\"right-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Info\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge\n      variant=\"success\"\n      gap=\"xs\"\n      size=\"xs\"\n      slot=\"fet-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Success\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge\n      variant=\"warning\"\n      gap=\"xs\"\n      size=\"xs\"\n      slot=\"fet-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Warning\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge\n      variant=\"danger\"\n      gap=\"xs\"\n      size=\"xs\"\n      slot=\"fet-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Danger\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n  </div>\n  <!-- SM Size -->\n  <div class=\"flex flex-wrap justify-center gap-2\">\n    <Badge\n      variant=\"default\"\n      gap=\"xs\"\n      size=\"sm\"\n      slot=\"left-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Default\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge\n      variant=\"accent\"\n      gap=\"xs\"\n      size=\"sm\"\n      slot=\"left-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Accent\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n\n    <Badge\n      variant=\"muted\"\n      gap=\"xs\"\n      size=\"sm\"\n      slot=\"left-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Muted\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge variant=\"text\" gap=\"xs\" size=\"sm\" slot=\"left-icon\" slot=\"right-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Text\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge variant=\"info\" gap=\"xs\" size=\"sm\" slot=\"fet-icon\" slot=\"right-icon\">\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Info\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge\n      variant=\"success\"\n      gap=\"xs\"\n      size=\"sm\"\n      slot=\"fet-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Success\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge\n      variant=\"warning\"\n      gap=\"xs\"\n      size=\"sm\"\n      slot=\"fet-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Warning\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n    <Badge\n      variant=\"danger\"\n      gap=\"xs\"\n      size=\"sm\"\n      slot=\"fet-icon\"\n      slot=\"right-icon\"\n    >\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n      Danger\n      <PlaceHolderIcon gap=\"xs\" size=\"sm\" />\n    </Badge>\n  </div>\n  <!-- copy:end -->\n</section>\n"
