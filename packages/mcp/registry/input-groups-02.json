      "name": "02.astro",
      "path": "oxbow/application/input-groups/02.astro",
      "content": "---\nexport const description = \"Block input group\";\nimport TextInput from \"@/components/fundations/inputs/TextInput.astro\";\n---\n\n<section class=\"justify-center h-full p-12 bg-white gap-2 \">\n  <div class=\"w-full max-w-sm mx-auto\">\n    <!-- copy:start -->\n    <div class=\"grid grid-cols-2\">\n      <div class=\"col-span-full\">\n        <TextInput\n          id=\"creditCard\"\n          name=\"creditCard\"\n          label=\"Credit Card Number\"\n          type=\"text\"\n          formatCreditCard={true}\n          variant=\"default\"\n          size=\"base\"\n          noRoundedBottom\n          placeholder=\"XXXX XXXX XXXX XXXX\"\n          isGrouped={true}\n        />\n      </div>\n      <TextInput\n        id=\"expiry\"\n        name=\"expiry\"\n        label=\"Expiry Date\"\n        type=\"text\"\n        variant=\"default\"\n        size=\"base\"\n        noRoundedTop={true}\n        noRoundedBottomRight={true}\n        placeholder=\"MM/YY\"\n        isGrouped={true}\n      />\n      <TextInput\n        id=\"cvv\"\n        name=\"cvv\"\n        label=\"CVV\"\n        type=\"text\"\n        variant=\"default\"\n        size=\"base\"\n        noRoundedTop={true}\n        noRoundedBottomLeft={true}\n        placeholder=\"123\"\n        isGrouped={true}\n      />\n    </div>\n    <!-- copy:end -->\n  </div>\n</section>\n"
    }
